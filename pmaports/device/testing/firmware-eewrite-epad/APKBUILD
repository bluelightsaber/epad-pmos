# Maintainer: bluelightsaber <26096600+bluelightsaber@users.noreply.github.com>
# Proprietary firmware: NOT distributed. Extract it from your own unit (the WiFi NVRAM holds its MAC address).
# CONNSYS (WiFi/BT) from Android /vendor/firmware and the NVRAM/BT_Addr partitions; SPM PCM programs from Android.
pkgname=firmware-eewrite-epad
pkgver=1
pkgrel=0
pkgdesc="Firmware for the Eewrite E-PAD (MT6797 CONNSYS WiFi/BT, SPM)"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
source="
	ROMv3_patch_1_0_hdr.bin
	ROMv3_patch_1_1_hdr.bin
	WIFI_RAM_CODE_6797
	mt6797-epad-wifi-nvram.bin
	BT.bin
	pcm_suspend.bin
	pcm_vcorefs_lpm.bin
"

package() {
	local d="$pkgdir"/lib/firmware/mediatek
	install -Dm644 "$srcdir"/ROMv3_patch_1_0_hdr.bin "$srcdir"/ROMv3_patch_1_1_hdr.bin \
		"$srcdir"/WIFI_RAM_CODE_6797 "$srcdir"/mt6797-epad-wifi-nvram.bin -t "$d"
	install -Dm644 "$srcdir"/BT.bin "$srcdir"/pcm_suspend.bin "$srcdir"/pcm_vcorefs_lpm.bin -t "$d"/mt6797
}
