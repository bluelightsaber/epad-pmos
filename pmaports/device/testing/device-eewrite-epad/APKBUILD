# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: bluelightsaber <26096600+bluelightsaber@users.noreply.github.com>
pkgname=device-eewrite-epad
pkgdesc="Eewrite E-PAD"
pkgver=1
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-eewrite-epad
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
source="deviceinfo"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

nonfree_firmware() {
	pkgdesc="WiFi, Bluetooth and SPM firmware"
	depends="firmware-eewrite-epad wireless-regdb"
	mkdir "$subpkgdir"
}
