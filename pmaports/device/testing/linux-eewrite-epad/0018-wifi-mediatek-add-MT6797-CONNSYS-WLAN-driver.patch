+
+	/* 1. switch P2P-FSM on */
+	/* 1.1 allocate for message */
+	prFuncSwitch = (P_MSG_P2P_FUNCTION_SWITCH_T) cnmMemAlloc(prAdapter,
+								 RAM_TYPE_MSG, sizeof(MSG_P2P_FUNCTION_SWITCH_T));
+
+	if (!prFuncSwitch) {
+		ASSERT(0);	/* Can't trigger P2P FSM */
+		return -ENOMEM;
