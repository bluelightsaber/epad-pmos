+	if (UNEQUAL_SSID(prBssDesc->aucSSID, prBssDesc->ucSSIDLen,
+		prConnSettings->aucSSID, prConnSettings->ucSSIDLen)) {
+		DBGLOG(RSN, TRACE, "-- SSID not matched\n");
