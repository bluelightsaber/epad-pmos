+	}
+	/* 4 <2> Compose Null frame in MSDU_INfO_T. */
+	bssComposeNullFrame(prAdapter, (PUINT_8) ((ULONG) prMsduInfo->prPacket + MAC_TX_RESERVED_FIELD), prStaRec);
+#if 0
