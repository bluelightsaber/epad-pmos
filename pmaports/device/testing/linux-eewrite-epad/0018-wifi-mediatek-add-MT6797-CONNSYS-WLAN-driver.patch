+		prGetChnLoad = (P_PARAM_GET_CHN_LOAD) &(prGlueInfo->prAdapter->rWifiVar.rChnLoadInfo);
+
+		for (ucIdx = 0; ucIdx < ucMax_24G_Chn_List; ucIdx++) {
+			DBGLOG(P2P, INFO,
+			       "[Auto Channel][Ori_AP_Num] ch[%d]=%d\n", ucIdx + 1,
