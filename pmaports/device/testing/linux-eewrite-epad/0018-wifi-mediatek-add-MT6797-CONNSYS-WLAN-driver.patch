+INT_32 wlanHexToNum(CHAR c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+INT_32 wlanHexToByte(PCHAR hex)
+{
+	INT_32 a, b;
+
+	a = wlanHexToNum(*hex++);
+	if (a < 0)
+		return -1;
+	b = wlanHexToNum(*hex++);
+	if (b < 0)
+		return -1;
+	return (a << 4) | b;
+}
+
+INT_32 wlanHwAddrToBin(PCHAR txt, UINT_8 *addr)
+{
+	INT_32 i;
+	PCHAR pos = txt;
+
+	for (i = 0; i < 6; i++) {
+		INT_32 a, b;
+
+		while (*pos == ':' || *pos == '.' || *pos == '-')
+			pos++;
+
+		a = wlanHexToNum(*pos++);
+		if (a < 0)
+			return -1;
+		b = wlanHexToNum(*pos++);
+		if (b < 0)
+			return -1;
+		*addr++ = (a << 4) | b;
+	}
+
+	return pos - txt;
+}
