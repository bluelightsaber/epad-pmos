+
+const UINT_16 au2RateVHT[VHT_RATE_NUM] = {
+	RATE_VHT_MCS_0,		/* RATE_MCS0_INDEX, */
+	RATE_VHT_MCS_1,		/* RATE_MCS1_INDEX, */
