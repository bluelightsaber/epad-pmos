+	/* 6. Frame Formation - 20/40 BSS Coexistence */
+	/*
+	   Follow WiFi test plan, add 20/40 element to request/response/confirm.
+	 */
+#if 0
+	if (prGlueInfo->fgTdlsIs2040Supported == TRUE) {
