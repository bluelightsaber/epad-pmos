+void mtk_p2p_cfg80211_update_mgmt_frame_registrations(struct wiphy *wiphy,
+		struct wireless_dev *wdev, struct mgmt_frame_regs *regs)
+{
+	u32 types = regs->interface_stypes | regs->global_stypes;
+
+	mtk_p2p_cfg80211_mgmt_frame_register(wiphy, wdev, MAC_FRAME_PROBE_REQ,
+				      !!(types & BIT(MAC_FRAME_PROBE_REQ >> 4)));
+	mtk_p2p_cfg80211_mgmt_frame_register(wiphy, wdev, MAC_FRAME_ACTION,
+				      !!(types & BIT(MAC_FRAME_ACTION >> 4)));
