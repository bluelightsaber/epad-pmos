+VOID wlanCfgSetSwCtrl(IN P_ADAPTER_T prAdapter)
+{
+	UINT_32 i = 0;
+	CHAR aucKey[WLAN_CFG_VALUE_LEN_MAX];
+	CHAR aucValue[WLAN_CFG_VALUE_LEN_MAX];
+	CHAR *pcPtr = NULL;
+	CHAR *pcDupValue = NULL;
+	UINT_32 au4Values[2];
