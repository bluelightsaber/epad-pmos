+		((P_NETDEV_PRIVATE_GLUE_INFO) netdev_priv(prGlueInfo->prMonDevHandler))->prGlueInfo = prGlueInfo;
+		prGlueInfo->prMonDevHandler->type = ARPHRD_IEEE80211_RADIOTAP;
