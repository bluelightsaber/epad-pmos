+			   &rDefaultKey, sizeof(PARAM_DEFAULT_KEY_T), FALSE, FALSE, TRUE, FALSE, &u4BufLen);
+#endif
+
+	if (rStatus == WLAN_STATUS_SUCCESS)
+		i4Rst = 0;
+
+	return i4Rst;
+}
