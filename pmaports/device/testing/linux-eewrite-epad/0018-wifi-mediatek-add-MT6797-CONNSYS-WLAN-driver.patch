+		/* Get the Maximun channel List in 2.4G Bands */
+		/* Determin if countryCode is valid */
+		/* whatever case only support ch 1~11 */
+		/* if (prGlueInfo->prAdapter->rWifiVar.rConnSettings.u2CountryCode != 0x0000) { */
