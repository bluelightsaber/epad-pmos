+					 ucBssIndex,
+					 prStaRec,
+					 txAssocRspAttributesTable,
+					 sizeof(txAssocRspAttributesTable) / sizeof(APPEND_VAR_ATTRI_ENTRY_T));
+
+}				/* p2pFuncCalculateP2p_IELenForAssocRsp */
