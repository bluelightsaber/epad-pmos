+	prAisBssInfo = prAdapter->prAisBssInfo;
+
+	/* Search a BSS with the same SSID from the given BSS description set. */
+	/* DBGLOG(RSN, TRACE, ("Check scan result ["MACSTR"]\n", */
+	/* MAC2STR(prBssDesc->aucBSSID))); */
