+	if (prEvent->ucEID != EVENT_ID_DEBUG_MSG)
+		DBGLOG(RX, EVENT, "RX EVENT: ID[0x%02X] SEQ[%u] LEN[%u]\n",
+		prEvent->ucEID, prEvent->ucSeqNum, prEvent->u2PacketLength);
+
+	/* Event Handling */
+	switch (prEvent->ucEID) {
