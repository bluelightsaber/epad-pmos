+#if DBG
+/*lint -save -e64 Type mismatch */
+static PUINT_8 apucDebugScanState[SCAN_STATE_NUM] = {
+	(PUINT_8) DISP_STRING("SCAN_STATE_IDLE"),
+	(PUINT_8) DISP_STRING("SCAN_STATE_SCANNING"),
+};
