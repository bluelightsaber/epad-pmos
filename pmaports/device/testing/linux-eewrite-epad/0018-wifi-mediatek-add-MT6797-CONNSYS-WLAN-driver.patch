+
+WLAN_STATUS
+wlanoidSetGSCNAConfig(IN P_ADAPTER_T prAdapter,
+		      IN PVOID pvSetBuffer, IN UINT_32 u4SetBufferLen, OUT PUINT_32 pu4SetInfoLen)
+{
+
+	P_PARAM_WIFI_GSCAN_CMD_PARAMS prCmdGscnScnConfigParam;
