+
+	if (u4CSUMFlags & CSUM_OFFLOAD_EN_TX_IP)
+		rCmdBasicConfig.rCsumOffload.u2TxChecksum |= BIT(0);
+
+	if (u4CSUMFlags & CSUM_OFFLOAD_EN_RX_TCP)
