+	__pm_wakeup_event(*(_prWakeLock), jiffies_to_msecs(_u4Timeout))
+#define KAL_WAKE_UNLOCK(_prAdapter, _prWakeLock) __pm_relax(*(_prWakeLock))
+static inline bool kalWakeLockActive(struct wakeup_source *source)
+{
+	unsigned long flags;
+	bool active;
+
+	if (!source)
+		return false;
+	spin_lock_irqsave(&source->lock, flags);
+	active = source->active;
+	spin_unlock_irqrestore(&source->lock, flags);
+	return active;
+}
+#define KAL_WAKE_LOCK_ACTIVE(_prAdapter, _prWakeLock) \
+	kalWakeLockActive(*(_prWakeLock))
