+	} else if (eState == PARAM_MEDIA_STATE_DISCONNECTED) {
+		snprintf(aucBuffer, IW_CUSTOM_MAX - 1, "P2P_STA_DISCONNECT=" MACSTR, MAC2STR(rPeerAddr));
