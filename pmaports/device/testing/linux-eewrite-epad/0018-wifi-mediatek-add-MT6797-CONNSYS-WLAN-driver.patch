+
+	/* specify data length */
+	wrqu->data.length = sizeof(IW_P2P_IOCTL_INVITATION_STATUS);
+
+	/* copy to upper-layer supplied buffer */
+	prInvStatus->status_code = prGlueInfo->prP2PInfo->u4InvStatus;
+
+	return 0;
+}				/* end of mtk_p2p_wext_invitation_status() */
