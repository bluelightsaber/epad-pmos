+	UINT_32 name_len;
+	UINT_8 device_addr[6];
+	UINT_8 device_type;
+	INT_32 config_method;
+	INT_32 active_config_method;
+} IW_P2P_DEVICE_REQ, *P_IW_P2P_DEVICE_REQ;
+
+typedef struct iw_p2p_transport_struct {
