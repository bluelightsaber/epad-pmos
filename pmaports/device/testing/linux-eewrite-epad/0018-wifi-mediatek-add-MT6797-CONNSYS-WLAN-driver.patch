+	/* Long Format, the following structure is for long format ONLY */
+	/* DW 2 */
+	UINT_8 ucType_SubType;	/* Type, Sub-type, NDP, NDPA */
+	UINT_8 ucFrag;		/* Sounding, force RTS/CTS, BMC, BIP, Duration, HTC exist, Fragment */
