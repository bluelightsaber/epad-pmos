+/*----------------------------------------------------------------------------*/
+/*!
+* \brief Initialize the adapter. The sequence is
+*        1. Disable interrupt
+*        2. Read adapter configuration from EEPROM and registry, verify chip ID.
+*        3. Create NIC Tx/Rx resource.
+*        4. Initialize the chip
+*        5. Initialize the protocol
+*        6. Enable Interrupt
+*
+* \param prAdapter      Pointer of Adapter Data Structure
+*
+* \retval WLAN_STATUS_SUCCESS: Success
+* \retval WLAN_STATUS_FAILURE: Failed
+*/
+/*----------------------------------------------------------------------------*/
+static bool wlan_firmware_trace;
+module_param_named(firmware_trace, wlan_firmware_trace, bool, 0600);
+MODULE_PARM_DESC(firmware_trace, "Log bounded firmware startup stages");
+static bool wlan_download_check;
+module_param_named(download_check, wlan_download_check, bool, 0444);
+MODULE_PARM_DESC(download_check, "Query ROM download errors before Wi-Fi Start");
+static bool wlan_rom_emi_check;
+module_param_named(rom_emi_check, wlan_rom_emi_check, bool, 0444);
+MODULE_PARM_DESC(rom_emi_check, "Compare firmware EMI words through the Wi-Fi ROM");
+
+static bool mt6797_wlan_firmware_valid(const u8 *data, size_t length)
+{
+	u32 count, index, offset, bytes, destination;
+	size_t table_end;
+	const u8 *section;
+
+	if (!data || length < 24 || get_unaligned_le32(data) != MTK_WIFI_SIGNATURE)
+		return false;
+	/* The pinned June 2016 vendor image has zero version/chip metadata. */
+	if (get_unaligned_le32(data + 16) != 6797 &&
+	    (get_unaligned_le32(data + 16) || get_unaligned_le32(data + 12)))
+		return false;
+	count = get_unaligned_le32(data + 8);
+	if (count < 2 || count > (length - 24) / 16)
+		return false;
+	table_end = 24 + (size_t)count * 16;
+	if (get_unaligned_le32(data + 4) != wlanCRC32((u8 *)data + 8, length - 8))
+		return false;
+	for (index = 0; index < count; index++) {
+		section = data + 24 + index * 16;
+		offset = get_unaligned_le32(section);
+		bytes = get_unaligned_le32(section + 8);
+		destination = get_unaligned_le32(section + 12);
+		if (offset < table_end || offset > length || !bytes ||
+		    bytes > length - offset || section[4] > 3 || section[5] > 1 ||
+		    bytes > U32_MAX - destination)
+			return false;
+		if (index >= 2 && ((destination & 0xfffff) >= 0x80000 ||
+				  bytes > 0x80000 - (destination & 0xfffff)))
+			return false;
+	}
+	return true;
+}
