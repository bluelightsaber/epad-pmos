+/* 2 Definition in each register */
+/* 3 WCIR 0x0000 */
+#define WCIR_WLAN_READY                 BIT(21)
+#define WCIR_POR_INDICATOR              BIT(20)
+#define WCIR_REVISION_ID                BITS(16, 19)
+#define WCIR_CHIP_ID                    BITS(0, 15)
