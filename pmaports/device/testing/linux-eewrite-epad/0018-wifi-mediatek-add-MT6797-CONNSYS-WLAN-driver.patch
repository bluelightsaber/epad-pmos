+/*----------------------------------------------------------------------------*/
+static int p2pOpen(IN struct net_device *prDev)
+{
+/* P_GLUE_INFO_T prGlueInfo = NULL; */
+/* P_ADAPTER_T prAdapter = NULL; */
+/* P_MSG_P2P_FUNCTION_SWITCH_T prFuncSwitch; */
