+
+		HAL_MCR_WR(prAdapter, MCR_WHIER, WHIER_DEFAULT);
+
+		/* 4 <2> init FW HIF */
+		nicHifInit(prAdapter);
+	} while (FALSE);
+
+	DBGLOG(NIC, INFO, "Chip ID[%04X] Version[E%u]\n", MTK_CHIP_REV, wlanGetEcoVersion(prAdapter));
+
+	return u4Status;
+}
