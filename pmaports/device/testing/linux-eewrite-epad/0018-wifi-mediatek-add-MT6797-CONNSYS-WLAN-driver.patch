+/* Type definition for Boolean */
+typedef unsigned char BOOL, *PBOOL, BOOLEAN, *PBOOLEAN;
+
+/* Type definition for signed integers */
+typedef signed char CHAR, *PCHAR, **PPCHAR;
+typedef signed char INT_8, *PINT_8, **PPINT_8;
