+int	mtk_cfg80211_suspend(struct wiphy *wiphy, struct cfg80211_wowlan *wow)
+{
+	P_GLUE_INFO_T prGlueInfo = NULL;
+
+	if (kalHaltTryLock())
+		return 0;
+
+	if (kalIsHalted() || !wiphy)
+		goto end;
+
+	prGlueInfo = (P_GLUE_INFO_T) wiphy_priv(wiphy);
+
+	set_bit(SUSPEND_FLAG_FOR_WAKEUP_REASON, &prGlueInfo->prAdapter->ulSuspendFlag);
+	set_bit(SUSPEND_FLAG_CLEAR_WHEN_RESUME, &prGlueInfo->prAdapter->ulSuspendFlag);
+end:
+	kalHaltUnlock();
+	return 0;
+}
+
+/*----------------------------------------------------------------------------*/
+/*!
+ * @brief cfg80211 resume callback, will be invoked in wiphy_resume.
+ *
+ * @param wiphy: pointer to wiphy
+ *
+ * @retval 0:       successful
+ *         others:  failure
+ */
+/*----------------------------------------------------------------------------*/
+int mtk_cfg80211_resume(struct wiphy *wiphy)
+{
+	P_GLUE_INFO_T prGlueInfo = NULL;
+	P_BSS_DESC_T *pprBssDesc = NULL;
+	P_ADAPTER_T prAdapter = NULL;
+	UINT_8 i = 0;
+
+	if (kalHaltTryLock())
+		return 0;
+
+	if (kalIsHalted() || !wiphy)
+		goto end;
+
+	prGlueInfo = (P_GLUE_INFO_T) wiphy_priv(wiphy);
+	prAdapter = prGlueInfo->prAdapter;
+	clear_bit(SUSPEND_FLAG_CLEAR_WHEN_RESUME, &prAdapter->ulSuspendFlag);
+	pprBssDesc = &prAdapter->rWifiVar.rScanInfo.rNloParam.aprPendingBssDescToInd[0];
+	for (; i < SCN_SSID_MATCH_MAX_NUM; i++) {
+		if (pprBssDesc[i] == NULL)
+			break;
+		if (pprBssDesc[i]->u2RawLength == 0)
+			continue;
+		kalIndicateBssInfo(prGlueInfo,
+						   (PUINT_8) pprBssDesc[i]->aucRawBuf,
+						   pprBssDesc[i]->u2RawLength,
+						   pprBssDesc[i]->ucChannelNum,
+						   RCPI_TO_dBm(pprBssDesc[i]->ucRCPI));
+	}
+	DBGLOG(SCN, INFO, "pending %d sched scan results\n", i);
+	if (i > 0)
+		kalMemZero(&pprBssDesc[0], i * sizeof(P_BSS_DESC_T));
+end:
+	kalHaltUnlock();
+	return 0;
+}
+
+void mtk_cfg80211_update_mgmt_frame_registrations(struct wiphy *wiphy,
+		struct wireless_dev *wdev, struct mgmt_frame_regs *regs)
+{
+	u32 types = regs->interface_stypes | regs->global_stypes;
+
+	mtk_cfg80211_mgmt_frame_register(wiphy, wdev, MAC_FRAME_PROBE_REQ,
+				      !!(types & BIT(MAC_FRAME_PROBE_REQ >> 4)));
+	mtk_cfg80211_mgmt_frame_register(wiphy, wdev, MAC_FRAME_ACTION,
+				      !!(types & BIT(MAC_FRAME_ACTION >> 4)));
+}
+
+int mtk_cfg80211_external_auth(struct wiphy *wiphy, struct net_device *ndev,
+		struct cfg80211_external_auth_params *params)
+{
+	P_GLUE_INFO_T glue = wiphy_priv(wiphy);
+	MSG_EXTERNAL_AUTH_T *msg;
+
+	if (!mtk_sae_external_auth || ndev != glue->prDevHandler)
+		return -EOPNOTSUPP;
+	if (!glue->u4ReadyFlag || test_bit(GLUE_FLAG_HALT_BIT, &glue->ulFlag))
+		return -ENODEV;
+	if (params->ssid.ssid_len > sizeof(msg->ssid))
+		return -EINVAL;
+	msg = cnmMemAlloc(glue->prAdapter, RAM_TYPE_MSG, sizeof(*msg));
+	if (!msg)
+		return -ENOMEM;
+	memset(msg, 0, sizeof(*msg));
+	msg->rMsgHdr.eMsgId = MID_OID_SAA_EXTERNAL_AUTH;
+	memcpy(msg->bssid, params->bssid, MAC_ADDR_LEN);
+	msg->ssid_len = params->ssid.ssid_len;
+	memcpy(msg->ssid, params->ssid.ssid, msg->ssid_len);
+	msg->status = params->status;
+	msg->has_pmkid = params->pmkid != NULL;
+	if (params->pmkid)
+		memcpy(msg->pmkid, params->pmkid, sizeof(msg->pmkid));
+	mboxSendMsg(glue->prAdapter, MBOX_ID_0, &msg->rMsgHdr, MSG_SEND_METHOD_BUF);
+	return 0;
+}
