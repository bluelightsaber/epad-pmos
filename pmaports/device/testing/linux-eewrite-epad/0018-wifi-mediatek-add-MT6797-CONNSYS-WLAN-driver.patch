+	} else if (prScanInfo->prPscnParam->fgNLOScnEnable) {
+		memcpy(&prCmdPscnParam->rCmdNloReq, &prScanInfo->prPscnParam->rCurrentCmdNloReq, sizeof(CMD_NLO_REQ));
