+			if (prWtbl[entry].ucUsed &&
+				(prStaRec->ucIndex == prWtbl[entry].ucStaIndex)) {
+				secPrivacyFreeForEntry(prAdapter, entry);
+#if 1				/* DBG */
+				DBGLOG(RSN, INFO, "Free the STA entry (%u)!\n", entry);
+#endif
+			}
+		}
+	}
+
+}
