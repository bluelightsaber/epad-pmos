+	UINT_8 aucSsid[32];
+	UINT_32 u4SsidLen;
+	UINT_8 ucReinvoke;
+} IW_P2P_IOCTL_INVITATION_STRUCT, *P_IW_P2P_IOCTL_INVITATION_STRUCT;
+
