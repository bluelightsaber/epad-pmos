+		prGlueInfo = *((P_GLUE_INFO_T *) netdev_priv(prDev));
+	} else {		/* wlan0 */
+		prGlueInfo = (P_GLUE_INFO_T) netdev_priv(prDev);
+	}
+
+	if (prGlueInfo == NULL) {
+		DBGLOG(REQ, INFO, "netdev_event: prGlueInfo is empty.\n");
