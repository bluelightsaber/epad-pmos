+				FALSE,
+				TRUE,
+				nicCmdEventSetCommon,
+				nicOidCmdTimeoutCommon,
+				sizeof(BOOLEAN),
+				(PUINT_8)&rSuspendCmd,
+				NULL,
+				0);
+}
