+WLAN_STATUS kalFirmwareOpen(IN P_GLUE_INFO_T prGlueInfo)
+{
+	int ret;
+
+	ret = request_firmware(&prGlueInfo->firmware, "mediatek/WIFI_RAM_CODE_6797",
+			       prGlueInfo->rHifInfo.Dev);
+	if (ret)
+		return WLAN_STATUS_FAILURE;
+	return WLAN_STATUS_SUCCESS;
+}
+
+WLAN_STATUS kalFirmwareClose(IN P_GLUE_INFO_T prGlueInfo)
+{
+	release_firmware(prGlueInfo->firmware);
+	prGlueInfo->firmware = NULL;
+	return WLAN_STATUS_SUCCESS;
+}
+
+WLAN_STATUS kalFirmwareLoad(IN P_GLUE_INFO_T prGlueInfo, OUT PVOID prBuf,
+			   IN UINT_32 offset, OUT PUINT_32 size)
+{
+	const struct firmware *fw = prGlueInfo->firmware;
+
+	if (!fw || offset > fw->size || *size > fw->size - offset)
+		return WLAN_STATUS_FAILURE;
+	memcpy(prBuf, fw->data + offset, *size);
+	return WLAN_STATUS_SUCCESS;
+}
+
+WLAN_STATUS kalFirmwareSize(IN P_GLUE_INFO_T prGlueInfo, OUT PUINT_32 size)
+{
+	if (!prGlueInfo->firmware || prGlueInfo->firmware->size > U32_MAX)
+		return WLAN_STATUS_FAILURE;
+	*size = prGlueInfo->firmware->size;
+	return WLAN_STATUS_SUCCESS;
+}
