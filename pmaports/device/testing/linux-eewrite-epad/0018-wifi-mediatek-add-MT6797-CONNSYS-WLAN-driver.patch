+#define CMD_WLS_BATCHING        "WLS_BATCHING"
+
+#define BATCHING_SET            "SET"
+#define BATCHING_GET            "GET"
+#define BATCHING_STOP           "STOP"
+
+#define PARAM_SCANFREQ          "SCANFREQ"
