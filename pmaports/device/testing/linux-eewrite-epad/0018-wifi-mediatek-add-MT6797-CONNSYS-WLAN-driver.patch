+	/* indicate IWEVP2PDVCFND event */
+	wireless_send_event(prGlueInfo->prP2PInfo->prDevHandler, IWEVCUSTOM, &evt, aucBuffer);
+
+	return FALSE;
+}				/* end of kalP2PIndicateFound() */
