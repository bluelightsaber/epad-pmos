+			prAdapter->rWlanInfo.arScanResult[i].u4IELength = (UINT_32) u2IELength;
+
+			if (u2IELength > 0) {
+				/* IE - allocate buffer and update pointer */
+				if (ALIGN_4(u2IELength) + prAdapter->rWlanInfo.u4ScanIEBufferUsage <= u4BufferSize) {
