+		else
+			ASSERT(eNetTypeIndex < NETWORK_TYPE_INDEX_NUM);
+
+		if (fgReplyProbeResp)
+			bssSendBeaconProbeResponse(prAdapter, eNetTypeIndex, prMgtHdr->aucSrcAddr);
+
+	}
+
+	return WLAN_STATUS_SUCCESS;
+
+}				/* end of bssProcessProbeRequest() */
