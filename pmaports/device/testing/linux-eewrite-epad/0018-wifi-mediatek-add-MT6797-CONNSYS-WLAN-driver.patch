+			}
+			if ((ucIdx > 0) && (ucIdx < (MAXMUN_2_4G_CHA_NUM - 1))) {
+				u2APNumScore = (prGetChnLoad->rEachChnLoad[ucIdx].u2APNum + ((UINT_16)
+											     ((3 *
+											       (prGetChnLoad->
+												rEachChnLoad[ucIdx +
