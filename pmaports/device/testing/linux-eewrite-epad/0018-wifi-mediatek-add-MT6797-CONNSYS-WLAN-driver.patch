+			u4IeLen = IE_SIZE(pPkt);
+			LR_TDLS_FME_FIELD_FILL(u4IeLen);
+		} else {
+			/* 5. Frame Formation - WMM Information element */
+			if (IS_FEATURE_ENABLED(prAdapter->rWifiVar.ucQoS)) {
