+/*----------------------------------------------------------------------------*/
+/*!
+* \brief Utility function for reading data from files on NVRAM-FS
+*
+* \param[in]
+*           filename
+*           len
+*           offset
+* \param[out]
+*           buf
+* \return
+*           actual length of data being read
+*/
+/*----------------------------------------------------------------------------*/
+int mt6797_nvram_init(struct device *dev, struct mt6797_wifi_nvram *nvram)
+{
+	const char *name = "mediatek/mt6797-x20-wifi-nvram.bin";
+	const struct firmware *firmware;
+	void *data;
+	size_t length;
+	int ret;
+
+	nvram->dev = dev;
+	mutex_init(&nvram->lock);
+	nvram->cell = nvmem_cell_get(dev, "wifi-calibration");
+	if (!IS_ERR(nvram->cell)) {
+		data = nvmem_cell_read(nvram->cell, &length);
+		if (IS_ERR(data)) {
+			ret = PTR_ERR(data);
+			goto release_cell;
+		}
+		ret = length == sizeof(nvram->data) ? 0 : -EINVAL;
+		if (!ret)
+			memcpy(nvram->data, data, length);
+		kfree(data);
+		if (ret)
+			goto release_cell;
+		dev_info(dev, "loaded 512-byte WiFi calibration from NVMEM\n");
+	} else {
+		ret = PTR_ERR(nvram->cell);
+		nvram->cell = NULL;
+		if (ret != -ENOENT && ret != -ENODEV && ret != -EOPNOTSUPP)
+			return ret;
+		device_property_read_string(dev, "mediatek,nvram-firmware", &name);
+		ret = request_firmware_direct(&firmware, name, dev);
+		if (ret)
+			return ret;
+		ret = firmware->size == sizeof(nvram->data) ? 0 : -EINVAL;
+		if (!ret)
+			memcpy(nvram->data, firmware->data, firmware->size);
+		release_firmware(firmware);
+		if (ret)
+			return ret;
+		dev_info(dev, "loaded 512-byte WiFi configuration from %s (read-only)\n", name);
+	}
+	nvram->valid = true;
+	return 0;
+release_cell:
+	nvmem_cell_put(nvram->cell);
+	nvram->cell = NULL;
+	return ret;
+}
+
+void mt6797_nvram_release(struct mt6797_wifi_nvram *nvram)
+{
+	if (nvram->cell)
+		nvmem_cell_put(nvram->cell);
+	nvram->cell = NULL;
+	nvram->valid = false;
+}
+
+BOOLEAN kalCfgDataRead16(P_GLUE_INFO_T glue, UINT_32 offset, PUINT_16 data)
+{
+	struct mt6797_wifi_nvram *nvram = glue->rHifInfo.nvram;
+	bool valid;
+
+	if (!nvram || !data || offset > sizeof(nvram->data) - sizeof(*data))
+		return FALSE;
+	mutex_lock(&nvram->lock);
+	valid = nvram->valid;
+	if (valid)
+		*data = get_unaligned_le16(nvram->data + offset);
+	mutex_unlock(&nvram->lock);
+	return valid;
+}
+
+BOOLEAN kalCfgDataWrite16(P_GLUE_INFO_T glue, UINT_32 offset, UINT_16 value)
+{
+	struct mt6797_wifi_nvram *nvram = glue->rHifInfo.nvram;
+	int ret;
+
+	if (!nvram || offset > sizeof(nvram->data) - sizeof(value))
+		return FALSE;
+	mutex_lock(&nvram->lock);
+	if (!nvram->valid || !nvram->cell) {
+		mutex_unlock(&nvram->lock);
+		return FALSE;
+	}
+	put_unaligned_le16(value, nvram->data + offset);
+	ret = nvmem_cell_write(nvram->cell, nvram->data, sizeof(nvram->data));
+	if (ret != sizeof(nvram->data)) {
+		nvram->valid = false;
+		dev_err(nvram->dev, "WiFi NVMEM write failed: %d; cached configuration invalidated\n", ret);
+	}
+	mutex_unlock(&nvram->lock);
+	return ret == sizeof(nvram->data);
+}
