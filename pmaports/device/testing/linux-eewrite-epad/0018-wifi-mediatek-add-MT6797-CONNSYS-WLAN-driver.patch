+			break;
+
+		prMgmtFrameRegister = (P_MSG_P2P_MGMT_FRAME_REGISTER_T) prMsgHdr;
+
+		p2pFuncMgmtFrameRegister(prAdapter,
+					 prMgmtFrameRegister->u2FrameType,
