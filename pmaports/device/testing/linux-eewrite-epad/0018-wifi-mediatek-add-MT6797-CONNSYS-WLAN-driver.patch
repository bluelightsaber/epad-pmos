+/* string operation */
+#define kalStrCpy(dest, src)                         strcpy(dest, src)
+/* E-PAD: Linux 7.x ya no tiene strncpy(); equivalente con relleno de ceros. */
+static inline char *mt6797_strncpy(char *dest, const char *src, size_t n)
+{
+	size_t i = 0;
+
+	for (; i < n && src[i]; i++)
+		dest[i] = src[i];
+	for (; i < n; i++)
+		dest[i] = 0;
+	return dest;
+}
+#define strncpy(dest, src, n)                         mt6797_strncpy(dest, src, n)
+#define kalStrnCpy(dest, src, n)                      strncpy(dest, src, n)
