# Maintainer: bluelightsaber <26096600+bluelightsaber@users.noreply.github.com>
# Kernel for the Eewrite E-PAD (MediaTek MT6797): Linux 7.2 + the E-PAD series
pkgname=linux-eewrite-epad
pkgver=7.2.11
pkgrel=1
pkgdesc="Eewrite E-PAD (MT6797) mainline kernel"
arch="aarch64"
_carch="arm64"
_flavor="eewrite-epad"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bison
	findutils
	flex
	gmp-dev
	linux-headers
	mpc1-dev
	mpfr-dev
	openssl-dev
	pahole
	zstd
	perl
	postmarketos-installkernel
	python3
	xz
"
_config="config-$_flavor.$arch"
source="
	https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz
	$_config
	0001-watchdog-mtk_wdt-raise-restart-handler-priority.patch
	0002-pinctrl-mediatek-mt6797-add-IES-SMT-pull-EINT-data-a.patch
	0003-pmdomain-mediatek-scpsys-handle-MT6797-register-hole.patch
	0004-regulator-add-minimal-MT6351-regulator-driver-over-t.patch
	0005-i2c-mt65xx-MT6797-write-then-read-support.patch
	0006-Input-cyttsp5-support-the-E-PAD-TT21000-sysinfo-axis.patch
	0007-phy-mediatek-tphy-MT6797-USB2-PHY.patch
	0008-mmc-mtk-sd-add-MT6797-HS200-HS400.patch
	0009-pwm-mediatek-add-MT6797.patch
	0010-arm64-MT6797-bring-up-all-10-CPUs-cluster-coherency-.patch
	0011-power-supply-bq24190-work-without-IRQ-line-add-MT635.patch
	0012-cpufreq-add-MT6797-driver-3-clusters-CCI-DA9214-EEM.patch
	0013-thermal-mediatek-auxadc-add-MT6797.patch
	0014-rtc-add-MT6351-RTC-driver.patch
	0015-misc-add-E-Ink-T1000-controller-driver.patch
	0016-soc-mediatek-MT6797-SPM-MT6351-PMIC-interrupts-and-C.patch
	0017-Bluetooth-add-MT6797-CONNSYS-STP-driver.patch
	0018-wifi-mediatek-add-MT6797-CONNSYS-WLAN-driver.patch
	0019-Input-add-MediaTek-MT6351-PMIC-power-key-driver.patch
	0020-arm64-dts-mediatek-add-Eewrite-E-PAD-Epad_PRO.patch
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	make ARCH="$_carch" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source
	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}
