From a7b87163a218f39af543a17ecc11c1dbe7a553d3 Mon Sep 17 00:00:00 2001
From: bluelightsaber <26096600+bluelightsaber@users.noreply.github.com>
Date: Fri, 23 Oct 2026 00:20:02 +0200
Subject: [PATCH 09/20] pwm: mediatek: add MT6797

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/pwm/pwm-mediatek.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/pwm/pwm-mediatek.c b/drivers/pwm/pwm-mediatek.c
index 992137a27..bc80fe47d 100644
--- a/drivers/pwm/pwm-mediatek.c
+++ b/drivers/pwm/pwm-mediatek.c
@@ -518,6 +518,15 @@ static const struct pwm_mediatek_of_data mt6795_pwm_data = {
 	.chanreg_width = 0x40,
 };
 
+/* E-PAD: MT6797, 4 canales (PWM1-4) con la misma disposición de registros que el MT6795 */
+static const struct pwm_mediatek_of_data mt6797_pwm_data = {
+	.num_pwms = 4,
+	.clksel_fixup = false,
+	.pwm45_fixup = false,
+	.chanreg_base = 0x10,
+	.chanreg_width = 0x40,
+};
+
 static const struct pwm_mediatek_of_data mt7622_pwm_data = {
 	.num_pwms = 6,
 	.clksel_fixup = false,
@@ -616,6 +625,7 @@ static const struct pwm_mediatek_of_data mt6991_pwm_data = {
 static const struct of_device_id pwm_mediatek_of_match[] = {
 	{ .compatible = "mediatek,mt2712-pwm", .data = &mt2712_pwm_data },
 	{ .compatible = "mediatek,mt6795-pwm", .data = &mt6795_pwm_data },
+	{ .compatible = "mediatek,mt6797-pwm", .data = &mt6797_pwm_data },
 	{ .compatible = "mediatek,mt6991-pwm", .data = &mt6991_pwm_data },
 	{ .compatible = "mediatek,mt7622-pwm", .data = &mt7622_pwm_data },
 	{ .compatible = "mediatek,mt7623-pwm", .data = &mt7623_pwm_data },
