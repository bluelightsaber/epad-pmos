# Maintainer: Antoine Martin (ayakael) <dev@ayakael.net>
pkgname=koreader
pkgver=2026.07.2
pkgrel=92
pkgdesc="An ebook reader application supporting PDF, DjVu, EPUB, FB2 and many more formats (with the E-PAD port)"
# s390x|riscv64|ppc64le|loongarch64: FTBFS
# armhf|armv7|x86: Tests fail, segmentation fault
arch="x86_64 aarch64"
url="https://github.com/koreader/koreader/"
license="AGPL-3.0-only"
options="!check" # E-PAD: build sin -march=native (CI=1)
depends="
	bash
	so:libSDL3.so.0
	procps-ng
	"
makedepends="
	bash
	sdl3
	autoconf
	automake
	cmake
	coreutils
	curl
	diffutils
	findutils
	gettext
	grep
	libtool
	linux-headers
	meson
	nasm
	ninja-build
	perl
	pkgconf
	wget
	"
source="
	https://ayakael.net/api/packages/mirrors/generic/koreader/v$pkgver/koreader-v$pkgver.tar.gz
	koreader-sh-enable-ko-multiuser.patch
	lj-wpaclient-59cac3b591ca60ca57b6d729573fb6bb0c4e5035.tar.gz::https://github.com/koreader/lj-wpaclient/archive/59cac3b591ca60ca57b6d729573fb6bb0c4e5035.tar.gz
	epad-device-probe.patch
	epad-input-platform.patch
	input-epad.h
	framebuffer_epad.lua
	epad-device.lua
	epad-powerd.lua
	"
subpackages="$pkgname-doc"
builddir="$srcdir"/$pkgname-v$pkgver

# has vendored copies of system libraries
sonameprefix="$pkgname:"

prepare() {
	default_prepare

	# no need to test manually set version
	rm "$builddir"/spec/unit/version_spec.lua

	# E-PAD: evdev input platform header
	cp "$srcdir"/input-epad.h "$builddir"/base/input/
}

build() {
	# add ninja bin to path
	export PATH="$PATH":/usr/lib/ninja-build/bin

	# default target is emulator build
	make TARGET= KODEBUG= VERBOSE= CI=1

	# E-PAD: the emulator build has no evdev input module (libkoreader-input); build it for the E-PAD platform
	_luajit_inc="$(dirname "$(find "$builddir"/base/build -path '*staging/include/*' -name luajit.h | head -1)")"
	${CC:-gcc} $CFLAGS -shared -fPIC -fvisibility=hidden -DEPAD -I"$_luajit_inc" \
		-o "$builddir"/libkoreader-input.so "$builddir"/base/input/input.c
}

check() {
	KODEBUG= TARGET= VERBOSE= ./base/utils/fake_tty.py make --assume-old=base testfront
}

package() {
	install -Dm644 "$builddir"/platform/linux/koreader.desktop -t "$pkgdir"/usr/share/applications/
	install -Dm644 "$builddir"/resources/koreader.png -t "$pkgdir"/usr/share/pixmaps/
	install -Dm644 "$builddir"/platform/linux/koreader.1 -t "$pkgdir"/usr/share/man/man1/

	mkdir -p "$pkgdir"/usr/lib
	cp -RL "$builddir"/koreader-emulator-*/koreader "$pkgdir"/usr/lib/koreader

	# bin link
	mkdir -p "$pkgdir"/usr/bin
	ln -s ../lib/koreader/koreader.sh "$pkgdir"/usr/bin/koreader

	# delete debug files
	find "$pkgdir" -name '*.dbg' -delete

	# version information
	echo "v$pkgver" > "$pkgdir"/usr/lib/koreader/git-rev

	# E-PAD port: device, framebuffer (T1000 refresh), evdev input, wpa_supplicant client
	local _ko="$pkgdir"/usr/lib/koreader
	install -Dm644 "$srcdir"/framebuffer_epad.lua "$_ko"/ffi/framebuffer_epad.lua
	install -Dm644 "$srcdir"/epad-device.lua "$_ko"/frontend/device/epad/device.lua
	install -Dm644 "$srcdir"/epad-powerd.lua "$_ko"/frontend/device/epad/powerd.lua
	install -Dm755 "$builddir"/libkoreader-input.so "$_ko"/libs/libkoreader-input.so
	install -Dm644 "$srcdir"/lj-wpaclient-59cac3b591ca60ca57b6d729573fb6bb0c4e5035/*.lua -t "$_ko"/common/lj-wpaclient/
}
