 		132, "GPIO132",
 		MTK_EINT_FUNCTION(0, 87),
-		DRV_GRP3,
+		DRV_GRP4,
 		MTK_FUNCTION(0, "GPIO132"),
 		MTK_FUNCTION(1, "MSDC1_DAT2"),
 		MTK_FUNCTION(5, "C2K_RTCK")
@@ -1277,7 +1277,7 @@ static const struct mtk_pin_desc mtk_pins_mt6797[] = {
