index d7293977f..e1e052a4c 100644
--- a/drivers/soc/mediatek/Kconfig
+++ b/drivers/soc/mediatek/Kconfig
@@ -45,6 +45,19 @@ config MTK_INFRACFG
 	  INFRACFG controller contains various infrastructure registers not
 	  directly associated to any device.
 
+config MTK_MT6351_IRQ
+	tristate "MediaTek MT6351 PMIC interrupts (E-PAD)"
+	depends on MTK_PMIC_WRAP
+	help
+	  Controlador de interrupciones del PMIC MT6351 (tecla de encendido, alarma RTC, cargador) en cascada
+	  desde su EINT.
+
+config MTK_MT6797_SPM
+	bool "MT6797 SPM suspend (E-PAD)"
+	depends on ARCH_MEDIATEK && SUSPEND && MTK_PMIC_WRAP
+	help
+	  Suspend to RAM on the MT6797 with the vendor SPM PCM firmware.
+
 config MTK_PMIC_WRAP
 	tristate "MediaTek PMIC Wrapper Support"
 	depends on RESET_CONTROLLER
@@ -89,4 +102,84 @@ config MTK_SOCINFO
 	  information about the SoC to the userspace including the
 	  manufacturer name, marketing name and soc name.
 
+
+config MTK_MT6797_CONSYS
+	tristate "MT6797 ConSys power/bring-up driver"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	help
+	  Power-on/bring-up support for the MT6797 connectivity subsystem
+	  (ConSys) that hosts the WLAN/BT/GPS baseband and drives the external
+	  MT6631 radio.  Exposes a sysfs power switch and chip-ID readback for
+	  board bring-up; protocol stacks are separate drivers.
+
+config MTK_MT6797_BTIF
+	tristate "MT6797 ConSys BTIF PIO transport"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on MTK_MT6797_CONSYS
+	depends on COMMON_CLK
+	help
+	  PIO byte transport for the MT6797 ConSys BTIF block.  This is not a
+	  serial console or a 16550 UART; an STP/WMT client must claim it before
+	  the clock, FIFO and IRQ are enabled.
+
+config MTK_MT6797_STP
+	tristate "MT6797 ConSys STP wire codec"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on MTK_MT6797_BTIF
+	help
+	  Allocation-free STP header/CRC16 codec and streaming decoder for the
+	  MT6797 ConSys transport.  It does not power the chip or claim BTIF;
+	  WMT sequencing and retransmission are supplied by a separate client.
+
+config MTK_MT6797_STP_SESSION
+	tristate "MT6797 ConSys reliable STP/WMT session"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on MTK_MT6797_STP
+	help
+	  Reliable full-mode STP sequence/ACK/retry and WMT event matching on top
+	  of the MT6797 BTIF transport.  It claims BTIF only when explicitly
+	  started by a higher-level ConSys owner and does not power the chip.
+
+config MTK_MT6797_WMT_INIT
+	tristate "MT6797 WMT firmware initialization"
+	depends on MTK_MT6797_CONSYS && MTK_MT6797_STP_SESSION
+	select FW_LOADER
+	help
+	  Shared ROM version and ROMv3 patch/reset initialization for MT6797
+	  connectivity clients. The caller owns ConSys power and the STP session.
+
+config MTK_MT6797_STP_DIAG
+	tristate "MT6797 bounded STP/WMT diagnostic client"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on MTK_MT6797_CONSYS
+	depends on MTK_MT6797_STP_SESSION
+	depends on MTK_MT6797_WLAN_HIF
+	select MTK_MT6797_WMT_INIT
+	help
+	  Root-controlled diagnostic client for one bounded MT6797 STP/WMT
+	  transaction.  It requires ConSys to be powered explicitly, reserves the
+	  host parser while the transaction runs, and never exposes BTIF as a tty
+	  or HCI device.
+
+config MTK_MT6797_WMT
+	tristate "MT6797 shared connectivity lifecycle"
+	depends on OF && MTK_MT6797_CONSYS && MTK_MT6797_STP_SESSION
+	select MTK_MT6797_WMT_INIT
+	select SRCU
+	help
+	  Share the powered firmware and STP session between standard WLAN and
+	  Bluetooth clients. Firmware starts with the first client and stops with
+	  the last one; independent radio rails and callbacks are managed here.
+
+config MTK_MT6797_WLAN_HIF
+	tristate "MT6797 WLAN AHB sdioLike PIO HIF"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on OF
+	depends on HAS_IOMEM
+	help
+	  Map the MT6797 WLAN AHB sdioLike command port and provide an explicit
+	  owner-gated PIO/IRQ contract.  Probe never reads the HIF window; a future
+	  WMT WLAN owner must turn the function on before claiming it.  AP-DMA,
+	  EMI remap, firmware download and cfg80211 are separate steps.
+
 endmenu
