diff --git a/drivers/soc/mediatek/mt6351-irq.c b/drivers/soc/mediatek/mt6351-irq.c
new file mode 100644
index 000000000..d91a99363
--- /dev/null
+++ b/drivers/soc/mediatek/mt6351-irq.c
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Interrupciones del PMIC MT6351 (E-PAD) a través del regmap del PMIC wrapper.
+ *
+ * La línea de interrupción del PMIC llega al SoC por el GPIO 262 = EINT 176 (nivel alto, DT de fábrica). 64
+ * fuentes en INT_CON0..3 (habilitación, con registros SET/CLR) e INT_STATUS0..3 (se limpian escribiendo 1), como
+ * el BSP 3.18 (pmic.c). Ejemplos: 0 PWRKEY, 2 PWRKEY_R, 9 RTC, 46 CHRDET (INT_CON2 bit 14).
+ */
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#define MT6351_INT_CON(n)	(0x02c2 + 6 * (n))
+#define MT6351_INT_STATUS(n)	(0x02e0 + 2 * (n))
+#define MT6351_INT_REGS		4
+
+struct mt6351_irq {
+	struct device *dev;
+	struct regmap *regmap;
+	struct irq_domain *domain;
+	struct mutex lock;
+	u16 enable[MT6351_INT_REGS];
+	u16 wake[MT6351_INT_REGS];
+};
+
+static void mt6351_irq_lock(struct irq_data *d)
+{
+	struct mt6351_irq *p = irq_data_get_irq_chip_data(d);
+
+	mutex_lock(&p->lock);
+}
+
+static void mt6351_irq_sync_unlock(struct irq_data *d)
+{
+	struct mt6351_irq *p = irq_data_get_irq_chip_data(d);
+	int i;
+
+	for (i = 0; i < MT6351_INT_REGS; i++)
+		regmap_write(p->regmap, MT6351_INT_CON(i), p->enable[i]);
+	mutex_unlock(&p->lock);
+}
+
+static void mt6351_irq_mask(struct irq_data *d)
+{
+	struct mt6351_irq *p = irq_data_get_irq_chip_data(d);
+
+	p->enable[d->hwirq / 16] &= ~BIT(d->hwirq % 16);
+}
+
+static void mt6351_irq_unmask(struct irq_data *d)
+{
+	struct mt6351_irq *p = irq_data_get_irq_chip_data(d);
+
+	p->enable[d->hwirq / 16] |= BIT(d->hwirq % 16);
+}
+
+static int mt6351_irq_set_wake(struct irq_data *d, unsigned int on)
+{
+	struct mt6351_irq *p = irq_data_get_irq_chip_data(d);
+
+	if (on)
+		p->wake[d->hwirq / 16] |= BIT(d->hwirq % 16);
+	else
+		p->wake[d->hwirq / 16] &= ~BIT(d->hwirq % 16);
+	return 0;
+}
+
+static struct irq_chip mt6351_irq_chip = {
+	.name = "mt6351-irq",
+	.irq_bus_lock = mt6351_irq_lock,
+	.irq_bus_sync_unlock = mt6351_irq_sync_unlock,
+	.irq_mask = mt6351_irq_mask,
+	.irq_unmask = mt6351_irq_unmask,
+	.irq_set_wake = mt6351_irq_set_wake,
+	.flags = IRQCHIP_SKIP_SET_WAKE,
+};
+
+static irqreturn_t mt6351_irq_thread(int irq, void *data)
+{
+	struct mt6351_irq *p = data;
+	u32 sta;
+	int i, b;
+
+	for (i = 0; i < MT6351_INT_REGS; i++) {
+		if (regmap_read(p->regmap, MT6351_INT_STATUS(i), &sta) || !sta)
+			continue;
+		for (b = 0; b < 16; b++)
+			if (sta & BIT(b))
+				handle_nested_irq(irq_find_mapping(p->domain, 16 * i + b));
+		regmap_write(p->regmap, MT6351_INT_STATUS(i), sta);
+	}
+	return IRQ_HANDLED;
+}
+
+static int mt6351_irq_map(struct irq_domain *d, unsigned int irq, irq_hw_number_t hw)
+{
+	struct mt6351_irq *p = d->host_data;
+
+	irq_set_chip_data(irq, p);
+	irq_set_chip_and_handler(irq, &mt6351_irq_chip, handle_level_irq);
+	irq_set_nested_thread(irq, 1);
+	irq_set_noprobe(irq);
+	return 0;
+}
+
+static const struct irq_domain_ops mt6351_irq_domain_ops = {
+	.map = mt6351_irq_map,
+	.xlate = irq_domain_xlate_onecell,
+};
+
+static int mt6351_irq_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mt6351_irq *p;
+	int irq, ret, i;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->dev = dev;
+	p->regmap = dev_get_regmap(dev->parent, NULL);
+	if (!p->regmap)
+		return dev_err_probe(dev, -EPROBE_DEFER, "sin regmap del PMIC wrapper\n");
+	mutex_init(&p->lock);
+
+	/* todo deshabilitado y limpio hasta que alguien pida una fuente */
+	for (i = 0; i < MT6351_INT_REGS; i++) {
+		regmap_write(p->regmap, MT6351_INT_CON(i), 0);
+		regmap_write(p->regmap, MT6351_INT_STATUS(i), 0xffff);
+	}
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	p->domain = irq_domain_create_linear(dev_fwnode(dev), 16 * MT6351_INT_REGS, &mt6351_irq_domain_ops, p);
+	if (!p->domain)
+		return -ENOMEM;
+	ret = devm_request_threaded_irq(dev, irq, NULL, mt6351_irq_thread, IRQF_ONESHOT, "mt6351-pmic", p);
+	if (ret) {
+		irq_domain_remove(p->domain);
+		return ret;
+	}
+	enable_irq_wake(irq);
+	platform_set_drvdata(pdev, p);
+	dev_info(dev, "interrupciones del PMIC por la IRQ %d\n", irq);
+	return 0;
+}
+
+static const struct of_device_id mt6351_irq_of_match[] = {
+	{ .compatible = "mediatek,mt6351-irq" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6351_irq_of_match);
+
+static struct platform_driver mt6351_irq_driver = {
+	.driver = {
+		.name = "mt6351-irq",
+		.of_match_table = mt6351_irq_of_match,
+	},
+	.probe = mt6351_irq_probe,
+};
+module_platform_driver(mt6351_irq_driver);
+
+MODULE_DESCRIPTION("Interrupciones del PMIC MT6351");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6797-btif-ring.h b/drivers/soc/mediatek/mt6797-btif-ring.h
new file mode 100644
index 000000000..5b9d24d1a
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-btif-ring.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6797_BTIF_RING_H
+#define MT6797_BTIF_RING_H
+
+#define BTIF_VFIFO_SIZE 8192U
+#define BTIF_VFIFO_WRAP 0x10000U
+
+static inline unsigned int btif_vfifo_advance(unsigned int pointer,
+					    unsigned int count)
+{
+	unsigned int offset = (pointer & 0xffff) + count;
+
+	if (offset >= BTIF_VFIFO_SIZE) {
+		offset -= BTIF_VFIFO_SIZE;
+		pointer ^= BTIF_VFIFO_WRAP;
+	}
+	return (pointer & BTIF_VFIFO_WRAP) | offset;
+}
+
+static inline int btif_vfifo_pending(unsigned int write, unsigned int read)
+{
+	int count;
+
+	if ((write | read) & ~(BTIF_VFIFO_WRAP | 0xffffU) ||
+	    (write & 0xffff) >= BTIF_VFIFO_SIZE ||
+	    (read & 0xffff) >= BTIF_VFIFO_SIZE)
+		return -1;
+	count = (int)(write & 0xffff) - (int)(read & 0xffff);
+	if ((write ^ read) & BTIF_VFIFO_WRAP)
+		count += BTIF_VFIFO_SIZE;
+	return count >= 0 && count <= BTIF_VFIFO_SIZE ? count : -1;
+}
+#endif
diff --git a/drivers/soc/mediatek/mt6797-btif.c b/drivers/soc/mediatek/mt6797-btif.c
new file mode 100644
index 000000000..ecc7e21f0
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-btif.c
@@ -0,0 +1,898 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// MT6797 BTIF PIO and dedicated DMA/VFIFO transport for ConSys STP/WMT.
+//
+// The block has UART-like FIFOs but is not a serial console.  This driver
+// deliberately exposes only an in-kernel byte transport: STP framing,
+// function ownership and HCI demultiplexing belong to its client.
+
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/dma-mapping.h>
+#include <linux/errno.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/kfifo.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/wait.h>
+
+#include <linux/mt6797-btif.h>
+#include "mt6797-btif-ring.h"
+
+static bool trace;
+module_param(trace, bool, 0600);
+MODULE_PARM_DESC(trace, "Log raw BTIF bytes and initial IRQ state");
+
+#define BTIF_RBR_THR		0x00
+#define BTIF_IER		0x04
+#define BTIF_IIR_FIFOCTRL	0x08
+#define BTIF_FAKELCR		0x0c
+#define BTIF_LSR		0x14
+#define BTIF_SLEEP_EN		0x48
+#define BTIF_DMA_EN		0x4c
+#define BTIF_TRI_LVL		0x60
+#define BTIF_WAK		0x64
+#define BTIF_HANDSHAKE		0x6c
+
+#define BTIF_IER_RXFEN		BIT(0)
+#define BTIF_IER_TXEEN		BIT(1)
+#define BTIF_IIR_NINT		BIT(0)
+#define BTIF_IIR_TX_EMPTY	BIT(1)
+#define BTIF_IIR_RX		BIT(2)
+#define BTIF_IIR_RX_TIMEOUT	(0x11 << 2)
+#define BTIF_LSR_THRE		BIT(5)
+#define BTIF_LSR_TEMT		BIT(6)
+#define BTIF_FIFOCTRL_CLR_RX	BIT(1)
+#define BTIF_FIFOCTRL_CLR_TX	BIT(2)
+#define BTIF_DMA_AUTORST	BIT(2)
+#define BTIF_HANDSHAKE_ENABLE	BIT(0)
+#define BTIF_WAK_SIGNAL		BIT(0)
+#define BTIF_TRI_TX_MASK		GENMASK(3, 0)
+#define BTIF_TRI_RX_MASK		GENMASK(6, 4)
+#define BTIF_TRI_TX_THRESHOLD	8
+#define BTIF_TRI_RX_THRESHOLD	1
+#define BTIF_TX_FIFO_SIZE	16
+#define BTIF_RX_BUDGET		256
+#define BTIF_TX_QUEUE_SIZE	4096
+
+#define VFF_FLAG 0x00
+#define VFF_INT_EN 0x04
+#define VFF_EN 0x08
+#define VFF_RST 0x0c
+#define VFF_STOP 0x10
+#define VFF_FLUSH 0x14
+#define VFF_ADDR 0x1c
+#define VFF_LEN 0x24
+#define VFF_THRE 0x28
+#define VFF_WPT 0x2c
+#define VFF_RPT 0x30
+#define VFF_VALID 0x3c
+#define VFF_LEFT 0x40
+#define VFF_ADDR2 0x54
+
+struct btif_dma_channel {
+	void __iomem *base;
+	void *buffer;
+	dma_addr_t address;
+	int irq;
+	u32 pointer;
+	u64 bytes;
+};
+
+struct mt6797_btif {
+	struct device *dev;
+	void __iomem *base;
+	struct clk *clk;
+	int irq;
+	struct clk *dma_clk;
+	struct btif_dma_channel tx_dma, rx_dma;
+	bool dma_mode, dma_clocked, dma_fault;
+	bool dma_live, clocked, idle, irqs_enabled;
+
+	struct mutex client_lock;
+	struct device *owner;
+	const struct mt6797_btif_client_ops *ops;
+	void *context;
+	bool running;
+	unsigned int debug_irq_count;
+
+	spinlock_t tx_lock;
+	struct kfifo tx_fifo;
+	wait_queue_head_t tx_wait;
+};
+
+static struct mt6797_btif *mt6797_btif_singleton;
+static DEFINE_MUTEX(mt6797_btif_singleton_lock);
+
+static void btif_kfifo_free(void *data)
+{
+	kfifo_free((struct kfifo *)data);
+}
+
+static void btif_update_bits(struct mt6797_btif *btif, unsigned int offset,
+			     u32 mask, u32 value)
+{
+	u32 reg = readl(btif->base + offset);
+
+	reg = (reg & ~mask) | (value & mask);
+	writel(reg, btif->base + offset);
+}
+
+static void btif_fifo_reset(struct mt6797_btif *btif)
+{
+	/* IIR/FIFOCTRL share an offset; FIFOCTRL is write-only on this block. */
+	writel(BTIF_FIFOCTRL_CLR_RX, btif->base + BTIF_IIR_FIFOCTRL);
+	writel(0, btif->base + BTIF_IIR_FIFOCTRL);
+	writel(BTIF_FIFOCTRL_CLR_TX, btif->base + BTIF_IIR_FIFOCTRL);
+	writel(0, btif->base + BTIF_IIR_FIFOCTRL);
+}
+
+static int btif_dma_reset(struct btif_dma_channel *channel)
+{
+	u32 value;
+	int ret;
+
+	writel(0, channel->base + VFF_INT_EN);
+	writel(BIT(0), channel->base + VFF_RST);
+	ret = readl_poll_timeout(channel->base + VFF_EN, value,
+				 !(value & 1), 10, 10000);
+	if (ret) {
+		writel(BIT(1), channel->base + VFF_RST);
+		udelay(100);
+	}
+	writel(0, channel->base + VFF_RST);
+	writel(0, channel->base + VFF_STOP);
+	return readl_poll_timeout(channel->base + VFF_EN, value,
+				  !(value & 1), 10, 10000);
+}
+
+static void btif_dma_free(void *data)
+{
+	struct mt6797_btif *btif = data;
+	struct btif_dma_channel *channels[] = { &btif->tx_dma, &btif->rx_dma };
+	int i;
+
+	/* Never free memory while an engine could still write into it. */
+	if (btif->dma_clocked || btif->dma_live) {
+		dev_err(btif->dev, "retaining DMA buffers and clock after failed stop\n");
+		return;
+	}
+	for (i = 0; i < ARRAY_SIZE(channels); i++)
+		if (channels[i]->buffer)
+			dma_free_coherent(btif->dev, BTIF_VFIFO_SIZE,
+					  channels[i]->buffer, channels[i]->address);
+}
+
+static irqreturn_t btif_dma_rx_irq(int irq, void *data)
+{
+	struct mt6797_btif *btif = data;
+	struct btif_dma_channel *channel = &btif->rx_dma;
+	const struct mt6797_btif_client_ops *ops;
+	u32 write, offset, first;
+	int count, round;
+
+	if (!READ_ONCE(btif->running))
+		return IRQ_NONE;
+	/* RX flags are W1C; the TX flag below is write-zero-to-clear. */
+	writel(3, channel->base + VFF_FLAG);
+	ops = READ_ONCE(btif->ops);
+	for (round = 0; round < 32; round++) {
+		write = readl(channel->base + VFF_WPT);
+		count = btif_vfifo_pending(write, channel->pointer);
+		if (count < 0) {
+			WRITE_ONCE(btif->dma_fault, true);
+			writel(0, channel->base + VFF_INT_EN);
+			dev_err_ratelimited(btif->dev, "invalid RX DMA ring pointers %x/%x\n",
+					    write, channel->pointer);
+			break;
+		}
+		if (!count)
+			break;
+		dma_rmb();
+		offset = channel->pointer & 0xffff;
+		first = min_t(u32, count, BTIF_VFIFO_SIZE - offset);
+		if (ops && ops->rx_bytes) {
+			ops->rx_bytes(READ_ONCE(btif->context), channel->buffer + offset, first);
+			if (count > first)
+				ops->rx_bytes(READ_ONCE(btif->context), channel->buffer, count - first);
+		}
+		channel->pointer = btif_vfifo_advance(channel->pointer, count);
+		channel->bytes += count;
+		/* The callback has copied every byte before returning ownership. */
+		dma_mb();
+		writel(channel->pointer, channel->base + VFF_RPT);
+	}
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t btif_dma_tx_irq(int irq, void *data)
+{
+	struct mt6797_btif *btif = data;
+	struct btif_dma_channel *channel = &btif->tx_dma;
+	unsigned long flags;
+	u32 valid;
+
+	if (!READ_ONCE(btif->running))
+		return IRQ_NONE;
+	spin_lock_irqsave(&btif->tx_lock, flags);
+	writel(0, channel->base + VFF_INT_EN);
+	writel(0, channel->base + VFF_FLAG);
+	valid = readl(channel->base + VFF_VALID);
+	if (valid && valid < 8 && !readl(channel->base + VFF_FLUSH))
+		writel(1, channel->base + VFF_FLUSH);
+	if (valid >= 8)
+		writel(1, channel->base + VFF_INT_EN);
+	spin_unlock_irqrestore(&btif->tx_lock, flags);
+	wake_up_all(&btif->tx_wait);
+	return IRQ_HANDLED;
+}
+
+static int btif_dma_start(struct mt6797_btif *btif)
+{
+	struct btif_dma_channel *channels[] = { &btif->tx_dma, &btif->rx_dma };
+	struct btif_dma_channel *channel;
+	int i, ret;
+
+	if (!btif->dma_clocked) {
+		ret = clk_prepare_enable(btif->dma_clk);
+		if (ret)
+			return ret;
+		btif->dma_clocked = true;
+	}
+	for (i = 0; i < ARRAY_SIZE(channels); i++) {
+		channel = channels[i];
+		ret = btif_dma_reset(channel);
+		if (ret) {
+			btif->dma_fault = true;
+			return ret;
+		}
+		memset(channel->buffer, 0, BTIF_VFIFO_SIZE);
+		channel->pointer = 0;
+		writel(lower_32_bits(channel->address), channel->base + VFF_ADDR);
+		writel(upper_32_bits(channel->address), channel->base + VFF_ADDR2);
+		writel(BTIF_VFIFO_SIZE, channel->base + VFF_LEN);
+		writel(i ? BTIF_VFIFO_SIZE * 3 / 4 : BTIF_VFIFO_SIZE - 7,
+		       channel->base + VFF_THRE);
+		writel(0, channel->base + VFF_WPT);
+		writel(0, channel->base + VFF_RPT);
+		writel(i ? 3 : 0, channel->base + VFF_FLAG);
+	}
+	btif->dma_fault = false;
+	return 0;
+}
+
+static int btif_dma_stop(struct mt6797_btif *btif)
+{
+	int tx, rx;
+
+	btif_update_bits(btif, BTIF_DMA_EN, BIT(0) | BIT(1), 0);
+	tx = btif_dma_reset(&btif->tx_dma);
+	rx = btif_dma_reset(&btif->rx_dma);
+	if (tx || rx) {
+		btif->dma_fault = true;
+		dev_err(btif->dev, "DMA stop/reset failed: tx=%d rx=%d\n", tx, rx);
+		return tx ?: rx;
+	}
+	clk_disable_unprepare(btif->dma_clk);
+	btif->dma_clocked = false;
+	btif->dma_live = false;
+	return 0;
+}
+
+static void btif_enable_irqs(struct mt6797_btif *btif)
+{
+	if (btif->irqs_enabled || !btif->running)
+		return;
+	btif->irqs_enabled = true;
+	if (btif->dma_mode) {
+		enable_irq(btif->tx_dma.irq);
+		enable_irq(btif->rx_dma.irq);
+	} else {
+		enable_irq(btif->irq);
+	}
+}
+
+static void btif_disable_irqs(struct mt6797_btif *btif)
+{
+	if (!btif->irqs_enabled)
+		return;
+	btif->irqs_enabled = false;
+	if (btif->dma_mode) {
+		disable_irq(btif->tx_dma.irq);
+		disable_irq(btif->rx_dma.irq);
+	} else {
+		disable_irq(btif->irq);
+	}
+}
+
+/* Singleton/client ownership keeps clock changes out of write and release. */
+static int btif_exit_idle(struct mt6797_btif *btif)
+{
+	int ret;
+
+	if (!btif->idle)
+		return 0;
+	if (btif->dma_mode) {
+		ret = clk_prepare_enable(btif->dma_clk);
+		if (ret)
+			return ret;
+		btif->dma_clocked = true;
+	}
+	ret = clk_prepare_enable(btif->clk);
+	if (ret) {
+		if (btif->dma_mode) {
+			clk_disable_unprepare(btif->dma_clk);
+			btif->dma_clocked = false;
+		}
+		return ret;
+	}
+	btif->clocked = true;
+	btif->idle = false;
+	btif_enable_irqs(btif);
+	return 0;
+}
+
+int mt6797_btif_idle(struct device *client, bool idle)
+{
+	struct mt6797_btif *btif;
+	u32 value;
+	int ret = 0;
+
+	mutex_lock(&mt6797_btif_singleton_lock);
+	btif = mt6797_btif_singleton;
+	if (!btif || btif->owner != client || !btif->running) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (!idle) {
+		ret = btif_exit_idle(btif);
+		goto out;
+	}
+	if (btif->idle)
+		goto out;
+	/* WMT has acknowledged sleep. Drain its final STP ACK before gating.
+	 * No producer can enqueue TX while this ownership mutex is held.
+	 */
+	ret = readl_poll_timeout(btif->base + BTIF_LSR, value,
+		(value & BTIF_LSR_TEMT) && kfifo_is_empty(&btif->tx_fifo) &&
+		(!btif->dma_mode || !readl(btif->tx_dma.base + VFF_VALID)), 10, 100000);
+	if (ret)
+		goto out;
+	btif_disable_irqs(btif);
+	/* Synchronizing RX above also waits for its final DMA RPT update. A
+	 * racing wake/data event must drain before a later sleep can gate.
+	 */
+	if ((btif->dma_mode &&
+	     (readl(btif->rx_dma.base + VFF_VALID) ||
+	      readl(btif->rx_dma.base + VFF_WPT) != btif->rx_dma.pointer)) ||
+	    (!btif->dma_mode && (readl(btif->base + BTIF_IIR_FIFOCTRL) & BTIF_IIR_RX))) {
+		btif_enable_irqs(btif);
+		ret = -EBUSY;
+		goto out;
+	}
+	if (btif->dma_mode) {
+		clk_disable_unprepare(btif->dma_clk);
+		btif->dma_clocked = false;
+	}
+	clk_disable_unprepare(btif->clk);
+	btif->clocked = false;
+	btif->idle = true;
+out:
+	mutex_unlock(&mt6797_btif_singleton_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_btif_idle);
+
+/* The caller holds the singleton lock, keeping ownership and clocks stable. */
+static ssize_t btif_dma_write(struct mt6797_btif *btif, const u8 *data,
+			     size_t length, unsigned long timeout)
+{
+	struct btif_dma_channel *channel = &btif->tx_dma;
+	unsigned long flags;
+	size_t written = 0;
+	u32 value, room, count, offset, first;
+	long remaining;
+	int ret;
+
+	while (written < length) {
+		if (READ_ONCE(btif->dma_fault))
+			return -EIO;
+		ret = readl_poll_timeout(channel->base + VFF_FLUSH, value,
+					 !value, 10, 20000);
+		if (ret) {
+			btif->dma_fault = true;
+			return ret;
+		}
+		spin_lock_irqsave(&btif->tx_lock, flags);
+		if (readl(channel->base + VFF_FLUSH)) {
+			spin_unlock_irqrestore(&btif->tx_lock, flags);
+			continue;
+		}
+		room = readl(channel->base + VFF_LEFT);
+		if (room > BTIF_VFIFO_SIZE) {
+			spin_unlock_irqrestore(&btif->tx_lock, flags);
+			btif->dma_fault = true;
+			return -EPROTO;
+		}
+		count = min_t(size_t, length - written, room);
+		if (count) {
+			writel(0, channel->base + VFF_INT_EN);
+			offset = channel->pointer & 0xffff;
+			first = min(count, BTIF_VFIFO_SIZE - offset);
+			memcpy(channel->buffer + offset, data + written, first);
+			if (count > first)
+				memcpy(channel->buffer, data + written + first, count - first);
+			channel->pointer = btif_vfifo_advance(channel->pointer, count);
+			dma_wmb();
+			writel(1, channel->base + VFF_EN);
+			writel(channel->pointer, channel->base + VFF_WPT);
+			value = readl(channel->base + VFF_VALID);
+			if (value && value < 8)
+				writel(1, channel->base + VFF_FLUSH);
+			writel(1, channel->base + VFF_INT_EN);
+			channel->bytes += count;
+			written += count;
+		}
+		spin_unlock_irqrestore(&btif->tx_lock, flags);
+		if (written == length || !timeout)
+			break;
+		remaining = wait_event_interruptible_timeout(btif->tx_wait,
+			readl(channel->base + VFF_LEFT) > 0, timeout);
+		if (remaining <= 0)
+			return remaining ? -ERESTARTSYS : -ETIMEDOUT;
+		timeout = remaining;
+	}
+	return written;
+}
+
+static void btif_debug_state(struct mt6797_btif *btif, const char *where)
+{
+	if (!trace)
+		return;
+	dev_info(btif->dev,
+		 "BTIF debug %s: ier=%08x iir=%08x lsr=%08x tri=%08x dma=%08x handshake=%08x wak=%08x clk=%lu\n",
+		 where, readl(btif->base + BTIF_IER),
+		 readl(btif->base + BTIF_IIR_FIFOCTRL),
+		 readl(btif->base + BTIF_LSR), readl(btif->base + BTIF_TRI_LVL),
+		 readl(btif->base + BTIF_DMA_EN),
+		 readl(btif->base + BTIF_HANDSHAKE),
+		 readl(btif->base + BTIF_WAK), clk_get_rate(btif->clk));
+}
+
+static void btif_hw_init(struct mt6797_btif *btif)
+{
+	u32 tri;
+
+	writel(0, btif->base + BTIF_FAKELCR);
+	btif_update_bits(btif, BTIF_HANDSHAKE, BTIF_HANDSHAKE_ENABLE,
+			 BTIF_HANDSHAKE_ENABLE);
+	btif_fifo_reset(btif);
+	tri = readl(btif->base + BTIF_TRI_LVL);
+	tri &= ~(BTIF_TRI_TX_MASK | BTIF_TRI_RX_MASK);
+	tri |= BTIF_TRI_TX_THRESHOLD | (BTIF_TRI_RX_THRESHOLD << 4);
+	writel(tri, btif->base + BTIF_TRI_LVL);
+	btif_update_bits(btif, BTIF_DMA_EN, BTIF_DMA_AUTORST, BTIF_DMA_AUTORST);
+	btif_update_bits(btif, BTIF_DMA_EN, BIT(0) | BIT(1), 0);
+	/* Vendor PIO init leaves RX interrupts enabled; TX is armed per write. */
+	btif_update_bits(btif, BTIF_IER, BTIF_IER_RXFEN | BTIF_IER_TXEEN,
+			 BTIF_IER_RXFEN);
+}
+
+static irqreturn_t mt6797_btif_irq(int irq, void *data)
+{
+	struct mt6797_btif *btif = data;
+	const struct mt6797_btif_client_ops *ops;
+	unsigned long flags;
+	u8 rx[BTIF_RX_BUDGET];
+	unsigned int rx_len = 0;
+	u32 iir;
+
+	/* Release sets running false before disable_irq() synchronizes this IRQ. */
+	if (!READ_ONCE(btif->running))
+		return IRQ_NONE;
+	ops = READ_ONCE(btif->ops);
+
+	iir = readl(btif->base + BTIF_IIR_FIFOCTRL);
+	if (trace && btif->debug_irq_count < 32) {
+		btif->debug_irq_count++;
+		dev_info(btif->dev,
+			 "BTIF debug irq#%u: iir=%08x ier=%08x lsr=%08x\n",
+			 btif->debug_irq_count, iir,
+			 readl(btif->base + BTIF_IER), readl(btif->base + BTIF_LSR));
+	}
+	while ((iir & (BTIF_IIR_RX | BTIF_IIR_RX_TIMEOUT)) &&
+	       rx_len < ARRAY_SIZE(rx)) {
+		rx[rx_len++] = readb(btif->base + BTIF_RBR_THR);
+		iir = readl(btif->base + BTIF_IIR_FIFOCTRL);
+	}
+
+	if (iir & BTIF_IIR_TX_EMPTY) {
+		u8 tx[BTIF_TX_FIFO_SIZE];
+		unsigned int count;
+		unsigned int index;
+		u32 lsr = readl(btif->base + BTIF_LSR);
+		unsigned int room = lsr & BTIF_LSR_TEMT ? BTIF_TX_FIFO_SIZE :
+			(lsr & BTIF_LSR_THRE ? BTIF_TX_FIFO_SIZE - BTIF_TRI_TX_THRESHOLD : 0);
+
+		spin_lock_irqsave(&btif->tx_lock, flags);
+		count = min_t(unsigned int, room, kfifo_out_peek(&btif->tx_fifo,
+							 tx, sizeof(tx)));
+		if (count)
+			kfifo_skip_count(&btif->tx_fifo, count);
+		if (kfifo_is_empty(&btif->tx_fifo))
+			btif_update_bits(btif, BTIF_IER, BTIF_IER_TXEEN, 0);
+		spin_unlock_irqrestore(&btif->tx_lock, flags);
+
+		for (index = 0; index < count; index++)
+			writeb(tx[index], btif->base + BTIF_RBR_THR);
+		wake_up_all(&btif->tx_wait);
+	}
+
+	if (trace && rx_len && ops && ops->rx_bytes)
+		dev_info(btif->dev, "BTIF debug rx len=%u data=%*phN\n", rx_len,
+			 rx_len, rx);
+	if (rx_len && ops && ops->rx_bytes)
+		ops->rx_bytes(READ_ONCE(btif->context), rx, rx_len);
+	return (rx_len || (iir & (BTIF_IIR_TX_EMPTY | BTIF_IIR_RX |
+					 BTIF_IIR_RX_TIMEOUT))) ? IRQ_HANDLED : IRQ_NONE;
+}
+
+int mt6797_btif_claim(struct device *client,
+			      const struct mt6797_btif_client_ops *ops,
+			      void *context)
+{
+	struct mt6797_btif *btif;
+	int ret;
+
+	if (!client || !ops || !ops->rx_bytes)
+		return -EINVAL;
+	mutex_lock(&mt6797_btif_singleton_lock);
+	btif = mt6797_btif_singleton;
+	if (!btif) {
+		ret = -ENODEV;
+		goto out;
+	}
+	mutex_lock(&btif->client_lock);
+	if (btif->ops) {
+		ret = -EBUSY;
+		goto unlock_client;
+	}
+	ret = clk_prepare_enable(btif->clk);
+	if (ret)
+		goto unlock_client;
+	btif->clocked = true;
+	btif->idle = false;
+	btif_hw_init(btif);
+	if (btif->dma_mode) {
+		ret = btif_dma_start(btif);
+		if (ret) {
+			clk_disable_unprepare(btif->clk);
+			btif->clocked = false;
+			goto unlock_client;
+		}
+		btif_update_bits(btif, BTIF_IER, BTIF_IER_RXFEN | BTIF_IER_TXEEN, 0);
+		btif_update_bits(btif, BTIF_DMA_EN, BIT(0) | BIT(1), BIT(0) | BIT(1));
+	}
+	btif->debug_irq_count = 0;
+	btif_debug_state(btif, "claim");
+	WRITE_ONCE(btif->ops, ops);
+	btif->owner = client;
+	WRITE_ONCE(btif->context, context);
+	WRITE_ONCE(btif->running, true);
+	btif_enable_irqs(btif);
+	if (btif->dma_mode) {
+		writel(3, btif->rx_dma.base + VFF_INT_EN);
+		btif->dma_live = true;
+		writel(1, btif->rx_dma.base + VFF_EN);
+	}
+	dev_info(btif->dev, "BTIF claimed: %s\n", btif->dma_mode ? "DMA/VFIFO" : "PIO");
+	ret = 0;
+unlock_client:
+	mutex_unlock(&btif->client_lock);
+out:
+	mutex_unlock(&mt6797_btif_singleton_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_btif_claim);
+
+void mt6797_btif_release(struct device *client)
+{
+	struct mt6797_btif *btif;
+
+	if (!client)
+		return;
+	mutex_lock(&mt6797_btif_singleton_lock);
+	btif = mt6797_btif_singleton;
+	if (!btif)
+		goto out;
+	mutex_lock(&btif->client_lock);
+	if (btif->ops && btif->owner == client)
+		WRITE_ONCE(btif->running, false);
+	else if (btif->ops) {
+		dev_warn(btif->dev, "release from non-owner device\n");
+		goto unlock_client;
+	} else
+		goto unlock_client;
+	btif_disable_irqs(btif);
+	if (btif_exit_idle(btif)) {
+		btif->dma_fault = true;
+		dev_err(btif->dev, "clock resume failed during release; retaining live DMA buffers\n");
+		goto clear_owner;
+	}
+	if (btif->dma_mode)
+		btif_dma_stop(btif);
+	btif_update_bits(btif, BTIF_IER, BTIF_IER_RXFEN | BTIF_IER_TXEEN, 0);
+clear_owner:
+	WRITE_ONCE(btif->ops, NULL);
+	btif->owner = NULL;
+	WRITE_ONCE(btif->context, NULL);
+	spin_lock_irq(&btif->tx_lock);
+	kfifo_reset(&btif->tx_fifo);
+	spin_unlock_irq(&btif->tx_lock);
+	if (btif->clocked) {
+		clk_disable_unprepare(btif->clk);
+		btif->clocked = false;
+	}
+unlock_client:
+	mutex_unlock(&btif->client_lock);
+out:
+	mutex_unlock(&mt6797_btif_singleton_lock);
+}
+EXPORT_SYMBOL_GPL(mt6797_btif_release);
+
+ssize_t mt6797_btif_write(struct device *client, const u8 *data,
+			   size_t length, unsigned long timeout_jiffies)
+{
+	struct mt6797_btif *btif;
+	ssize_t written = 0;
+
+	if (!client || !data)
+		return -EINVAL;
+	mutex_lock(&mt6797_btif_singleton_lock);
+	btif = mt6797_btif_singleton;
+	if (!btif || btif->owner != client || !btif->running) {
+		mutex_unlock(&mt6797_btif_singleton_lock);
+		return -ENODEV;
+	}
+	written = btif_exit_idle(btif);
+	if (written) {
+		mutex_unlock(&mt6797_btif_singleton_lock);
+		return written;
+	}
+	if (btif->dma_mode) {
+		written = btif_dma_write(btif, data, length, timeout_jiffies);
+		mutex_unlock(&mt6797_btif_singleton_lock);
+		return written;
+	}
+	while (written < length) {
+		unsigned int count;
+		long wait_ret;
+
+		spin_lock_irq(&btif->tx_lock);
+		count = kfifo_in(&btif->tx_fifo, data + written, length - written);
+		if (count)
+			btif_update_bits(btif, BTIF_IER, BTIF_IER_TXEEN,
+					 BTIF_IER_TXEEN);
+		spin_unlock_irq(&btif->tx_lock);
+		written += count;
+		if (trace && count)
+			dev_info(btif->dev,
+				 "BTIF debug write queued=%u/%zu data=%*phN ier=%08x lsr=%08x\n",
+				 count, length, (int)min_t(size_t, count, 32), data + written - count,
+				 readl(btif->base + BTIF_IER), readl(btif->base + BTIF_LSR));
+		if (written == length)
+			break;
+		if (!timeout_jiffies)
+			break;
+		wait_ret = wait_event_interruptible_timeout(btif->tx_wait,
+							!kfifo_is_full(&btif->tx_fifo),
+							timeout_jiffies);
+		if (wait_ret <= 0) {
+			if (!wait_ret && written)
+				break;
+			written = wait_ret ? -ERESTARTSYS : -ETIMEDOUT;
+			break;
+		}
+		timeout_jiffies = wait_ret;
+	}
+	mutex_unlock(&mt6797_btif_singleton_lock);
+	return written;
+}
+EXPORT_SYMBOL_GPL(mt6797_btif_write);
+
+int mt6797_btif_wake(struct device *client)
+{
+	struct mt6797_btif *btif;
+	int ret;
+
+	mutex_lock(&mt6797_btif_singleton_lock);
+	btif = mt6797_btif_singleton;
+	if (!btif || btif->owner != client || !btif->running) {
+		mutex_unlock(&mt6797_btif_singleton_lock);
+		return -ENODEV;
+	}
+	ret = btif_exit_idle(btif);
+	if (ret) {
+		mutex_unlock(&mt6797_btif_singleton_lock);
+		return ret;
+	}
+	/* BSP hal_btif_raise_wak_sig(): a fresh low/high edge spanning at
+	 * least one 32-kHz period is required for every wake, not only boot.
+	 */
+	writel(0, btif->base + BTIF_WAK);
+	udelay(64);
+	writel(BTIF_WAK_SIGNAL, btif->base + BTIF_WAK);
+	mutex_unlock(&mt6797_btif_singleton_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_btif_wake);
+
+static ssize_t transfer_mode_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct mt6797_btif *btif = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%s tx=%llu rx=%llu fault=%u running=%u idle=%u clocked=%u live=%u\n",
+		btif->dma_mode ? "dma" : "pio", READ_ONCE(btif->tx_dma.bytes),
+		READ_ONCE(btif->rx_dma.bytes), READ_ONCE(btif->dma_fault),
+		READ_ONCE(btif->running), READ_ONCE(btif->idle),
+		READ_ONCE(btif->clocked), READ_ONCE(btif->dma_live));
+}
+
+static ssize_t transfer_mode_store(struct device *dev, struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct mt6797_btif *btif = dev_get_drvdata(dev);
+	bool dma;
+	int ret = 0;
+
+	if (sysfs_streq(buf, "dma"))
+		dma = true;
+	else if (sysfs_streq(buf, "pio"))
+		dma = false;
+	else
+		return -EINVAL;
+	mutex_lock(&mt6797_btif_singleton_lock);
+	mutex_lock(&btif->client_lock);
+	if (btif->running || btif->dma_clocked || btif->dma_live)
+		ret = -EBUSY;
+	else if (dma && !btif->rx_dma.buffer)
+		ret = -EOPNOTSUPP;
+	else
+		btif->dma_mode = dma;
+	mutex_unlock(&btif->client_lock);
+	mutex_unlock(&mt6797_btif_singleton_lock);
+	return ret ?: count;
+}
+static DEVICE_ATTR_RW(transfer_mode);
+static struct attribute *btif_attrs[] = { &dev_attr_transfer_mode.attr, NULL };
+ATTRIBUTE_GROUPS(btif);
+
+static int btif_dma_probe(struct platform_device *pdev, struct mt6797_btif *btif)
+{
+	struct btif_dma_channel *channels[] = { &btif->tx_dma, &btif->rx_dma };
+	irq_handler_t handlers[] = { btif_dma_tx_irq, btif_dma_rx_irq };
+	const char *names[] = { "mt6797-btif-tx", "mt6797-btif-rx" };
+	int i, ret;
+
+	if (!platform_get_resource(pdev, IORESOURCE_MEM, 1))
+		return 0;
+	btif->dma_clk = devm_clk_get(&pdev->dev, "dma");
+	if (IS_ERR(btif->dma_clk))
+		return PTR_ERR(btif->dma_clk);
+	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(&pdev->dev, btif_dma_free, btif);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(channels); i++) {
+		channels[i]->base = devm_platform_ioremap_resource(pdev, i + 1);
+		if (IS_ERR(channels[i]->base))
+			return PTR_ERR(channels[i]->base);
+		channels[i]->irq = platform_get_irq(pdev, i + 1);
+		if (channels[i]->irq < 0)
+			return channels[i]->irq;
+		channels[i]->buffer = dma_alloc_coherent(&pdev->dev, BTIF_VFIFO_SIZE,
+							&channels[i]->address, GFP_KERNEL);
+		if (!channels[i]->buffer)
+			return -ENOMEM;
+		ret = devm_request_threaded_irq(&pdev->dev, channels[i]->irq, NULL,
+						 handlers[i], IRQF_ONESHOT | IRQF_NO_AUTOEN,
+						 names[i], btif);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int mt6797_btif_probe(struct platform_device *pdev)
+{
+	struct mt6797_btif *btif;
+	int ret;
+
+	mutex_lock(&mt6797_btif_singleton_lock);
+	if (mt6797_btif_singleton) {
+		mutex_unlock(&mt6797_btif_singleton_lock);
+		return -EBUSY;
+	}
+	mutex_unlock(&mt6797_btif_singleton_lock);
+
+	btif = devm_kzalloc(&pdev->dev, sizeof(*btif), GFP_KERNEL);
+	if (!btif)
+		return -ENOMEM;
+	btif->dev = &pdev->dev;
+	btif->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(btif->base))
+		return PTR_ERR(btif->base);
+	btif->irq = platform_get_irq(pdev, 0);
+	if (btif->irq < 0)
+		return btif->irq;
+	btif->clk = devm_clk_get(&pdev->dev, "btif");
+	if (IS_ERR(btif->clk))
+		return dev_err_probe(&pdev->dev, PTR_ERR(btif->clk),
+				     "BTIF clock missing\n");
+	mutex_init(&btif->client_lock);
+	spin_lock_init(&btif->tx_lock);
+	init_waitqueue_head(&btif->tx_wait);
+	ret = kfifo_alloc(&btif->tx_fifo, BTIF_TX_QUEUE_SIZE, GFP_KERNEL);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(&pdev->dev, btif_kfifo_free,
+				       &btif->tx_fifo);
+	if (ret)
+		return ret;
+	ret = devm_request_irq(&pdev->dev, btif->irq, mt6797_btif_irq,
+				IRQF_NO_AUTOEN, dev_name(&pdev->dev), btif);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "BTIF IRQ request failed\n");
+	ret = btif_dma_probe(pdev, btif);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "BTIF DMA setup failed\n");
+	btif->dma_mode = of_property_read_bool(pdev->dev.of_node, "mediatek,use-dma");
+	if (btif->dma_mode && !btif->rx_dma.buffer)
+		return -EINVAL;
+	platform_set_drvdata(pdev, btif);
+	mutex_lock(&mt6797_btif_singleton_lock);
+	mt6797_btif_singleton = btif;
+	mutex_unlock(&mt6797_btif_singleton_lock);
+	dev_info(&pdev->dev, "MT6797 BTIF transport ready (%s%s; STP client required)\n",
+		 btif->dma_mode ? "DMA" : "PIO",
+		 btif->rx_dma.buffer ? ", DMA/VFIFO available" : "");
+	return 0;
+}
+
+static void mt6797_btif_remove(struct platform_device *pdev)
+{
+	struct mt6797_btif *btif = platform_get_drvdata(pdev);
+
+	mt6797_btif_release(btif ? btif->owner : NULL);
+	mutex_lock(&mt6797_btif_singleton_lock);
+	if (mt6797_btif_singleton == btif)
+		mt6797_btif_singleton = NULL;
+	mutex_unlock(&mt6797_btif_singleton_lock);
+}
+
+static const struct of_device_id mt6797_btif_of_match[] = {
+	{ .compatible = "mediatek,mt6797-btif" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6797_btif_of_match);
+
+static struct platform_driver mt6797_btif_driver = {
+	.probe = mt6797_btif_probe,
+	.remove = mt6797_btif_remove,
+	.driver = {
+		.name = "mt6797-btif",
+		.of_match_table = mt6797_btif_of_match,
+		.dev_groups = btif_groups,
+	},
+};
+module_platform_driver(mt6797_btif_driver);
+
+MODULE_DESCRIPTION("MT6797 ConSys BTIF PIO and DMA/VFIFO transport");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6797-consys.c b/drivers/soc/mediatek/mt6797-consys.c
new file mode 100644
index 000000000..b9cef05a3
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-consys.c
@@ -0,0 +1,1117 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// MT6797 ConSys power/bring-up driver for the X20-96 board.
+//
+// The MT6797 connectivity subsystem (ConSys) hosts the WLAN/BT/GPS baseband
+// and drives the external MT6631 radio through dedicated CONN_IF pins.  This
+// driver implements the vendor power-on sequence from the MT6797 BSP
+// (conn_soc/mt6797/mtk_wcn_consys_hw.c): MT6351 connectivity LDOs, MTCMOS
+// power-up through SPM, AXI bus-protect release, and the ConSys MCU chip-ID
+// handshake.  It exposes the resulting state through sysfs for bring-up and
+// testing; protocol stacks (WMT/STP, WLAN) are out of scope here.
+//
+//       radio_power - 1 to run the full power-on sequence, 0 to power off
+//       chipid - read of CONN_MCU_CFG + 0x08 (0x0279 when the MCU is alive)
+
+#include <linux/bitops.h>
+#include <linux/arm-smccc.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/kstrtox.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+#include <linux/sysfs.h>
+
+#include <linux/mt6797-consys.h>
+#include <linux/mt6797-stp-session.h>
+
+#define CONSYS_CHIP_ID			0x0279
+
+/* CONN_MCU_CONFIG_BASE */
+#define CONSYS_MCU_CHIP_ID_OFF		0x0008
+#define CONSYS_MCU_CFG_ACR_OFF		0x0110
+#define CONSYS_MCU_CFG_ACR_MBIST	BIT(18)
+/* AP_RGU_BASE */
+#define CONSYS_RGU_SWSYSRST_OFF		0x0018
+#define CONSYS_RGU_KEY			(0x88u << 24)
+#define CONSYS_RGU_RST_BIT		BIT(12)
+/* TOPCKGEN_BASE */
+#define CONSYS_TOPAXI_PROT_EN_OFF	0x1220
+#define CONSYS_TOPAXI_PROT_STA1_OFF	0x1228
+#define CONSYS_TOPAXI_PROT_MASK		(BIT(18) | BIT(19))
+#define CONSYS_CONN2AP_SLEEP_MASK_OFF	0x1350
+#define CONSYS_CONN2AP_SLEEP_MASK_BIT	BIT(8)
+#define CONSYS_EMI_MAPPING_OFF		0x1340
+#define CONSYS_EMI_MAPPING_ENABLE	0x1000
+/* SPM_BASE */
+#define CONSYS_SPM_PWRON_CONFG_EN_OFF	0x0000
+#define CONSYS_SPM_PWRON_CONFG_EN_VAL	0x0b160001
+#define CONSYS_SPM_CONN_PWR_CTRL_OFF	0x032c
+#define CONSYS_SPM_PWR_RST_BIT		BIT(0)
+#define CONSYS_SPM_PWR_ISO_S_BIT	BIT(1)
+#define CONSYS_SPM_PWR_ON_BIT		BIT(2)
+#define CONSYS_SPM_PWR_ON_S_BIT		BIT(3)
+#define CONSYS_SPM_CLK_DIS_BIT		BIT(4)
+#define CONSYS_SPM_PWR_ACK_OFF		0x0180
+#define CONSYS_SPM_PWR_ACK_S_OFF	0x0184
+#define CONSYS_SPM_PWR_ACK_BIT		BIT(1)
+
+/*
+ * These bits describe an attempted stage, rather than only a successful
+ * stage.  That distinction matters when a register write succeeds but its
+ * following ACK poll times out: cleanup must still undo the write.
+ */
+#define CONSYS_STAGE_VCN18		BIT(0)
+#define CONSYS_STAGE_VCN28		BIT(1)
+#define CONSYS_STAGE_SLEEP_MASK		BIT(2)
+#define CONSYS_STAGE_RGU_RESET		BIT(3)
+#define CONSYS_STAGE_PWR_CFG		BIT(4)
+#define CONSYS_STAGE_PWR_ON		BIT(5)
+#define CONSYS_STAGE_PWR_ON_S		BIT(6)
+#define CONSYS_STAGE_CLK_ON		BIT(7)
+#define CONSYS_STAGE_ISO_RELEASED	BIT(8)
+#define CONSYS_STAGE_SPM_RESET		BIT(9)
+#define CONSYS_STAGE_AXI		BIT(10)
+#define CONSYS_STAGE_CHIP_ID		BIT(11)
+#define CONSYS_STAGE_RGU_RELEASED	BIT(12)
+
+#define CONSYS_STAGE_POWERED		(CONSYS_STAGE_CHIP_ID | \
+						 CONSYS_STAGE_RGU_RELEASED)
+
+#define MT6797_SIP_KERNEL_EMIMPU_SET	0xc2000209ULL
+#define MT6797_EMI_REGION_SHIFT		27U
+#define MT6797_EMI_REGION18		18U
+#define MT6797_EMI_REGION19		19U
+#define MT6797_EMI_REGION18_OPEN	0x00000000U
+#define MT6797_EMI_REGION18_RESTORE	0x00b6da2dU
+#define MT6797_EMI_REGION19_HOST	0x00b6da28U
+#define MT6797_EMI_WINDOW_SIZE		0x00080000U
+#define MT6797_EMI_MAPPED_SIZE		0x00100000U
+
+struct mt6797_consys {
+	struct device *dev;
+	void __iomem *base[4];
+	void __iomem *mcu;
+	void __iomem *rgu;
+	void __iomem *topckgen;
+	void __iomem *spm;
+	struct regulator *vcn18;
+	struct regulator *vcn28;
+	struct regulator *vcn33_bt;
+	struct regulator *vcn33_wifi;
+	struct mutex lock;
+	u32 stages;
+	u32 stp_mode;
+	int last_error;
+	bool powered;
+	bool stp_claimed;
+	bool stp_power_owned;
+	bool stp_enabled;
+	bool bt_radio_on;
+	bool wifi_radio_on;
+	phys_addr_t emi_base;
+	phys_addr_t emi_size;
+	void __iomem *emi_io;
+	u32 emi_mapping_saved;
+	bool emi_mapping_active;
+	bool emi_patch_active;
+};
+
+static int consys_emi_prepare_locked(struct mt6797_consys *cs);
+static int consys_emi_restore_locked(struct mt6797_consys *cs);
+
+static int consys_wait_ack(struct mt6797_consys *cs, u32 off, u32 mask)
+{
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout(cs->spm + off, val, val & mask, 10, 100000);
+	if (ret)
+		dev_err(cs->dev, "timeout waiting SPM ack @0x%x (val=0x%08x)\n",
+			off, val);
+	return ret;
+}
+
+static int consys_wait_ack_clear(struct mt6797_consys *cs, u32 off, u32 mask)
+{
+	u32 val;
+	int ret;
+
+	ret = readl_poll_timeout(cs->spm + off, val, !(val & mask), 10, 100000);
+	if (ret)
+		dev_err(cs->dev, "timeout clearing SPM ack @0x%x (val=0x%08x)\n",
+			off, val);
+	return ret;
+}
+
+static void consys_rgu_sw_rst(struct mt6797_consys *cs, bool assert)
+{
+	u32 val = readl(cs->rgu + CONSYS_RGU_SWSYSRST_OFF);
+
+	if (assert)
+		val |= CONSYS_RGU_RST_BIT;
+	else
+		val &= ~CONSYS_RGU_RST_BIT;
+	val |= CONSYS_RGU_KEY;
+	writel(val, cs->rgu + CONSYS_RGU_SWSYSRST_OFF);
+}
+
+static int consys_axi_protect(struct mt6797_consys *cs, bool enable)
+{
+	u32 val;
+
+	val = readl(cs->topckgen + CONSYS_TOPAXI_PROT_EN_OFF);
+	if (enable)
+		val |= CONSYS_TOPAXI_PROT_MASK;
+	else
+		val &= ~CONSYS_TOPAXI_PROT_MASK;
+	writel(val, cs->topckgen + CONSYS_TOPAXI_PROT_EN_OFF);
+
+	if (enable)
+		return readl_poll_timeout(cs->topckgen + CONSYS_TOPAXI_PROT_STA1_OFF,
+					  val, (val & CONSYS_TOPAXI_PROT_MASK) ==
+					       CONSYS_TOPAXI_PROT_MASK,
+					  10, 100000);
+
+	return readl_poll_timeout(cs->topckgen + CONSYS_TOPAXI_PROT_STA1_OFF,
+				  val, !(val & CONSYS_TOPAXI_PROT_MASK),
+				  10, 100000);
+}
+
+/* Called with cs->lock held. */
+static int consys_cleanup_locked(struct mt6797_consys *cs)
+{
+	int ret = 0;
+	int tmp;
+	u32 val;
+
+	/* WMT function rails are children of the ConSys power owner. */
+	if (cs->wifi_radio_on) {
+		tmp = regulator_disable(cs->vcn33_wifi);
+		if (tmp && !ret)
+			ret = tmp;
+		cs->wifi_radio_on = false;
+	}
+	if (cs->bt_radio_on) {
+		tmp = regulator_disable(cs->vcn33_bt);
+		if (tmp && !ret)
+			ret = tmp;
+		cs->bt_radio_on = false;
+	}
+
+	if (cs->stages & CONSYS_STAGE_RGU_RELEASED) {
+		consys_rgu_sw_rst(cs, true);
+		cs->stages &= ~CONSYS_STAGE_RGU_RELEASED;
+	}
+
+	if (cs->stages & CONSYS_STAGE_AXI) {
+		tmp = consys_axi_protect(cs, true);
+		if (tmp && !ret) {
+			ret = tmp;
+			dev_err(cs->dev, "failed to re-enable AXI protection: %d\n", tmp);
+		}
+		cs->stages &= ~CONSYS_STAGE_AXI;
+	}
+	/* The MCU must be reset before its DRAM mapping can be removed. */
+	tmp = consys_emi_restore_locked(cs);
+	if (tmp && !ret)
+		ret = tmp;
+
+	if (cs->stages & CONSYS_STAGE_SPM_RESET) {
+		val = readl(cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+		writel(val & ~CONSYS_SPM_PWR_RST_BIT,
+		       cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+		cs->stages &= ~CONSYS_STAGE_SPM_RESET;
+	}
+
+	if (cs->stages & CONSYS_STAGE_ISO_RELEASED) {
+		val = readl(cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+		writel(val | CONSYS_SPM_PWR_ISO_S_BIT,
+		       cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+		cs->stages &= ~CONSYS_STAGE_ISO_RELEASED;
+	}
+
+	if (cs->stages & CONSYS_STAGE_CLK_ON) {
+		val = readl(cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+		writel(val | CONSYS_SPM_CLK_DIS_BIT,
+		       cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+		udelay(1);
+		cs->stages &= ~CONSYS_STAGE_CLK_ON;
+	}
+
+	if (cs->stages & (CONSYS_STAGE_PWR_ON | CONSYS_STAGE_PWR_ON_S)) {
+		val = readl(cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+		writel(val & ~(CONSYS_SPM_PWR_ON_BIT | CONSYS_SPM_PWR_ON_S_BIT),
+		       cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+		tmp = consys_wait_ack_clear(cs, CONSYS_SPM_PWR_ACK_OFF,
+					     CONSYS_SPM_PWR_ACK_BIT);
+		if (tmp && !ret)
+			ret = tmp;
+		tmp = consys_wait_ack_clear(cs, CONSYS_SPM_PWR_ACK_S_OFF,
+					     CONSYS_SPM_PWR_ACK_BIT);
+		if (tmp && !ret)
+			ret = tmp;
+		cs->stages &= ~(CONSYS_STAGE_PWR_ON | CONSYS_STAGE_PWR_ON_S);
+	}
+
+	if (cs->stages & CONSYS_STAGE_PWR_CFG) {
+		writel(CONSYS_SPM_PWRON_CONFG_EN_VAL & ~0x1,
+		       cs->spm + CONSYS_SPM_PWRON_CONFG_EN_OFF);
+		cs->stages &= ~CONSYS_STAGE_PWR_CFG;
+	}
+
+	/* The chip ID is an observation, not a power-off action. */
+	cs->stages &= ~CONSYS_STAGE_CHIP_ID;
+
+	if (cs->stages & CONSYS_STAGE_RGU_RESET)
+		cs->stages &= ~CONSYS_STAGE_RGU_RESET;
+
+	if (cs->stages & CONSYS_STAGE_SLEEP_MASK) {
+		val = readl(cs->topckgen + CONSYS_CONN2AP_SLEEP_MASK_OFF);
+		writel(val & ~CONSYS_CONN2AP_SLEEP_MASK_BIT,
+		       cs->topckgen + CONSYS_CONN2AP_SLEEP_MASK_OFF);
+		cs->stages &= ~CONSYS_STAGE_SLEEP_MASK;
+	}
+
+	if (cs->stages & CONSYS_STAGE_VCN28) {
+		tmp = regulator_disable(cs->vcn28);
+		if (tmp && !ret)
+			ret = tmp;
+		cs->stages &= ~CONSYS_STAGE_VCN28;
+	}
+	if (cs->stages & CONSYS_STAGE_VCN18) {
+		tmp = regulator_disable(cs->vcn18);
+		if (tmp && !ret)
+			ret = tmp;
+		cs->stages &= ~CONSYS_STAGE_VCN18;
+	}
+
+	cs->powered = false;
+	cs->stp_enabled = false;
+	cs->stp_mode = 0;
+	return ret;
+}
+
+/* Called with cs->lock held. */
+static int consys_power_on_locked(struct mt6797_consys *cs)
+{
+	u32 val, chipid;
+	int ret, retry;
+
+	if (cs->powered)
+		return 0;
+	if (cs->stages || cs->emi_mapping_active || cs->emi_patch_active) {
+		dev_warn(cs->dev, "recovering incomplete state before power-on (0x%x)\n",
+			 cs->stages);
+		ret = consys_cleanup_locked(cs);
+		if (ret)
+			return ret;
+	}
+
+	/* Step 1: connectivity LDOs (vendor order: VCN18, settle, VCN28). */
+	ret = regulator_enable(cs->vcn18);
+	if (ret) {
+		dev_err(cs->dev, "failed to enable vcn18: %d\n", ret);
+		return ret;
+	}
+	cs->stages |= CONSYS_STAGE_VCN18;
+	udelay(240);
+	ret = regulator_enable(cs->vcn28);
+	if (ret) {
+		dev_err(cs->dev, "failed to enable vcn28: %d\n", ret);
+		goto err_cleanup;
+	}
+	cs->stages |= CONSYS_STAGE_VCN28;
+
+	/* Mask ConSys sleep requests while the MCU boots. */
+	val = readl(cs->topckgen + CONSYS_CONN2AP_SLEEP_MASK_OFF);
+	writel(val | CONSYS_CONN2AP_SLEEP_MASK_BIT,
+	       cs->topckgen + CONSYS_CONN2AP_SLEEP_MASK_OFF);
+	cs->stages |= CONSYS_STAGE_SLEEP_MASK;
+
+	/* Step 2: hold the ConSys MCU in software reset during power-up. */
+	consys_rgu_sw_rst(cs, true);
+	cs->stages |= CONSYS_STAGE_RGU_RESET;
+
+	/* Step 3: unmask SPM power-on control for the CONN domain. */
+	writel(CONSYS_SPM_PWRON_CONFG_EN_VAL,
+	       cs->spm + CONSYS_SPM_PWRON_CONFG_EN_OFF);
+	cs->stages |= CONSYS_STAGE_PWR_CFG;
+
+	/* Step 4: MTCMOS power-up with ISO release and clock enable. */
+	val = readl(cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	writel(val | CONSYS_SPM_PWR_ON_BIT, cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	cs->stages |= CONSYS_STAGE_PWR_ON;
+	ret = consys_wait_ack(cs, CONSYS_SPM_PWR_ACK_OFF, CONSYS_SPM_PWR_ACK_BIT);
+	if (ret)
+		goto err_cleanup;
+
+	val = readl(cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	writel(val | CONSYS_SPM_PWR_ON_S_BIT, cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	cs->stages |= CONSYS_STAGE_PWR_ON_S;
+	ret = consys_wait_ack(cs, CONSYS_SPM_PWR_ACK_S_OFF, CONSYS_SPM_PWR_ACK_BIT);
+	if (ret)
+		goto err_cleanup;
+
+	val = readl(cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	writel(val & ~CONSYS_SPM_CLK_DIS_BIT, cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	cs->stages |= CONSYS_STAGE_CLK_ON;
+	udelay(1);
+
+	val = readl(cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	writel(val & ~CONSYS_SPM_PWR_ISO_S_BIT, cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	cs->stages |= CONSYS_STAGE_ISO_RELEASED;
+
+	val = readl(cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	writel(val | CONSYS_SPM_PWR_RST_BIT, cs->spm + CONSYS_SPM_CONN_PWR_CTRL_OFF);
+	cs->stages |= CONSYS_STAGE_SPM_RESET;
+
+	/* Step 5: release the ConSys AXI bus protection. */
+	cs->stages |= CONSYS_STAGE_AXI;
+	ret = consys_axi_protect(cs, false);
+	if (ret) {
+		dev_err(cs->dev, "AXI bus protect stuck (sta1=0x%08x)\n",
+			readl(cs->topckgen + CONSYS_TOPAXI_PROT_STA1_OFF));
+		goto err_cleanup;
+	}
+
+	/* 26 MHz is running by now; allow memory power-down de-assert. */
+	udelay(30);
+
+	/* Step 6: poll the ConSys MCU chip ID (vendor handshake). */
+	chipid = 0;
+	for (retry = 10; retry > 0; retry--) {
+		chipid = readl(cs->mcu + CONSYS_MCU_CHIP_ID_OFF);
+		if (chipid == CONSYS_CHIP_ID)
+			break;
+		msleep(20);
+	}
+	if (chipid != CONSYS_CHIP_ID) {
+		dev_err(cs->dev, "ConSys chip ID 0x%08x != 0x%04x, power-on issue\n",
+			chipid, CONSYS_CHIP_ID);
+		ret = -EIO;
+		goto err_cleanup;
+	}
+	dev_info(cs->dev, "ConSys chip ID 0x%04x confirmed\n", chipid);
+	cs->stages |= CONSYS_STAGE_CHIP_ID;
+
+	/* Reserve and clear shared DRAM while the ConSys MCU is still reset. */
+	ret = consys_emi_prepare_locked(cs);
+	if (ret) {
+		dev_err(cs->dev, "ConSys EMI setup failed (matching BL31 required): %d\n", ret);
+		goto err_cleanup;
+	}
+
+	/* Step 7: run MBIST at real speed, then release the MCU reset. */
+	val = readl(cs->mcu + CONSYS_MCU_CFG_ACR_OFF);
+	writel(val | CONSYS_MCU_CFG_ACR_MBIST, cs->mcu + CONSYS_MCU_CFG_ACR_OFF);
+
+	consys_rgu_sw_rst(cs, false);
+	cs->stages &= ~CONSYS_STAGE_RGU_RESET;
+	cs->stages |= CONSYS_STAGE_RGU_RELEASED;
+	msleep(20);
+
+	cs->powered = (cs->stages & CONSYS_STAGE_POWERED) == CONSYS_STAGE_POWERED;
+	dev_info(cs->dev, "ConSys powered on\n");
+	return 0;
+
+err_cleanup:
+	cs->last_error = ret;
+	if (consys_cleanup_locked(cs))
+		dev_err(cs->dev, "cleanup after power-on failure also failed\n");
+	return ret;
+}
+
+/* Called with cs->lock held. */
+static int consys_power_off_locked(struct mt6797_consys *cs)
+{
+	int ret;
+
+	if (cs->stp_claimed)
+		return -EBUSY;
+	if (!cs->stages)
+		return 0;
+
+	ret = consys_cleanup_locked(cs);
+	cs->last_error = ret;
+	if (ret)
+		dev_err(cs->dev, "ConSys power-off cleanup failed: %d\n", ret);
+	dev_info(cs->dev, "ConSys powered off\n");
+	return ret;
+}
+
+int mt6797_consys_stp_set_mode(void *context, u32 mode)
+{
+	struct mt6797_consys *cs = context;
+	int ret = 0;
+
+	if (!cs || (mode & ~GENMASK(4, 0)))
+		return -EINVAL;
+	mutex_lock(&cs->lock);
+	if (!cs->powered)
+		ret = -EHOSTDOWN;
+	else if (!cs->stp_claimed)
+		ret = -EPERM;
+	else
+		cs->stp_mode = mode;
+	mutex_unlock(&cs->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_stp_set_mode);
+
+int mt6797_consys_stp_set_enabled(void *context, bool enabled)
+{
+	struct mt6797_consys *cs = context;
+	int ret = 0;
+
+	if (!cs)
+		return -EINVAL;
+	mutex_lock(&cs->lock);
+	if (enabled && !cs->powered)
+		ret = -EHOSTDOWN;
+	else if (!cs->stp_claimed)
+		ret = -EPERM;
+	else if (enabled && !cs->stp_mode)
+		ret = -EINVAL;
+	else
+		cs->stp_enabled = enabled;
+	mutex_unlock(&cs->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_stp_set_enabled);
+
+static int consys_stp_acquire(struct device *consys_dev,
+			      struct mt6797_stp_host_ops *ops,
+			      void **context, bool manage_power)
+{
+	struct mt6797_consys *cs;
+	int ret = 0;
+
+	if (!consys_dev || !ops || !context)
+		return -EINVAL;
+	cs = dev_get_drvdata(consys_dev);
+	if (!cs)
+		return -EPROBE_DEFER;
+	mutex_lock(&cs->lock);
+	if (cs->stp_claimed)
+		ret = -EBUSY;
+	else if (!cs->powered)
+		ret = manage_power ? consys_power_on_locked(cs) : -EHOSTDOWN;
+	if (!ret) {
+		cs->stp_claimed = true;
+		cs->stp_power_owned = manage_power;
+		ops->set_mode = mt6797_consys_stp_set_mode;
+		ops->set_enabled = mt6797_consys_stp_set_enabled;
+		*context = cs;
+	}
+	mutex_unlock(&cs->lock);
+	return ret;
+}
+
+int mt6797_consys_stp_acquire(struct device *consys_dev,
+			      struct mt6797_stp_host_ops *ops, void **context)
+{
+	return consys_stp_acquire(consys_dev, ops, context, false);
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_stp_acquire);
+
+int mt6797_consys_stp_open(struct device *consys_dev,
+			  struct mt6797_stp_host_ops *ops, void **context)
+{
+	return consys_stp_acquire(consys_dev, ops, context, true);
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_stp_open);
+
+int mt6797_consys_stp_release(void *context)
+{
+	struct mt6797_consys *cs = context;
+	int ret = 0;
+
+	if (!cs)
+		return -EINVAL;
+	mutex_lock(&cs->lock);
+	if (!cs->stp_claimed)
+		ret = -EINVAL;
+	else if (cs->stp_enabled)
+		ret = -EBUSY;
+	else {
+		cs->stp_claimed = false;
+		cs->stp_mode = 0;
+		if (cs->stp_power_owned) {
+			cs->stp_power_owned = false;
+			ret = consys_power_off_locked(cs);
+		}
+	}
+	mutex_unlock(&cs->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_stp_release);
+
+int mt6797_consys_radio_power(void *context, u8 function, bool enabled,
+				      bool *changed)
+{
+	struct mt6797_consys *cs = context;
+	struct regulator *supply;
+	bool *state;
+	int ret = 0;
+
+	if (!cs)
+		return -EINVAL;
+	if (changed)
+		*changed = false;
+	switch (function) {
+	case MT6797_CONSYS_FUNC_BT:
+		supply = cs->vcn33_bt;
+		state = &cs->bt_radio_on;
+		break;
+	case MT6797_CONSYS_FUNC_WIFI:
+		supply = cs->vcn33_wifi;
+		state = &cs->wifi_radio_on;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	mutex_lock(&cs->lock);
+	if (!cs->powered)
+		ret = -EHOSTDOWN;
+	else if (!cs->stp_claimed)
+		ret = -EPERM;
+	else if (*state == enabled)
+		ret = 0;
+	else if (enabled)
+		ret = regulator_enable(supply);
+	else
+		ret = regulator_disable(supply);
+	if (!ret && *state != enabled) {
+		*state = enabled;
+		if (changed)
+			*changed = true;
+	}
+	mutex_unlock(&cs->lock);
+
+	if (ret)
+		dev_err(cs->dev, "VCN33 function %u %s failed: %d\n",
+			function, enabled ? "on" : "off", ret);
+	else
+		dev_info(cs->dev, "VCN33 function %u %s\n",
+			 function, enabled ? "on" : "off");
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_radio_power);
+
+int mt6797_consys_get_emi(void *context, phys_addr_t *base,
+				  phys_addr_t *size)
+{
+	struct mt6797_consys *cs = context;
+	int ret = 0;
+
+	if (!cs || !base || !size)
+		return -EINVAL;
+
+	mutex_lock(&cs->lock);
+	if (!cs->stp_claimed)
+		ret = -EPERM;
+	else if (!cs->emi_size || !cs->emi_mapping_active || !cs->powered)
+		ret = -ENODEV;
+	else {
+		*base = cs->emi_base;
+		*size = cs->emi_size;
+	}
+	mutex_unlock(&cs->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_get_emi);
+
+int mt6797_consys_read_cpupcr(void *context, u32 *value)
+{
+	struct mt6797_consys *cs = context;
+	int ret = 0;
+
+	if (!cs || !value)
+		return -EINVAL;
+	mutex_lock(&cs->lock);
+	if (!cs->stp_claimed || !cs->powered)
+		ret = -EHOSTDOWN;
+	else
+		*value = readl(cs->mcu + 0x160);
+	mutex_unlock(&cs->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_read_cpupcr);
+
+static int consys_emi_smc_set_locked(struct mt6797_consys *cs,
+					     phys_addr_t start, phys_addr_t end,
+					     unsigned int region, u32 permission)
+{
+	struct arm_smccc_res res;
+	u32 packed;
+	s64 result;
+
+	if (!cs->emi_size || !cs->emi_io)
+		return -ENODEV;
+	packed = (region << MT6797_EMI_REGION_SHIFT) | permission;
+	arm_smccc_smc(MT6797_SIP_KERNEL_EMIMPU_SET,
+			      (u64)start, (u64)end, packed, 0, 0, 0, 0, &res);
+	result = (s64)res.a0;
+	if (!result)
+		return 0;
+	if (result == -1 || result == -2)
+		return -EOPNOTSUPP;
+	if (result == -3)
+		return -ERANGE;
+	if (result == -4)
+		return -EACCES;
+	return -EIO;
+}
+
+/* Called with cs->lock held. */
+static int consys_emi_prepare_locked(struct mt6797_consys *cs)
+{
+	phys_addr_t base = cs->emi_base;
+	u32 map_bits;
+	u32 old_map;
+	u32 readback;
+	int ret;
+
+	if (!cs->emi_size)
+		return 0;
+	if (!cs->emi_io)
+		return -ENODEV;
+	if (!IS_ALIGNED(base, MT6797_CONSYS_EMI_REGION_SIZE) ||
+	    cs->emi_size < MT6797_CONSYS_EMI_REGION_SIZE ||
+	    base > U32_MAX)
+		return -ERANGE;
+
+	/* Replace the address field rather than OR-ing a previous mapping into it. */
+	map_bits = ((u32)base & 0xfff00000U) >> 20;
+	map_bits |= CONSYS_EMI_MAPPING_ENABLE;
+	old_map = readl(cs->topckgen + CONSYS_EMI_MAPPING_OFF);
+	cs->emi_mapping_saved = old_map;
+	cs->emi_mapping_active = true;
+	map_bits |= old_map & ~GENMASK(12, 0);
+	writel(map_bits, cs->topckgen + CONSYS_EMI_MAPPING_OFF);
+	readback = readl(cs->topckgen + CONSYS_EMI_MAPPING_OFF);
+	if (readback != map_bits) {
+		ret = -EIO;
+		goto err_map;
+	}
+
+	/*
+	 * Region 19 is the AP/ConSys host window; region 18 is opened only for
+	 * the bounded firmware transaction.
+	 */
+	ret = consys_emi_smc_set_locked(cs, base + MT6797_EMI_WINDOW_SIZE,
+					base + MT6797_EMI_MAPPED_SIZE - 1,
+					MT6797_EMI_REGION19, MT6797_EMI_REGION19_HOST);
+	if (ret)
+		goto err_map;
+	ret = consys_emi_smc_set_locked(cs, base, base + MT6797_EMI_WINDOW_SIZE - 1,
+					MT6797_EMI_REGION18, MT6797_EMI_REGION18_OPEN);
+	if (ret)
+		goto err_map;
+	cs->emi_patch_active = true;
+
+	/* This only runs before MCU reset release, never between patch images. */
+	memset_io(cs->emi_io, 0, MT6797_EMI_MAPPED_SIZE);
+	/* Complete the clear before readback and removal of AP write access. */
+	wmb();
+	if (readl(cs->emi_io) ||
+	    readl(cs->emi_io + MT6797_EMI_MAPPED_SIZE - sizeof(u32))) {
+		ret = -EIO;
+		goto err_region;
+	}
+	ret = consys_emi_smc_set_locked(cs, base, base + MT6797_EMI_WINDOW_SIZE - 1,
+					MT6797_EMI_REGION18, MT6797_EMI_REGION18_RESTORE);
+	if (ret)
+		goto err_region;
+	cs->emi_patch_active = false;
+	dev_info(cs->dev, "ConSys EMI owner active: remap=0x%08x base=%pa\n",
+		 readback, &base);
+	return 0;
+
+err_region:
+	if (!consys_emi_smc_set_locked(cs, base, base + MT6797_EMI_WINDOW_SIZE - 1,
+					 MT6797_EMI_REGION18, MT6797_EMI_REGION18_RESTORE))
+		cs->emi_patch_active = false;
+err_map:
+	writel(cs->emi_mapping_saved, cs->topckgen + CONSYS_EMI_MAPPING_OFF);
+	cs->emi_mapping_active = readl(cs->topckgen + CONSYS_EMI_MAPPING_OFF) !=
+				 cs->emi_mapping_saved;
+	return ret;
+}
+
+/* Called with cs->lock held. */
+static int consys_emi_restore_locked(struct mt6797_consys *cs)
+{
+	int ret;
+
+	if (!cs->emi_patch_active && !cs->emi_mapping_active)
+		return 0;
+	ret = consys_emi_smc_set_locked(cs, cs->emi_base,
+					cs->emi_base + MT6797_EMI_WINDOW_SIZE - 1,
+					MT6797_EMI_REGION18, MT6797_EMI_REGION18_RESTORE);
+	if (ret)
+		dev_warn(cs->dev, "failed to restore ConSys EMI region 18: %d\n", ret);
+	if (cs->emi_mapping_active) {
+		writel(cs->emi_mapping_saved,
+		       cs->topckgen + CONSYS_EMI_MAPPING_OFF);
+		cs->emi_mapping_active = readl(cs->topckgen + CONSYS_EMI_MAPPING_OFF) !=
+					 cs->emi_mapping_saved;
+		if (cs->emi_mapping_active) {
+			dev_warn(cs->dev, "failed to restore ConSys EMI remap\n");
+			if (!ret)
+				ret = -EIO;
+		}
+	}
+	if (!ret)
+		cs->emi_patch_active = false;
+	return ret;
+}
+
+int mt6797_consys_emi_patch_begin(void *context)
+{
+	struct mt6797_consys *cs = context;
+	int ret;
+
+	if (!cs)
+		return -EINVAL;
+
+	mutex_lock(&cs->lock);
+	if (!cs->stp_claimed)
+		ret = -EPERM;
+	else if (!cs->powered)
+		ret = -EHOSTDOWN;
+	else if (cs->emi_patch_active)
+		ret = -EBUSY;
+	else if (!cs->emi_size || !cs->emi_mapping_active)
+		ret = -ENODEV;
+	else
+		ret = consys_emi_smc_set_locked(cs, cs->emi_base,
+					cs->emi_base + MT6797_EMI_WINDOW_SIZE - 1,
+					MT6797_EMI_REGION18, MT6797_EMI_REGION18_OPEN);
+	if (!ret)
+		cs->emi_patch_active = true;
+	mutex_unlock(&cs->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_emi_patch_begin);
+
+int mt6797_consys_emi_patch_end(void *context)
+{
+	struct mt6797_consys *cs = context;
+	int ret;
+
+	if (!cs)
+		return -EINVAL;
+	mutex_lock(&cs->lock);
+	if (!cs->stp_claimed || !cs->emi_patch_active) {
+		ret = -EPERM;
+	} else {
+		ret = consys_emi_smc_set_locked(cs, cs->emi_base,
+					cs->emi_base + MT6797_EMI_WINDOW_SIZE - 1,
+					MT6797_EMI_REGION18, MT6797_EMI_REGION18_RESTORE);
+		if (!ret)
+			cs->emi_patch_active = false;
+	}
+	/* Firmware keeps using the remap until power-off asserts MCU reset. */
+	mutex_unlock(&cs->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_emi_patch_end);
+
+int mt6797_consys_wifi_emi_write(void *context, u32 offset,
+			       const void *data, size_t length)
+{
+	struct mt6797_consys *cs = context;
+	u8 verify[64];
+	size_t position, count;
+	int ret, restore_ret;
+
+	if (!cs || !data || !length || offset >= MT6797_CONSYS_WIFI_EMI_SIZE ||
+	    length > MT6797_CONSYS_WIFI_EMI_SIZE - offset)
+		return -EINVAL;
+	ret = mt6797_consys_emi_patch_begin(context);
+	if (ret)
+		return ret;
+	mutex_lock(&cs->lock);
+	memcpy_toio(cs->emi_io + offset, data, length);
+	wmb();
+	for (position = 0; position < length; position += count) {
+		count = min_t(size_t, sizeof(verify), length - position);
+		memcpy_fromio(verify, cs->emi_io + offset + position, count);
+		if (memcmp(verify, (const u8 *)data + position, count)) {
+			ret = -EIO;
+			break;
+		}
+	}
+	mutex_unlock(&cs->lock);
+	restore_ret = mt6797_consys_emi_patch_end(context);
+	return ret ? ret : restore_ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_consys_wifi_emi_write);
+
+static ssize_t radio_power_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct mt6797_consys *cs = dev_get_drvdata(dev);
+	bool powered;
+
+	mutex_lock(&cs->lock);
+	powered = cs->powered;
+	mutex_unlock(&cs->lock);
+
+	return sysfs_emit(buf, "%d\n", powered);
+}
+
+static ssize_t radio_power_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct mt6797_consys *cs = dev_get_drvdata(dev);
+	bool on;
+	int ret;
+
+	ret = kstrtobool(buf, &on);
+	if (ret)
+		return ret;
+
+	mutex_lock(&cs->lock);
+	if (on)
+		ret = consys_power_on_locked(cs);
+	else
+		ret = consys_power_off_locked(cs);
+	mutex_unlock(&cs->lock);
+
+	return ret ? ret : count;
+}
