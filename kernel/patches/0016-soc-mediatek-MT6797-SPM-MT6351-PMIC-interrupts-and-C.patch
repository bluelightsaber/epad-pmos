+
+static ssize_t stp_enabled_show(struct device *dev,
+					struct device_attribute *attr, char *buf)
+{
+	struct mt6797_consys *cs = dev_get_drvdata(dev);
+	bool enabled;
+
+	mutex_lock(&cs->lock);
+	enabled = cs->stp_enabled;
+	mutex_unlock(&cs->lock);
+	return sysfs_emit(buf, "%d\n", enabled);
+}
+
+static ssize_t last_error_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct mt6797_consys *cs = dev_get_drvdata(dev);
+	int error;
+
+	mutex_lock(&cs->lock);
+	error = cs->last_error;
+	mutex_unlock(&cs->lock);
+
+	return sysfs_emit(buf, "%d\n", error);
+}
+
+static ssize_t emi_show(struct device *dev, struct device_attribute *attr,
+			char *buf)
+{
+	struct mt6797_consys *cs = dev_get_drvdata(dev);
+	phys_addr_t base, size;
+
+	mutex_lock(&cs->lock);
+	base = cs->emi_base;
+	size = cs->emi_size;
+	mutex_unlock(&cs->lock);
+
+	if (!size)
+		return sysfs_emit(buf, "none\n");
+	return sysfs_emit(buf, "base=0x%pa size=0x%pa wifi=0x%x\n",
+			  &base, &size, MT6797_CONSYS_WIFI_EMI_SIZE);
+}
+
+/* "power" is the device PM directory when CONFIG_PM is enabled. */
+static DEVICE_ATTR_RW(radio_power);
+static DEVICE_ATTR_RO(chipid);
+static DEVICE_ATTR_RO(state);
+static DEVICE_ATTR_RO(stp_mode);
+static DEVICE_ATTR_RO(stp_enabled);
+static DEVICE_ATTR_RO(last_error);
+static DEVICE_ATTR_RO(emi);
+
+static struct attribute *consys_attrs[] = {
+	&dev_attr_radio_power.attr,
+	&dev_attr_chipid.attr,
+	&dev_attr_state.attr,
+	&dev_attr_stp_mode.attr,
+	&dev_attr_stp_enabled.attr,
+	&dev_attr_last_error.attr,
+	&dev_attr_emi.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(consys);
+
+static int mt6797_consys_probe(struct platform_device *pdev)
+{
+	struct mt6797_consys *cs;
+	struct resource *r;
+	struct resource emi;
+	int ret;
+	int i;
+
+	cs = devm_kzalloc(&pdev->dev, sizeof(*cs), GFP_KERNEL);
+	if (!cs)
+		return -ENOMEM;
+
+	cs->dev = &pdev->dev;
+	mutex_init(&cs->lock);
+	/*
+	 * Every window here is (partly) owned by another driver: the RGU by
+	 * the watchdog, TOPCKGEN by the clock driver.  Map them shared
+	 * (devm_ioremap, no request_mem_region) and touch only the ConSys
+	 * registers defined above.
+	 */
+	for (i = 0; i < ARRAY_SIZE(cs->base); i++) {
+		r = platform_get_resource(pdev, IORESOURCE_MEM, i);
+		if (!r)
+			return -ENODEV;
+		cs->base[i] = devm_ioremap(&pdev->dev, r->start, resource_size(r));
+		if (!cs->base[i])
+			return -ENOMEM;
+	}
+	cs->mcu = cs->base[0];
+	cs->rgu = cs->base[1];
+	cs->topckgen = cs->base[2];
+	cs->spm = cs->base[3];
+
+	/*
+	 * The vendor MT6797 layout reserves a 2 MiB, 2 MiB-aligned region for
+	 * ConSys.  Wi-Fi uses its first 512 KiB; later offsets belong to ConSys
+	 * diagnostics/GPS. Remap/MPU setup and clearing happen at power-on before
+	 * MCU reset release; firmware retains that mapping until power-off.
+	 */
+	ret = of_reserved_mem_region_to_resource(pdev->dev.of_node, 0, &emi);
+	if (!ret) {
+		if (!IS_ALIGNED(emi.start, MT6797_CONSYS_EMI_REGION_SIZE) ||
+		    resource_size(&emi) < MT6797_CONSYS_EMI_REGION_SIZE)
+			return dev_err_probe(&pdev->dev, -EINVAL,
+					     "invalid ConSys EMI reservation %pa/%pa\n",
+					     &emi.start, &emi.end);
+		cs->emi_base = emi.start;
+		cs->emi_size = resource_size(&emi);
+		cs->emi_io = devm_ioremap(&pdev->dev, cs->emi_base,
+					  MT6797_CONSYS_EMI_REGION_SIZE);
+		if (!cs->emi_io)
+			return dev_err_probe(&pdev->dev, -ENOMEM,
+					     "failed to map ConSys EMI reservation\n");
+		dev_info(&pdev->dev,
+			 "ConSys EMI reservation base=%pa size=%pa (Wi-Fi=%x)\n",
+			 &cs->emi_base, &cs->emi_size, MT6797_CONSYS_WIFI_EMI_SIZE);
+	} else if (ret != -ENOENT && ret != -ENODEV) {
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to resolve ConSys EMI reservation\n");
+	} else {
+		dev_warn(&pdev->dev,
+			 "no ConSys EMI reservation; WLAN firmware cannot start\n");
+	}
+
+	cs->vcn18 = devm_regulator_get_exclusive(&pdev->dev, "vcn18");
+	if (IS_ERR(cs->vcn18))
+		return dev_err_probe(&pdev->dev, PTR_ERR(cs->vcn18),
+				     "vcn18 supply missing\n");
+	cs->vcn28 = devm_regulator_get_exclusive(&pdev->dev, "vcn28");
+	if (IS_ERR(cs->vcn28))
+		return dev_err_probe(&pdev->dev, PTR_ERR(cs->vcn28),
+				     "vcn28 supply missing\n");
+	cs->vcn33_bt = devm_regulator_get_exclusive(&pdev->dev, "vcn33-bt");
+	if (IS_ERR(cs->vcn33_bt))
+		return dev_err_probe(&pdev->dev, PTR_ERR(cs->vcn33_bt),
+				     "vcn33-bt supply missing\n");
+	cs->vcn33_wifi = devm_regulator_get_exclusive(&pdev->dev, "vcn33-wifi");
+	if (IS_ERR(cs->vcn33_wifi))
+		return dev_err_probe(&pdev->dev, PTR_ERR(cs->vcn33_wifi),
+				     "vcn33-wifi supply missing\n");
+
+	platform_set_drvdata(pdev, cs);
+	ret = device_add_groups(&pdev->dev, consys_groups);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to create sysfs attributes\n");
+
+	dev_info(&pdev->dev, "MT6797 ConSys bring-up driver probed\n");
+	return 0;
+}
+
+static void mt6797_consys_remove(struct platform_device *pdev)
+{
+	struct mt6797_consys *cs = platform_get_drvdata(pdev);
+
+	device_remove_groups(&pdev->dev, consys_groups);
+	mutex_lock(&cs->lock);
+	consys_power_off_locked(cs);
+	mutex_unlock(&cs->lock);
+}
+
+static const struct of_device_id mt6797_consys_of_match[] = {
+	{ .compatible = "mediatek,mt6797-consys" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, mt6797_consys_of_match);
+
+static struct platform_driver mt6797_consys_driver = {
+	.probe = mt6797_consys_probe,
+	.remove = mt6797_consys_remove,
+	.driver = {
+		.name = "mt6797-consys",
+		.of_match_table = mt6797_consys_of_match,
+	},
+};
+module_platform_driver(mt6797_consys_driver);
+
+MODULE_DESCRIPTION("MT6797 ConSys power/bring-up driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6797-spm.c b/drivers/soc/mediatek/mt6797-spm.c
new file mode 100644
index 000000000..d9585ed0d
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-spm.c
@@ -0,0 +1,1462 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SPM (System Power Manager) del MT6797 en la E-PAD: suspensión a RAM con el firmware PCM de fábrica.
+ *
+ * Port de spm_v2 del kernel 3.18 (mt_spm.c, mt_spm_internal.c, mt_spm_sleep.c, mt_spm_pmic_wrap.c): el SPM
+ * ejecuta un programa (PCM) que, cuando todas las CPU están en WFI, duerme el sistema y lo despierta con sus
+ * fuentes de despertar (temporizador propio, EINT, teclado...). PSCI de este ATF es v0.2, sin SYSTEM_SUSPEND.
+ *
+ * Primera fase: firmware pcm_suspend.bin con la CPU en WFI (sin apagar CPU ni infra) y sin los modos de bajo
+ * consumo del PMIC (spm_pmic_power_mode).
+ */
+#include <asm/sysreg.h>
+#include <linux/cpu_pm.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/platform_device.h>
+#include <linux/psci.h>
+#include <linux/regmap.h>
+#include <linux/suspend.h>
+
+#define SPM_PROJECT_CODE		0xb16
+#define SPM_REGWR_CFG_KEY		(SPM_PROJECT_CODE << 16)
+
+#define POWERON_CONFIG_EN		0x000
+#define SPM_POWER_ON_VAL0		0x004
+#define SPM_POWER_ON_VAL1		0x008
+#define SPM_CLK_CON			0x00c
+#define SPM_CLK_SETTLE			0x010
+#define SPM_AP_STANDBY_CON		0x014
+#define PCM_CON0			0x018
+#define PCM_CON1			0x01c
+#define PCM_IM_PTR			0x020
+#define PCM_IM_LEN			0x024
+#define PCM_REG_DATA_INI		0x028
+#define PCM_PWR_IO_EN			0x02c
+#define PCM_TIMER_VAL			0x030
+#define PCM_WDT_VAL			0x034
+#define PCM_EVENT_VECTOR(n)		(0x040 + 4 * (n))
+#define SPM_SW_INT_CLEAR		0x094
+#define SPM_CPU_WAKEUP_EVENT		0x0b0
+#define SPM_IRQ_MASK			0x0b4
+#define SPM_SRC_REQ			0x0b8
+#define SPM_SRC_MASK			0x0bc
+#define SPM_SRC2_MASK			0x0c0
+#define SPM_WAKEUP_EVENT_MASK		0x0c4
+#define PCM_REG13_DATA			0x134
+#define PCM_REG0_DATA			0x100
+#define PCM_REG1_DATA			0x104
+#define PCM_REG6_DATA			0x118
+#define PCM_REG15_DATA			0x13c
+#define PCM_REG12_EXT_DATA		0x144
+#define SPM_IRQ_STA			0x158
+#define SPM_WAKEUP_STA			0x15c
+#define SPM_WAKEUP_EXT_STA		0x160
+#define SUBSYS_IDLE_STA			0x170
+#define PCM_FSM_STA			0x17c
+#define LITTLE_CLK_CON			0x2c4
+#define SPM_MAS_PAUSE_MASK_B		0x408
+#define SPM_MAS_PAUSE2_MASK_B		0x40c
+#define SPM_BSI_D0_SR			0x41c
+#define SPM_BSI_D1_SR			0x420
+#define SPM_BSI_D2_SR			0x424
+#define MP0_CPU0_WFI_EN			0x540	/* MP0 0x540..0x54c, MP1 0x550..0x55c, MP2 0x560/0x564 */
+#define SPM_SW_FLAG			0x600
+#define SPM_SW_DEBUG			0x604
+#define SPM_SW_RSV_0			0x608
+#define SPM_DVFS_CON			0x400
+#define SPM_SW_RSV_4			0x618
+#define SPM_SW_RSV_5			0x61c
+#define DDRPHY_SHUFFLE			0x63c
+
+/* PCM_CON0 */
+#define PCM_KICK_L			BIT(0)
+#define IM_KICK_L			BIT(1)
+#define PCM_CK_EN			BIT(2)
+#define EN_IM_SLEEP_DVS			BIT(3)
+#define PCM_SW_RESET			BIT(15)
+/* PCM_CON1 */
+#define IM_SLAVE			BIT(0)
+#define MIF_APBEN			BIT(3)
+#define PCM_TIMER_EN			BIT(5)
+#define IM_NONRP_EN			BIT(6)
+#define PCM_WDT_EN			BIT(8)
+#define PCM_WDT_WAKE_MODE		BIT(9)
+#define SPM_SRAM_SLEEP_B		BIT(10)
+#define SPM_SRAM_ISOINT_B		BIT(11)
+#define EVENT_LOCK_EN			BIT(12)
+#define SCP_APB_INTERNAL_EN		BIT(14)
+/* SPM_CLK_CON */
+#define CC_SYSCLK1_EN_0			BIT(2)
+#define CC_SYSCLK1_EN_1			BIT(3)
+#define SYS_SETTLE_SEL			BIT(4)
+#define SPM_LOCK_INFRA_DCM		BIT(5)
+#define CC_SRCLKENA_MASK_0		BIT(6)
+#define CLKSQ1_SEL_CTRL			BIT(12)
+#define SYSCLK0_SRC_MASK_B		BIT(16)
+#define CC_SYSCLK1_SRC_MASK_B_MD2	BIT(27)
+/* SPM_AP_STANDBY_CON */
+#define SRCCLKENI_MASK_B		BIT(23)
+/* PCM_PWR_IO_EN */
+#define PCM_PWRIO_EN_R0			BIT(0)
+#define PCM_PWRIO_EN_R7			BIT(7)
+#define PCM_RF_SYNC_R0			BIT(16)
+#define PCM_RF_SYNC_R7			BIT(23)
+/* SPM_IRQ_MASK / SPM_IRQ_STA */
+#define ISRM_TWAM			BIT(2)
+#define ISRM_RET_IRQ_AUX		GENMASK(17, 9)
+#define ISRM_ALL			(ISRM_RET_IRQ_AUX | ISRM_TWAM)
+#define ISRS_TWAM			BIT(2)
+#define ISRS_PCM_RETURN			BIT(3)
+#define PCM_SW_INT_ALL			GENMASK(9, 0)
+
+#define PCM_FSM_STA_DEF			0x00048490
+#define POWER_ON_VAL1_DEF		0x00015820
+#define SPM_WAKEUP_EVENT_MASK_DEF	0xf0f83ebb
+#define PCM_WDT_TIMEOUT			(30 * 32768)
+#define PCM_TIMER_MAX			(0xffffffff - PCM_WDT_TIMEOUT)
+#define SPM_SYSCLK_SETTLE		99	/* 3 ms */
+
+/* sleep_def_mt6797.h */
+#define SPM_FLAG_DIS_CPU_PDN		BIT(0)
+#define SPM_FLAG_DIS_INFRA_PDN		BIT(1)
+#define SPM_FLAG_DIS_VCORE_DVS		BIT(3)
+#define SPM_FLAG_RUN_COMMON_SCENARIO	BIT(10)
+#define SPM_FLAG_DIS_VCORE_DFS		BIT(4)
+#define SPM_FLAG_DIS_DPD		BIT(5)
+#define SPM_FLAG_DIS_SYSRAM_SLEEP	BIT(16)
+#define SPM_FLAG_EN_HPM_SODI		BIT(17)
+#define SPM_FLAG_EN_SEGMENT_E2		BIT(18)
+
+/* pcm_def_mt6797.h: WAKE_SRC_FOR_SUSPEND */
+#define WAKE_SRC_PCM_TIMER		BIT(0)
+#define WAKE_SRC_FOR_SUSPEND		(BIT(0) | BIT(2) | BIT(5) | BIT(6) | BIT(7) | BIT(8) | BIT(10) | BIT(14) | \
+					 BIT(15) | BIT(16) | BIT(17) | BIT(18) | BIT(24) | BIT(25) | BIT(26) | \
+					 BIT(27))
+
+/* MCUCFG: ACINACTM de cada clúster mientras la CPU espera en WFI (spm_trigger_wfi_for_sleep) */
+#define MP0_AXI_CONFIG			0x002c
+#define MP1_AXI_CONFIG			0x022c
+#define MP2_AXI_CONFIG			0x220c
+#define ACINACTM			BIT(4)
+
+/* PMIC wrapper: comandos que el PCM manda al PMIC por el canal DVFS (mt_spm_pmic_wrap.c) */
+#define PWRAP_DVFS_ADR(n)		(0x10c + 8 * (n))
+#define PWRAP_DVFS_WDATA(n)		(0x110 + 8 * (n))
+#define MT6351_TOP_CON			0x0204
+#define MT6351_VCORE_ANA_CON7		0x045c
+#define MT6351_BUCK_VCORE_CON5		0x060a	/* VOSEL_ON */
+#define MT6351_BUCK_VSRAM_PROC_CON4	0x06a8
+#define VCORE_VAL(uv)			DIV_ROUND_UP((uv) - 600000, 6250)
+
+/* TOPRGU: que el WDT del PCM reinicie el sistema (wd_spmwdt_mode_config(WD_REQ_EN, WD_REQ_RST_MODE)) */
+#define WDT_REQ_MODE			0x30
+#define WDT_REQ_IRQ_EN			0x34
+#define WDT_REQ_MODE_KEY		0x33000000
+#define WDT_REQ_IRQ_KEY			0x44000000
+#define WDT_REQ_SPM_SCPSYS		BIT(1)
+
+#define PCM_BUF_SIZE			0x4000
+
+struct mt6797_pcm {
+	u32 pa;
+	u16 size;	/* palabras */
+	u8 sess;
+	u8 replace;
+	u32 vec[16];
+	char version[32];
+};
+
+struct mt6797_spm {
+	struct device *dev;
+	void __iomem *base;
+	void __iomem *pwrap;
+	void __iomem *mcucfg;
+	void __iomem *toprgu;
+	void __iomem *ddrphy;
+	struct regmap *pmic;
+	void *buf;
+	phys_addr_t buf_pa;
+	struct mt6797_pcm suspend, vcorefs;
+	unsigned int wake_sec;
+	u32 last_r12;
+};
+
+static struct mt6797_spm *spm;
+static unsigned int irq_count;
+static u32 irq_isr;
+
+static unsigned int wake_sec = 10;
+module_param(wake_sec, uint, 0644);
+static unsigned int psci_power_state = 0x1010000;
+module_param(psci_power_state, uint, 0644);
+
+static unsigned int flags_set, flags_clear;
+static bool wdt_wake, mark_recovery, pmic_mode = true, safety = true, pcm_wdt = true;
+module_param(pcm_wdt, bool, 0644);
+module_param(safety, bool, 0644);
+static unsigned int wake_src;
+module_param(wake_src, uint, 0644);
+static unsigned int idle_mask, trace_iters, rsv5 = 1, standby_clear, src_mask_clear;
+module_param(standby_clear, uint, 0644);
+module_param(src_mask_clear, uint, 0644);
+module_param(rsv5, uint, 0644);
+module_param(trace_iters, uint, 0644);
+module_param(idle_mask, uint, 0644);
+module_param(pmic_mode, bool, 0644);
+module_param(mark_recovery, bool, 0644);
+module_param(wdt_wake, bool, 0644);
+MODULE_PARM_DESC(wdt_wake, "el WDT del PCM despierta en vez de reiniciar (pruebas)");
+module_param(flags_set, uint, 0644);
+module_param(flags_clear, uint, 0644);
+MODULE_PARM_DESC(flags_set, "SPM_FLAG_* añadidos a los de suspensión (pruebas)");
+
+MODULE_PARM_DESC(wake_sec, "Despertar por el temporizador del SPM tras N segundos (0: solo otras fuentes)");
+
+static inline u32 spm_rd(u32 off)
+{
+	return readl(spm->base + off);
+}
+
+static inline void spm_wr(u32 off, u32 val)
+{
+	writel(val, spm->base + off);
+}
+
+/* pcm_*.bin: u16 tamaño en palabras, el programa, la cola de struct pcm_desc desde «size» y la versión. */
+static int mt6797_spm_load(struct mt6797_spm *s, const char *name, struct mt6797_pcm *pcm, unsigned int off)
+{
+	const struct firmware *fw;
+	const u8 *p;
+	u16 words;
+	int ret;
+
+	ret = request_firmware(&fw, name, s->dev);
+	if (ret)
+		return ret;
+	ret = -EINVAL;
+	if (fw->size < 2)
+		goto out;
+	memcpy(&words, fw->data, 2);
+	if (2 + words * 4 + 72 > fw->size || words * 4 > PCM_BUF_SIZE - off)
+		goto out;
+	memcpy(s->buf + off, fw->data + 2, words * 4);
+	wmb();
+	p = fw->data + 2 + words * 4;
+	memcpy(&pcm->size, p, 2);
+	pcm->sess = p[2];
+	pcm->replace = p[3];
+	memcpy(pcm->vec, p + 8, sizeof(pcm->vec));
+	strscpy(pcm->version, (const char *)p + 72, min_t(size_t, sizeof(pcm->version), fw->size - (p + 72 - fw->data)));
+	pcm->pa = s->buf_pa + off;
+	dev_info(s->dev, "%s: %u palabras, versión %s\n", name, pcm->size, pcm->version);
+	ret = 0;
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+/* spm_register_init() */
+static void mt6797_spm_hw_init(void)
+{
+	u32 shuf, opp;
+	int i;
+
+	spm_wr(POWERON_CONFIG_EN, SPM_REGWR_CFG_KEY | BIT(0));
+	spm_wr(SPM_POWER_ON_VAL1, POWER_ON_VAL1_DEF);
+	spm_wr(PCM_PWR_IO_EN, 0);
+	spm_wr(PCM_CON0, SPM_REGWR_CFG_KEY | PCM_CK_EN | PCM_SW_RESET);
+	spm_wr(PCM_CON0, SPM_REGWR_CFG_KEY | PCM_CK_EN);
+	if ((spm_rd(PCM_FSM_STA) & 0x7fffff) != PCM_FSM_STA_DEF)
+		dev_warn(spm->dev, "PCM no vuelve al estado de reposo: 0x%08x\n", spm_rd(PCM_FSM_STA));
+	spm_wr(PCM_CON0, SPM_REGWR_CFG_KEY | PCM_CK_EN | EN_IM_SLEEP_DVS);
+	spm_wr(PCM_CON1, SPM_REGWR_CFG_KEY | EVENT_LOCK_EN | SPM_SRAM_ISOINT_B | SPM_SRAM_SLEEP_B | MIF_APBEN);
+	spm_wr(PCM_IM_PTR, 0);
+	spm_wr(PCM_IM_LEN, 0);
+	spm_wr(SPM_CLK_CON, spm_rd(SPM_CLK_CON) | CC_SYSCLK1_EN_0 | CC_SYSCLK1_EN_1 | CC_SRCLKENA_MASK_0 |
+	       CLKSQ1_SEL_CTRL | SYSCLK0_SRC_MASK_B | CC_SYSCLK1_SRC_MASK_B_MD2);
+	spm_wr(SPM_WAKEUP_EVENT_MASK, SPM_WAKEUP_EVENT_MASK_DEF);
+	spm_wr(SPM_IRQ_MASK, ISRM_ALL);
+	spm_wr(SPM_IRQ_STA, ISRS_TWAM | ISRS_PCM_RETURN);
+	spm_wr(SPM_SW_INT_CLEAR, PCM_SW_INT_ALL);
+	spm_wr(PCM_REG_DATA_INI, spm_rd(SPM_POWER_ON_VAL1));
+	spm_wr(PCM_PWR_IO_EN, PCM_RF_SYNC_R7);
+	spm_wr(PCM_PWR_IO_EN, 0);
+	spm_wr(LITTLE_CLK_CON, spm_rd(LITTLE_CLK_CON) | 0x1f);
+
+	/* spm_vcorefs_init_dvfs_con(): canal de órdenes SPM→PMIC; el PMIC confirma con el bit 31 */
+	spm_wr(SPM_DVFS_CON, 0);
+	for (i = 0; i < 1000 && !(spm_rd(SPM_DVFS_CON) & BIT(31)); i++)
+		udelay(1);
+	if (!(spm_rd(SPM_DVFS_CON) & BIT(31)))
+		dev_warn(spm->dev, "SPM_DVFS_CON sin confirmación del PMIC: 0x%08x\n", spm_rd(SPM_DVFS_CON));
+
+	/*
+	 * Estado de Vcore/DDR que el firmware espera en SW_RSV_5 ([1:0] y [24:23]; en Android lo mantiene vcorefs)
+	 * según el «shuffle» de la DDR que dejó el preloader (0 = HPM, 1 = LPM, otro = ULPM), y los umbrales de
+	 * ancho de banda de SW_RSV_4 de Android. Sin esto valen 0xffffffff.
+	 */
+	shuf = readl(spm->ddrphy + DDRPHY_SHUFFLE);
+	opp = shuf == 0 ? 3 : shuf == 1 ? 2 : 0;
+	spm_wr(SPM_SW_RSV_5, opp | (opp << 23));
+	spm_wr(SPM_SW_RSV_4, 0x130dffff);
+	dev_info(spm->dev, "DDR shuffle %u: SW_RSV_5 = 0x%08x\n", shuf, spm_rd(SPM_SW_RSV_5));
+}
+
+static bool safe_volt = true;
+module_param(safe_volt, bool, 0644);
+
+/* Tabla PMIC_WRAP_PHASE_SUSPEND (14 comandos, IDX_SP_*) */
+static void mt6797_spm_pwrap_suspend_table(struct mt6797_spm *s)
+{
+	u32 lq = 0, top = 0;
+	struct { u16 addr; u16 data; } t[14];
+	int i;
+
+	regmap_read(s->pmic, MT6351_VCORE_ANA_CON7, &lq);
+	regmap_read(s->pmic, MT6351_TOP_CON, &top);
+	for (i = 0; i <= 6; i++) {	/* VCORE HPM 1,0 V .. LPM 0,9 V */
+		static const u32 uv[] = { 1000000, 983330, 966660, 949990, 933330, 916660, 900000 };
+
+		t[i].addr = MT6351_BUCK_VCORE_CON5;
+		t[i].data = VCORE_VAL(uv[i]);
+	}
+	/*
+	 * SRCCLKEN_IN2 normal/sueño. La tabla de suspensión del BSP pondría el registro entero a 0x8/0x0 (borrando el
+	 * resto de TOP_CON, 0x17b en Android); se conservan los demás bits como hace la de deepidle.
+	 */
+	t[7] = (typeof(t[0])){ MT6351_TOP_CON, (top & 0x37f) | BIT(3) };
+	t[8] = (typeof(t[0])){ MT6351_TOP_CON, (top & 0x37f) & ~BIT(3) };
+	/*
+	 * Deepidle/SODI 0,77 V y VSRAM 1,0 V en el BSP. Si la suspensión se cuelga con esas tensiones puestas, el
+	 * reinicio por watchdog no reinicia el PMIC y el arranque se queda en el logo: `safe_volt` (por defecto) las
+	 * deja en 0,9 V y 1,1 V mientras se depura.
+	 */
+	t[9] = (typeof(t[0])){ MT6351_BUCK_VCORE_CON5, VCORE_VAL(safe_volt ? 900000 : 770000) };
+	t[10] = (typeof(t[0])){ MT6351_BUCK_VSRAM_PROC_CON4, VCORE_VAL(safe_volt ? 1100000 : 1000000) };
+	t[11] = (typeof(t[0])){ MT6351_BUCK_VSRAM_PROC_CON4, VCORE_VAL(1100000) };
+	t[12] = (typeof(t[0])){ MT6351_VCORE_ANA_CON7, lq | BIT(1) };
+	t[13] = (typeof(t[0])){ MT6351_VCORE_ANA_CON7, lq & ~BIT(1) };
+	for (i = 0; i < ARRAY_SIZE(t); i++) {
+		writel(t[i].addr, s->pwrap + PWRAP_DVFS_ADR(i));
+		writel(t[i].data, s->pwrap + PWRAP_DVFS_WDATA(i));
+	}
+	dev_info(s->dev, "TOP_CON 0x%04x VCORE_ANA_CON7 0x%04x\n", top, lq);
+}
+
+/* __spm_reset_and_init_pcm() sin la parte de vcorefs (no hay firmware residente) */
+static int mt6797_spm_reset_pcm(const struct mt6797_pcm *pcm)
+{
+	u32 con1;
+	int i;
+
+	spm_wr(PCM_CON0, SPM_REGWR_CFG_KEY | PCM_CK_EN | PCM_SW_RESET);
+	for (i = 0; (spm_rd(PCM_FSM_STA) & 0x7fffff) != PCM_FSM_STA_DEF; i++) {
+		if (i > 5000)
+			return -ETIMEDOUT;
+		udelay(1);
+	}
+	spm_wr(PCM_CON0, SPM_REGWR_CFG_KEY | PCM_CK_EN);
+	spm_wr(PCM_CON0, SPM_REGWR_CFG_KEY | PCM_CK_EN | EN_IM_SLEEP_DVS);
+	con1 = spm_rd(PCM_CON1) & (PCM_WDT_WAKE_MODE | PCM_WDT_EN);
+	spm_wr(PCM_CON1, con1 | SPM_REGWR_CFG_KEY | EVENT_LOCK_EN | SPM_SRAM_ISOINT_B | SPM_SRAM_SLEEP_B |
+	       (pcm->replace ? 0 : IM_NONRP_EN) | MIF_APBEN | SCP_APB_INTERNAL_EN);
+	return 0;
+}
+
+static void mt6797_spm_kick_im(const struct mt6797_pcm *pcm)
+{
+	u32 con0;
+	int i;
+
+	spm_wr(PCM_IM_PTR, pcm->pa);
+	spm_wr(PCM_IM_LEN, pcm->size - 1);
+	con0 = spm_rd(PCM_CON0) & ~(IM_KICK_L | PCM_KICK_L);
+	spm_wr(PCM_CON0, con0 | SPM_REGWR_CFG_KEY | PCM_CK_EN | IM_KICK_L);
+	spm_wr(PCM_CON0, con0 | SPM_REGWR_CFG_KEY | PCM_CK_EN);
+
+	/* __spm_init_pcm_register() y __spm_init_event_vector() */
+	spm_wr(PCM_REG_DATA_INI, spm_rd(SPM_POWER_ON_VAL0));
+	spm_wr(PCM_PWR_IO_EN, PCM_RF_SYNC_R0);
+	spm_wr(PCM_PWR_IO_EN, 0);
+	spm_wr(PCM_REG_DATA_INI, spm_rd(SPM_POWER_ON_VAL1));
+	spm_wr(PCM_PWR_IO_EN, PCM_RF_SYNC_R7);
+	spm_wr(PCM_PWR_IO_EN, 0);
+	for (i = 0; i < 16; i++)
+		spm_wr(PCM_EVENT_VECTOR(i), pcm->vec[i]);
+}
+
+/* __spm_set_power_control(suspend_ctrl) con los valores de mt_spm_sleep.c ya calculados */
+static void mt6797_spm_power_control(void)
+{
+	int i;
+
+	/* conn_mask_b, md1_req_mask_b, mp3top_idle_mask, wfi_op AND (scp_req_mask_b sin SCP) */
+	spm_wr(SPM_AP_STANDBY_CON, BIT(26) | BIT(19) | BIT(4) | BIT(0) |
+	       (spm_rd(SPM_AP_STANDBY_CON) & SRCCLKENI_MASK_B));
+	spm_wr(SPM_SRC_REQ, BIT(6));	/* spm_dvfs_force_down */
+	spm_wr(SPM_SRC_MASK, BIT(28) | BIT(23) | BIT(21) | BIT(19) | BIT(17) | GENMASK(6, 1));
+	spm_wr(SPM_SRC2_MASK, GENMASK(23, 20) | BIT(16) | 0x1f);
+	spm_wr(SPM_CLK_CON, spm_rd(SPM_CLK_CON) | CC_SRCLKENA_MASK_0);
+	for (i = 0; i < 10; i++)
+		spm_wr(MP0_CPU0_WFI_EN + 4 * i, 1);
+	/* pruebas: no esperar a que MCUSYS/clústeres estén ociosos (bits 1-6 de AP_STANDBY_CON) */
+	spm_wr(SPM_AP_STANDBY_CON, spm_rd(SPM_AP_STANDBY_CON) | (idle_mask & GENMASK(6, 1)));
+	/* pruebas: quitar máscaras de AP_STANDBY_CON (bit 19 md1_req_mask_b, 26 conn_mask_b...) */
+	spm_wr(SPM_AP_STANDBY_CON, spm_rd(SPM_AP_STANDBY_CON) & ~standby_clear);
+	spm_wr(SPM_SRC_MASK, spm_rd(SPM_SRC_MASK) & ~src_mask_clear);
+}
+
+static void mt6797_spm_wakeup_event(u32 timer, u32 wake_src)
+{
+	spm_wr(PCM_TIMER_VAL, timer);
+	spm_wr(PCM_CON1, spm_rd(PCM_CON1) | SPM_REGWR_CFG_KEY | PCM_TIMER_EN);
+	spm_wr(SPM_WAKEUP_EVENT_MASK, ~wake_src);
+	spm_wr(SPM_IRQ_MASK, (spm_rd(SPM_IRQ_MASK) & ISRM_TWAM) | ISRM_RET_IRQ_AUX);
+}
+
+static void mt6797_spm_kick_pcm(u32 flags)
+{
+	u32 con0, con1;
+
+	/* PCM WDT: si el firmware se cuelga, reinicia (30 s más que el temporizador) */
+	con1 = spm_rd(PCM_CON1) & ~(PCM_WDT_WAKE_MODE | PCM_WDT_EN);
+	spm_wr(PCM_CON1, SPM_REGWR_CFG_KEY | con1);
+	if (spm_rd(PCM_TIMER_VAL) > PCM_TIMER_MAX)
+		spm_wr(PCM_TIMER_VAL, PCM_TIMER_MAX);
+	spm_wr(PCM_WDT_VAL, spm_rd(PCM_TIMER_VAL) + (wdt_wake ? 10 * 32768 : PCM_WDT_TIMEOUT));
+	if (pcm_wdt)
+		spm_wr(PCM_CON1, con1 | SPM_REGWR_CFG_KEY | PCM_WDT_EN | (wdt_wake ? PCM_WDT_WAKE_MODE : 0));
+
+	spm_wr(SPM_MAS_PAUSE_MASK_B, 0xffffffff);
+	spm_wr(SPM_MAS_PAUSE2_MASK_B, 0xffffffff);
+	spm_wr(PCM_REG_DATA_INI, 0);
+	spm_wr(SPM_SW_FLAG, flags);
+	spm_wr(SPM_SW_RSV_0, 0);
+	spm_wr(SPM_CLK_CON, spm_rd(SPM_CLK_CON) | SPM_LOCK_INFRA_DCM);
+	spm_wr(PCM_PWR_IO_EN, PCM_PWRIO_EN_R0 | PCM_PWRIO_EN_R7);
+	con0 = spm_rd(PCM_CON0) & ~(IM_KICK_L | PCM_KICK_L);
+	spm_wr(PCM_CON0, con0 | SPM_REGWR_CFG_KEY | PCM_CK_EN | PCM_KICK_L);
+	spm_wr(PCM_CON0, con0 | SPM_REGWR_CFG_KEY | PCM_CK_EN);
+}
+
+static void mt6797_spm_clean_after_wakeup(void)
+{
+	spm_wr(PCM_CON1, SPM_REGWR_CFG_KEY | (spm_rd(PCM_CON1) & ~PCM_WDT_EN));
+	spm_wr(SPM_CPU_WAKEUP_EVENT, 0);
+	spm_wr(SPM_WAKEUP_EVENT_MASK, ~0);
+	spm_wr(SPM_IRQ_MASK, spm_rd(SPM_IRQ_MASK) | ISRM_RET_IRQ_AUX);
+	spm_wr(SPM_IRQ_STA, ISRS_PCM_RETURN);
+	spm_wr(SPM_SW_INT_CLEAR, PCM_SW_INT_ALL);
+}
+
+/*
+ * Firmware vcorefs residente (como Android, que lo tiene corriendo desde el arranque y hace la suspensión con un
+ * relevo desde él). spm_go_to_vcore_dvfs() con el vcore_dvfs_ctrl del BSP y DVFS deshabilitado por flags.
+ * Parámetro `vcorefs` (arranque): cargarlo en el probe y tras cada suspensión.
+ */
+#define SPM_EMI_BW_MODE			0x450
+#define SPM_SW_RSV_1			0x60c
+#define SPM_CLEAN_WAKE_EVENT_DONE	0xa
+#define SPM_OFFLOAD			0xf
+#define VCOREFS_FLAGS			(SPM_FLAG_EN_SEGMENT_E2 | SPM_FLAG_RUN_COMMON_SCENARIO | \
+					 SPM_FLAG_DIS_VCORE_DVS | SPM_FLAG_DIS_VCORE_DFS)
+#define VCOREFS_WAKE_SRC		(BIT(0) | BIT(3) | BIT(10))	/* PCM_TIMER, APWDT, MD32_SPM_IRQ */
+
+static bool vcorefs;
+module_param(vcorefs, bool, 0444);
+MODULE_PARM_DESC(vcorefs, "mantener el firmware vcorefs del SPM corriendo (como Android)");
+
+/* PMIC_WRAP_PHASE_NORMAL (IDX_NM_*): VCORE 1,0 → 0,9 V y modo PWM/auto de VGPU */
+static void mt6797_spm_pwrap_normal_table(struct mt6797_spm *s)
+{
+	static const u32 uv[] = { 1000000, 983330, 966660, 949990, 933330, 916660, 900000, 900000, 900000, 900000 };
+	u32 gpu = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(uv); i++) {
+		writel(MT6351_BUCK_VCORE_CON5, s->pwrap + PWRAP_DVFS_ADR(i));
+		writel(VCORE_VAL(uv[i]), s->pwrap + PWRAP_DVFS_WDATA(i));
+	}
+	regmap_read(s->pmic, 0x0462, &gpu);	/* VGPU_ANA_CON0 */
+	writel(0x0462, s->pwrap + PWRAP_DVFS_ADR(10));
+	writel((gpu & ~0x7) | 6, s->pwrap + PWRAP_DVFS_WDATA(10));
+	writel(0x0462, s->pwrap + PWRAP_DVFS_ADR(11));
+	writel((gpu & ~0x7) | 4, s->pwrap + PWRAP_DVFS_WDATA(11));
+}
+
+static int mt6797_spm_vcorefs_start(struct mt6797_spm *s)
+{
+	int ret, i;
+
+	mt6797_spm_clean_after_wakeup();
+	ret = mt6797_spm_reset_pcm(&s->vcorefs);
+	if (ret)
+		return ret;
+	mt6797_spm_kick_im(&s->vcorefs);
+	/* __spm_set_power_control(vcore_dvfs_ctrl) */
+	spm_wr(SPM_AP_STANDBY_CON, BIT(20) | BIT(19) | (spm_rd(SPM_AP_STANDBY_CON) & SRCCLKENI_MASK_B));
+	spm_wr(SPM_SRC_REQ, BIT(6) | BIT(5));			/* spm_dvfs_force_down, spm_dvfs_req */
+	spm_wr(SPM_SRC_MASK, BIT(28));				/* emi_bw_dvfs_req_mask */
+	spm_wr(SPM_SRC2_MASK, BIT(26) | BIT(8) | 0x07);
+	spm_wr(SPM_CLK_CON, spm_rd(SPM_CLK_CON) & ~CC_SRCLKENA_MASK_0);
+	for (i = 0; i < 10; i++)
+		spm_wr(MP0_CPU0_WFI_EN + 4 * i, 0);
+	mt6797_spm_wakeup_event(PCM_TIMER_MAX, VCOREFS_WAKE_SRC);
+	spm_wr(SPM_EMI_BW_MODE, spm_rd(SPM_EMI_BW_MODE) & ~(BIT(0) | BIT(1)));
+	mt6797_spm_pwrap_normal_table(s);
+	/* __spm_kick_pcm_to_run() sin WDT ni bloqueo de DCM */
+	spm_wr(SPM_MAS_PAUSE_MASK_B, 0xffffffff);
+	spm_wr(SPM_MAS_PAUSE2_MASK_B, 0xffffffff);
+	spm_wr(PCM_REG_DATA_INI, 0);
+	spm_wr(SPM_SW_FLAG, VCOREFS_FLAGS);
+	spm_wr(SPM_SW_RSV_0, 0);
+	spm_wr(SPM_CLK_CON, spm_rd(SPM_CLK_CON) & ~SPM_LOCK_INFRA_DCM);
+	spm_wr(PCM_PWR_IO_EN, PCM_PWRIO_EN_R0 | PCM_PWRIO_EN_R7);
+	i = spm_rd(PCM_CON0) & ~(IM_KICK_L | PCM_KICK_L);
+	spm_wr(PCM_CON0, i | SPM_REGWR_CFG_KEY | PCM_CK_EN | PCM_KICK_L);
+	spm_wr(PCM_CON0, i | SPM_REGWR_CFG_KEY | PCM_CK_EN);
+	udelay(100);
+	dev_info(s->dev, "vcorefs en marcha: r15 0x%x r1 0x%x r6 0x%08x fsm 0x%08x\n", spm_rd(PCM_REG15_DATA),
+		 spm_rd(PCM_REG1_DATA), spm_rd(PCM_REG6_DATA), spm_rd(PCM_FSM_STA));
+	return 0;
+}
+
+/*
+ * __spm_reset_and_init_pcm() con vcorefs corriendo (r1 == 1): pedirle que pare (evento de CPU), copiar r0 a
+ * POWER_ON_VAL0 (control de memoria durante el reset del PCM), soltar r0/r7, parar el temporizador y guardar el
+ * estado de Vcore de r6[24:23] en SW_RSV_5[1:0].
+ */
+static void mt6797_spm_vcorefs_stop(struct mt6797_spm *s)
+{
+	u32 mask;
+	int i;
+
+	if (spm_rd(PCM_REG1_DATA) != 1)
+		dev_info(s->dev, "vcorefs: r1 0x%x r15 0x%x\n", spm_rd(PCM_REG1_DATA), spm_rd(PCM_REG15_DATA));
+	mask = spm_rd(SPM_WAKEUP_EVENT_MASK);
+	spm_wr(SPM_WAKEUP_EVENT_MASK, mask & ~BIT(0));
+	spm_wr(SPM_SW_RSV_1, (spm_rd(SPM_SW_RSV_1) & ~0xf) | SPM_OFFLOAD);
+	spm_wr(SPM_CPU_WAKEUP_EVENT, 1);
+	for (i = 0; i < 2000 && !(spm_rd(SPM_IRQ_STA) & ISRS_PCM_RETURN); i++)
+		udelay(1);
+	spm_wr(SPM_CPU_WAKEUP_EVENT, 0);
+	spm_wr(SPM_WAKEUP_EVENT_MASK, mask);
+	spm_wr(SPM_SW_RSV_1, (spm_rd(SPM_SW_RSV_1) & ~0xf) | SPM_CLEAN_WAKE_EVENT_DONE);
+	if (i >= 2000)
+		dev_warn(s->dev, "vcorefs no vuelve: r15 0x%x fsm 0x%08x\n", spm_rd(PCM_REG15_DATA),
+			 spm_rd(PCM_FSM_STA));
+	spm_wr(SPM_POWER_ON_VAL0, spm_rd(PCM_REG0_DATA));
+	spm_wr(PCM_PWR_IO_EN, 0);
+	spm_wr(PCM_CON1, SPM_REGWR_CFG_KEY | (spm_rd(PCM_CON1) & ~PCM_TIMER_EN));
+	spm_wr(SPM_SW_RSV_5, (spm_rd(SPM_SW_RSV_5) & ~0x3) | ((spm_rd(PCM_REG6_DATA) >> 23) & 0x3));
+	dev_info(s->dev, "vcorefs parado: VAL0 0x%08x RSV_5 0x%08x\n", spm_rd(SPM_POWER_ON_VAL0),
+		 spm_rd(SPM_SW_RSV_5));
+}
+
+/*
+ * Pruebas: despertar con el APXGPT1 (fuente R12_APXGPT1_EVENT_B, bit 4) a 32 kHz en vez del temporizador del PCM.
+ * Mainline no usa el GPT (reloj infra_apxgpt, CG0 bit 6, cortado).
+ */
+static unsigned int gpt_sec;
+module_param(gpt_sec, uint, 0644);
+
+static void __iomem *gpt_base, *gpt_icfg;
+
+static void mt6797_spm_gpt_arm(unsigned int sec)
+{
+	void __iomem *g = gpt_base, *icfg = gpt_icfg;
+
+	if (!g || !icfg)
+		return;
+	writel(0, g + 0x10);				/* GPT1 parado */
+	writel(BIT(0), g + 0x08);			/* ACK */
+	if (sec) {
+		writel(BIT(6), icfg + 0x84);		/* infra_apxgpt sin cortar */
+		writel(BIT(4), g + 0x14);		/* RTC 32 kHz, /1 */
+		writel(sec * 32768, g + 0x1c);		/* CMP */
+		writel(readl(g) | BIT(0), g);		/* IRQ_EN */
+		writel(BIT(1) | BIT(0), g + 0x10);	/* CLEAR | ENABLE, one-shot */
+		pr_info("SPM: GPT1 a %u s (cnt 0x%x)\n", sec, readl(g + 0x18));
+	} else {
+		pr_info("SPM: GPT1 cnt 0x%x irq_sta 0x%x\n", readl(g + 0x18), readl(g + 0x04));
+		writel(readl(g) & ~BIT(0), g);
+	}
+}
+
+/*
+ * Pruebas: mt_irq_mask_all() + mt_irq_unmask_for_sleep() de Android: antes del WFI solo quedan habilitadas en el
+ * GICD la IRQ del SPM (SPI 180) y la del EINT (SPI 170).
+ */
+static bool gic_mask;
+module_param(gic_mask, bool, 0644);
+
+#define GICD_PHYS	0x19000000
+#define GICD_NREG	32
+static u32 gic_saved[GICD_NREG];
+static void __iomem *gicd;
+
+static void mt6797_spm_gic_mask(bool on)
+{
+	static const unsigned int keep[] = { 32 + 180, 32 + 170 };
+	void __iomem *d = gicd;
+	unsigned int n, i;
+
+	if (!d)
+		return;
+	n = min_t(unsigned int, ((readl(d + 4) & 0x1f) + 1), GICD_NREG);
+
+	if (on) {
+		for (i = 1; i < n; i++) {
+			gic_saved[i] = readl(d + 0x100 + 4 * i);
+			writel(~0u, d + 0x180 + 4 * i);
+		}
+		for (i = 0; i < ARRAY_SIZE(keep); i++)
+			writel(BIT(keep[i] % 32), d + 0x100 + 4 * (keep[i] / 32));
+		pr_info("SPM: GIC enmascarado (%u regs), pend 6 0x%08x\n", n, readl(d + 0x200 + 4 * 6));
+	} else {
+		for (i = 1; i < n; i++) {
+			writel(~0u, d + 0x180 + 4 * i);
+			writel(gic_saved[i], d + 0x100 + 4 * i);
+		}
+	}
+}
+
+/*
+ * Con la CPU apagada por el firmware (sin DIS_CPU_PDN), MCUSYS pierde el GIC: guardar y restaurar el distribuidor
+ * y el redistribuidor (frame SGI) de la CPU0, como mt_platform_save_context() de Android.
+ */
+static void __iomem *gicr_sgi;
+static struct {
+	u32 ctlr, grp[GICD_NREG], en[GICD_NREG], mod[GICD_NREG], cfg[2 * GICD_NREG], pri[8 * GICD_NREG];
+	u64 route[32 * GICD_NREG];
+	u32 r_grp, r_en, r_mod, r_cfg[2], r_pri[8];
+} gic_ctx;
+
+static void mt6797_spm_gic_save(void)
+{
+	void __iomem *d = gicd, *r = gicr_sgi;
+	unsigned int n = min_t(unsigned int, ((readl(d + 4) & 0x1f) + 1), GICD_NREG), i;
+
+	gic_ctx.ctlr = readl(d);
+	for (i = 1; i < n; i++) {
+		gic_ctx.grp[i] = readl(d + 0x80 + 4 * i);
+		gic_ctx.en[i] = readl(d + 0x100 + 4 * i);
+		gic_ctx.mod[i] = readl(d + 0xd00 + 4 * i);
+	}
+	for (i = 2; i < 2 * n; i++)
+		gic_ctx.cfg[i] = readl(d + 0xc00 + 4 * i);
+	for (i = 8; i < 8 * n; i++)
+		gic_ctx.pri[i] = readl(d + 0x400 + 4 * i);
+	for (i = 32; i < 32 * n; i++)
+		gic_ctx.route[i] = readq(d + 0x6000 + 8 * i);
+	gic_ctx.r_grp = readl(r + 0x80);
+	gic_ctx.r_en = readl(r + 0x100);
+	gic_ctx.r_mod = readl(r + 0xd00);
+	gic_ctx.r_cfg[0] = readl(r + 0xc00);
+	gic_ctx.r_cfg[1] = readl(r + 0xc04);
+	for (i = 0; i < 8; i++)
+		gic_ctx.r_pri[i] = readl(r + 0x400 + 4 * i);
+}
+
+static void mt6797_spm_gic_restore(void)
+{
+	void __iomem *d = gicd, *r = gicr_sgi;
+	unsigned int n = min_t(unsigned int, ((readl(d + 4) & 0x1f) + 1), GICD_NREG), i;
+	u32 ctlr = readl(d), en = readl(r + 0x100);
+
+	pr_info("SPM: GIC tras despertar: ctlr 0x%x (era 0x%x) isenabler0 0x%x (era 0x%x) en1 0x%x (era 0x%x)\n",
+		ctlr, gic_ctx.ctlr, en, gic_ctx.r_en, readl(d + 0x104), gic_ctx.en[1]);
+	if (ctlr == gic_ctx.ctlr && readl(d + 0x104) == gic_ctx.en[1])
+		return;
+	writel(0, d);
+	for (i = 0; i < 1000 && (readl(d) & BIT(31)); i++)
+		udelay(1);
+	for (i = 1; i < n; i++) {
+		writel(gic_ctx.grp[i], d + 0x80 + 4 * i);
+		writel(gic_ctx.mod[i], d + 0xd00 + 4 * i);
+	}
+	for (i = 2; i < 2 * n; i++)
+		writel(gic_ctx.cfg[i], d + 0xc00 + 4 * i);
+	for (i = 8; i < 8 * n; i++)
+		writel(gic_ctx.pri[i], d + 0x400 + 4 * i);
+	for (i = 32; i < 32 * n; i++)
+		writeq(gic_ctx.route[i], d + 0x6000 + 8 * i);
+	for (i = 1; i < n; i++) {
+		writel(~0u, d + 0x180 + 4 * i);
+		writel(gic_ctx.en[i], d + 0x100 + 4 * i);
+	}
+	writel(gic_ctx.r_grp, r + 0x80);
+	writel(gic_ctx.r_mod, r + 0xd00);
+	writel(gic_ctx.r_cfg[0], r + 0xc00);
+	writel(gic_ctx.r_cfg[1], r + 0xc04);
+	for (i = 0; i < 8; i++)
+		writel(gic_ctx.r_pri[i], r + 0x400 + 4 * i);
+	writel(~0u, r + 0x180);
+	writel(gic_ctx.r_en, r + 0x100);
+	writel(gic_ctx.ctlr, d);
+}
+
+static int mt6797_spm_enter(suspend_state_t state)
+{
+	u32 flags = SPM_FLAG_DIS_VCORE_DFS | SPM_FLAG_DIS_SYSRAM_SLEEP | SPM_FLAG_EN_HPM_SODI | SPM_FLAG_DIS_DPD |
+		    SPM_FLAG_EN_SEGMENT_E2 | SPM_FLAG_DIS_VCORE_DVS;
+	u32 timer = wake_sec ? wake_sec * 32768 : PCM_TIMER_MAX;
+
+	flags = (flags | flags_set) & ~flags_clear;
+	u32 settle, r12, raw, dbg, pc;
+	int ret;
+
+	/* spm_set_sysclk_settle() */
+	spm_wr(SPM_CLK_CON, spm_rd(SPM_CLK_CON) | SYS_SETTLE_SEL);
+	spm_wr(SPM_CLK_SETTLE, 0);
+	settle = spm_rd(SPM_CLK_SETTLE);
+	spm_wr(SPM_CLK_SETTLE, SPM_SYSCLK_SETTLE - settle);
+
+	if (vcorefs)
+		mt6797_spm_vcorefs_stop(spm);
+	ret = mt6797_spm_reset_pcm(&spm->suspend);
+	if (ret) {
+		pr_err("SPM: el PCM no se resetea (0x%08x)\n", spm_rd(PCM_FSM_STA));
+		return ret;
+	}
+	mt6797_spm_kick_im(&spm->suspend);
+	mt6797_spm_power_control();
+	mt6797_spm_wakeup_event(timer, wake_src ? wake_src : WAKE_SRC_FOR_SUSPEND);
+	writel(WDT_REQ_IRQ_KEY | (readl(spm->toprgu + WDT_REQ_IRQ_EN) & ~WDT_REQ_SPM_SCPSYS), spm->toprgu + WDT_REQ_IRQ_EN);
+	if (wdt_wake && safety) {
+		/* red de seguridad: el WDT del TOPRGU (mtk_wdt lo paró al suspender) a 31 s con reinicio */
+		writel((31 << 6 << 5) | 0x8, spm->toprgu + 0x04);
+		writel(0x1971, spm->toprgu + 0x08);
+		writel(0x22000000 | ((readl(spm->toprgu) & ~(BIT(3) | BIT(6))) | BIT(0) | BIT(2)), spm->toprgu);
+	} else if (!wdt_wake && pcm_wdt)
+		writel(WDT_REQ_MODE_KEY | readl(spm->toprgu + WDT_REQ_MODE) | WDT_REQ_SPM_SCPSYS,
+		       spm->toprgu + WDT_REQ_MODE);
+	if (rsv5 != 1)
+		spm_wr(SPM_SW_RSV_5, rsv5);
+	if (gpt_sec)
+		mt6797_spm_gpt_arm(gpt_sec);
+	if (gic_mask)
+		mt6797_spm_gic_mask(true);
+	mt6797_spm_kick_pcm(flags);
+	pr_info("SPM: PCM en marcha: fsm 0x%08x r15 0x%08x im 0x%08x/%u, cpu%d, online %*pbl\n", spm_rd(PCM_FSM_STA),
+		spm_rd(PCM_REG15_DATA), spm_rd(PCM_IM_PTR), spm_rd(PCM_IM_LEN), smp_processor_id(),
+		cpumask_pr_args(cpu_online_mask));
+
+	/* pruebas: traza del PCM antes del WFI (cambios de r15/FSM/SW_DEBUG/IRQ_STA) */
+	if (trace_iters) {
+		static u32 tr[64][5];
+		u32 last[4] = { ~0u, ~0u, ~0u, ~0u };
+		unsigned int it, k = 0;
+
+		for (it = 0; it < trace_iters && k < 64; it++) {
+			u32 v[4] = { spm_rd(PCM_REG15_DATA), spm_rd(PCM_FSM_STA), spm_rd(0x114),
+				     spm_rd(0x134) };	/* r15, FSM, r5, r13 */
+
+			if (memcmp(v, last, 2 * sizeof(u32))) {
+				memcpy(last, v, sizeof(v));
+				memcpy(tr[k], v, sizeof(v));
+				tr[k++][4] = it;
+			}
+		}
+		for (it = 0x100; it < 0x200; it += 32)
+			pr_info("SPM bucle %03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", it, spm_rd(it),
+				spm_rd(it + 4), spm_rd(it + 8), spm_rd(it + 12), spm_rd(it + 16), spm_rd(it + 20),
+				spm_rd(it + 24), spm_rd(it + 28));
+		for (it = 0; it < k; it++)
+			pr_info("SPM traza it %u: pc 0x%03x fsm 0x%08x r5 0x%08x r13 0x%x\n", tr[it][4], tr[it][0],
+				tr[it][1], tr[it][2], tr[it][3]);
+	}
+
+	if (flags & SPM_FLAG_DIS_CPU_PDN) {
+		/* spm_trigger_wfi_for_sleep() sin apagar la CPU */
+		writel(readl(spm->mcucfg + MP0_AXI_CONFIG) | ACINACTM, spm->mcucfg + MP0_AXI_CONFIG);
+		writel(readl(spm->mcucfg + MP1_AXI_CONFIG) | ACINACTM, spm->mcucfg + MP1_AXI_CONFIG);
+		writel(readl(spm->mcucfg + MP2_AXI_CONFIG) | (ACINACTM + 1), spm->mcucfg + MP2_AXI_CONFIG);
+		dsb(sy);
+		wfi();
+		pr_info("SPM: tras WFI: ISR_EL1 0x%llx HPPIR1 %llu r15 0x%x fsm 0x%08x\n", read_sysreg(isr_el1),
+			read_sysreg_s(SYS_ICC_HPPIR1_EL1), spm_rd(PCM_REG15_DATA), spm_rd(PCM_FSM_STA));
+		writel(readl(spm->mcucfg + MP0_AXI_CONFIG) & ~ACINACTM, spm->mcucfg + MP0_AXI_CONFIG);
+		writel(readl(spm->mcucfg + MP1_AXI_CONFIG) & ~ACINACTM, spm->mcucfg + MP1_AXI_CONFIG);
+		writel(readl(spm->mcucfg + MP2_AXI_CONFIG) & ~(ACINACTM + 1), spm->mcucfg + MP2_AXI_CONFIG);
+	} else {
+		/* mt_cpu_dormant(CPU_SHUTDOWN_MODE): cpu_suspend(2) = cluster-sleep del DT de fábrica */
+		cpu_pm_enter();
+		mt6797_spm_gic_save();
+		ret = psci_cpu_suspend_enter(psci_power_state);
+		mt6797_spm_gic_restore();
+		cpu_pm_exit();
+		pr_info("SPM: psci_cpu_suspend_enter: %d\n", ret);
+	}
+
+	if (gic_mask)
+		mt6797_spm_gic_mask(false);
+	if (gpt_sec)
+		mt6797_spm_gpt_arm(0);
+	/* __spm_get_wakeup_status() */
+	pc = spm_rd(PCM_REG_DATA_INI);
+	r12 = spm_rd(SPM_SW_RSV_0);
+	raw = spm_rd(SPM_WAKEUP_STA);
+	dbg = spm_rd(SPM_SW_DEBUG);
+	spm->last_r12 = r12;
+	mt6797_spm_clean_after_wakeup();
+	writel(WDT_REQ_MODE_KEY | (readl(spm->toprgu + WDT_REQ_MODE) & ~WDT_REQ_SPM_SCPSYS), spm->toprgu + WDT_REQ_MODE);
+	pr_info("SPM: despierta r12=0x%08x raw=0x%08x timer_out=%u debug=0x%08x pc=0x%x r13=0x%08x\n", r12, raw,
+		spm_rd(SPM_BSI_D1_SR), dbg, pc, spm_rd(PCM_REG13_DATA));
+	pr_info("SPM: event_reg=0x%08x wake_misc=0x%08x r12_ext=0x%08x raw_ext=0x%08x idle_sta=0x%08x\n",
+		spm_rd(0x424), spm_rd(0x41c), spm_rd(0x144), spm_rd(0x160), spm_rd(0x170));
+	return 0;
+}
+
+/*
+ * Pruebas: marca RTC_PDN1 de «arrancar en recovery» (lk) para que un reinicio por WDT durante la suspensión vuelva
+ * al kernel de pruebas, que vuelca el estado del SPM en el probe.
+ */
+#define MT6351_RTC_BBPU		0x4000
+#define MT6351_RTC_PDN1		0x402c
+#define MT6351_RTC_WRTGR	0x403c
+static void mt6797_spm_rtc_recovery(bool on)
+{
+	u32 v = 0;
+	int i;
+
+	regmap_update_bits(spm->pmic, MT6351_RTC_PDN1, 0x30, on ? 0x10 : 0);
+	regmap_write(spm->pmic, MT6351_RTC_WRTGR, 1);
+	for (i = 0; i < 100; i++) {
+		regmap_read(spm->pmic, MT6351_RTC_BBPU, &v);
+		if (!(v & BIT(6)))
+			break;
+		udelay(100);
+	}
+	regmap_read(spm->pmic, MT6351_RTC_PDN1, &v);
+	pr_info("SPM: RTC_PDN1 = 0x%04x\n", v);
+}
