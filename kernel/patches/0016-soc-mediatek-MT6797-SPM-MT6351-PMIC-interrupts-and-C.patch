+#define MT6351_BUCK_VCORE_CON4		0x0608	/* VOSEL (control por software) */
+
+static void mt6797_spm_pmic_init_setting(struct regmap *m)
+{
+	u32 vosel = 0, xo = 0, a04 = 0;
+	int i;
+
+	/* VCORE pasa a control por hardware (VOSEL_ON): misma tensión que la actual */
+	regmap_read(m, MT6351_BUCK_VCORE_CON4, &vosel);
+	regmap_update_bits(m, MT6351_BUCK_VCORE_CON5, 0x7f, vosel & 0x7f);
+	for (i = 0; i < ARRAY_SIZE(mt6351_init_setting); i++)
+		regmap_update_bits(m, mt6351_init_setting[i].addr,
+				   mt6351_init_setting[i].mask << mt6351_init_setting[i].shift,
+				   mt6351_init_setting[i].val << mt6351_init_setting[i].shift);
+	/* PMIC_MD_INIT_SETTING_V1: detección de cristal de 32 kHz y LDO del TCXO (0xa04) bajo control de SRCLKEN */
+	regmap_update_bits(m, 0x701e, BIT(0), BIT(0));
+	regmap_update_bits(m, 0x701e, 0xf << 1, 0x3 << 1);
+	regmap_read(m, 0x7000, &xo);
+	regmap_update_bits(m, 0x701e, BIT(0), 0);
+	regmap_update_bits(m, 0xa04, BIT(3), BIT(3));
+	if (xo & 0x200) {
+		regmap_update_bits(m, 0xa04, 0x7 << 11, 0);		/* VCTCXO en el MT6176: srclken_0 */
+	} else {
+		regmap_update_bits(m, 0xa04, BIT(4), BIT(4));
+		regmap_update_bits(m, 0xa04, 0x7 << 11, 0x1 << 11);	/* srclken_1 */
+	}
+	regmap_read(m, 0xa04, &a04);
+	pr_info("SPM: PMIC 0x7000 = 0x%04x, 0xa04 = 0x%04x\n", xo, a04);
+	pr_info("SPM: PMIC_INIT_SETTING_V1 aplicado (%zu escrituras, VCORE VOSEL_ON 0x%02x)\n",
+		ARRAY_SIZE(mt6351_init_setting), vosel & 0x7f);
+}
+
+/*
+ * spm_suspend_pre_process()/post_process() del BSP: modo de energía del PMIC para la suspensión
+ * (spm_pmic_power_mode(PMIC_PWR_SUSPEND)): Vcore de sueño 0,6 V y bucks/LDO que siguen a SRCLKEN0 con su modo de
+ * sueño; «power good» forzado y bajo Iq de VGPU mientras duerme.
+ */
+#define MT6351_STRUP_CON4		0x0008	/* bit 15: STRUP_DIG_IO_PG_FORCE */
+#define MT6351_STRUP_CON6		0x000c	/* bit 9: RG_STRUP_VIO18_PG_ENB */
+#define MT6351_VGPU_ANA_CON7		0x0470
+#define MT6351_BUCK_VCORE_CON0		0x0600
+#define MT6351_BUCK_VCORE_CON6		0x060c	/* VOSEL_SLEEP [6:0] */
+#define MT6351_BUCK_VGPU_CON0		0x0614
+#define MT6351_BUCK_VS1_CON0		0x0664
+#define MT6351_BUCK_VS2_CON0		0x0678
+#define MT6351_LDO_VA18_CON0		0x0a00
+#define MT6351_LDO_VUSB33_CON0		0x0a16
+#define MT6351_LDO_VIO28_CON0		0x0a34
+#define MT6351_LDO_VIO18_CON0		0x0a4c
+#define MT6351_LDO_VA10_CON0		0x0a6e
+#define MT6351_LDO_VLDO28_CON0		0x0a9c
+
+/* spm_pmic_set_buck(addr, en_ctrl 0, en 1, vsleep_en 1, vosel_sel SRCLKEN0) */
+static void mt6797_spm_pmic_buck_sleep(struct regmap *m, u32 con0)
+{
+	regmap_update_bits(m, con0, BIT(0), 0);
+	regmap_update_bits(m, con0 + 0x4, BIT(0), BIT(0));
+	regmap_update_bits(m, con0 + 0x12, BIT(8), BIT(8));
+	regmap_update_bits(m, con0 + 0x2, 0x7 << 3, 0);
+}
+
+/* spm_pmic_set_ldo(addr, on_ctrl 0, en 1, mode_ctrl 1, srclk_mode_sel SRCLKEN0) */
+static void mt6797_spm_pmic_ldo_sleep(struct regmap *m, u32 con0)
+{
+	regmap_update_bits(m, con0, BIT(3) | BIT(1) | BIT(2) | (0x7 << 5), BIT(1) | BIT(2));
+}
+
+static void mt6797_spm_pmic_suspend(struct regmap *m, bool enter)
+{
+	static const u32 bucks[] = { MT6351_BUCK_VCORE_CON0, MT6351_BUCK_VS1_CON0, MT6351_BUCK_VS2_CON0,
+				     MT6351_BUCK_VGPU_CON0 };
+	static const u32 ldos[] = { MT6351_LDO_VUSB33_CON0, MT6351_LDO_VIO28_CON0, MT6351_LDO_VLDO28_CON0,
+				    MT6351_LDO_VIO18_CON0, MT6351_LDO_VA18_CON0, MT6351_LDO_VA10_CON0 };
+	int i;
+
+	regmap_update_bits(m, MT6351_VGPU_ANA_CON7, BIT(1), enter ? BIT(1) : 0);
+	regmap_update_bits(m, MT6351_STRUP_CON4, BIT(15), enter ? BIT(15) : 0);
+	regmap_update_bits(m, MT6351_STRUP_CON6, BIT(9), enter ? BIT(9) : 0);
+	if (!enter || !pmic_mode)
+		return;
+	regmap_update_bits(m, MT6351_BUCK_VCORE_CON6, 0x7f, 0);	/* VCORE_VOSEL_SLEEP_0P6 */
+	for (i = 0; i < ARRAY_SIZE(bucks); i++)
+		mt6797_spm_pmic_buck_sleep(m, bucks[i]);
+	for (i = 0; i < ARRAY_SIZE(ldos); i++)
+		mt6797_spm_pmic_ldo_sleep(m, ldos[i]);
+	regmap_write(m, MT6351_LDO_VA10_CON0, 0x020e);
+}
+
+/* regmap del PMIC: antes de syscore_suspend (pwrap usa ktime_get en sus esperas) */
+static int mt6797_spm_prepare(void)
+{
+	mt6797_spm_pmic_suspend(spm->pmic, true);
+	mt6797_spm_pwrap_suspend_table(spm);
+	if (mark_recovery)
+		mt6797_spm_rtc_recovery(true);
+	return 0;
+}
+
+static void mt6797_spm_finish(void)
+{
+	if (vcorefs)
+		mt6797_spm_vcorefs_start(spm);
+	mt6797_spm_pmic_suspend(spm->pmic, false);
+	if (mark_recovery)
+		mt6797_spm_rtc_recovery(false);
+}
+
+static int mt6797_spm_valid(suspend_state_t state)
+{
+	return state == PM_SUSPEND_MEM;
+}
+
+static const struct platform_suspend_ops mt6797_spm_suspend_ops = {
+	.valid = mt6797_spm_valid,
+	.prepare = mt6797_spm_prepare,
+	.finish = mt6797_spm_finish,
+	.enter = mt6797_spm_enter,
+};
+
+static irqreturn_t mt6797_spm_irq(int irq, void *data)
+{
+	u32 isr = spm_rd(SPM_IRQ_STA);
+
+	irq_count++;
+	irq_isr |= isr;
+
+	spm_wr(SPM_IRQ_MASK, spm_rd(SPM_IRQ_MASK) | ISRM_RET_IRQ_AUX);
+	spm_wr(SPM_IRQ_STA, isr);
+	spm_wr(SPM_SW_INT_CLEAR, BIT(0));
+	return IRQ_HANDLED;
+}
+
+static ssize_t last_wakeup_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "0x%08x\n", spm->last_r12);
+}
+static DEVICE_ATTR_RO(last_wakeup);
+
+
+/* Prueba del camino de la IRQ del SPM: dispara PCM_SW_INT0 y cuenta las IRQ recibidas. */
+static ssize_t test_irq_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	u32 mask = spm_rd(SPM_IRQ_MASK);
+
+	spm_wr(SPM_IRQ_MASK, mask & ~(BIT(8) | ISRS_PCM_RETURN));	/* RET_IRQ0 sin enmascarar */
+	spm_wr(0x090, BIT(0));					/* SPM_SW_INT_SET */
+	mdelay(10);
+	spm_wr(SPM_IRQ_MASK, mask);
+	return sysfs_emit(buf, "irqs %u sta 0x%08x\n", irq_count, spm_rd(SPM_IRQ_STA));
+}
+static DEVICE_ATTR_RO(test_irq);
+
+/*
+ * Prueba del firmware sin dormir la CPU0: el PCM solo espera el WFI de las CPU de la máscara escrita (bit n =
+ * CPU n) y la CPU0 registra los cambios de PC (r15), FSM, SW_DEBUG, r6 e IRQ_STA hasta que el PCM vuelve o pasan
+ * wake_sec + 3 s. Sin WDT de reinicio.
+ */
+#define TEST_MAX 200
+static unsigned int test_iters = 20000000;
+module_param(test_iters, uint, 0644);
+static bool test_live, test_cpu_wake;
+module_param(test_cpu_wake, bool, 0644);
+module_param(test_live, bool, 0644);
+/* test_psci: la CPU0 entra en PSCI (apagado por el firmware) mientras la CPU que escribe vigila el PCM */
+static unsigned int test_psci;	/* 1: con el PCM; 2: solo PSCI, sin tocar el SPM */
+module_param(test_psci, uint, 0644);
+static volatile int test_psci_ret = 1000;
+
+static void mt6797_spm_test_psci_fn(void *unused)
+{
+	int ret;
+
+	cpu_pm_enter();
+	ret = psci_cpu_suspend_enter(psci_power_state);
+	cpu_pm_exit();
+	test_psci_ret = ret;
+}
+
+static ssize_t test_pcm_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t n)
+{
+	u32 flags = SPM_FLAG_DIS_VCORE_DFS | SPM_FLAG_DIS_SYSRAM_SLEEP | SPM_FLAG_EN_HPM_SODI | SPM_FLAG_DIS_DPD |
+		    SPM_FLAG_EN_SEGMENT_E2 | SPM_FLAG_DIS_VCORE_DVS;
+	static u32 tr[TEST_MAX][6];
+	u32 mask, cur[5], settle, irqs0 = irq_count;
+	unsigned int it, ret_it = 0;
+	int i, k = 0, ret;
+
+	if (kstrtou32(buf, 0, &mask))
+		return -EINVAL;
+	if (test_psci && raw_smp_processor_id() == 0)
+		return -EAGAIN;
+	if (test_psci == 2) {
+		unsigned int it2;
+		u32 last = ~0u;
+
+		test_psci_ret = 1000;
+		smp_call_function_single(0, mt6797_spm_test_psci_fn, NULL, 0);
+		for (it2 = 0; it2 < test_iters && test_psci_ret == 1000; it2++)
+			if (spm_rd(0x188) != last) {
+				last = spm_rd(0x188);
+				if (it2 < 1000000)
+					pr_info("SPM psci it %u: cpupwr 0x%08x\n", it2, last);
+			}
+		pr_info("SPM psci: ret %d tras %u iter\n", test_psci_ret, it2);
+		return n;
+	}
+	flags = (flags | flags_set) & ~flags_clear;
+	mt6797_spm_pwrap_suspend_table(spm);
+	spm_wr(SPM_CLK_CON, spm_rd(SPM_CLK_CON) | SYS_SETTLE_SEL);
+	spm_wr(SPM_CLK_SETTLE, 0);
+	settle = spm_rd(SPM_CLK_SETTLE);
+	spm_wr(SPM_CLK_SETTLE, SPM_SYSCLK_SETTLE - settle);
+	ret = mt6797_spm_reset_pcm(&spm->suspend);
+	if (ret)
+		return ret;
+	mt6797_spm_kick_im(&spm->suspend);
+	mt6797_spm_power_control();
+	for (i = 0; i < 10; i++)
+		spm_wr(MP0_CPU0_WFI_EN + 4 * i, !!(mask & BIT(i)));
+	/* sin esperar a que los clústeres/MCUSYS estén ociosos (la CPU0 sigue en marcha) */
+	spm_wr(SPM_AP_STANDBY_CON, spm_rd(SPM_AP_STANDBY_CON) | GENMASK(6, 1));
+	mt6797_spm_wakeup_event(wake_sec * 32768, wake_src ? wake_src : WAKE_SRC_FOR_SUSPEND);
+	if (safety) {
+		/* red de seguridad: WDT del TOPRGU a 31 s con reinicio (en caliente: conserva el pstore) */
+		writel((31 << 6 << 5) | 0x8, spm->toprgu + 0x04);
+		writel(0x1971, spm->toprgu + 0x08);
+		writel(0x22000000 | ((readl(spm->toprgu) & ~(BIT(3) | BIT(6))) | BIT(0) | BIT(2)), spm->toprgu);
+	}
+	mt6797_spm_kick_pcm(flags);
+	test_psci_ret = 1000;
+	if (test_psci && smp_processor_id() != 0) {
+		pr_info("SPM test: CPU0 a PSCI 0x%x desde la CPU%d\n", psci_power_state, smp_processor_id());
+		smp_call_function_single(0, mt6797_spm_test_psci_fn, NULL, 0);
+	}
+	if (!wdt_wake)
+		spm_wr(PCM_CON1, SPM_REGWR_CFG_KEY | (spm_rd(PCM_CON1) & ~PCM_WDT_EN));
+
+	/* sin jiffies ni udelay: si el firmware apaga el 26 MHz el temporizador de la CPU se para */
+	memset(cur, 0xff, sizeof(cur));
+	for (it = 0, irq_isr = 0; it < test_iters; it++) {
+		if (!ret_it && (irq_isr & ISRS_PCM_RETURN))
+			ret_it = it;
+		if (test_cpu_wake && it == test_iters / 2) {
+			pr_info("SPM test: SPM_CPU_WAKEUP_EVENT = 1\n");
+			spm_wr(SPM_CPU_WAKEUP_EVENT, 1);
+		}
+		u32 v[5] = { spm_rd(PCM_REG15_DATA), spm_rd(PCM_FSM_STA), spm_rd(SPM_SW_DEBUG), spm_rd(SPM_WAKEUP_STA),
+			     spm_rd(0x150) };	/* r15, FSM, r12, WAKEUP_STA, PCM_TIMER_OUT */
+
+		if (!(it & 0x3ffff) && test_live)
+			pr_info("SPM vivo it %u: pc 0x%03x r12 0x%08x wake_sta 0x%08x timer_out 0x%x con1 0x%x\n", it, v[0], v[2],
+				v[3], v[4], spm_rd(PCM_CON1));
+		if (memcmp(v, cur, 4 * sizeof(u32)) && k < TEST_MAX) {
+			memcpy(cur, v, sizeof(v));
+			memcpy(tr[k], v, sizeof(v));
+			tr[k++][5] = it;
+			if (test_live)
+				pr_info("SPM vivo it %u: pc 0x%03x fsm 0x%08x dbg 0x%08x cpupwr 0x%08x ret %d\n", it, v[0], v[1],
+					v[2], v[3], (int)v[4]);
+		}
+	}
+	pr_info("SPM test: vuelve en it %u (wake_sec %u)\n", ret_it, wake_sec);
+	pr_info("SPM test: %u iter, mask 0x%x flags 0x%08x irqs %u->%u isr 0x%x timer_out %u r12 0x%08x wake_sta 0x%08x\n", it, mask, flags,
+		irqs0, irq_count, irq_isr, spm_rd(0x150), spm_rd(SPM_SW_RSV_0), spm_rd(SPM_WAKEUP_STA));
+	for (i = 0; i < k; i++)
+		pr_info("SPM test it %8u: pc 0x%03x fsm 0x%08x dbg 0x%08x r6 0x%08x irq 0x%08x\n", tr[i][5], tr[i][0],
+			tr[i][1], tr[i][2], tr[i][3], tr[i][4]);
+	spm_wr(SPM_CPU_WAKEUP_EVENT, 0);
+	for (i = 0; i < 0x700; i += i == 0x1e0 ? 0x420 : 32)
+		pr_info("SPM reg %03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", i, spm_rd(i), spm_rd(i + 4),
+			spm_rd(i + 8), spm_rd(i + 12), spm_rd(i + 16), spm_rd(i + 20), spm_rd(i + 24), spm_rd(i + 28));
+	mt6797_spm_clean_after_wakeup();
+	return n;
+}
+static DEVICE_ATTR_WO(test_pcm);
+
+static int mt6797_spm_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np;
+	struct platform_device *pw;
+	struct reserved_mem *rmem;
+	struct mt6797_spm *s;
+	int irq, ret, i;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->dev = dev;
+	/* SPM, PMIC wrapper, MCUCFG y TOPRGU ya tienen dueño (scpsys, pwrap, SMP, watchdog): sin reservar las regiones */
+	s->base = devm_ioremap(dev, platform_get_resource(pdev, IORESOURCE_MEM, 0)->start, 0x1000);
+	s->pwrap = devm_ioremap(dev, platform_get_resource(pdev, IORESOURCE_MEM, 1)->start, 0x1000);
+	s->mcucfg = devm_ioremap(dev, platform_get_resource(pdev, IORESOURCE_MEM, 2)->start, 0x3000);
+	s->toprgu = devm_ioremap(dev, platform_get_resource(pdev, IORESOURCE_MEM, 3)->start, 0x100);
+	s->ddrphy = devm_ioremap(dev, platform_get_resource(pdev, IORESOURCE_MEM, 4)->start, 0x1000);
+	if (!s->base || !s->pwrap || !s->mcucfg || !s->toprgu || !s->ddrphy)
+		return -ENOMEM;
+
+	np = of_parse_phandle(dev->of_node, "mediatek,pwrap", 0);
+	pw = np ? of_find_device_by_node(np) : NULL;
+	of_node_put(np);
+	if (!pw)
+		return -EPROBE_DEFER;
+	s->pmic = dev_get_regmap(&pw->dev, NULL);
+	put_device(&pw->dev);
+	if (!s->pmic)
+		return -EPROBE_DEFER;
+
+	np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	rmem = np ? of_reserved_mem_lookup(np) : NULL;
+	of_node_put(np);
+	if (!rmem || rmem->size < PCM_BUF_SIZE)
+		return dev_err_probe(dev, -EINVAL, "sin memoria reservada para el PCM\n");
+	s->buf_pa = rmem->base;
+	s->buf = devm_memremap(dev, rmem->base, PCM_BUF_SIZE, MEMREMAP_WC);
+	if (IS_ERR(s->buf))
+		return PTR_ERR(s->buf);
+
+	ret = mt6797_spm_load(s, "mediatek/mt6797/pcm_suspend.bin", &s->suspend, 0);
+	if (ret)
+		return dev_err_probe(dev, ret, "pcm_suspend.bin\n");
+	if (vcorefs) {
+		ret = mt6797_spm_load(s, "mediatek/mt6797/pcm_vcorefs_lpm.bin", &s->vcorefs, 0x2000);
+		if (ret)
+			return dev_err_probe(dev, ret, "pcm_vcorefs_lpm.bin\n");
+	}
+
+	spm = s;
+	gicd = devm_ioremap(dev, GICD_PHYS, 0x10000);
+	gicr_sgi = devm_ioremap(dev, 0x19210000, 0x1000);
+	gpt_base = devm_ioremap(dev, 0x10008000, 0x100);
+	gpt_icfg = devm_ioremap(dev, 0x10001000, 0x100);
+	if (pmic_init)
+		mt6797_spm_pmic_init_setting(s->pmic);
+	/* estado que dejó el arranque anterior (si un WDT cortó una suspensión de prueba) */
+	for (i = 0x100; i < 0x200; i += 32)
+		dev_info(dev, "previo %03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", i, spm_rd(i), spm_rd(i + 4),
+			 spm_rd(i + 8), spm_rd(i + 12), spm_rd(i + 16), spm_rd(i + 20), spm_rd(i + 24), spm_rd(i + 28));
+	dev_info(dev, "previo 600: %08x %08x %08x %08x %08x %08x %08x %08x\n", spm_rd(0x600), spm_rd(0x604),
+		 spm_rd(0x608), spm_rd(0x60c), spm_rd(0x610), spm_rd(0x614), spm_rd(0x618), spm_rd(0x61c));
+	mt6797_spm_hw_init();
+	if (vcorefs)
+		mt6797_spm_vcorefs_start(s);
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	ret = devm_request_irq(dev, irq, mt6797_spm_irq, IRQF_NO_SUSPEND, "mt6797-spm", s);
+	if (ret)
+		return ret;
+	enable_irq_wake(irq);
+
+	device_create_file(dev, &dev_attr_last_wakeup);
+	device_create_file(dev, &dev_attr_test_irq);
+	device_create_file(dev, &dev_attr_test_pcm);
+	suspend_set_ops(&mt6797_spm_suspend_ops);
+	dev_info(dev, "suspensión con el SPM lista (firmware en 0x%llx)\n", (u64)s->buf_pa);
+	return 0;
+}
+
+static const struct of_device_id mt6797_spm_of_match[] = {
+	{ .compatible = "mediatek,mt6797-spm" },
+	{ }
+};
+
+static struct platform_driver mt6797_spm_driver = {
+	.driver = {
+		.name = "mt6797-spm",
+		.of_match_table = mt6797_spm_of_match,
+		.suppress_bind_attrs = true,
+	},
+	.probe = mt6797_spm_probe,
+};
+builtin_platform_driver(mt6797_spm_driver);
diff --git a/drivers/soc/mediatek/mt6797-stp-diag.c b/drivers/soc/mediatek/mt6797-stp-diag.c
new file mode 100644
index 000000000..868961350
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-stp-diag.c
@@ -0,0 +1,635 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// MT6797 STP/WMT diagnostic client.
+//
+// This is an explicit, root-only bring-up hook.  It never powers ConSys by
+// itself and never creates a tty or HCI device.  The operator powers ConSys
+// through its existing sysfs control, then requests one bounded WMT query or
+// the vendor BTIF-full preamble.  A ConSys reservation prevents a concurrent
+// power-off from invalidating the BTIF MMIO transaction.
+
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/unaligned.h>
+
+#include <linux/mt6797-consys.h>
+#include <linux/mt6797-stp-session.h>
+#include <linux/mt6797-wlan-hif.h>
+#include <linux/mt6797-wmt.h>
+
+#define MT6797_STP_DIAG_TIMEOUT_MS	1000
+#define MT6797_STP_DIAG_RESPONSE_MAX	32
+#define MT6797_WMT_OPCODE_FUNC_CTRL	0x06
+#define MT6797_WLAN_WCIR_CHIP_ID	0x0279
+
+enum mt6797_stp_diag_mode {
+	MT6797_STP_DIAG_QUERY,
+	MT6797_STP_DIAG_FULL,
+	MT6797_STP_DIAG_VERSION,
+	MT6797_STP_DIAG_PATCH,
+	MT6797_STP_DIAG_INIT,
+	MT6797_STP_DIAG_EMI_TEST,
+	MT6797_STP_DIAG_BT_ON,
+	MT6797_STP_DIAG_BT_OFF,
+	MT6797_STP_DIAG_WIFI_ON,
+	MT6797_STP_DIAG_WIFI_OFF,
+	MT6797_STP_DIAG_WIFI_HIF,
+};
+
+struct mt6797_stp_diag {
+	struct device *dev;
+	struct device *consys_dev;
+	struct mutex lock;
+	struct mt6797_wmt_config config;
+	struct mt6797_wmt_calibration calibration;
+	u8 response[MT6797_STP_DIAG_RESPONSE_MAX];
+	u16 response_length;
+	int last_result;
+	bool busy;
+};
+
+static void mt6797_stp_diag_rx(void *context, u8 task, const u8 *payload,
+				       u16 length)
+{
+	struct mt6797_stp_diag *diag = context;
+
+	dev_dbg(diag->dev, "STP RX task=%u length=%u\n", task, length);
+}
+
+static int mt6797_stp_diag_query(struct mt6797_stp_diag *diag,
+				 struct mt6797_stp_session *session)
+{
+	static const u8 params[] = { 0x04 };
+	static const u8 expected[] = { 0x00, 0x04, 0x11, 0x00, 0x00, 0x00 };
+	u16 response_length = 0;
+	int ret;
+
+	ret = mt6797_stp_session_wmt(session, 0x04, params, sizeof(params),
+					 diag->response, &response_length,
+					 sizeof(diag->response),
+					 msecs_to_jiffies(MT6797_STP_DIAG_TIMEOUT_MS));
+	diag->response_length = response_length;
+	if (ret)
+		return ret;
+	if (response_length != sizeof(expected) ||
+	    memcmp(diag->response, expected, sizeof(expected)))
+		return -EPROTO;
+	return 0;
+}
+
+static int mt6797_stp_diag_query_full(struct mt6797_stp_diag *diag,
+				      struct mt6797_stp_session *session)
+{
+	static const u8 params[] = { 0x04 };
+	static const u8 expected[] = {
+		0x00, 0x04, 0xdf, 0x0e, 0x68, 0x01,
+	};
+	u16 response_length = 0;
+	int ret;
+
+	/* This query deliberately runs after the mode switch, using full STP. */
+	ret = mt6797_stp_session_wmt(session, 0x04, params, sizeof(params),
+				     diag->response, &response_length,
+				     sizeof(diag->response),
+				     msecs_to_jiffies(MT6797_STP_DIAG_TIMEOUT_MS));
+	diag->response_length = response_length;
+	if (ret)
+		return ret;
+	if (response_length != sizeof(expected) ||
+	    memcmp(diag->response, expected, sizeof(expected)))
+		return -EPROTO;
+	return 0;
+}
+
+static int mt6797_stp_diag_function(struct mt6797_stp_diag *diag,
+				    struct mt6797_stp_session *session,
+				    u8 function, bool enabled)
+{
+	const u8 params[] = { function, enabled ? 1 : 0 };
+	u8 response[MT6797_STP_DIAG_RESPONSE_MAX];
+	u16 response_length = 0;
+	int ret;
+
+	/* WMT_FUNC_CTRL event carries exactly one status byte. */
+	ret = mt6797_stp_session_wmt(session, MT6797_WMT_OPCODE_FUNC_CTRL,
+				     params, ARRAY_SIZE(params), response,
+				     &response_length, sizeof(response),
+				     msecs_to_jiffies(MT6797_STP_DIAG_TIMEOUT_MS));
+	diag->response_length = response_length;
+	if (ret)
+		return ret;
+	if (response_length != 1 || response[0])
+		return -EPROTO;
+	dev_info(diag->dev, "WMT function %u %s acknowledged\n", function,
+		 enabled ? "on" : "off");
+	return 0;
+}
+
+static int mt6797_stp_diag_run(struct mt6797_stp_diag *diag,
+				       enum mt6797_stp_diag_mode mode)
+{
+	static const struct mt6797_stp_session_ops session_ops = {
+		.rx_frame = mt6797_stp_diag_rx,
+	};
+	struct mt6797_stp_host_ops host_ops = { };
+	struct mt6797_stp_session *session;
+	void *host_context = NULL;
+	int ret;
+	int release_ret;
+	u8 function = 0;
+	bool function_enabled = false;
+	bool function_powered = false;
+	bool function_power_changed = false;
+	bool function_on_ack = false;
+	bool hif_claimed = false;
+
+	if (mode == MT6797_STP_DIAG_INIT)
+		ret = mt6797_consys_stp_open(diag->consys_dev, &host_ops,
+					   &host_context);
+	else
+		ret = mt6797_consys_stp_acquire(diag->consys_dev, &host_ops,
+					      &host_context);
+	if (ret)
+		return ret;
+	if (mode == MT6797_STP_DIAG_EMI_TEST) {
+		ret = mt6797_consys_emi_patch_begin(host_context);
+		if (!ret)
+			ret = mt6797_consys_emi_patch_end(host_context);
+		goto out_release;
+	}
+
+	session = mt6797_stp_session_alloc(diag->dev, &session_ops, diag);
+	if (!session) {
+		ret = -ENOMEM;
+		goto out_release;
+	}
+	ret = mt6797_stp_session_set_host_ops(session, &host_ops, host_context);
+	if (ret)
+		goto out_free;
+	ret = mt6797_stp_session_start(session, true);
+	if (ret)
+		goto out_free;
+	ret = mt6797_stp_session_wake(session);
+	if (ret)
+		goto out_stop;
+
+	if (mode == MT6797_STP_DIAG_INIT) {
+		ret = mt6797_wmt_bootstrap(diag->dev, session, host_context,
+					   &diag->config, &diag->calibration);
+	} else if (mode == MT6797_STP_DIAG_BT_ON || mode == MT6797_STP_DIAG_BT_OFF ||
+	    mode == MT6797_STP_DIAG_WIFI_ON || mode == MT6797_STP_DIAG_WIFI_OFF ||
+	    mode == MT6797_STP_DIAG_WIFI_HIF) {
+		function = (mode == MT6797_STP_DIAG_BT_ON ||
+			    mode == MT6797_STP_DIAG_BT_OFF) ?
+			   MT6797_CONSYS_FUNC_BT : MT6797_CONSYS_FUNC_WIFI;
+		function_enabled = mode == MT6797_STP_DIAG_BT_ON ||
+				 mode == MT6797_STP_DIAG_WIFI_ON ||
+				 mode == MT6797_STP_DIAG_WIFI_HIF;
+		ret = mt6797_stp_session_configure_btif_full(
+			session, msecs_to_jiffies(MT6797_STP_DIAG_TIMEOUT_MS));
+		if (!ret && function_enabled) {
+			ret = mt6797_consys_radio_power(host_context, function, true,
+							&function_power_changed);
+			function_powered = !ret && function_power_changed;
+		}
+		if (!ret)
+			ret = mt6797_stp_diag_function(diag, session, function,
+						function_enabled);
+		function_on_ack = !ret && function_enabled;
+		if (!ret && mode == MT6797_STP_DIAG_WIFI_HIF) {
+			u32 wcir;
+
+			/* Function-on is the ownership hand-off.  The HIF driver does
+			 * not power the radio or infer this state itself. */
+			ret = mt6797_wlan_hif_claim(diag->dev);
+			if (!ret)
+				hif_claimed = true;
+			if (!ret)
+				ret = mt6797_wlan_hif_wcir_read(diag->dev, &wcir);
+			if (!ret) {
+				put_unaligned_le32(wcir, diag->response);
+				diag->response_length = sizeof(wcir);
+				if ((wcir & 0xffff) != MT6797_WLAN_WCIR_CHIP_ID) {
+					dev_err(diag->dev,
+						"WLAN WCIR chip ID 0x%08x != 0x%04x\n",
+						wcir, MT6797_WLAN_WCIR_CHIP_ID);
+					ret = -EPROTO;
+				} else {
+					dev_info(diag->dev,
+						 "WLAN HIF WCIR chip ID 0x%04x confirmed\n",
+						 wcir & 0xffff);
+				}
+			}
+		}
+		if (hif_claimed) {
+			release_ret = mt6797_wlan_hif_release(diag->dev);
+			hif_claimed = false;
+			if (!ret && release_ret)
+				ret = release_ret;
+		}
+		if (mode == MT6797_STP_DIAG_WIFI_HIF && function_on_ack) {
+			int off_ret;
+
+			off_ret = mt6797_stp_diag_function(diag, session, function,
+							false);
+			if (!ret && off_ret)
+				ret = off_ret;
+			if (function_powered) {
+				off_ret = mt6797_consys_radio_power(host_context, function,
+								false, NULL);
+				if (!ret && off_ret)
+					ret = off_ret;
+			}
+		}
+		if (!ret && !function_enabled)
+			ret = mt6797_consys_radio_power(host_context, function, false, NULL);
+		if (ret && function_powered)
+			mt6797_consys_radio_power(host_context, function, false, NULL);
+	} else if (mode == MT6797_STP_DIAG_FULL ||
+		   mode == MT6797_STP_DIAG_VERSION ||
+		   mode == MT6797_STP_DIAG_PATCH) {
+		ret = mt6797_stp_session_configure_btif_full(
+			session, msecs_to_jiffies(MT6797_STP_DIAG_TIMEOUT_MS));
+		if (!ret && mode == MT6797_STP_DIAG_FULL)
+			ret = mt6797_stp_diag_query_full(diag, session);
+		if (!ret && (mode == MT6797_STP_DIAG_VERSION ||
+			     mode == MT6797_STP_DIAG_PATCH)) {
+			u32 hw_version;
+			u32 fw_version;
+
+			ret = mt6797_wmt_read_version(diag->dev, session,
+							   &hw_version, &fw_version);
+			if (!ret && mode == MT6797_STP_DIAG_VERSION) {
+				put_unaligned_le32(hw_version, diag->response);
+				put_unaligned_le32(fw_version, diag->response + 4);
+				diag->response_length = 8;
+			}
+			if (!ret && mode == MT6797_STP_DIAG_PATCH)
+				ret = mt6797_wmt_download_patches(diag->dev, session, host_context, hw_version,
+							    fw_version);
+		}
+	} else {
+		ret = mt6797_stp_session_prepare_btif_mandatory(session);
+		if (ret)
+			goto out_stop;
+		ret = mt6797_stp_diag_query(diag, session);
+	}
+
+out_stop:
+	mt6797_stp_session_stop(session);
+out_free:
+	mt6797_stp_session_free(session);
+out_release:
+	release_ret = mt6797_consys_stp_release(host_context);
+	if (!ret && release_ret)
+		ret = release_ret;
+	return ret;
+}
+
+static ssize_t command_show(struct device *dev, struct device_attribute *attr,
+				    char *buf)
+{
+	return sysfs_emit(buf,
+			  "write 'init' for managed WMT bootstrap, or 'query', 'full', 'version', 'patch', 'emi-test', 'bt-on', 'bt-off', 'wifi-on', 'wifi-off', 'wifi-hif' for a powered test\n");
+}
+
+static ssize_t command_store(struct device *dev, struct device_attribute *attr,
+				     const char *buf, size_t count)
+{
+	struct mt6797_stp_diag *diag = dev_get_drvdata(dev);
+	enum mt6797_stp_diag_mode mode;
+	const char *name;
+	int ret;
+
+	if (sysfs_streq(buf, "query")) {
+		mode = MT6797_STP_DIAG_QUERY;
+		name = "query";
+	} else if (sysfs_streq(buf, "full")) {
+		mode = MT6797_STP_DIAG_FULL;
+		name = "full";
+	} else if (sysfs_streq(buf, "version")) {
+		mode = MT6797_STP_DIAG_VERSION;
+		name = "version";
+	} else if (sysfs_streq(buf, "patch")) {
+		mode = MT6797_STP_DIAG_PATCH;
+		name = "patch";
+	} else if (sysfs_streq(buf, "init")) {
+		mode = MT6797_STP_DIAG_INIT;
+		name = "init";
+	} else if (sysfs_streq(buf, "emi-test")) {
+		mode = MT6797_STP_DIAG_EMI_TEST;
+		name = "emi-test";
+	} else if (sysfs_streq(buf, "bt-on")) {
+		mode = MT6797_STP_DIAG_BT_ON;
+		name = "bt-on";
+	} else if (sysfs_streq(buf, "bt-off")) {
+		mode = MT6797_STP_DIAG_BT_OFF;
+		name = "bt-off";
+	} else if (sysfs_streq(buf, "wifi-on")) {
+		mode = MT6797_STP_DIAG_WIFI_ON;
+		name = "wifi-on";
+	} else if (sysfs_streq(buf, "wifi-off")) {
+		mode = MT6797_STP_DIAG_WIFI_OFF;
+		name = "wifi-off";
+	} else if (sysfs_streq(buf, "wifi-hif")) {
+		mode = MT6797_STP_DIAG_WIFI_HIF;
+		name = "wifi-hif";
+	} else {
+		return -EINVAL;
+	}
+
+	mutex_lock(&diag->lock);
+	if (diag->busy) {
+		mutex_unlock(&diag->lock);
+		return -EBUSY;
+	}
+	diag->busy = true;
+	diag->response_length = 0;
+	ret = mt6797_stp_diag_run(diag, mode);
+	diag->last_result = ret;
+	diag->busy = false;
+	mutex_unlock(&diag->lock);
+
+	dev_info(dev, "STP %s result=%d response_length=%u\n",
+		 name, ret, diag->response_length);
+	return ret ? ret : count;
+}
+
+static ssize_t result_show(struct device *dev, struct device_attribute *attr,
+				   char *buf)
+{
+	struct mt6797_stp_diag *diag = dev_get_drvdata(dev);
+	int result;
+
+	mutex_lock(&diag->lock);
+	result = diag->last_result;
+	mutex_unlock(&diag->lock);
+	return sysfs_emit(buf, "%d\n", result);
+}
+
+static ssize_t response_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct mt6797_stp_diag *diag = dev_get_drvdata(dev);
+	ssize_t written = 0;
+	u16 length;
+	u16 index;
+
+	mutex_lock(&diag->lock);
+	length = diag->response_length;
+	for (index = 0; index < length && written < PAGE_SIZE - 4; index++)
+		written += scnprintf(buf + written, PAGE_SIZE - written,
+				     "%s%02x", index ? " " : "", diag->response[index]);
+	mutex_unlock(&diag->lock);
+	if (written < PAGE_SIZE - 1)
+		buf[written++] = '\n';
+	return written;
+}
+
+static ssize_t busy_show(struct device *dev, struct device_attribute *attr,
+				 char *buf)
+{
+	struct mt6797_stp_diag *diag = dev_get_drvdata(dev);
+	bool busy;
+
+	mutex_lock(&diag->lock);
+	busy = diag->busy;
+	mutex_unlock(&diag->lock);
+	return sysfs_emit(buf, "%d\n", busy);
+}
+
+static DEVICE_ATTR_RW(command);
+static DEVICE_ATTR_RO(result);
+static DEVICE_ATTR_RO(response);
+static DEVICE_ATTR_RO(busy);
+
+static ssize_t calibration_read(struct file *file, struct kobject *kobj,
+				const struct bin_attribute *attr, char *buf,
+				loff_t offset, size_t count)
+{
+	struct mt6797_stp_diag *diag = dev_get_drvdata(kobj_to_dev(kobj));
+	ssize_t length = 0;
+
+	mutex_lock(&diag->lock);
+	if (offset < diag->calibration.length) {
+		length = min_t(size_t, count, diag->calibration.length - offset);
+		memcpy(buf, diag->calibration.data + offset, length);
+	}
+	mutex_unlock(&diag->lock);
+	return length;
+}
+static BIN_ATTR_RO(calibration, MT6797_WMT_CALIBRATION_MAX);
+
+static const struct bin_attribute *mt6797_stp_diag_bin_attrs[] = {
+	&bin_attr_calibration,
+	NULL,
+};
+
+static struct attribute *mt6797_stp_diag_attrs[] = {
+	&dev_attr_command.attr,
+	&dev_attr_result.attr,
+	&dev_attr_response.attr,
+	&dev_attr_busy.attr,
+	NULL,
+};
+static const struct attribute_group mt6797_stp_diag_group = {
+	.attrs = mt6797_stp_diag_attrs,
+	.bin_attrs = mt6797_stp_diag_bin_attrs,
+};
+__ATTRIBUTE_GROUPS(mt6797_stp_diag);
+
+static int mt6797_stp_diag_probe(struct platform_device *pdev)
+{
+	struct mt6797_stp_diag *diag;
+	struct platform_device *consys_pdev;
+	struct device_node *consys_node;
+	int ret;
+
+	consys_node = of_parse_phandle(pdev->dev.of_node, "consys", 0);
+	if (!consys_node)
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "missing consys phandle\n");
+	consys_pdev = of_find_device_by_node(consys_node);
+	of_node_put(consys_node);
+	if (!consys_pdev)
+		return -EPROBE_DEFER;
+	if (!dev_get_drvdata(&consys_pdev->dev)) {
+		put_device(&consys_pdev->dev);
+		return -EPROBE_DEFER;
+	}
+
+	diag = devm_kzalloc(&pdev->dev, sizeof(*diag), GFP_KERNEL);
+	if (!diag) {
+		put_device(&consys_pdev->dev);
+		return -ENOMEM;
+	}
+	diag->dev = &pdev->dev;
+	diag->consys_dev = &consys_pdev->dev;
+	ret = device_property_read_u8(&pdev->dev, "mediatek,antenna-mode",
+				      &diag->config.antenna_mode);
+	if (!ret)
+		ret = device_property_read_u8(&pdev->dev, "mediatek,fm-transport",
+					      &diag->config.fm_transport);
+	if (ret) {
+		put_device(&consys_pdev->dev);
+		return dev_err_probe(&pdev->dev, ret, "missing board WMT configuration\n");
+	}
+	diag->config.co_clock = device_property_read_bool(&pdev->dev,
+							 "mediatek,co-clock");
+	mutex_init(&diag->lock);
+	diag->last_result = -ENODATA;
+	platform_set_drvdata(pdev, diag);
+	ret = device_add_groups(&pdev->dev, mt6797_stp_diag_groups);
+	if (ret) {
+		put_device(&consys_pdev->dev);
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to create diagnostic sysfs\n");
+	}
+	dev_info(&pdev->dev,
+		 "MT6797 STP diagnostic ready; power ConSys before command\n");
+	return 0;
+}
+
+static void mt6797_stp_diag_remove(struct platform_device *pdev)
+{
+	struct mt6797_stp_diag *diag = platform_get_drvdata(pdev);
+
+	device_remove_groups(&pdev->dev, mt6797_stp_diag_groups);
+	if (diag)
+		put_device(diag->consys_dev);
+}
+
+static const struct of_device_id mt6797_stp_diag_of_match[] = {
+	{ .compatible = "mediatek,mt6797-stp-diag" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6797_stp_diag_of_match);
+
+static struct platform_driver mt6797_stp_diag_driver = {
+	.probe = mt6797_stp_diag_probe,
+	.remove = mt6797_stp_diag_remove,
+	.driver = {
+		.name = "mt6797-stp-diag",
+		.of_match_table = mt6797_stp_diag_of_match,
+	},
+};
+
+static DEFINE_MUTEX(mt6797_stp_diag_registration_lock);
+static bool mt6797_stp_diag_registered;
+static bool mt6797_stp_diag_deferred;
+static bool mt6797_stp_diag_enable;
+
+static int mt6797_stp_diag_register(void)
+{
+	int ret = 0;
+
+	mutex_lock(&mt6797_stp_diag_registration_lock);
+	if (!mt6797_stp_diag_registered) {
+		ret = platform_driver_register(&mt6797_stp_diag_driver);
+		if (!ret) {
+			mt6797_stp_diag_registered = true;
+			mt6797_stp_diag_enable = true;
+		}
+	}
+	mutex_unlock(&mt6797_stp_diag_registration_lock);
+	return ret;
+}
+
+static int mt6797_stp_diag_enable_set(const char *val,
+					      const struct kernel_param *kp)
+{
+	bool enable;
+	int ret;
+
+	ret = kstrtobool(val, &enable);
+	if (ret)
+		return ret;
+	if (!enable)
+		return -EINVAL;
+	/*
+	 * The parameter is also present for the ordinary opt-in DT.  In that
+	 * case the late initcall already registered the driver, so accepting a
+	 * redundant write keeps the initramfs hook harmless on a normal image.
+	 * Only the explicitly deferred DT is allowed to register at this point.
+	 */
+	if (!mt6797_stp_diag_deferred) {
+		if (READ_ONCE(mt6797_stp_diag_registered)) {
+			*(bool *)kp->arg = true;
+			return 0;
+		}
+		return -EINVAL;
+	}
+
+	return mt6797_stp_diag_register();
+}
+
+static const struct kernel_param_ops mt6797_stp_diag_enable_ops = {
+	.set = mt6797_stp_diag_enable_set,
+	.get = param_get_bool,
+};
+module_param_cb(enable, &mt6797_stp_diag_enable_ops,
+		&mt6797_stp_diag_enable, 0644);
+MODULE_PARM_DESC(enable,
+		 "register the deferred STP diagnostic platform driver (0/1)");
+
+/*
+ * The driver is an opt-in bring-up hook.  Avoid registering a built-in
+ * platform driver on the ordinary headless DT, where no diagnostic device
+ * exists.  Besides avoiding needless initcall activity, this keeps the
+ * diagnostic object completely dormant until a board DT explicitly opts in.
+ *
+ * When built in, register at late initcall time.  The diagnostic probe only
+ * creates sysfs state and takes a reference to ConSys, but doing that during
+ * the ordinary device/deferred-probe window unnecessarily races storage
+ * bring-up on this board.  A DT node with mediatek,defer-registration delays
+ * the registration until userspace writes the enable parameter after rootfs
+ * is mounted.  A module keeps the normal module-init semantics unless the DT
+ * explicitly requests the same deferred path.
+ */
+static int __init mt6797_stp_diag_init(void)
+{
+	struct device_node *node;
+
+	node = of_find_compatible_node(NULL, NULL, "mediatek,mt6797-stp-diag");
+	if (!node)
+		return 0;
+	mt6797_stp_diag_deferred = of_property_read_bool(node,
+							"mediatek,defer-registration");
+	of_node_put(node);
+	if (mt6797_stp_diag_deferred) {
+		pr_info("MT6797 STP diagnostic registration deferred; write enable=1 after rootfs mount\n");
+		return 0;
+	}
+
+	return mt6797_stp_diag_register();
+}
+#if IS_BUILTIN(CONFIG_MTK_MT6797_STP_DIAG)
+late_initcall(mt6797_stp_diag_init);
+#else
+module_init(mt6797_stp_diag_init);
+#endif
+
+static void __exit mt6797_stp_diag_exit(void)
+{
+	mutex_lock(&mt6797_stp_diag_registration_lock);
+	if (mt6797_stp_diag_registered) {
+		platform_driver_unregister(&mt6797_stp_diag_driver);
+		mt6797_stp_diag_registered = false;
+		mt6797_stp_diag_enable = false;
+	}
+	mutex_unlock(&mt6797_stp_diag_registration_lock);
+}
+module_exit(mt6797_stp_diag_exit);
+
+MODULE_DESCRIPTION("MT6797 bounded STP/WMT bring-up diagnostic");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6797-stp-session.c b/drivers/soc/mediatek/mt6797-stp-session.c
new file mode 100644
index 000000000..7f4700987
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-stp-session.c
@@ -0,0 +1,1013 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// MT6797 reliable full-mode STP/WMT session.
+//
+// This is intentionally a library-style module.  It claims BTIF only when a
+// higher-level ConSys owner explicitly starts a session.  It does not power
+// VCN rails, select an STP mode, or probe the chip by itself.
+
+#include <linux/atomic.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/jiffies.h>
+#include <linux/kfifo.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+#include <linux/mt6797-btif.h>
+#include <linux/mt6797-stp-session.h>
+#include <linux/mt6797-stp.h>
+
+#define MT6797_STP_WINDOW_SIZE		7
+#define MT6797_STP_RETRY_LIMIT		10
+#define MT6797_STP_ACK_TIMEOUT_MS	180
+#define MT6797_STP_RX_FIFO_SIZE		8192
+#define MT6797_STP_RESYNC_SIZE		4
+#define MT6797_STP_WMT_HEADER_SIZE	4
+#define MT6797_STP_FRAME_SIZE		(2 + MT6797_STP_HEADER_SIZE + \
+					 MT6797_STP_MAX_PAYLOAD + MT6797_STP_CRC_SIZE)
+
+struct mt6797_stp_tx_slot {
+	u8 frame[MT6797_STP_FRAME_SIZE];
+	u16 length;
+	bool pending;
+	bool acked;
+};
+
+struct mt6797_stp_session {
+	struct device *owner;
+	struct mt6797_stp_session_ops ops;
+	void *context;
+	struct mt6797_stp_host_ops host_ops;
+	void *host_context;
+	struct mt6797_btif_client_ops btif_ops;
+
+	struct mt6797_stp_decoder decoder;
+	DECLARE_KFIFO(rx_fifo, u8, MT6797_STP_RX_FIFO_SIZE);
+	spinlock_t rx_lock;
+	struct work_struct rx_work;
+
+	/* send_lock serializes synchronous callers; tx_io_lock serializes bytes. */
+	struct mutex send_lock;
+	struct mutex tx_io_lock;
+	struct mutex host_config_lock;
+	spinlock_t state_lock;
+	wait_queue_head_t ack_wait;
+	struct completion response_done;
+
+	struct mt6797_stp_tx_slot slots[8];
+	u8 tx_next;
+	u8 tx_acked;
+	u8 rx_expected;
+	u8 rx_ack;
+	u8 retries;
+	unsigned int outstanding;
+	bool retry_requested;
+	bool active;
+	bool delimiter;
+	bool mandatory;
+	bool host_enabled;
+	int terminal_error;
+
+	bool response_waiting;
+	u8 response_opcode;
+	u8 response[MT6797_STP_MAX_PAYLOAD];
+	u8 wmt_pdu[MT6797_STP_MAX_PAYLOAD];
+	u16 response_length;
+	int response_status;
+};
+
+static atomic_t mt6797_stp_trace_frames = ATOMIC_INIT(0);
+
+static int mt6797_stp_trace_set(const char *value, const struct kernel_param *kp)
+{
+	unsigned int frames;
+	int ret;
+
+	ret = kstrtouint(value, 0, &frames);
+	if (ret)
+		return ret;
+	if (frames > 256)
+		return -ERANGE;
+	atomic_set(&mt6797_stp_trace_frames, frames);
+	return 0;
+}
+
+static int mt6797_stp_trace_get(char *buffer, const struct kernel_param *kp)
+{
+	return sysfs_emit(buffer, "%d\n", atomic_read(&mt6797_stp_trace_frames));
+}
+
+static const struct kernel_param_ops mt6797_stp_trace_ops = {
+	.set = mt6797_stp_trace_set,
+	.get = mt6797_stp_trace_get,
+};
+module_param_cb(trace_frames, &mt6797_stp_trace_ops, NULL, 0600);
+MODULE_PARM_DESC(trace_frames, "Capture 0..256 STP frame metadata records, without payload bytes");
+
+static void mt6797_stp_trace(struct mt6797_stp_session *session, const char *way,
+			     u8 task, u8 seq, u8 ack, bool nak, u16 length)
+{
+	if (atomic_dec_if_positive(&mt6797_stp_trace_frames) < 0)
+		return;
+	dev_info(session->owner,
+		 "STP %s task=%u seq=%u ack=%u nak=%u len=%u want=%u next=%u acked=%u pending=%u err=%d\n",
+		 way, task, seq, ack, nak, length,
+		 READ_ONCE(session->rx_expected), READ_ONCE(session->tx_next),
+		 READ_ONCE(session->tx_acked), READ_ONCE(session->outstanding),
+		 READ_ONCE(session->terminal_error));
+}
+
+static bool mt6797_stp_session_active(struct mt6797_stp_session *session)
+{
+	return READ_ONCE(session->active);
+}
+
+static u8 mt6797_stp_next_seq(u8 sequence)
+{
+	return (sequence + 1) & 7;
+}
+
+static void mt6797_stp_set_error(struct mt6797_stp_session *session, int error)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (!session->terminal_error)
+		session->terminal_error = error;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	wake_up_all(&session->ack_wait);
+	complete_all(&session->response_done);
+}
+
+static void mt6797_stp_btif_rx(void *context, const u8 *data, size_t length)
+{
+	struct mt6797_stp_session *session = context;
+
+	if (!mt6797_stp_session_active(session) || !length)
+		return;
+	if (kfifo_in_spinlocked(&session->rx_fifo, data, length,
+				       &session->rx_lock) != length)
+		mt6797_stp_set_error(session, -ENOBUFS);
+	schedule_work(&session->rx_work);
+}
+
+static bool mt6797_stp_slot_acked(struct mt6797_stp_session *session,
+					  struct mt6797_stp_tx_slot *slot)
+{
+	unsigned long flags;
+	bool done;
+
+	spin_lock_irqsave(&session->state_lock, flags);
+	done = slot->acked || session->terminal_error;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	return done;
+}
+
+static void mt6797_stp_update_frame_ack(struct mt6797_stp_session *session,
+						struct mt6797_stp_tx_slot *slot)
+{
+	u8 *header = slot->frame + (session->delimiter ? 2 : 0);
+
+	header[0] = (header[0] & 0xf8) | session->rx_ack;
+	header[3] = header[0] + header[1] + header[2];
+}
+
+static void mt6797_stp_process_ack(struct mt6797_stp_session *session,
+					   u8 acknowledgement, bool nak)
+{
+	unsigned long flags;
+	u8 sequence;
+	bool found = false;
+
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (nak)
+		session->retry_requested = true;
+	sequence = mt6797_stp_next_seq(session->tx_acked);
+	while (sequence != session->tx_next) {
+		if (sequence == acknowledgement) {
+			found = true;
+			break;
+		}
+		sequence = mt6797_stp_next_seq(sequence);
+	}
+	if (found) {
+		sequence = mt6797_stp_next_seq(session->tx_acked);
+		while (true) {
+			struct mt6797_stp_tx_slot *slot = &session->slots[sequence];
+
+			slot->pending = false;
+			slot->acked = true;
+			if (session->outstanding)
+				session->outstanding--;
+			session->tx_acked = sequence;
+			if (sequence == acknowledgement)
+				break;
+			sequence = mt6797_stp_next_seq(sequence);
+		}
+		session->retries = 0;
+		session->retry_requested = false;
+	}
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	wake_up_all(&session->ack_wait);
+}
+
+static int mt6797_stp_write(struct mt6797_stp_session *session,
+				    const u8 *data, size_t length,
+				    unsigned long timeout)
+{
+	ssize_t written;
+
+	if (!mt6797_stp_session_active(session))
+		return -ESHUTDOWN;
+	mutex_lock(&session->tx_io_lock);
+	written = mt6797_btif_write(session->owner, data, length, timeout);
+	mutex_unlock(&session->tx_io_lock);
+	if (written == length)
+		return 0;
+	if (written < 0)
+		return written;
+	return -EIO;
+}
+
+static int mt6797_stp_send_ack(struct mt6797_stp_session *session, u8 ack,
+				       bool nak)
+{
+	u8 frame[MT6797_STP_HEADER_SIZE + 2];
+	ssize_t length;
+
+	length = mt6797_stp_encode_frame(frame, sizeof(frame), 0, 0, ack, nak,
+					 NULL, 0, session->delimiter);
+	if (length < 0)
+		return length;
+	return mt6797_stp_write(session, frame, length,
+				msecs_to_jiffies(MT6797_STP_ACK_TIMEOUT_MS));
+}
+
+static int mt6797_stp_send_resync(struct mt6797_stp_session *session)
+{
+	static const u8 resync[MT6797_STP_RESYNC_SIZE] = { 0x7f, 0x7f, 0x7f, 0x7f };
+
+	return mt6797_stp_write(session, resync, sizeof(resync),
+				msecs_to_jiffies(MT6797_STP_ACK_TIMEOUT_MS));
+}
+
+static int mt6797_stp_send_pending(struct mt6797_stp_session *session)
+{
+	u8 sequence;
+	int ret;
+
+	spin_lock_irq(&session->state_lock);
+	sequence = mt6797_stp_next_seq(session->tx_acked);
+	while (sequence != session->tx_next) {
+		struct mt6797_stp_tx_slot *slot = &session->slots[sequence];
+		u16 length = slot->length;
+
+		if (slot->pending) {
+			mt6797_stp_update_frame_ack(session, slot);
+			spin_unlock_irq(&session->state_lock);
+			ret = mt6797_stp_write(session, slot->frame, length,
+					msecs_to_jiffies(MT6797_STP_ACK_TIMEOUT_MS));
+			if (ret)
+				return ret;
+			spin_lock_irq(&session->state_lock);
+		}
+		sequence = mt6797_stp_next_seq(sequence);
+	}
+	spin_unlock_irq(&session->state_lock);
+	return 0;
+}
+
+static void mt6797_stp_wmt_event(struct mt6797_stp_session *session,
+					const u8 *payload, u16 length)
+{
+	unsigned long flags;
+	u16 parameter_length;
+	bool complete_response = false;
+
+	if (length < MT6797_STP_WMT_HEADER_SIZE)
+		return;
+	parameter_length = payload[2] | (payload[3] << 8);
+	/*
+	 * The vendor WMT register-read event advertises a four-byte status
+	 * header, but appends the addressed register and value (eight more
+	 * bytes).  wmt_core_rx() consumes that complete 16-byte event.  Keep
+	 * the same bounded exception here so ROM-version reads do not discard
+	 * the value or fail the generic length check.  No other opcode is
+	 * allowed to use this legacy framing.
+	 */
+	if (payload[1] == 0x08 && parameter_length == 4 &&
+	    length == MT6797_STP_WMT_HEADER_SIZE + 12)
+		parameter_length = 12;
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (session->response_waiting && payload[0] == 2 &&
+		payload[1] == session->response_opcode) {
+		if (parameter_length != length - MT6797_STP_WMT_HEADER_SIZE) {
+			session->response_status = -EPROTO;
+		} else if (parameter_length > sizeof(session->response)) {
+			session->response_status = -EMSGSIZE;
+		} else {
+			memcpy(session->response, payload + MT6797_STP_WMT_HEADER_SIZE,
+			       parameter_length);
+			session->response_length = parameter_length;
+			session->response_status = 0;
+		}
+		session->response_waiting = false;
+		complete_response = true;
+	}
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	if (complete_response)
+		complete(&session->response_done);
+}
+
+static int mt6797_stp_frame(struct mt6797_stp_session *session,
+				    const struct mt6797_stp_frame *frame)
+{
+	unsigned long flags;
+	u8 ack;
+	bool in_order;
+
+	mt6797_stp_trace(session, "RX", frame->packet_type, frame->sequence,
+			 frame->acknowledgement, frame->nak, frame->payload_length);
+
+	if (session->mandatory) {
+		/* Mandatory BTIF framing has no sequence/ACK semantics. */
+		if (frame->packet_type == MT6797_STP_TASK_WMT)
+			mt6797_stp_wmt_event(session, frame->payload,
+					     frame->payload_length);
+		if (session->ops.rx_frame)
+			session->ops.rx_frame(session->context, frame->packet_type,
+					      frame->payload, frame->payload_length);
+		return 0;
+	}
+
+	mt6797_stp_process_ack(session, frame->acknowledgement, frame->nak);
+	if (!frame->payload_length && !frame->has_crc)
+		return 0;
+
+	spin_lock_irqsave(&session->state_lock, flags);
+	in_order = frame->sequence == session->rx_expected;
+	ack = session->rx_ack;
+	if (in_order) {
+		session->rx_ack = frame->sequence;
+		session->rx_expected = mt6797_stp_next_seq(frame->sequence);
+		ack = session->rx_ack;
+	}
+	spin_unlock_irqrestore(&session->state_lock, flags);
+
+	if (!in_order) {
+		mt6797_stp_send_ack(session, ack, true);
+		return 0;
+	}
+	/* ACK before handing data to a possibly slow client. */
+	if (mt6797_stp_send_ack(session, ack, false))
+		mt6797_stp_set_error(session, -EIO);
+	if (frame->packet_type == MT6797_STP_TASK_WMT)
+		mt6797_stp_wmt_event(session, frame->payload, frame->payload_length);
+	if (session->ops.rx_frame)
+		session->ops.rx_frame(session->context, frame->packet_type,
+				      frame->payload, frame->payload_length);
+	return 0;
+}
+
+static int mt6797_stp_decoder_frame(void *context,
+					const struct mt6797_stp_frame *frame)
+{
+	return mt6797_stp_frame(context, frame);
+}
+
+static void mt6797_stp_rx_work(struct work_struct *work)
+{
+	struct mt6797_stp_session *session =
+		container_of(work, struct mt6797_stp_session, rx_work);
+	u8 data[256];
+	unsigned int length;
+
+	if (!mt6797_stp_session_active(session))
+		return;
+	while ((length = kfifo_out_spinlocked(&session->rx_fifo, data,
+						      sizeof(data), &session->rx_lock))) {
+		if (mt6797_stp_decoder_feed(&session->decoder, data, length,
+					     mt6797_stp_decoder_frame, session) < 0)
+			mt6797_stp_set_error(session, -EPROTO);
+		if (!mt6797_stp_session_active(session))
+			break;
+	}
+}
+
+static int mt6797_stp_queue_frame(struct mt6797_stp_session *session,
+					  u8 task, const u8 *payload, u16 length,
+					  struct mt6797_stp_tx_slot **queued)
+{
+	struct mt6797_stp_tx_slot *slot;
+	unsigned long flags;
+	ssize_t encoded;
+	u8 sequence;
+
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (!session->active || session->terminal_error) {
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		return session->terminal_error ?: -ESHUTDOWN;
+	}
+	if (session->outstanding >= MT6797_STP_WINDOW_SIZE) {
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		return -EAGAIN;
+	}
+	sequence = session->tx_next;
+	slot = &session->slots[sequence];
+	encoded = mt6797_stp_encode_frame(slot->frame, sizeof(slot->frame), task,
+					 sequence, session->rx_ack, false, payload,
+					 length, session->delimiter);
+	if (encoded < 0) {
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		return encoded;
+	}
+	slot->length = encoded;
+	slot->pending = true;
+	slot->acked = false;
+	session->outstanding++;
+	session->tx_next = mt6797_stp_next_seq(sequence);
+	*queued = slot;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	return 0;
+}
+
+static void mt6797_stp_abort_tx(struct mt6797_stp_session *session)
+{
+	unsigned long flags;
+	unsigned int index;
+
+	spin_lock_irqsave(&session->state_lock, flags);
+	for (index = 0; index < ARRAY_SIZE(session->slots); index++) {
+		session->slots[index].pending = false;
+		session->slots[index].acked = false;
+	}
+	session->outstanding = 0;
+	session->tx_acked = (session->tx_next + 7) & 7;
+	session->retry_requested = false;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+}
+
+static int mt6797_stp_send_locked(struct mt6797_stp_session *session,
+					   u8 task, const u8 *payload, u16 length,
+					   unsigned long timeout)
+{
+	struct mt6797_stp_tx_slot *slot;
+	unsigned long remaining;
+	int ret;
+	unsigned int attempt;
+	u8 *mandatory_frame;
+	ssize_t mandatory_length;
+
+	if (session->mandatory) {
+		mandatory_frame = kmalloc(MT6797_STP_FRAME_SIZE, GFP_KERNEL);
+		if (!mandatory_frame)
+			return -ENOMEM;
+		mandatory_length = mt6797_stp_encode_mandatory_frame(
+			mandatory_frame, MT6797_STP_FRAME_SIZE, task, payload,
+			length, session->delimiter);
+		if (mandatory_length < 0) {
+			kfree(mandatory_frame);
+			return mandatory_length;
+		}
+		ret = mt6797_stp_write(session, mandatory_frame, mandatory_length,
+				       msecs_to_jiffies(MT6797_STP_ACK_TIMEOUT_MS));
+		kfree(mandatory_frame);
+		return ret;
+	}
+
+	ret = mt6797_stp_queue_frame(session, task, payload, length, &slot);
+	if (ret)
+		return ret;
+	mt6797_stp_trace(session, "TX", task, (session->tx_next + 7) & 7,
+			 session->rx_ack, false, length);
+	for (attempt = 0; attempt <= MT6797_STP_RETRY_LIMIT; attempt++) {
+		if (attempt) {
+			ret = mt6797_stp_send_resync(session);
+			if (!ret)
+				ret = mt6797_stp_send_pending(session);
+		} else {
+			ret = mt6797_stp_write(session, slot->frame, slot->length,
+					msecs_to_jiffies(MT6797_STP_ACK_TIMEOUT_MS));
+		}
+		if (ret)
+			break;
+		remaining = wait_event_interruptible_timeout(session->ack_wait,
+					     mt6797_stp_slot_acked(session, slot) ||
+					     READ_ONCE(session->retry_requested),
+					     timeout);
+		if (mt6797_stp_slot_acked(session, slot)) {
+			ret = session->terminal_error;
+			if (!ret)
+				ret = 0;
+			break;
+		}
+		if (remaining < 0) {
+			ret = -ERESTARTSYS;
+			break;
+		}
+		if (!remaining && attempt == MT6797_STP_RETRY_LIMIT) {
+			ret = -ETIMEDOUT;
+			break;
+		}
+		spin_lock_irq(&session->state_lock);
+		session->retry_requested = false;
+		session->retries = attempt + 1;
+		spin_unlock_irq(&session->state_lock);
+	}
+	if (ret)
+		mt6797_stp_abort_tx(session);
+	return ret;
+}
+
+struct mt6797_stp_session *mt6797_stp_session_alloc(
+	struct device *owner, const struct mt6797_stp_session_ops *ops,
+	void *context)
+{
+	struct mt6797_stp_session *session;
+
+	if (!owner)
+		return NULL;
+	session = kzalloc(sizeof(*session), GFP_KERNEL);
+	if (!session)
+		return NULL;
+	session->owner = owner;
+	if (ops)
+		session->ops = *ops;
+	session->context = context;
+	session->btif_ops.rx_bytes = mt6797_stp_btif_rx;
+	INIT_KFIFO(session->rx_fifo);
+	spin_lock_init(&session->rx_lock);
+	spin_lock_init(&session->state_lock);
+	mutex_init(&session->send_lock);
+	mutex_init(&session->tx_io_lock);
+	mutex_init(&session->host_config_lock);
+	init_waitqueue_head(&session->ack_wait);
+	init_completion(&session->response_done);
+	INIT_WORK(&session->rx_work, mt6797_stp_rx_work);
+	mt6797_stp_decoder_init(&session->decoder);
+	session->mandatory = true;
+	mt6797_stp_decoder_set_mandatory(&session->decoder, true);
+	return session;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_alloc);
+
+void mt6797_stp_session_stop(struct mt6797_stp_session *session)
+{
+	unsigned long flags;
+	bool was_active;
+	bool host_enabled;
+	int ret;
+
+	if (!session)
+		return;
+	mutex_lock(&session->host_config_lock);
+	spin_lock_irqsave(&session->state_lock, flags);
+	host_enabled = session->host_enabled;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	if (host_enabled && session->host_ops.set_enabled) {
+		ret = session->host_ops.set_enabled(session->host_context, false);
+		if (ret)
+			dev_warn(session->owner,
+				 "failed to disable host STP before stop: %d\n", ret);
+	}
+	spin_lock_irqsave(&session->state_lock, flags);
+	was_active = session->active;
+	session->active = false;
+	session->host_enabled = false;
+	session->terminal_error = -ESHUTDOWN;
+	session->response_waiting = false;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	mutex_unlock(&session->host_config_lock);
+	wake_up_all(&session->ack_wait);
+	complete_all(&session->response_done);
+	if (was_active)
+		mt6797_btif_release(session->owner);
+	cancel_work_sync(&session->rx_work);
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_stop);
+
+void mt6797_stp_session_free(struct mt6797_stp_session *session)
+{
+	if (!session)
+		return;
+	mt6797_stp_session_stop(session);
+	kfree(session);
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_free);
+
+int mt6797_stp_session_start(struct mt6797_stp_session *session, bool delimiter)
+{
+	unsigned long flags;
+	int ret;
+
+	if (!session)
+		return -EINVAL;
+	mutex_lock(&session->host_config_lock);
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (session->active) {
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		mutex_unlock(&session->host_config_lock);
+		return -EBUSY;
+	}
+	session->delimiter = delimiter;
+	session->terminal_error = 0;
+	session->tx_next = 0;
+	session->tx_acked = 7;
+	session->rx_expected = 0;
+	session->rx_ack = 7;
+	session->retries = 0;
+	session->outstanding = 0;
+	session->retry_requested = false;
+	session->host_enabled = false;
+	memset(session->slots, 0, sizeof(session->slots));
+	spin_lock(&session->rx_lock);
+	kfifo_reset(&session->rx_fifo);
+	spin_unlock(&session->rx_lock);
+	mt6797_stp_decoder_init(&session->decoder);
+	session->mandatory = true;
+	mt6797_stp_decoder_set_mandatory(&session->decoder, true);
+	session->active = true;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	mutex_unlock(&session->host_config_lock);
+	ret = mt6797_btif_claim(session->owner, &session->btif_ops, session);
+	if (ret) {
+		spin_lock_irqsave(&session->state_lock, flags);
+		session->active = false;
+		session->terminal_error = ret;
+		spin_unlock_irqrestore(&session->state_lock, flags);
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_start);
+
+int mt6797_stp_session_wake(struct mt6797_stp_session *session)
+{
+	if (!session || !mt6797_stp_session_active(session))
+		return -ENODEV;
+	return mt6797_btif_wake(session->owner);
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_wake);
+
+int mt6797_stp_session_set_host_ops(struct mt6797_stp_session *session,
+					const struct mt6797_stp_host_ops *ops,
+					void *context)
+{
+	unsigned long flags;
+
+	if (!session || !ops || !ops->set_mode || !ops->set_enabled)
+		return -EINVAL;
+	mutex_lock(&session->host_config_lock);
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (session->active || session->host_enabled) {
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		mutex_unlock(&session->host_config_lock);
+		return -EBUSY;
+	}
+	session->host_ops = *ops;
+	session->host_context = context;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	mutex_unlock(&session->host_config_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_set_host_ops);
+
+int mt6797_stp_session_prepare_btif_mandatory(
+					struct mt6797_stp_session *session)
+{
+	struct mt6797_stp_host_ops host_ops;
+	void *host_context;
+	unsigned long flags;
+	int ret;
+
+	if (!session)
+		return -EINVAL;
+	mutex_lock(&session->host_config_lock);
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (!session->active || session->terminal_error) {
+		ret = session->terminal_error ?: -ESHUTDOWN;
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		goto out_unlock;
+	}
+	host_ops = session->host_ops;
+	host_context = session->host_context;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	if (!host_ops.set_mode || !host_ops.set_enabled) {
+		ret = -EOPNOTSUPP;
+		goto out_unlock;
+	}
+
+	ret = host_ops.set_mode(host_context,
+				MT6797_STP_BTIF_MANDATORY_MODE);
+	if (ret)
+		goto out_unlock;
+	ret = host_ops.set_enabled(host_context, true);
+	if (ret)
+		goto out_unlock;
+	spin_lock_irqsave(&session->state_lock, flags);
+	session->mandatory = true;
+	session->host_enabled = true;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	mt6797_stp_decoder_set_mandatory(&session->decoder, true);
+
+out_unlock:
+	mutex_unlock(&session->host_config_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_prepare_btif_mandatory);
+
+int mt6797_stp_session_send(struct mt6797_stp_session *session, u8 task,
+				    const u8 *payload, u16 length,
+				    unsigned long timeout_jiffies)
+{
+	int ret;
+
+	if (!session || (!payload && length) || !timeout_jiffies)
+		return -EINVAL;
+	mutex_lock(&session->send_lock);
+	ret = mt6797_stp_send_locked(session, task, payload, length,
+					     timeout_jiffies);
+	mutex_unlock(&session->send_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_send);
+
+int mt6797_stp_session_wmt(struct mt6797_stp_session *session, u8 opcode,
+				   const u8 *params, u16 parameter_length,
+				   u8 *response, u16 *response_length,
+				   size_t response_size,
+				   unsigned long timeout_jiffies)
+{
+	unsigned long flags;
+	unsigned long remaining;
+	int ret;
+
+	if (!session || (!params && parameter_length) ||
+	    parameter_length > MT6797_STP_MAX_PAYLOAD - MT6797_STP_WMT_HEADER_SIZE ||
+	    !response_length || (!response && response_size) || !timeout_jiffies)
+		return -EINVAL;
+	mutex_lock(&session->send_lock);
+	session->wmt_pdu[0] = 1;
+	session->wmt_pdu[1] = opcode;
+	session->wmt_pdu[2] = parameter_length & 0xff;
+	session->wmt_pdu[3] = parameter_length >> 8;
+	if (parameter_length)
+		memcpy(session->wmt_pdu + MT6797_STP_WMT_HEADER_SIZE, params,
+		       parameter_length);
+
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (!session->active || session->terminal_error) {
+		ret = session->terminal_error ?: -ESHUTDOWN;
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		goto out_unlock;
+	}
+	reinit_completion(&session->response_done);
+	session->response_opcode = opcode;
+	session->response_length = 0;
+	session->response_status = -ETIMEDOUT;
+	session->response_waiting = true;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+
+	ret = mt6797_stp_send_locked(session, MT6797_STP_TASK_WMT, session->wmt_pdu,
+					     parameter_length + MT6797_STP_WMT_HEADER_SIZE,
+					     timeout_jiffies);
+	if (ret < 0) {
+		spin_lock_irqsave(&session->state_lock, flags);
+		session->response_waiting = false;
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		goto out_unlock;
+	}
+	remaining = wait_for_completion_timeout(&session->response_done,
+					       timeout_jiffies);
+	if (!remaining) {
+		ret = -ETIMEDOUT;
+		spin_lock_irqsave(&session->state_lock, flags);
+		session->response_waiting = false;
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		goto out_unlock;
+	}
+	spin_lock_irqsave(&session->state_lock, flags);
+	ret = session->response_status;
+	if (!ret) {
+		if (response_size < session->response_length) {
+			ret = -ENOSPC;
+		} else if (session->response_length) {
+			memcpy(response, session->response, session->response_length);
+		}
+		if (!ret)
+			*response_length = session->response_length;
+	}
+	spin_unlock_irqrestore(&session->state_lock, flags);
+
+out_unlock:
+	mutex_unlock(&session->send_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_wmt);
+
+int mt6797_stp_session_power(struct mt6797_stp_session *session, u8 action,
+			      unsigned long timeout_jiffies)
+{
+	u8 response[2];
+	u16 length = 0;
+	unsigned long flags, remaining;
+	int ret;
+
+	if (!session || !timeout_jiffies || action < MT6797_STP_POWER_SLEEP ||
+	    action > MT6797_STP_POWER_WAKE)
+		return -EINVAL;
+	if (action != MT6797_STP_POWER_WAKE) {
+		ret = mt6797_stp_session_wmt(session, 3, &action, 1, response,
+					     &length, sizeof(response), timeout_jiffies);
+		if (ret)
+			return ret;
+		return length == 2 && !response[0] && response[1] == action ? 0 : -EPROTO;
+	}
+
+	/* MT6797's BSP uses a BTIF wake edge, not its disabled raw-0xff path.
+	 * Arm the opcode-03 event before the edge, as firmware may answer fast.
+	 */
+	mutex_lock(&session->send_lock);
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (!session->active || session->terminal_error) {
+		ret = session->terminal_error ?: -ESHUTDOWN;
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		goto unlock;
+	}
+	reinit_completion(&session->response_done);
+	session->response_opcode = 3;
+	session->response_length = 0;
+	session->response_status = -ETIMEDOUT;
+	session->response_waiting = true;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	ret = mt6797_btif_wake(session->owner);
+	if (!ret) {
+		remaining = wait_for_completion_timeout(&session->response_done, timeout_jiffies);
+		if (!remaining)
+			ret = -ETIMEDOUT;
+	}
+	spin_lock_irqsave(&session->state_lock, flags);
+	session->response_waiting = false;
+	if (!ret)
+		ret = session->terminal_error ?: session->response_status;
+	if (!ret && (session->response_length != 2 || session->response[0] ||
+		     session->response[1] != MT6797_STP_POWER_WAKE))
+		ret = -EPROTO;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+unlock:
+	mutex_unlock(&session->send_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_power);
+
+int mt6797_stp_session_idle(struct mt6797_stp_session *session, bool idle)
+{
+	int ret;
+
+	if (!session)
+		return -EINVAL;
+	/* Serialize gating with the RX worker's final sleep-response ACK. */
+	mutex_lock(&session->tx_io_lock);
+	ret = mt6797_btif_idle(session->owner, idle);
+	mutex_unlock(&session->tx_io_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_idle);
+
+static int mt6797_stp_expect_wmt(struct mt6797_stp_session *session,
+					const u8 *params, u16 parameter_length,
+					const u8 *expected, u16 expected_length,
+					unsigned long timeout_jiffies)
+{
+	u8 response[MT6797_STP_WMT_HEADER_SIZE + 6];
+	u16 response_length = 0;
+	int ret;
+
+	if (expected_length > sizeof(response))
+		return -EINVAL;
+	ret = mt6797_stp_session_wmt(session, 0x04, params, parameter_length,
+					     response, &response_length,
+					     sizeof(response), timeout_jiffies);
+	if (ret)
+		return ret;
+	if (response_length != expected_length ||
+	    memcmp(response, expected, expected_length))
+		return -EPROTO;
+	return 0;
+}
+
+int mt6797_stp_session_configure_btif_full(
+					struct mt6797_stp_session *session,
+					unsigned long timeout_jiffies)
+{
+	static const u8 query_params[] = { 0x04 };
+	static const u8 default_response[] = {
+		0x00, 0x04, 0x11, 0x00, 0x00, 0x00,
+	};
+	static const u8 set_params[] = {
+		0x03, 0xdf, 0x0e, 0x68, 0x01,
+	};
+	static const u8 set_response[] = { 0x00, 0x03 };
+	static const u8 full_response[] = {
+		0x00, 0x04, 0xdf, 0x0e, 0x68, 0x01,
+	};
+	struct mt6797_stp_host_ops host_ops;
+	void *host_context;
+	unsigned long flags;
+	bool host_enabled = false;
+	int ret;
+	int disable_ret;
+
+	if (!session || !timeout_jiffies)
+		return -EINVAL;
+	mutex_lock(&session->host_config_lock);
+	spin_lock_irqsave(&session->state_lock, flags);
+	if (!session->active || session->terminal_error) {
+		ret = session->terminal_error ?: -ESHUTDOWN;
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		goto out_unlock;
+	}
+	host_ops = session->host_ops;
+	host_context = session->host_context;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	if (!host_ops.set_mode || !host_ops.set_enabled) {
+		ret = -EOPNOTSUPP;
+		goto out_unlock;
+	}
+
+	/* The vendor starts BTIF in mandatory mode before the first WMT query. */
+	ret = host_ops.set_mode(host_context,
+				MT6797_STP_BTIF_MANDATORY_MODE);
+	if (ret)
+		goto out_unlock;
+	ret = host_ops.set_enabled(host_context, true);
+	if (ret)
+		goto out_unlock;
+	host_enabled = true;
+
+	ret = mt6797_stp_expect_wmt(session, query_params,
+					ARRAY_SIZE(query_params), default_response,
+					ARRAY_SIZE(default_response), timeout_jiffies);
+	if (ret)
+		goto out_unlock;
+	ret = mt6797_stp_expect_wmt(session, set_params, ARRAY_SIZE(set_params),
+					set_response, ARRAY_SIZE(set_response),
+					timeout_jiffies);
+	if (ret)
+		goto out_unlock;
+	ret = host_ops.set_mode(host_context, MT6797_STP_BTIF_FULL_MODE);
+	if (ret)
+		goto out_unlock;
+	spin_lock_irqsave(&session->state_lock, flags);
+	session->mandatory = false;
+	spin_unlock_irqrestore(&session->state_lock, flags);
+	mt6797_stp_decoder_set_mandatory(&session->decoder, false);
+
+	/* The vendor sequence requires at least 2 ms; retain its 10 ms margin. */
+	msleep(10);
+	ret = mt6797_stp_expect_wmt(session, query_params,
+					ARRAY_SIZE(query_params), full_response,
+					ARRAY_SIZE(full_response), timeout_jiffies);
+	if (!ret) {
+		spin_lock_irqsave(&session->state_lock, flags);
+		session->host_enabled = true;
+		spin_unlock_irqrestore(&session->state_lock, flags);
+		goto out_unlock;
+	}
+
+out_unlock:
+	if (ret && host_enabled) {
+		/* Do not leave a platform-owned host parser enabled after any failure. */
+		disable_ret = host_ops.set_enabled(host_context, false);
+		if (disable_ret)
+			dev_warn(session->owner,
+				 "failed to roll back host STP enable after init error: %d\n",
+				 disable_ret);
+		spin_lock_irqsave(&session->state_lock, flags);
+		session->host_enabled = false;
+		spin_unlock_irqrestore(&session->state_lock, flags);
+	}
+	mutex_unlock(&session->host_config_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_session_configure_btif_full);
+
+static int __init mt6797_stp_session_init(void)
+{
+	return 0;
+}
+module_init(mt6797_stp_session_init);
+
+static void __exit mt6797_stp_session_exit(void)
+{
+}
+module_exit(mt6797_stp_session_exit);
+
+MODULE_DESCRIPTION("MT6797 reliable ConSys STP/WMT session");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6797-stp.c b/drivers/soc/mediatek/mt6797-stp.c
new file mode 100644
index 000000000..e6ca04889
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-stp.c
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// MT6797 ConSys STP full-mode wire codec.
+//
+// This file intentionally has no BTIF or WMT device probe.  It is a small,
+// allocation-free codec that a future STP client can feed from a workqueue
+// after the BTIF hard-IRQ callback has copied bytes.  Power, sequencing,
+// retransmission and function ownership stay above this layer.
+
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include <linux/mt6797-stp.h>
+
+#define STP_DELIMITER_BYTE	0x55
+#define STP_SYNC_MASK		0xc0
+#define STP_SYNC_VALUE		0x80
+#define STP_MAX_TASK_TYPE	7
+#define STP_LENGTH_HIGH_MASK	0x0f
+
+enum mt6797_stp_decode_state {
+	STP_DECODE_HEADER = 0,
+	STP_DECODE_PAYLOAD,
+	STP_DECODE_CRC,
+};
+
+u16 mt6797_stp_crc16(const u8 *data, size_t length)
+{
+	u16 crc = 0;
+
+	while (length--) {
+		u8 bit;
+
+		crc ^= *data++;
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc >> 1) ^ ((crc & 1) ? 0xa001 : 0);
+	}
+	return crc;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_crc16);
+
+ssize_t mt6797_stp_encode_frame(u8 *out, size_t out_size, u8 packet_type,
+					u8 sequence, u8 acknowledgement, bool nak,
+					const u8 *payload, u16 payload_length,
+					bool delimiter)
+{
+	size_t needed = MT6797_STP_HEADER_SIZE + payload_length +
+			(payload_length ? MT6797_STP_CRC_SIZE : 0) +
+			(delimiter ? 2 : 0);
+	u8 *header;
+	u16 crc;
+
+	if (!out || (!payload && payload_length) || packet_type > STP_MAX_TASK_TYPE ||
+		sequence > 7 || acknowledgement > 7 ||
+		payload_length > MT6797_STP_MAX_PAYLOAD || out_size < needed)
+		return -EINVAL;
+	if (delimiter) {
+		out[0] = STP_DELIMITER_BYTE;
+		out[1] = STP_DELIMITER_BYTE;
+	}
+	header = out + (delimiter ? 2 : 0);
+	header[0] = 0x80 | (sequence << 3) | acknowledgement;
+	header[1] = (nak ? 0x80 : 0) | (packet_type << 4) |
+		((payload_length >> 8) & STP_LENGTH_HIGH_MASK);
+	header[2] = payload_length & 0xff;
+	header[3] = header[0] + header[1] + header[2];
+	if (!payload_length)
+		return needed;
+	memcpy(header + MT6797_STP_HEADER_SIZE, payload, payload_length);
+	crc = mt6797_stp_crc16(payload, payload_length);
+	header[MT6797_STP_HEADER_SIZE + payload_length] = crc & 0xff;
+	header[MT6797_STP_HEADER_SIZE + payload_length + 1] = crc >> 8;
+	return needed;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_encode_frame);
+
+ssize_t mt6797_stp_encode_mandatory_frame(u8 *out, size_t out_size,
+						  u8 packet_type,
+						  const u8 *payload,
+						  u16 payload_length,
+						  bool delimiter)
+{
+	size_t needed = MT6797_STP_HEADER_SIZE + payload_length +
+			(payload_length ? MT6797_STP_CRC_SIZE : 0) +
+			(delimiter ? 2 : 0);
+	u8 *header;
+
+	if (!out || (!payload && payload_length) || packet_type > STP_MAX_TASK_TYPE ||
+		payload_length > MT6797_STP_MAX_PAYLOAD || out_size < needed)
+		return -EINVAL;
+	if (delimiter) {
+		out[0] = STP_DELIMITER_BYTE;
+		out[1] = STP_DELIMITER_BYTE;
+	}
+	header = out + (delimiter ? 2 : 0);
+	header[0] = 0x80;
+	header[1] = (packet_type << 4) |
+		((payload_length >> 8) & STP_LENGTH_HIGH_MASK);
+	header[2] = payload_length & 0xff;
+	/* Mandatory mode deliberately does not use header/CRC checksums. */
+	header[3] = 0;
+	if (payload_length)
+		memcpy(header + MT6797_STP_HEADER_SIZE, payload, payload_length);
+	if (payload_length) {
+		header[MT6797_STP_HEADER_SIZE + payload_length] = 0;
+		header[MT6797_STP_HEADER_SIZE + payload_length + 1] = 0;
+	}
+	return needed;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_encode_mandatory_frame);
+
+ssize_t mt6797_stp_encode_wmt(u8 *out, size_t out_size, u8 opcode,
+				      const u8 *params, u16 parameter_length)
+{
+	if (parameter_length > U16_MAX - 4 ||
+		(!params && parameter_length) || out_size < parameter_length + 4)
+		return -EINVAL;
+	out[0] = 0x01; /* WMT command PDU */
+	out[1] = opcode;
+	out[2] = parameter_length & 0xff;
+	out[3] = parameter_length >> 8;
+	if (parameter_length)
+		memcpy(out + 4, params, parameter_length);
+	return parameter_length + 4;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_encode_wmt);
+
+void mt6797_stp_decoder_init(struct mt6797_stp_decoder *decoder)
+{
+	memset(decoder, 0, sizeof(*decoder));
+	decoder->state = STP_DECODE_HEADER;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_decoder_init);
+
+void mt6797_stp_decoder_set_mandatory(struct mt6797_stp_decoder *decoder,
+					       bool mandatory)
+{
+	if (!decoder)
+		return;
+	decoder->mandatory = mandatory;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_decoder_set_mandatory);
+
+static void mt6797_stp_decoder_reset(struct mt6797_stp_decoder *decoder)
+{
+	decoder->header_position = 0;
+	decoder->payload_length = 0;
+	decoder->payload_position = 0;
+	decoder->crc_position = 0;
+	decoder->state = STP_DECODE_HEADER;
+}
+
+static int mt6797_stp_emit(struct mt6797_stp_decoder *decoder,
+				   mt6797_stp_frame_cb callback, void *context,
+				   bool has_crc)
+{
+	struct mt6797_stp_frame frame = {
+		.sequence = (decoder->header[0] >> 3) & 7,
+		.acknowledgement = decoder->header[0] & 7,
+		.packet_type = (decoder->header[1] >> 4) & 7,
+		.nak = !!(decoder->header[1] & 0x80),
+		.has_crc = has_crc,
+		.payload = decoder->payload,
+		.payload_length = decoder->payload_length,
+	};
+
+	if (!callback)
+		return 0;
+	return callback(context, &frame);
+}
+
+int mt6797_stp_decoder_feed(struct mt6797_stp_decoder *decoder,
+				    const u8 *data, size_t length,
+				    mt6797_stp_frame_cb callback, void *context)
+{
+	int frames = 0;
+
+	if (!decoder || (!data && length))
+		return -EINVAL;
+	while (length--) {
+		u8 byte = *data++;
+
+		if (decoder->state == STP_DECODE_HEADER) {
+			if (decoder->header_position == 0) {
+				if (byte == STP_DELIMITER_BYTE)
+					continue;
+				if ((byte & STP_SYNC_MASK) != STP_SYNC_VALUE) {
+					decoder->bad_frames++;
+					continue;
+				}
+			}
+			decoder->header[decoder->header_position++] = byte;
+			if (decoder->header_position < MT6797_STP_HEADER_SIZE)
+				continue;
+			if ((!decoder->mandatory &&
+			     (u8)(decoder->header[0] + decoder->header[1] +
+				  decoder->header[2]) != decoder->header[3]) ||
+			    ((decoder->header[1] >> 4) & 7) > STP_MAX_TASK_TYPE) {
+				decoder->bad_frames++;
+				mt6797_stp_decoder_reset(decoder);
+				continue;
+			}
+			decoder->payload_length =
+				((decoder->header[1] & STP_LENGTH_HIGH_MASK) << 8) |
+				decoder->header[2];
+			if (decoder->payload_length > MT6797_STP_MAX_PAYLOAD) {
+				decoder->bad_frames++;
+				mt6797_stp_decoder_reset(decoder);
+				continue;
+			}
+			if (!decoder->payload_length) {
+				int ret = mt6797_stp_emit(decoder, callback, context, false);
+
+				mt6797_stp_decoder_reset(decoder);
+				if (ret)
+					return ret;
+				frames++;
+			} else {
+				decoder->state = STP_DECODE_PAYLOAD;
+			}
+			continue;
+		}
+
+		if (decoder->state == STP_DECODE_PAYLOAD) {
+			decoder->payload[decoder->payload_position++] = byte;
+			if (decoder->payload_position == decoder->payload_length) {
+				decoder->state = STP_DECODE_CRC;
+				decoder->crc_position = 0;
+			}
+			continue;
+		}
+
+		decoder->crc[decoder->crc_position++] = byte;
+		if (decoder->crc_position == MT6797_STP_CRC_SIZE) {
+			u16 actual = decoder->crc[0] | (decoder->crc[1] << 8);
+			u16 expected = mt6797_stp_crc16(decoder->payload,
+								 decoder->payload_length);
+			int ret = 0;
+
+			if (!decoder->mandatory && actual != expected) {
+				decoder->bad_frames++;
+			} else {
+				ret = mt6797_stp_emit(decoder, callback, context, true);
+				frames++;
+			}
+			mt6797_stp_decoder_reset(decoder);
+			if (ret)
+				return ret;
+		}
+	}
+	return frames;
+}
+EXPORT_SYMBOL_GPL(mt6797_stp_decoder_feed);
+
+static int __init mt6797_stp_init(void)
+{
+	return 0;
+}
+module_init(mt6797_stp_init);
+
+static void __exit mt6797_stp_exit(void)
+{
+}
+module_exit(mt6797_stp_exit);
+
+MODULE_DESCRIPTION("MT6797 ConSys STP wire codec");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6797-wlan-hif.c b/drivers/soc/mediatek/mt6797-wlan-hif.c
new file mode 100644
index 000000000..17973386d
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-wlan-hif.c
@@ -0,0 +1,784 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// MT6797 WLAN AHB sdioLike PIO host window.
+//
+// The vendor block is an indirect SDIO-like command port.  It must not be
+// accessed merely because a platform device exists: the ConSys/WMT WLAN
+// function has to be on before the HIF is claimed.  This first slice maps the
+// resource, records the DT IRQ, and provides an owner-gated CMD53 PIO API.
+// AP-DMA uses the dedicated BSP HIF channel; register accesses remain PIO.
+
+#include <linux/errno.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/unaligned.h>
+
+#include <linux/mt6797-wlan-hif.h>
+
+#define MT6797_WLAN_HIF_LENGTH		0x1100
+#define MT6797_WLAN_HIF_CMD_SETUP	0x0000
+#define MT6797_WLAN_HIF_CMD53_DATA	0x1000
+#define MT6797_WLAN_HIF_CMD52_DATA	0x0004
+#define MT6797_WLAN_HIF_IRQ_MASK		0x0200
+
+/* CMD53 descriptor: count[8:0], addr[25:9], op[26], block[27], func[30:28], rw[31]. */
+#define CMD53_ADDR_MASK			GENMASK(16, 0)
+#define CMD53_ADDR_SHIFT		9
+#define CMD53_FUNC_WIFI			1
+#define CMD53_FUNC_SHIFT		28
+#define CMD53_RW_SHIFT			31
+#define CMD53_COUNT			4
+
+#define HIF_DMA_SIZE			(512 * 512)
+#define HIF_DMA_FLAG			0x00
+#define HIF_DMA_INT_EN			0x04
+#define HIF_DMA_EN			0x08
+#define HIF_DMA_RST			0x0c
+#define HIF_DMA_CON			0x18
+#define HIF_DMA_SRC			0x1c
+#define HIF_DMA_DST			0x20
+#define HIF_DMA_LEN			0x24
+#define HIF_DMA_SRC2			0x54
+#define HIF_DMA_DST2			0x58
+
+struct mt6797_wlan_hif {
+	struct device *dev;
+	void __iomem *base;
+	resource_size_t size;
+	resource_size_t data_phys;
+	void __iomem *dma_base;
+	struct clk *dma_clk;
+	void *dma_buffer;
+	dma_addr_t dma_address;
+	bool dma_enabled;
+	bool dma_clocked;
+	bool dma_fault;
+	u64 dma_transfers;
+	int irq;
+	struct mutex lock;
+	struct device *owner;
+	bool claimed;
+	bool irq_requested;
+	bool irq_enabled;
+	bool irq_tearing_down;
+	irq_handler_t irq_handler;
+	void *irq_data;
+};
+
+static struct mt6797_wlan_hif *mt6797_wlan_hif_singleton;
+static DEFINE_MUTEX(mt6797_wlan_hif_singleton_lock);
+
+/* Caller holds hif->lock and the channel clock.  Never reuse a timed-out
+ * channel or free its buffer until reset has made the engine inactive.
+ */
+static int mt6797_wlan_hif_dma_reset(struct mt6797_wlan_hif *hif)
+{
+	u32 value;
+	int ret;
+
+	writel(0, hif->dma_base + HIF_DMA_INT_EN);
+	writel(BIT(0), hif->dma_base + HIF_DMA_RST);
+	ret = readl_poll_timeout(hif->dma_base + HIF_DMA_EN, value,
+				 !(value & BIT(0)), 10, 10000);
+	if (ret) {
+		writel(BIT(1), hif->dma_base + HIF_DMA_RST);
+		udelay(1000);
+	}
+	writel(0, hif->dma_base + HIF_DMA_RST);
+	ret = readl_poll_timeout(hif->dma_base + HIF_DMA_EN, value,
+				 !(value & BIT(0)), 10, 10000);
+	/* This channel clears its interrupt by writing zero, as in the BSP. */
+	writel(0, hif->dma_base + HIF_DMA_FLAG);
+	return ret;
+}
+
+static int mt6797_wlan_hif_dma_transfer(struct mt6797_wlan_hif *hif,
+				      bool write, void *buffer,
+				      size_t length, size_t count)
+{
+	u32 value, con;
+	int ret, reset_ret;
+
+	if (hif->dma_fault || !hif->dma_clocked)
+		return -EIO;
+	if (write) {
+		memcpy(hif->dma_buffer, buffer, length);
+		memset(hif->dma_buffer + length, 0, count - length);
+	}
+	/* MT6797 HIF channel: incrementing bus, 4/4 burst, TX=0 / RX=1. */
+	con = readl(hif->dma_base + HIF_DMA_CON);
+	con &= ~(GENMASK(17, 16) | BIT(1) | BIT(0));
+	con |= BIT(31) | (3 << 16) | !write;
+	writel(con, hif->dma_base + HIF_DMA_CON);
+	writel(write ? lower_32_bits(hif->dma_address) : hif->data_phys,
+	       hif->dma_base + HIF_DMA_SRC);
+	writel(write ? hif->data_phys : lower_32_bits(hif->dma_address),
+	       hif->dma_base + HIF_DMA_DST);
+	writel(count, hif->dma_base + HIF_DMA_LEN);
+	/* Register Table Part 1, pp.418-419: bit 0 is address bit 32 on
+	 * both memory and FIFO sides. The BSP's forced 1 assumes its 4G
+	 * address layout; this driver's DMA API and HIF resource are 32-bit.
+	 */
+	writel(write ? upper_32_bits(hif->dma_address) : upper_32_bits(hif->data_phys),
+	       hif->dma_base + HIF_DMA_SRC2);
+	writel(write ? upper_32_bits(hif->data_phys) : upper_32_bits(hif->dma_address),
+	       hif->dma_base + HIF_DMA_DST2);
+	writel(0, hif->dma_base + HIF_DMA_FLAG);
+	dma_wmb();
+	writel(BIT(0), hif->dma_base + HIF_DMA_INT_EN);
+	writel(BIT(0), hif->dma_base + HIF_DMA_EN);
+	/* Normal FIFO transfers finish in microseconds. Without high-resolution
+	 * timers even a 10-us sleep costs a scheduler tick per transfer. Keep
+	 * that fast path bounded and retain sleeping polls for a slow engine.
+	 */
+	ret = readl_poll_timeout_atomic(hif->dma_base + HIF_DMA_FLAG, value,
+					value & BIT(0), 1, 2000);
+	if (ret)
+		ret = readl_poll_timeout(hif->dma_base + HIF_DMA_FLAG, value,
+					 value & BIT(0), 10, 100000);
+	if (!ret) {
+		ret = readl_poll_timeout_atomic(hif->dma_base + HIF_DMA_EN, value,
+						!(value & BIT(0)), 1, 100);
+		if (ret)
+			ret = readl_poll_timeout(hif->dma_base + HIF_DMA_EN, value,
+						 !(value & BIT(0)), 10, 10000);
+	}
+	writel(0, hif->dma_base + HIF_DMA_INT_EN);
+	writel(0, hif->dma_base + HIF_DMA_FLAG);
+	if (ret) {
+		/* Fail the owning WLAN session, even if reset recovered the engine.
+		 * Replaying a partly delivered CMD53 would corrupt the firmware stream.
+		 */
+		hif->dma_fault = true;
+		reset_ret = mt6797_wlan_hif_dma_reset(hif);
+		dev_err(hif->dev, "HIF DMA %s timeout, reset=%d\n",
+			write ? "TX" : "RX", reset_ret);
+		return ret;
+	}
+	dma_rmb();
+	if (!write)
+		memcpy(buffer, hif->dma_buffer, length);
+	hif->dma_transfers++;
+	return 0;
+}
+
+/* Return with the HIF lock held.  The singleton lock prevents remove from
+ * freeing the devm mapping while an API call is using it. */
+static int mt6797_wlan_hif_lock_client(struct device *client,
+					struct mt6797_wlan_hif **out)
+{
+	struct mt6797_wlan_hif *hif;
+
+	if (!client || !out)
+		return -EINVAL;
+
+	mutex_lock(&mt6797_wlan_hif_singleton_lock);
+	hif = mt6797_wlan_hif_singleton;
+	if (!hif) {
+		mutex_unlock(&mt6797_wlan_hif_singleton_lock);
+		return -ENODEV;
+	}
+	mutex_lock(&hif->lock);
+	mutex_unlock(&mt6797_wlan_hif_singleton_lock);
+
+	if (!hif->claimed || hif->owner != client) {
+		mutex_unlock(&hif->lock);
+		return -EPERM;
+	}
+	*out = hif;
+	return 0;
+}
+
+static u32 mt6797_wlan_hif_cmd53(bool write, u32 address)
+{
+	u32 command;
+
+	command = CMD53_COUNT;
+	command |= (address & CMD53_ADDR_MASK) << CMD53_ADDR_SHIFT;
+	command |= CMD53_FUNC_WIFI << CMD53_FUNC_SHIFT;
+	if (write)
+		command |= BIT(CMD53_RW_SHIFT);
+	return command;
+}
+
+int mt6797_wlan_hif_claim(struct device *client)
+{
+	struct mt6797_wlan_hif *hif;
+	int ret = 0;
+
+	if (!client)
+		return -EINVAL;
+	mutex_lock(&mt6797_wlan_hif_singleton_lock);
+	hif = mt6797_wlan_hif_singleton;
+	if (!hif)
+		ret = -ENODEV;
+	else {
+		mutex_lock(&hif->lock);
+		if (hif->claimed)
+			ret = hif->owner == client ? -EALREADY : -EBUSY;
+		else {
+			if (hif->dma_enabled) {
+				if (!hif->dma_clocked) {
+					ret = clk_prepare_enable(hif->dma_clk);
+					if (ret)
+						goto unlock;
+					hif->dma_clocked = true;
+				}
+				ret = mt6797_wlan_hif_dma_reset(hif);
+				if (ret) {
+					hif->dma_fault = true;
+					goto unlock;
+				}
+				hif->dma_fault = false;
+			}
+			if (!device_link_add(client, hif->dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+				ret = -ENOMEM;
+				if (hif->dma_clocked) {
+					clk_disable_unprepare(hif->dma_clk);
+					hif->dma_clocked = false;
+				}
+			} else {
+				hif->owner = client;
+				hif->claimed = true;
+				dev_info(hif->dev, "WLAN HIF claimed by %s; ports use %s\n",
+					 dev_name(client), hif->dma_enabled ? "AP-DMA" : "PIO");
+			}
+		}
+unlock:
+		mutex_unlock(&hif->lock);
+	}
+	mutex_unlock(&mt6797_wlan_hif_singleton_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_claim);
+
+int mt6797_wlan_hif_release(struct device *client)
+{
+	struct mt6797_wlan_hif *hif;
+	int ret = 0;
+
+	if (!client)
+		return -EINVAL;
+	mutex_lock(&mt6797_wlan_hif_singleton_lock);
+	hif = mt6797_wlan_hif_singleton;
+	if (!hif)
+		ret = -ENODEV;
+	else {
+		mutex_lock(&hif->lock);
+		if (!hif->claimed || hif->owner != client)
+			ret = -EPERM;
+		else if (hif->irq_requested)
+			ret = -EBUSY;
+		else {
+			if (hif->dma_clocked && !mt6797_wlan_hif_dma_reset(hif)) {
+				clk_disable_unprepare(hif->dma_clk);
+				hif->dma_clocked = false;
+				hif->dma_fault = false;
+			}
+			hif->owner = NULL;
+			hif->claimed = false;
+			dev_info(hif->dev, "WLAN HIF released\n");
+		}
+		mutex_unlock(&hif->lock);
+	}
+	mutex_unlock(&mt6797_wlan_hif_singleton_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_release);
+
+int mt6797_wlan_hif_pio_read(struct device *client, u32 address, u32 *value)
+{
+	struct mt6797_wlan_hif *hif;
+	int ret;
+
+	if (!value || (address & 3) || address > CMD53_ADDR_MASK)
+		return -EINVAL;
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+
+	/* The function register address is indirect; never use base + address. */
+	writel(mt6797_wlan_hif_cmd53(false, address),
+	       hif->base + MT6797_WLAN_HIF_CMD_SETUP);
+	*value = readl(hif->base + MT6797_WLAN_HIF_CMD53_DATA);
+	mutex_unlock(&hif->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_pio_read);
+
+int mt6797_wlan_hif_pio_write(struct device *client, u32 address, u32 value)
+{
+	struct mt6797_wlan_hif *hif;
+	int ret;
+
+	if ((address & 3) || address > CMD53_ADDR_MASK)
+		return -EINVAL;
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+
+	writel(mt6797_wlan_hif_cmd53(true, address),
+	       hif->base + MT6797_WLAN_HIF_CMD_SETUP);
+	writel(value, hif->base + MT6797_WLAN_HIF_CMD53_DATA);
+	mutex_unlock(&hif->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_pio_write);
+
+int mt6797_wlan_hif_wcir_read(struct device *client, u32 *value)
+{
+	return mt6797_wlan_hif_pio_read(client, MT6797_WLAN_HIF_WCIR, value);
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_wcir_read);
+
+static u8 mt6797_wlan_hif_cccr_read(struct mt6797_wlan_hif *hif, u32 address)
+{
+	writel(address << CMD53_ADDR_SHIFT, hif->base + MT6797_WLAN_HIF_CMD_SETUP);
+	return readl(hif->base + MT6797_WLAN_HIF_CMD52_DATA);
+}
+
+static void mt6797_wlan_hif_cccr_write(struct mt6797_wlan_hif *hif,
+				     u32 address, u8 value)
+{
+	writel(BIT(31) | (address << CMD53_ADDR_SHIFT) | value,
+	       hif->base + MT6797_WLAN_HIF_CMD_SETUP);
+	writel(value, hif->base + MT6797_WLAN_HIF_CMD52_DATA);
+}
+
+int mt6797_wlan_hif_function(struct device *client, bool enabled)
+{
+	struct mt6797_wlan_hif *hif;
+	u8 value;
+	int ret;
+
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+	/* Keep the AHB interrupt masked while CCCR/function state changes. */
+	writel(readl(hif->base + MT6797_WLAN_HIF_IRQ_MASK) | BIT(0),
+	       hif->base + MT6797_WLAN_HIF_IRQ_MASK);
+	value = mt6797_wlan_hif_cccr_read(hif, 0x02);
+	mt6797_wlan_hif_cccr_write(hif, 0x02,
+				    enabled ? value | BIT(1) : value & ~BIT(1));
+	if (enabled) {
+		ret = read_poll_timeout(mt6797_wlan_hif_cccr_read, value,
+					value & BIT(1), 100, 100000, false, hif, 0x03);
+		if (ret) {
+			value = mt6797_wlan_hif_cccr_read(hif, 0x02);
+			mt6797_wlan_hif_cccr_write(hif, 0x02, value & ~BIT(1));
+			goto out;
+		}
+		/* Function 1 FBR block size = 512, matching the BSP HIF. */
+		mt6797_wlan_hif_cccr_write(hif, 0x110, 0);
+		mt6797_wlan_hif_cccr_write(hif, 0x111, 2);
+	}
+	value = mt6797_wlan_hif_cccr_read(hif, 0x04);
+	if (enabled)
+		value |= BIT(0) | BIT(1);
+	else {
+		value &= ~BIT(1);
+		if (!(value & ~BIT(0)))
+			value = 0;
+	}
+	mt6797_wlan_hif_cccr_write(hif, 0x04, value);
+out:
+	mutex_unlock(&hif->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_function);
+
+int mt6797_wlan_hif_transfer(struct device *client, u32 port, bool write,
+			     void *buffer, size_t length)
+{
+	struct mt6797_wlan_hif *hif;
+	size_t count, position, valid;
+	u32 command, value;
+	u8 tail[4];
+	bool dma;
+	int ret;
+
+	if (!buffer || !length || port > CMD53_ADDR_MASK || (port & 3) ||
+	    length > 511 * 512)
+		return -EINVAL;
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+	if (hif->dma_fault) {
+		ret = -EIO;
+		goto out;
+	}
+	dma = hif->dma_enabled && ((write && port == 0x34) ||
+				 (!write && (port == 0x50 || port == 0x54)));
+	count = ALIGN(length, 4);
+	command = (port << CMD53_ADDR_SHIFT) | (CMD53_FUNC_WIFI << CMD53_FUNC_SHIFT);
+	if (count >= 512) {
+		count = ALIGN(count, 512);
+		command |= BIT(27) | (count / 512);
+	} else {
+		/* BSP RX byte-mode DMA requires 8-byte FIFO reads. A byte
+		 * count of 512 is encoded as zero in CMD53's 9-bit count.
+		 */
+		if (dma && !write)
+			count = ALIGN(count, 8);
+		command |= count & GENMASK(8, 0);
+	}
+	if (write)
+		command |= BIT(31);
+	writel(command, hif->base + MT6797_WLAN_HIF_CMD_SETUP);
+	/* Match the BSP: only WLAN packet FIFO ports use AP-DMA. */
+	if (dma) {
+		ret = mt6797_wlan_hif_dma_transfer(hif, write, buffer, length, count);
+		goto out;
+	}
+	for (position = 0; position < count; position += sizeof(value)) {
+		valid = position < length ? min(sizeof(value), length - position) : 0;
+		if (write) {
+			memset(tail, 0, sizeof(tail));
+			if (valid)
+				memcpy(tail, (u8 *)buffer + position, valid);
+			writel(get_unaligned_le32(tail), hif->base + MT6797_WLAN_HIF_CMD53_DATA);
+		} else {
+			value = readl(hif->base + MT6797_WLAN_HIF_CMD53_DATA);
+			put_unaligned_le32(value, tail);
+			if (valid)
+				memcpy((u8 *)buffer + position, tail, valid);
+		}
+	}
+out:
+	mutex_unlock(&hif->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_transfer);
+
+static ssize_t transfer_mode_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct mt6797_wlan_hif *hif = dev_get_drvdata(dev);
+	ssize_t length;
+
+	mutex_lock(&hif->lock);
+	length = sysfs_emit(buf, "%s transfers=%llu fault=%u\n",
+			hif->dma_enabled ? "dma" : "pio", hif->dma_transfers,
+			hif->dma_fault);
+	mutex_unlock(&hif->lock);
+	return length;
+}
+
+static ssize_t transfer_mode_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct mt6797_wlan_hif *hif = dev_get_drvdata(dev);
+	bool enabled;
+	int ret = 0;
+
+	if (sysfs_streq(buf, "dma"))
+		enabled = true;
+	else if (sysfs_streq(buf, "pio"))
+		enabled = false;
+	else
+		return -EINVAL;
+	mutex_lock(&hif->lock);
+	if (hif->claimed || hif->dma_clocked)
+		ret = -EBUSY;
+	else if (enabled && !hif->dma_buffer)
+		ret = -EOPNOTSUPP;
+	else
+		hif->dma_enabled = enabled;
+	mutex_unlock(&hif->lock);
+	return ret ?: count;
+}
+static DEVICE_ATTR_RW(transfer_mode);
+
+static struct attribute *mt6797_wlan_hif_attrs[] = {
+	&dev_attr_transfer_mode.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(mt6797_wlan_hif);
+
+int mt6797_wlan_hif_mask_irq(struct device *client, bool masked)
+{
+	struct mt6797_wlan_hif *hif;
+	u32 value;
+	int ret;
+
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+	value = readl(hif->base + MT6797_WLAN_HIF_IRQ_MASK);
+	writel(masked ? value | BIT(0) : value & ~BIT(0),
+	       hif->base + MT6797_WLAN_HIF_IRQ_MASK);
+	mutex_unlock(&hif->lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_mask_irq);
+
+int mt6797_wlan_hif_request_threaded_irq(struct device *client,
+			irq_handler_t thread, const char *name, void *data)
+{
+	struct mt6797_wlan_hif *hif;
+	int ret;
+
+	if (!thread)
+		return -EINVAL;
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+	if (hif->irq_requested)
+		ret = -EBUSY;
+	else {
+		ret = request_threaded_irq(hif->irq, NULL, thread,
+					   IRQF_ONESHOT | IRQF_NO_AUTOEN, name, data);
+		if (!ret) {
+			hif->irq_requested = true;
+			hif->irq_enabled = false;
+			hif->irq_handler = thread;
+			hif->irq_data = data;
+		}
+	}
+	mutex_unlock(&hif->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_request_threaded_irq);
+
+int mt6797_wlan_hif_request_irq(struct device *client, irq_handler_t handler,
+				unsigned long flags, const char *name, void *data)
+{
+	struct mt6797_wlan_hif *hif;
+	int ret;
+
+	if (!handler)
+		return -EINVAL;
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+	if (hif->irq_requested)
+		ret = -EBUSY;
+	else {
+		/* The DT interrupt type is authoritative; callers pass only sharing
+		 * or other request flags.  Keep the line disabled until the owner has
+		 * finished its HIF/firmware initialization. */
+		ret = request_irq(hif->irq, handler, flags | IRQF_NO_AUTOEN,
+				  name ?: dev_name(hif->dev), data);
+		if (!ret) {
+			hif->irq_requested = true;
+			hif->irq_enabled = false;
+			hif->irq_handler = handler;
+			hif->irq_data = data;
+		}
+	}
+	mutex_unlock(&hif->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_request_irq);
+
+int mt6797_wlan_hif_free_irq(struct device *client, void *data)
+{
+	struct mt6797_wlan_hif *hif;
+	int ret;
+
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+	if (!hif->irq_requested)
+		ret = -EINVAL;
+	else if (hif->irq_tearing_down)
+		ret = -EBUSY;
+	else if (data != hif->irq_data)
+		ret = -EPERM;
+	else {
+		hif->irq_tearing_down = true;
+		mutex_unlock(&hif->lock);
+		/* The IRQ thread may need the command lock while being drained. */
+		free_irq(hif->irq, hif->irq_data);
+		mutex_lock(&hif->lock);
+		hif->irq_requested = false;
+		hif->irq_enabled = false;
+		hif->irq_tearing_down = false;
+		hif->irq_handler = NULL;
+		hif->irq_data = NULL;
+	}
+	mutex_unlock(&hif->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_free_irq);
+
+int mt6797_wlan_hif_enable_irq(struct device *client)
+{
+	struct mt6797_wlan_hif *hif;
+	int ret;
+
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+	if (!hif->irq_requested)
+		ret = -EINVAL;
+	else if (hif->irq_tearing_down)
+		ret = -EBUSY;
+	else if (!hif->irq_enabled) {
+		enable_irq(hif->irq);
+		hif->irq_enabled = true;
+	}
+	mutex_unlock(&hif->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_enable_irq);
+
+int mt6797_wlan_hif_disable_irq(struct device *client)
+{
+	struct mt6797_wlan_hif *hif;
+	int ret;
+
+	ret = mt6797_wlan_hif_lock_client(client, &hif);
+	if (ret)
+		return ret;
+	if (!hif->irq_requested)
+		ret = -EINVAL;
+	else if (hif->irq_tearing_down)
+		ret = -EBUSY;
+	else if (hif->irq_enabled) {
+		hif->irq_tearing_down = true;
+		hif->irq_enabled = false;
+		mutex_unlock(&hif->lock);
+		disable_irq(hif->irq);
+		mutex_lock(&hif->lock);
+		hif->irq_tearing_down = false;
+	}
+	mutex_unlock(&hif->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wlan_hif_disable_irq);
+
+static int mt6797_wlan_hif_probe(struct platform_device *pdev)
+{
+	struct mt6797_wlan_hif *hif;
+	struct resource *resource;
+	int ret;
+
+	resource = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!resource || resource_size(resource) < MT6797_WLAN_HIF_LENGTH)
+		return dev_err_probe(&pdev->dev, -EINVAL,
+				     "HIF resource must be at least 0x%x bytes\n",
+				     MT6797_WLAN_HIF_LENGTH);
+
+	hif = devm_kzalloc(&pdev->dev, sizeof(*hif), GFP_KERNEL);
+	if (!hif)
+		return -ENOMEM;
+	hif->dev = &pdev->dev;
+	hif->size = resource_size(resource);
+	hif->data_phys = resource->start + MT6797_WLAN_HIF_CMD53_DATA;
+	hif->base = devm_ioremap_resource(&pdev->dev, resource);
+	if (IS_ERR(hif->base))
+		return PTR_ERR(hif->base);
+	hif->irq = platform_get_irq(pdev, 0);
+	if (hif->irq < 0)
+		return hif->irq;
+	resource = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (resource) {
+		if (resource_size(resource) < 0x80 || hif->data_phys > U32_MAX)
+			return -EINVAL;
+		hif->dma_base = devm_ioremap_resource(&pdev->dev, resource);
+		if (IS_ERR(hif->dma_base))
+			return PTR_ERR(hif->dma_base);
+		hif->dma_clk = devm_clk_get(&pdev->dev, "wifi-dma");
+		if (IS_ERR(hif->dma_clk))
+			return PTR_ERR(hif->dma_clk);
+		ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+		if (ret)
+			return ret;
+		/* Keep one buffer for the channel lifetime, including fault teardown. */
+		hif->dma_buffer = dma_alloc_coherent(&pdev->dev, HIF_DMA_SIZE,
+						    &hif->dma_address, GFP_KERNEL);
+		if (!hif->dma_buffer)
+			return -ENOMEM;
+	}
+	hif->dma_enabled = of_property_read_bool(pdev->dev.of_node, "mediatek,use-dma");
+	if (hif->dma_enabled && !hif->dma_buffer)
+		return -EINVAL;
+	mutex_init(&hif->lock);
+
+	mutex_lock(&mt6797_wlan_hif_singleton_lock);
+	if (mt6797_wlan_hif_singleton)
+		ret = -EBUSY;
+	else {
+		mt6797_wlan_hif_singleton = hif;
+		platform_set_drvdata(pdev, hif);
+		ret = 0;
+	}
+	mutex_unlock(&mt6797_wlan_hif_singleton_lock);
+	if (ret) {
+		if (hif->dma_buffer)
+			dma_free_coherent(hif->dev, HIF_DMA_SIZE, hif->dma_buffer,
+					  hif->dma_address);
+		return dev_err_probe(&pdev->dev, ret, "only one WLAN HIF is supported\n");
+	}
+
+	dev_info(&pdev->dev,
+		 "WLAN HIF mapped (data=%pa, size=0x%llx), irq=%d; dormant until WMT function-on\n",
+		 &hif->data_phys,
+		 (unsigned long long)hif->size, hif->irq);
+	return 0;
+}
+
+static void mt6797_wlan_hif_remove(struct platform_device *pdev)
+{
+	struct mt6797_wlan_hif *hif = platform_get_drvdata(pdev);
+
+	if (!hif)
+		return;
+	mutex_lock(&mt6797_wlan_hif_singleton_lock);
+	mutex_lock(&hif->lock);
+	if (mt6797_wlan_hif_singleton == hif)
+		mt6797_wlan_hif_singleton = NULL;
+	if (hif->claimed)
+		dev_warn(hif->dev, "removing WLAN HIF while owner is still claimed\n");
+	hif->owner = NULL;
+	hif->claimed = false;
+	mutex_unlock(&hif->lock);
+	mutex_unlock(&mt6797_wlan_hif_singleton_lock);
+	/* No new client can acquire this provider.  Drain the thread without
+	 * either API lock, since it may itself be completing a HIF access.
+	 */
+	if (hif->irq_requested)
+		free_irq(hif->irq, hif->irq_data);
+	if (hif->dma_clocked && !mt6797_wlan_hif_dma_reset(hif)) {
+		clk_disable_unprepare(hif->dma_clk);
+		hif->dma_clocked = false;
+	}
+	if (hif->dma_buffer) {
+		if (hif->dma_clocked)
+			dev_err(hif->dev, "DMA reset failed; retaining active channel buffer\n");
+		else
+			dma_free_coherent(hif->dev, HIF_DMA_SIZE, hif->dma_buffer,
+					  hif->dma_address);
+	}
+}
+
+static const struct of_device_id mt6797_wlan_hif_of_match[] = {
+	{ .compatible = "mediatek,mt6797-wlan-hif" },
+	/* Temporary board bring-up alias for the generic-resource A/B node. */
+	{ .compatible = "x20,diagnostic-hif" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6797_wlan_hif_of_match);
+
+static struct platform_driver mt6797_wlan_hif_driver = {
+	.probe = mt6797_wlan_hif_probe,
+	.remove = mt6797_wlan_hif_remove,
+	.driver = {
+		.name = "mt6797-wlan-hif",
+		.of_match_table = mt6797_wlan_hif_of_match,
+		.dev_groups = mt6797_wlan_hif_groups,
+	},
+};
+module_platform_driver(mt6797_wlan_hif_driver);
+
+MODULE_DESCRIPTION("MT6797 WLAN AHB sdioLike PIO HIF owner gate");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6797-wmt-init.c b/drivers/soc/mediatek/mt6797-wmt-init.c
new file mode 100644
index 000000000..53327dd66
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-wmt-init.c
@@ -0,0 +1,569 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Shared MT6797 WMT ROM/firmware initialization, independent of sysfs clients. */
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/firmware.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+#include <linux/mt6797-consys.h>
+#include <linux/mt6797-stp-session.h>
+#include <linux/mt6797-wmt.h>
+
+#define MT6797_WMT_TIMEOUT_MS	2000
+#define MT6797_WMT_RESET_TIMEOUT_MS	5000
+#define MT6797_WMT_RESPONSE_MAX	32
+#define MT6797_WMT_GEN_HVR		0x80000000
+#define MT6797_WMT_GEN_FVR		0x80000004
+#define MT6797_WMT_GEN_VER_MASK		0x0000ffff
+#define MT6797_WMT_PATCH_HEADER_SIZE	28
+#define MT6797_WMT_PATCH_FRAGMENT_SIZE	1000
+#define MT6797_WMT_PATCH_MAX_SIZE	(256 * 1024)
+#define MT6797_WMT_PATCH_COUNT		2
+#define MT6797_WMT_PATCH_HW_VERSION	0x8a00
+#define MT6797_WMT_PATCH_FW_1		"mediatek/ROMv3_patch_1_1_hdr.bin"
+#define MT6797_WMT_PATCH_FW_2		"mediatek/ROMv3_patch_1_0_hdr.bin"
+
+static int mt6797_wmt_read_reg(struct device *dev,
+				     struct mt6797_stp_session *session,
+				     u32 address, u32 mask, u32 *value)
+{
+	u8 params[16] = { 0 };
+	u8 response[MT6797_WMT_RESPONSE_MAX];
+	u16 response_length = 0;
+	u32 response_address;
+	int ret;
+
+	/* WMT_SET_REG_CMD: read, register type, one register, address, mask. */
+	params[0] = 0x02;
+	params[1] = 0x01;
+	params[3] = 0x01;
+	put_unaligned_le32(address, params + 4);
+	put_unaligned_le32(mask, params + 12);
+	ret = mt6797_stp_session_wmt(session, 0x08, params, sizeof(params),
+				     response, &response_length, sizeof(response),
+				     msecs_to_jiffies(MT6797_WMT_TIMEOUT_MS));
+	if (ret)
+		return ret;
+	/* status/type/revision/count + address + value */
+	if (response_length != 12 || response[0] || response[1] ||
+	    response[2] || response[3] != 1)
+		return -EPROTO;
+	response_address = get_unaligned_le32(response + 4);
+	if (response_address != address)
+		return -EPROTO;
+	*value = get_unaligned_le32(response + 8) & mask;
+	return 0;
+}
+
+int mt6797_wmt_read_version(struct device *dev,
+					struct mt6797_stp_session *session,
+					u32 *hw_version, u32 *fw_version)
+{
+	int ret;
+
+	ret = mt6797_wmt_read_reg(dev, session, MT6797_WMT_GEN_HVR,
+				       MT6797_WMT_GEN_VER_MASK, hw_version);
+	if (ret)
+		return ret;
+	ret = mt6797_wmt_read_reg(dev, session, MT6797_WMT_GEN_FVR,
+				       MT6797_WMT_GEN_VER_MASK, fw_version);
+	if (ret)
+		return ret;
+	dev_info(dev, "WMT ROM version hw=0x%04x fw=0x%04x\n",
+		 *hw_version, *fw_version);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_read_version);
+
+static int mt6797_wmt_reg_write(struct mt6797_stp_session *session,
+					     const u8 params[16])
+{
+	static const u8 expected[] = { 0x00, 0x00, 0x00, 0x01 };
+	u8 response[MT6797_WMT_RESPONSE_MAX];
+	u16 response_length = 0;
+	int ret;
+
+	ret = mt6797_stp_session_wmt(session, 0x08, params, 16,
+				     response, &response_length, sizeof(response),
+				     msecs_to_jiffies(MT6797_WMT_TIMEOUT_MS));
+	if (ret)
+		return ret;
+	if (response_length != sizeof(expected) ||
+	    memcmp(response, expected, sizeof(expected)))
+		return -EPROTO;
+	return 0;
+}
+
+static int mt6797_wmt_power_on_dlm(struct mt6797_stp_session *session)
+{
+	/* Vendor wmt_power_on_dlm_table, without the four-byte WMT header. */
+	static const u8 params[][16] = {
+		{ 1, 1, 0, 1, 0x60, 0, 0x10, 0x80, 0, 0, 0, 0, 0, 0x0f, 0, 0 },
+		{ 1, 1, 0, 1, 0x60, 0, 0x10, 0x80, 0, 0, 0, 0, 0xf0, 0, 0, 0 },
+		{ 1, 1, 0, 1, 0x60, 0, 0x10, 0x80, 0, 0, 0, 0, 0x08, 0, 0, 0 },
+	};
+	unsigned int index;
+	int ret;
+
+	for (index = 0; index < ARRAY_SIZE(params); index++) {
+		ret = mt6797_wmt_reg_write(session, params[index]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int mt6797_wmt_mcu_clock(struct device *dev,
+					 struct mt6797_stp_session *session, bool enable)
+{
+	static const u8 enable_params[][16] = {
+		{
+			0x01, 0x01, 0x00, 0x01,
+			0x10, 0x11, 0x02, 0x81,
+			0x00, 0x00, 0x00, 0x10,
+			0x00, 0x00, 0x00, 0x10,
+		},
+		{
+			0x01, 0x01, 0x00, 0x01,
+			0x0c, 0x01, 0x00, 0x80,
+			0x40, 0x00, 0x00, 0x00,
+			0xc0, 0x00, 0x00, 0x00,
+		},
+		{
+			0x01, 0x01, 0x00, 0x01,
+			0x18, 0x11, 0x02, 0x80,
+			0x07, 0x00, 0x00, 0x00,
+			0x3f, 0x00, 0x00, 0x00,
+		},
+		{
+			0x01, 0x01, 0x00, 0x01,
+			0x00, 0x11, 0x02, 0x81,
+			0x04, 0x00, 0x00, 0x00,
+			0x07, 0x00, 0x00, 0x00,
+		},
+	};
+	static const u8 disable_params[][16] = {
+		{
+			0x01, 0x01, 0x00, 0x01,
+			0x00, 0x11, 0x02, 0x81,
+			0x00, 0x00, 0x00, 0x00,
+			0x07, 0x00, 0x00, 0x00,
+		},
+		{
+			0x01, 0x01, 0x00, 0x01,
+			0x0c, 0x01, 0x00, 0x80,
+			0x00, 0x00, 0x00, 0x00,
+			0xc0, 0x00, 0x00, 0x00,
+		},
+		{
+			0x01, 0x01, 0x00, 0x01,
+			0x10, 0x11, 0x02, 0x81,
+			0x00, 0x00, 0x00, 0x00,
+			0x00, 0x00, 0x00, 0x10,
+		},
+	};
+	const u8 (*params)[16] = enable ? enable_params : disable_params;
+	size_t count = enable ? ARRAY_SIZE(enable_params) : ARRAY_SIZE(disable_params);
+	size_t index;
+	int ret;
+
+	for (index = 0; index < count; index++) {
+		ret = mt6797_wmt_reg_write(session, params[index]);
+		if (ret)
+			return ret;
+	}
+	dev_info(dev, "ROMv3 MCU clock %s\n", enable ? "boost enabled" :
+		 "boost disabled");
+	return 0;
+}
+
+static int mt6797_wmt_reset(struct mt6797_stp_session *session)
+{
+	static const u8 params[] = { 0x04 };
+	static const u8 expected[] = { 0x00 };
+	u8 response[MT6797_WMT_RESPONSE_MAX];
+	u16 response_length = 0;
+	int ret;
+
+	ret = mt6797_stp_session_wmt(session, 0x07, params, sizeof(params),
+				     response, &response_length, sizeof(response),
+				     msecs_to_jiffies(MT6797_WMT_RESET_TIMEOUT_MS));
+	if (ret)
+		return ret;
+	if (response_length != sizeof(expected) ||
+	    memcmp(response, expected, sizeof(expected)))
+		return -EPROTO;
+	return 0;
+}
+
+static int mt6797_wmt_patch_header(const struct firmware *fw,
+					      u32 expected_hw, u32 expected_fw,
+					      u8 expected_sequence)
+{
+	const u8 *data;
+	u16 hw_version;
+	u16 fw_version;
+	u8 patch_info;
+	u8 sequence;
+	u8 patch_count;
+	u32 address;
+	size_t payload_size;
+
+	if (!fw || fw->size < MT6797_WMT_PATCH_HEADER_SIZE ||
+		fw->size > MT6797_WMT_PATCH_HEADER_SIZE + MT6797_WMT_PATCH_MAX_SIZE)
+		return -EINVAL;
+	data = fw->data;
+
+	hw_version = get_unaligned_be16(data + 20);
+	fw_version = get_unaligned_be16(data + 22);
+	patch_info = data[24];
+	patch_count = patch_info >> 4;
+	sequence = patch_info & 0x0f;
+	address = get_unaligned_be24(data + 25);
+	payload_size = fw->size - MT6797_WMT_PATCH_HEADER_SIZE;
+	if (patch_count != MT6797_WMT_PATCH_COUNT ||
+		sequence != expected_sequence || !payload_size ||
+		(hw_version != (expected_hw & 0xffff)) ||
+		((fw_version ^ (expected_fw & 0xffff)) & 0x00ff))
+		return -EPROTO;
+	if (!address || address > 0x00ffffff)
+		return -ERANGE;
+
+	return 0;
+}
+
+static int mt6797_wmt_patch_address(struct device *dev,
+						 struct mt6797_stp_session *session,
+						 const struct firmware *fw)
+{
+	u8 params[16] = {
+		0x01, 0x01, 0x00, 0x01,
+		0x08, 0x05, 0x09, 0x02,
+		0x00, 0x00, 0x00, 0x00,
+		0xff, 0xff, 0xff, 0xff,
+	};
+	u8 response[MT6797_WMT_RESPONSE_MAX];
+	u16 response_length = 0;
+	int ret;
+
+	ret = mt6797_stp_session_wmt(session, 0x08, params, sizeof(params),
+				     response, &response_length, sizeof(response),
+				     msecs_to_jiffies(MT6797_WMT_TIMEOUT_MS));
+	if (ret)
+		return ret;
+	if (response_length != 4 || response[0] || response[1] ||
+		response[2] || response[3] != 1)
+		return -EPROTO;
+
+	/* WMT_PATCH_P_ADDRESS_CMD includes a four-byte WMT header. Its
+	 * bytes 12..15 are params[8..11] (value), not params[12..15] (mask).
+	 * Keep the vendor's full mask and prepend zero to the header address.
+	 */
+	params[4] = 0x2c;
+	params[5] = 0x0b;
+	params[8] = 0x00;
+	memcpy(params + 9, fw->data + 25, 3);
+	ret = mt6797_stp_session_wmt(session, 0x08, params, sizeof(params),
+				     response, &response_length, sizeof(response),
+				     msecs_to_jiffies(MT6797_WMT_TIMEOUT_MS));
+	if (ret)
+		return ret;
+	if (response_length != 4 || response[0] || response[1] ||
+		response[2] || response[3] != 1)
+		return -EPROTO;
+
+	dev_info(dev, "ROMv3 patch address 0x%06x accepted\n",
+		 get_unaligned_be24(fw->data + 25));
+	return 0;
+}
+
+static int mt6797_wmt_patch_one(struct device *dev,
+					     struct mt6797_stp_session *session,
+					     const struct firmware *fw,
+					     u32 expected_fw,
+					     u8 sequence)
+{
+	u8 *params;
+	u8 response[MT6797_WMT_RESPONSE_MAX];
+	u16 response_length;
+	size_t payload_size;
+	size_t offset;
+	u8 fragment;
+	int ret;
+
+	ret = mt6797_wmt_patch_header(fw, MT6797_WMT_PATCH_HW_VERSION,
+					  expected_fw, sequence);
+	if (ret)
+		return ret;
+	ret = mt6797_wmt_patch_address(dev, session, fw);
+	if (ret)
+		return ret;
+
+	payload_size = fw->size - MT6797_WMT_PATCH_HEADER_SIZE;
+	params = kmalloc(1 + MT6797_WMT_PATCH_FRAGMENT_SIZE, GFP_KERNEL);
+	if (!params)
+		return -ENOMEM;
+	for (offset = 0; offset < payload_size; offset += MT6797_WMT_PATCH_FRAGMENT_SIZE) {
+		size_t length = min_t(size_t, MT6797_WMT_PATCH_FRAGMENT_SIZE,
+					      payload_size - offset);
+
+		fragment = (offset == 0) ? 0x01 : 0x02;
+		if (offset + length == payload_size)
+			fragment = 0x03;
+		params[0] = fragment;
+		memcpy(params + 1, fw->data + MT6797_WMT_PATCH_HEADER_SIZE + offset,
+		       length);
+		response_length = 0;
+		ret = mt6797_stp_session_wmt(session, 0x01, params, 1 + length,
+					     response, &response_length, sizeof(response),
+					     msecs_to_jiffies(MT6797_WMT_TIMEOUT_MS));
+		if (ret)
+			break;
+		if (response_length != 1 || response[0]) {
+			ret = -EPROTO;
+			break;
+		}
+		dev_dbg(dev, "ROMv3 patch seq=%u offset=%zu length=%zu\n",
+			sequence, offset, length);
+	}
+	kfree(params);
+	if (!ret)
+		dev_info(dev, "ROMv3 patch seq=%u transferred payload=%zu\n",
+			 sequence, payload_size);
+	return ret;
+}
+
+int mt6797_wmt_download_patches(struct device *dev,
+					 struct mt6797_stp_session *session,
+					 void *host_context,
+					 u32 hw_version, u32 fw_version)
+{
+	static const char * const names[] = {
+		MT6797_WMT_PATCH_FW_1,
+		MT6797_WMT_PATCH_FW_2,
+	};
+	const struct firmware *fw[ARRAY_SIZE(names)] = { };
+	unsigned int index;
+	unsigned int loaded = 0;
+	bool clock_boosted = false;
+	bool emi_owned = false;
+	int ret;
+	int cleanup_ret;
+
+	if (hw_version != MT6797_WMT_PATCH_HW_VERSION ||
+		((fw_version ^ MT6797_WMT_PATCH_HW_VERSION) & 0x00ff))
+		return -EPROTO;
+	for (index = 0; index < ARRAY_SIZE(names); index++) {
+		ret = request_firmware(&fw[index], names[index], dev);
+		if (ret)
+			goto out_release;
+		loaded++;
+		ret = mt6797_wmt_patch_header(fw[index], hw_version,
+						 fw_version, index + 1);
+		if (ret)
+			goto out_release;
+	}
+	ret = mt6797_consys_emi_patch_begin(host_context);
+	if (ret)
+		goto out_release;
+	emi_owned = true;
+	ret = mt6797_wmt_power_on_dlm(session);
+	if (ret)
+		goto out_release;
+	/* Even a failed write can have changed part of the clock setup. */
+	clock_boosted = true;
+	ret = mt6797_wmt_mcu_clock(dev, session, true);
+	if (ret)
+		goto out_clock;
+	for (index = 0; index < ARRAY_SIZE(fw); index++) {
+		ret = mt6797_wmt_patch_one(dev, session, fw[index], fw_version,
+							index + 1);
+		if (ret)
+			goto out_clock;
+		/* Vendor init_table_3 resets the target after every patch image. */
+		ret = mt6797_wmt_reset(session);
+		if (ret)
+			goto out_clock;
+	}
+	ret = mt6797_wmt_mcu_clock(dev, session, false);
+	clock_boosted = false;
+	if (ret)
+		goto out_release;
+	dev_info(dev, "ROMv3 patch set transferred in sequence order\n");
+	ret = 0;
+
+out_clock:
+	if (clock_boosted) {
+		cleanup_ret = mt6797_wmt_mcu_clock(dev, session, false);
+		if (!ret && cleanup_ret)
+			ret = cleanup_ret;
+	}
+out_release:
+	if (emi_owned) {
+		cleanup_ret = mt6797_consys_emi_patch_end(host_context);
+		if (!ret)
+			ret = cleanup_ret;
+	}
+	while (loaded)
+		release_firmware(fw[--loaded]);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_download_patches);
+
+static int mt6797_wmt_expect(struct mt6797_stp_session *session, u8 opcode,
+			     const u8 *params, u16 length,
+			     const u8 *expected, u16 expected_length)
+{
+	u8 response[MT6797_WMT_RESPONSE_MAX];
+	u16 response_length = 0;
+	int ret;
+
+	ret = mt6797_stp_session_wmt(session, opcode, params, length,
+				     response, &response_length, sizeof(response),
+				     msecs_to_jiffies(MT6797_WMT_TIMEOUT_MS));
+	if (ret)
+		return ret;
+	if (response_length != expected_length ||
+	    memcmp(response, expected, expected_length))
+		return -EPROTO;
+	return 0;
+}
+
+int mt6797_wmt_function_control(struct device *dev,
+				struct mt6797_stp_session *session,
+				u8 function, bool enabled)
+{
+	const u8 params[] = { function, enabled ? 1 : 0 };
+	static const u8 expected[] = { 0 };
+	int ret;
+
+	ret = mt6797_wmt_expect(session, 0x06, params, sizeof(params),
+				expected, sizeof(expected));
+	if (!ret)
+		dev_info(dev, "WMT function %u %s acknowledged\n", function,
+			 enabled ? "on" : "off");
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_function_control);
+
+static int mt6797_wmt_calibrate(struct device *dev,
+			       struct mt6797_stp_session *session, void *host_context,
+			       struct mt6797_wmt_calibration *calibration)
+{
+	static const u8 params[] = { 1 };
+	bool bt_changed = false, wifi_changed = false;
+	int ret, cleanup_ret;
+
+	calibration->length = 0;
+	ret = mt6797_consys_radio_power(host_context, MT6797_CONSYS_FUNC_BT,
+				       true, &bt_changed);
+	if (ret)
+		return ret;
+	ret = mt6797_consys_radio_power(host_context, MT6797_CONSYS_FUNC_WIFI,
+				       true, &wifi_changed);
+	if (!ret) {
+		ret = mt6797_stp_session_wmt(session, 0x14, params, sizeof(params),
+				calibration->data, &calibration->length,
+				sizeof(calibration->data),
+				msecs_to_jiffies(MT6797_WMT_TIMEOUT_MS));
+		/* BSP skips comparison for opcode 0x14 because newer patches append
+		 * calibration data. Validate status/subcommand and retain all bytes;
+		 * the appended format is firmware-owned, not an invented host ABI.
+		 */
+		if (!ret && (calibration->length < 2 || calibration->data[0] ||
+			     calibration->data[1] != 1))
+			ret = -EPROTO;
+		if (ret)
+			calibration->length = 0;
+	}
+	if (wifi_changed) {
+		cleanup_ret = mt6797_consys_radio_power(host_context,
+					 MT6797_CONSYS_FUNC_WIFI, false, NULL);
+		if (!ret)
+			ret = cleanup_ret;
+	}
+	if (bt_changed) {
+		cleanup_ret = mt6797_consys_radio_power(host_context,
+					 MT6797_CONSYS_FUNC_BT, false, NULL);
+		if (!ret)
+			ret = cleanup_ret;
+	}
+	if (!ret)
+		dev_info(dev, "WMT RF calibration acknowledged, retained %u bytes\n",
+			 calibration->length);
+	return ret;
+}
+
+int mt6797_wmt_post_patch_init(struct device *dev,
+			      struct mt6797_stp_session *session,
+			      void *host_context, const struct mt6797_wmt_config *config,
+			      struct mt6797_wmt_calibration *calibration)
+{
+	static const u8 status_ok[] = { 0 };
+	static const u8 oscillator[] = { 0x08, 0x03 };
+	u8 coexistence[] = { 1, 0 };
+	u8 fm[] = { 2, 0 }, fm_expected[] = { 0, 0 };
+	int ret;
+
+	if (!config || !calibration ||
+	    (config->fm_transport != 1 && config->fm_transport != 2))
+		return -EINVAL;
+	ret = mt6797_wmt_calibrate(dev, session, host_context, calibration);
+	if (ret)
+		return ret;
+	coexistence[1] = config->antenna_mode;
+	ret = mt6797_wmt_expect(session, 0x10, coexistence, sizeof(coexistence),
+				status_ok, sizeof(status_ok));
+	if (ret)
+		return ret;
+	if (config->co_clock) {
+		ret = mt6797_wmt_expect(session, 0x0a, oscillator, sizeof(oscillator),
+					status_ok, sizeof(status_ok));
+		if (ret)
+			return ret;
+	}
+	fm[1] = fm_expected[1] = config->fm_transport;
+	ret = mt6797_wmt_expect(session, 0x05, fm, sizeof(fm),
+				fm_expected, sizeof(fm_expected));
+	if (!ret)
+		dev_info(dev, "WMT board configuration: antenna=%u co-clock=%u FM transport=%u\n",
+			 config->antenna_mode, config->co_clock, config->fm_transport);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_post_patch_init);
+
+int mt6797_wmt_bootstrap(struct device *dev, struct mt6797_stp_session *session,
+			 void *host_context, const struct mt6797_wmt_config *config,
+			      struct mt6797_wmt_calibration *calibration)
+{
+	u32 hw_version, fw_version;
+	int ret;
+
+	if (!dev || !session || !host_context || !config || !calibration)
+		return -EINVAL;
+	ret = mt6797_stp_session_configure_btif_full(session,
+					msecs_to_jiffies(MT6797_WMT_TIMEOUT_MS));
+	if (ret)
+		return ret;
+	ret = mt6797_wmt_read_version(dev, session, &hw_version, &fw_version);
+	if (ret)
+		return ret;
+	calibration->hw_version = hw_version;
+	calibration->fw_version = fw_version;
+	ret = mt6797_wmt_download_patches(dev, session, host_context, hw_version, fw_version);
+	if (ret)
+		return ret;
+	ret = mt6797_wmt_post_patch_init(dev, session, host_context, config, calibration);
+	if (!ret)
+		dev_info(dev, "WMT initialization complete\n");
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_bootstrap);
+
+MODULE_FIRMWARE(MT6797_WMT_PATCH_FW_1);
+MODULE_FIRMWARE(MT6797_WMT_PATCH_FW_2);
+MODULE_DESCRIPTION("MT6797 WMT firmware initialization");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/mediatek/mt6797-wmt.c b/drivers/soc/mediatek/mt6797-wmt.c
new file mode 100644
index 000000000..3074a9373
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-wmt.c
@@ -0,0 +1,908 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Shared MT6797 firmware, STP and radio lifecycle for functional clients. */
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/jiffies.h>
+#include <linux/interrupt.h>
+#include <linux/kref.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/slab.h>
+#include <linux/srcu.h>
+#include <linux/workqueue.h>
+
+#include <linux/mt6797-consys.h>
+#include <linux/mt6797-stp-session.h>
+#include <linux/mt6797-wmt.h>
+
+struct mt6797_wmt {
+	struct device *dev;
+	struct device *consys;
+	struct device *btif;
+	struct mutex lock;
+	struct kref ref;
+	struct srcu_struct rx_srcu;
+	struct mt6797_wmt_client __rcu *clients[4];
+	struct device *radios[4];
+	struct work_struct recovery_work;
+	bool recovery_pending;
+	bool reprobing;
+	unsigned int recovery_generation;
+	unsigned long last_recovery;
+	int recovery_result;
+	int wake_irq;
+	spinlock_t wake_irq_lock;
+	bool wake_irq_enabled;
+	atomic_t host_wake_pending;
+	struct work_struct host_wake_work;
+	struct delayed_work idle_work;
+	bool psm_enabled;
+	bool asleep;
+	unsigned long last_activity;
+	u64 sleeps, wakes, host_wakes;
+	int psm_error;
+	struct mt6797_stp_session *session;
+	struct mt6797_wmt_config config;
+	struct mt6797_wmt_calibration calibration;
+	void *host;
+	unsigned int users;
+	int error;
+	bool removed;
+};
+
+/* Protect drvdata lookup independently of the supplier device lock. Recovery
+ * holds that device lock while rebinding consumers through their normal probe.
+ */
+static DEFINE_MUTEX(mt6797_wmt_lookup_lock);
+
+#define WMT_PSM_IDLE_MS 200
+static int mt6797_wmt_queue_recovery(struct mt6797_wmt *wmt, int reason, bool manual);
+
+static void mt6797_wmt_psm_touch(struct mt6797_wmt *wmt)
+{
+	WRITE_ONCE(wmt->last_activity, jiffies);
+	if (READ_ONCE(wmt->psm_enabled) && !READ_ONCE(wmt->removed))
+		mod_delayed_work(system_wq, &wmt->idle_work, msecs_to_jiffies(WMT_PSM_IDLE_MS));
+}
+
+static void mt6797_wmt_wake_irq_set(struct mt6797_wmt *wmt, bool enabled)
+{
+	unsigned long flags;
+
+	if (wmt->wake_irq < 0)
+		return;
+	spin_lock_irqsave(&wmt->wake_irq_lock, flags);
+	if (enabled != wmt->wake_irq_enabled) {
+		wmt->wake_irq_enabled = enabled;
+		if (enabled)
+			enable_irq(wmt->wake_irq);
+		else
+			disable_irq_nosync(wmt->wake_irq);
+	}
+	spin_unlock_irqrestore(&wmt->wake_irq_lock, flags);
+	if (!enabled)
+		synchronize_irq(wmt->wake_irq);
+}
+
+/* wmt->lock serializes every power transaction against functional sends. */
+static int mt6797_wmt_psm_wake(struct mt6797_wmt *wmt)
+{
+	bool host_wake;
+	int ret;
+
+	mt6797_wmt_wake_irq_set(wmt, false);
+	host_wake = atomic_xchg(&wmt->host_wake_pending, 0);
+	if (!wmt->asleep && !host_wake)
+		return 0;
+	ret = mt6797_stp_session_idle(wmt->session, false);
+	if (!ret)
+		ret = mt6797_stp_session_power(wmt->session,
+			host_wake ? MT6797_STP_POWER_HOST_AWAKE : MT6797_STP_POWER_WAKE,
+			msecs_to_jiffies(1000));
+	if (ret) {
+		wmt->psm_error = ret;
+		wmt->psm_enabled = false;
+		mt6797_wmt_queue_recovery(wmt, ret, false);
+		return ret;
+	}
+	wmt->asleep = false;
+	if (host_wake)
+		wmt->host_wakes++;
+	else
+		wmt->wakes++;
+	mt6797_wmt_psm_touch(wmt);
+	return 0;
+}
+
+static void mt6797_wmt_host_wake_work(struct work_struct *work)
+{
+	struct mt6797_wmt *wmt = container_of(work, struct mt6797_wmt, host_wake_work);
+
+	mutex_lock(&wmt->lock);
+	if (!wmt->removed && !wmt->recovery_pending && wmt->session && wmt->users)
+		mt6797_wmt_psm_wake(wmt);
+	mutex_unlock(&wmt->lock);
+}
+
+static irqreturn_t mt6797_wmt_wake_irq(int irq, void *data)
+{
+	struct mt6797_wmt *wmt = data;
+	unsigned long flags;
+
+	spin_lock_irqsave(&wmt->wake_irq_lock, flags);
+	if (wmt->wake_irq_enabled) {
+		wmt->wake_irq_enabled = false;
+		disable_irq_nosync(irq);
+	}
+	spin_unlock_irqrestore(&wmt->wake_irq_lock, flags);
+	atomic_set(&wmt->host_wake_pending, 1);
+	if (!READ_ONCE(wmt->removed))
+		schedule_work(&wmt->host_wake_work);
+	return IRQ_HANDLED;
+}
+
+static void mt6797_wmt_idle_work(struct work_struct *work)
+{
+	struct mt6797_wmt *wmt = container_of(to_delayed_work(work), struct mt6797_wmt, idle_work);
+	unsigned long due;
+	int ret;
+
+	mutex_lock(&wmt->lock);
+	if (wmt->removed || !wmt->psm_enabled || wmt->asleep || !wmt->users ||
+	    !wmt->session || wmt->error || wmt->recovery_pending)
+		goto out;
+	due = READ_ONCE(wmt->last_activity) + msecs_to_jiffies(WMT_PSM_IDLE_MS);
+	if (time_before(jiffies, due)) {
+		mod_delayed_work(system_wq, &wmt->idle_work, due - jiffies);
+		goto out;
+	}
+	ret = mt6797_stp_session_power(wmt->session, MT6797_STP_POWER_SLEEP,
+				       msecs_to_jiffies(1000));
+	if (ret) {
+		wmt->psm_error = ret;
+		wmt->psm_enabled = false;
+		mt6797_wmt_queue_recovery(wmt, ret, false);
+		goto out;
+	}
+	wmt->asleep = true;
+	wmt->sleeps++;
+	ret = mt6797_stp_session_idle(wmt->session, true);
+	if (ret && ret != -EBUSY) {
+		wmt->psm_error = ret;
+		wmt->psm_enabled = false;
+		mt6797_wmt_queue_recovery(wmt, ret, false);
+		goto out;
+	}
+	mt6797_wmt_wake_irq_set(wmt, true);
+out:
+	mutex_unlock(&wmt->lock);
+}
+
+struct mt6797_wmt_client {
+	struct mt6797_wmt *wmt;
+	struct mt6797_wmt_client_ops ops;
+	void *context;
+	u8 task;
+	bool active;
+};
+
+static void mt6797_wmt_release(struct kref *ref)
+{
+	struct mt6797_wmt *wmt = container_of(ref, struct mt6797_wmt, ref);
+
+	cleanup_srcu_struct(&wmt->rx_srcu);
+	for (int task = 0; task < ARRAY_SIZE(wmt->radios); task++)
+		put_device(wmt->radios[task]);
+	put_device(wmt->btif);
+	put_device(wmt->consys);
+	put_device(wmt->dev);
+	kfree(wmt);
+}
+
+static void mt6797_wmt_receive(void *context, u8 task,
+			       const u8 *data, u16 length)
+{
+	struct mt6797_wmt *wmt = context;
+	struct mt6797_wmt_client *client;
+	int index;
+
+	if (task >= ARRAY_SIZE(wmt->clients))
+		return;
+	mt6797_wmt_psm_touch(wmt);
+	index = srcu_read_lock(&wmt->rx_srcu);
+	client = srcu_dereference(wmt->clients[task], &wmt->rx_srcu);
+	if (client && READ_ONCE(client->active) && client->ops.receive)
+		client->ops.receive(client->context, data, length);
+	srcu_read_unlock(&wmt->rx_srcu, index);
+}
+
+/* lock held; session_stop drains RX callbacks before freeing the session. */
+static int mt6797_wmt_stop(struct mt6797_wmt *wmt)
+{
+	int ret = 0;
+
+	cancel_delayed_work(&wmt->idle_work);
+	mt6797_wmt_wake_irq_set(wmt, false);
+	wmt->asleep = false;
+	atomic_set(&wmt->host_wake_pending, 0);
+	if (wmt->session) {
+		mt6797_stp_session_stop(wmt->session);
+		mt6797_stp_session_free(wmt->session);
+		wmt->session = NULL;
+	}
+	if (wmt->host) {
+		ret = mt6797_consys_stp_release(wmt->host);
+		wmt->host = NULL;
+	}
+	wmt->error = ret;
+	return ret;
+}
+
+static int mt6797_wmt_start(struct mt6797_wmt *wmt)
+{
+	static const struct mt6797_stp_session_ops ops = {
+		.rx_frame = mt6797_wmt_receive,
+	};
+	struct mt6797_stp_host_ops host_ops;
+	int ret;
+
+	ret = mt6797_consys_stp_open(wmt->consys, &host_ops, &wmt->host);
+	if (ret)
+		return ret;
+	wmt->session = mt6797_stp_session_alloc(wmt->dev, &ops, wmt);
+	if (!wmt->session) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	ret = mt6797_stp_session_set_host_ops(wmt->session, &host_ops, wmt->host);
+	if (ret)
+		goto fail;
+	ret = mt6797_stp_session_start(wmt->session, true);
+	if (ret)
+		goto fail;
+	ret = mt6797_stp_session_wake(wmt->session);
+	if (ret)
+		goto fail;
+	ret = mt6797_wmt_bootstrap(wmt->dev, wmt->session, wmt->host, &wmt->config,
+				   &wmt->calibration);
+	if (!ret)
+		return 0;
+fail:
+	mt6797_wmt_stop(wmt);
+	return ret;
+}
+
+/* One whole-chip attempt, with no WMT mutex held across consumer callbacks.
+ * Driver removal drains HCI/WLAN work and RX before the last client releases
+ * STP and ConSys. Reprobe then reloads firmware and restores native devices.
+ */
+static void mt6797_wmt_recovery_work(struct work_struct *work)
+{
+	struct mt6797_wmt *wmt = container_of(work, struct mt6797_wmt, recovery_work);
+	struct device *radios[4] = {};
+	unsigned int task, count = 0;
+	int ret = 0, attached;
+	bool locked;
+
+	/* Supplier removal may be holding this lock and waiting for this work.
+	 * Never wait on it: removal owns teardown if it wins this race.
+	 */
+	locked = device_trylock(wmt->dev);
+	mutex_lock(&wmt->lock);
+	if (!locked || wmt->removed) {
+		ret = wmt->removed ? -ENODEV : -EBUSY;
+		goto finish;
+	}
+	for (task = 0; task < ARRAY_SIZE(radios); task++) {
+		if (wmt->radios[task] && device_is_registered(wmt->radios[task])) {
+			radios[task] = get_device(wmt->radios[task]);
+			count++;
+		}
+	}
+	if (!count) {
+		ret = -ENODEV;
+		goto finish;
+	}
+	wmt->recovery_generation++;
+	dev_warn(wmt->dev, "whole-chip recovery %u: quiescing %u radios\n",
+		 wmt->recovery_generation, count);
+	/* Quiescing is gated by recovery_pending, so retain only errors from
+	 * this teardown, not a stale fault from an earlier failed attempt.
+	 */
+	wmt->error = 0;
+	mutex_unlock(&wmt->lock);
+	for (task = 0; task < ARRAY_SIZE(radios); task++)
+		if (radios[task])
+			device_release_driver(radios[task]);
+	mutex_lock(&wmt->lock);
+	if (wmt->users || wmt->session || wmt->host) {
+		ret = -EBUSY;
+		goto finish;
+	}
+	if (wmt->error) {
+		ret = wmt->error;
+		goto finish;
+	}
+	wmt->reprobing = true;
+	mutex_unlock(&wmt->lock);
+	for (task = 0; task < ARRAY_SIZE(radios); task++) {
+		if (!radios[task])
+			continue;
+		attached = device_attach(radios[task]);
+		if (attached != 1 && !ret)
+			ret = attached < 0 ? attached : -ENODEV;
+	}
+	if (ret) {
+		/* A partial reprobe must not leave one radio using a failed MCU. */
+		for (task = 0; task < ARRAY_SIZE(radios); task++)
+			if (radios[task])
+				device_release_driver(radios[task]);
+	}
+	mutex_lock(&wmt->lock);
+finish:
+	wmt->recovery_result = ret;
+	wmt->error = ret;
+	wmt->reprobing = false;
+	wmt->recovery_pending = false;
+	mutex_unlock(&wmt->lock);
+	if (locked)
+		device_unlock(wmt->dev);
+	for (task = 0; task < ARRAY_SIZE(radios); task++)
+		put_device(radios[task]);
+	dev_info(wmt->dev, "whole-chip recovery %u %s: %d\n",
+		 wmt->recovery_generation, ret ? "failed" : "complete", ret);
+	if (!ret) {
+		char *env[] = { "X20_RECOVERY=complete", NULL };
+
+		/* Network policy belongs to userspace; the new netdev has no IP. */
+		kobject_uevent_env(&wmt->dev->kobj, KOBJ_CHANGE, env);
+	}
+}
+
+/* lock held. Terminal errors schedule one attempt, never a reset loop. A
+ * failed attempt requires an explicit retry; successful ones have a cooldown.
+ */
+static int mt6797_wmt_queue_recovery(struct mt6797_wmt *wmt, int reason, bool manual)
+{
+	if (wmt->removed)
+		return -ENODEV;
+	if (wmt->recovery_pending)
+		return -EALREADY;
+	wmt->error = reason;
+	if (!manual && (wmt->recovery_result ||
+	    (wmt->last_recovery && time_before(jiffies, wmt->last_recovery + 30 * HZ))))
+		return -EAGAIN;
+	wmt->recovery_pending = true;
+	wmt->last_recovery = jiffies;
+	if (!schedule_work(&wmt->recovery_work)) {
+		wmt->recovery_pending = false;
+		return -EBUSY;
+	}
+	return 0;
+}
+
+struct mt6797_wmt_client *mt6797_wmt_client_get(struct device *dev, u8 task,
+				const struct mt6797_wmt_client_ops *ops, void *context)
+{
+	struct mt6797_wmt_client *client;
+	struct platform_device *pdev;
+	struct device_node *node;
+	struct mt6797_wmt *wmt;
+	struct device *old_radio = NULL;
+	int ret;
+
+	if (!dev || (task != MT6797_STP_TASK_BT && task != MT6797_STP_TASK_WIFI))
+		return ERR_PTR(-EINVAL);
+	node = of_parse_phandle(dev->of_node, "mediatek,wmt", 0);
+	if (!node)
+		return ERR_PTR(-EINVAL);
+	pdev = of_find_device_by_node(node);
+	of_node_put(node);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+	mutex_lock(&mt6797_wmt_lookup_lock);
+	wmt = platform_get_drvdata(pdev);
+	if (wmt)
+		kref_get(&wmt->ref);
+	mutex_unlock(&mt6797_wmt_lookup_lock);
+	if (!wmt) {
+		ret = -EPROBE_DEFER;
+		goto put_device;
+	}
+	if (!device_link_add(dev, &pdev->dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		ret = -ENOMEM;
+		goto put_wmt;
+	}
+	client = kzalloc(sizeof(*client), GFP_KERNEL);
+	if (!client) {
+		ret = -ENOMEM;
+		goto put_wmt;
+	}
+	client->wmt = wmt;
+	client->task = task;
+	client->context = context;
+	if (ops)
+		client->ops = *ops;
+	mutex_lock(&wmt->lock);
+	if (wmt->removed)
+		ret = -ENODEV;
+	else if (rcu_access_pointer(wmt->clients[task]))
+		ret = -EBUSY;
+	else {
+		if (wmt->radios[task] != dev) {
+			old_radio = wmt->radios[task];
+			wmt->radios[task] = get_device(dev);
+		}
+		rcu_assign_pointer(wmt->clients[task], client);
+		ret = 0;
+	}
+	mutex_unlock(&wmt->lock);
+	put_device(old_radio);
+	if (!ret) {
+		put_device(&pdev->dev);
+		return client;
+	}
+	kfree(client);
+put_wmt:
+	kref_put(&wmt->ref, mt6797_wmt_release);
+put_device:
+	put_device(&pdev->dev);
+	return ERR_PTR(ret);
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_client_get);
+
+int mt6797_wmt_client_open(struct mt6797_wmt_client *client)
+{
+	struct mt6797_wmt *wmt;
+	int ret;
+
+	if (!client)
+		return -EINVAL;
+	wmt = client->wmt;
+	mutex_lock(&wmt->lock);
+	if (wmt->removed) {
+		ret = -ENODEV;
+		goto out;
+	}
+	if (wmt->recovery_pending && !wmt->reprobing) {
+		ret = -EAGAIN;
+		goto out;
+	}
+	if (client->active) {
+		ret = -EALREADY;
+		goto out;
+	}
+	if (!wmt->users) {
+		ret = mt6797_wmt_start(wmt);
+		if (ret)
+			goto out;
+	} else if (wmt->error) {
+		ret = wmt->error;
+		goto out;
+	}
+	ret = mt6797_wmt_psm_wake(wmt);
+	if (ret)
+		goto fail;
+	ret = mt6797_consys_radio_power(wmt->host, client->task, true, NULL);
+	if (ret)
+		goto fail;
+	/* BSP WLAN probe owns its AHB function; only BT uses WMT FUNC_CTRL. */
+	if (client->task == MT6797_STP_TASK_BT) {
+		ret = mt6797_wmt_function_control(wmt->dev, wmt->session,
+						 client->task, true);
+		if (ret) {
+			mt6797_consys_radio_power(wmt->host, client->task, false, NULL);
+			goto fail;
+		}
+	}
+	WRITE_ONCE(client->active, true);
+	wmt->users++;
+	mt6797_wmt_psm_touch(wmt);
+	goto out;
+fail:
+	if (!wmt->users)
+		mt6797_wmt_stop(wmt);
+out:
+	mutex_unlock(&wmt->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_client_open);
+
+int mt6797_wmt_client_close(struct mt6797_wmt_client *client)
+{
+	struct mt6797_wmt *wmt;
+	int ret = 0, cleanup_ret;
+
+	if (!client)
+		return -EINVAL;
+	wmt = client->wmt;
+	mutex_lock(&wmt->lock);
+	if (!client->active)
+		goto out;
+	WRITE_ONCE(client->active, false);
+	if (wmt->removed)
+		goto out;
+	if (!wmt->recovery_pending)
+		ret = mt6797_wmt_psm_wake(wmt);
+	if (!ret && client->task == MT6797_STP_TASK_BT && !wmt->recovery_pending)
+		ret = mt6797_wmt_function_control(wmt->dev, wmt->session,
+						 client->task, false);
+	cleanup_ret = mt6797_consys_radio_power(wmt->host, client->task, false, NULL);
+	if (!ret)
+		ret = cleanup_ret;
+	if (ret)
+		wmt->error = ret;
+	if (!--wmt->users) {
+		cleanup_ret = mt6797_wmt_stop(wmt);
+		if (!ret)
+			ret = cleanup_ret;
+	}
+out:
+	mutex_unlock(&wmt->lock);
+	synchronize_srcu(&wmt->rx_srcu);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_client_close);
+
+void mt6797_wmt_client_put(struct mt6797_wmt_client *client)
+{
+	struct mt6797_wmt *wmt;
+
+	if (!client)
+		return;
+	wmt = client->wmt;
+	mt6797_wmt_client_close(client);
+	mutex_lock(&wmt->lock);
+	RCU_INIT_POINTER(wmt->clients[client->task], NULL);
+	mutex_unlock(&wmt->lock);
+	synchronize_srcu(&wmt->rx_srcu);
+	kfree(client);
+	kref_put(&wmt->ref, mt6797_wmt_release);
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_client_put);
+
+int mt6797_wmt_client_send(struct mt6797_wmt_client *client,
+			   const void *data, size_t length)
+{
+	struct mt6797_wmt *wmt;
+	int ret;
+
+	if (!client || !data || !length || length > 2048)
+		return -EINVAL;
+	wmt = client->wmt;
+	mutex_lock(&wmt->lock);
+	if (wmt->removed || !client->active)
+		ret = -ESHUTDOWN;
+	else if (wmt->recovery_pending && !wmt->reprobing)
+		ret = -EAGAIN;
+	else if (wmt->error)
+		ret = wmt->error;
+	else {
+		ret = mt6797_wmt_psm_wake(wmt);
+		if (!ret)
+			ret = mt6797_stp_session_send(wmt->session, client->task, data, length,
+						     msecs_to_jiffies(2000));
+		mt6797_wmt_psm_touch(wmt);
+	}
+	if (ret == -ETIMEDOUT || ret == -EIO || ret == -EPROTO || ret == -ENOBUFS)
+		mt6797_wmt_queue_recovery(wmt, ret, false);
+	mutex_unlock(&wmt->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_client_send);
+
+int mt6797_wmt_client_recover(struct mt6797_wmt_client *client, int reason)
+{
+	int ret;
+
+	if (!client || reason >= 0)
+		return -EINVAL;
+	mutex_lock(&client->wmt->lock);
+	ret = mt6797_wmt_queue_recovery(client->wmt, reason, false);
+	mutex_unlock(&client->wmt->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_client_recover);
+
+int mt6797_wmt_wifi_emi_write(struct mt6797_wmt_client *client, u32 offset,
+			    const void *data, size_t length)
+{
+	struct mt6797_wmt *wmt;
+	int ret;
+
+	if (!client || client->task != MT6797_STP_TASK_WIFI)
+		return -EINVAL;
+	wmt = client->wmt;
+	mutex_lock(&wmt->lock);
+	if (wmt->removed || !client->active)
+		ret = -ESHUTDOWN;
+	else if (wmt->recovery_pending && !wmt->reprobing)
+		ret = -EAGAIN;
+	else {
+		ret = mt6797_wmt_psm_wake(wmt);
+		if (!ret)
+			ret = mt6797_consys_wifi_emi_write(wmt->host, offset, data, length);
+		mt6797_wmt_psm_touch(wmt);
+	}
+	mutex_unlock(&wmt->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_wifi_emi_write);
+
+int mt6797_wmt_client_version(struct mt6797_wmt_client *client, u32 *hw, u32 *fw)
+{
+	struct mt6797_wmt *wmt;
+	int ret = 0;
+
+	if (!client || !hw || !fw)
+		return -EINVAL;
+	wmt = client->wmt;
+	mutex_lock(&wmt->lock);
+	if (wmt->removed || !client->active)
+		ret = -ESHUTDOWN;
+	else if (wmt->recovery_pending && !wmt->reprobing)
+		ret = -EAGAIN;
+	else {
+		*hw = wmt->calibration.hw_version;
+		*fw = wmt->calibration.fw_version;
+	}
+	mutex_unlock(&wmt->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_client_version);
+
+int mt6797_wmt_client_cpupcr(struct mt6797_wmt_client *client, u32 *value)
+{
+	struct mt6797_wmt *wmt;
+	int ret;
+
+	if (!client || !value)
+		return -EINVAL;
+	wmt = client->wmt;
+	mutex_lock(&wmt->lock);
+	if (wmt->removed || !client->active)
+		ret = -ESHUTDOWN;
+	else if (wmt->recovery_pending && !wmt->reprobing)
+		ret = -EAGAIN;
+	else
+		ret = mt6797_consys_read_cpupcr(wmt->host, value);
+	mutex_unlock(&wmt->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6797_wmt_client_cpupcr);
+
+static struct device *mt6797_wmt_provider(struct device *dev, const char *name)
+{
+	struct platform_device *pdev;
+	struct device_node *node;
+
+	node = of_parse_phandle(dev->of_node, name, 0);
+	if (!node)
+		return ERR_PTR(-EINVAL);
+	pdev = of_find_device_by_node(node);
+	of_node_put(node);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+	if (!dev_get_drvdata(&pdev->dev)) {
+		put_device(&pdev->dev);
+		return ERR_PTR(-EPROBE_DEFER);
+	}
+	if (!device_link_add(dev, &pdev->dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		put_device(&pdev->dev);
+		return ERR_PTR(-ENOMEM);
+	}
+	return &pdev->dev;
+}
+
+static ssize_t recovery_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct mt6797_wmt *wmt = dev_get_drvdata(dev);
+	const char *state;
+	ssize_t length;
+
+	mutex_lock(&wmt->lock);
+	state = wmt->recovery_pending ? (wmt->reprobing ? "reprobing" : "quiescing") :
+		(wmt->recovery_result ? "failed" : wmt->error ? "fault" : "idle");
+	length = sysfs_emit(buf, "%s generation=%u result=%d error=%d users=%u\n", state,
+			   wmt->recovery_generation, wmt->recovery_result, wmt->error, wmt->users);
+	mutex_unlock(&wmt->lock);
+	return length;
+}
+
+static ssize_t recovery_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct mt6797_wmt *wmt = dev_get_drvdata(dev);
+	int ret;
+
+	if (!sysfs_streq(buf, "recover") &&
+	    !(IS_ENABLED(CONFIG_FAULT_INJECTION) && sysfs_streq(buf, "fault")))
+		return -EINVAL;
+	mutex_lock(&wmt->lock);
+	if (sysfs_streq(buf, "fault")) {
+		if (!wmt->session || !wmt->users || wmt->recovery_pending)
+			ret = -EBUSY;
+		else {
+			/* Latch a provider failure, not an arbitrary MMIO fault. The
+			 * next real radio send exercises automatic error recovery.
+			 */
+			wmt->error = -EIO;
+			ret = 0;
+		}
+	} else {
+		ret = mt6797_wmt_queue_recovery(wmt, -ECANCELED, true);
+	}
+	mutex_unlock(&wmt->lock);
+	return ret ?: count;
+}
+static DEVICE_ATTR_RW(recovery);
+
+static ssize_t psm_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mt6797_wmt *wmt = dev_get_drvdata(dev);
+	ssize_t length;
+
+	mutex_lock(&wmt->lock);
+	length = sysfs_emit(buf, "%s %s sleeps=%llu wakes=%llu host_wakes=%llu error=%d irq=%d\n",
+		wmt->psm_enabled ? "auto" : "off", wmt->asleep ? "asleep" : "awake",
+		wmt->sleeps, wmt->wakes, wmt->host_wakes, wmt->psm_error, wmt->wake_irq);
+	mutex_unlock(&wmt->lock);
+	return length;
+}
+
+static ssize_t psm_store(struct device *dev, struct device_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct mt6797_wmt *wmt = dev_get_drvdata(dev);
+	bool enabled;
+	int ret = 0;
+
+	if (sysfs_streq(buf, "auto"))
+		enabled = true;
+	else if (sysfs_streq(buf, "off"))
+		enabled = false;
+	else
+		return -EINVAL;
+	mutex_lock(&wmt->lock);
+	if (wmt->removed || wmt->recovery_pending || wmt->error)
+		ret = -EBUSY;
+	else if (enabled && wmt->wake_irq < 0)
+		ret = -EOPNOTSUPP;
+	else {
+		if (!enabled && wmt->session)
+			ret = mt6797_wmt_psm_wake(wmt);
+		if (!ret) {
+			wmt->psm_enabled = enabled;
+			wmt->psm_error = 0;
+			if (enabled)
+				mt6797_wmt_psm_touch(wmt);
+			else
+				cancel_delayed_work(&wmt->idle_work);
+		}
+	}
+	mutex_unlock(&wmt->lock);
+	return ret ?: count;
+}
+static DEVICE_ATTR_RW(psm);
+static struct attribute *mt6797_wmt_attrs[] = { &dev_attr_recovery.attr, &dev_attr_psm.attr, NULL };
+ATTRIBUTE_GROUPS(mt6797_wmt);
+
+static int mt6797_wmt_probe(struct platform_device *pdev)
+{
+	struct mt6797_wmt *wmt;
+	int ret;
+
+	wmt = kzalloc(sizeof(*wmt), GFP_KERNEL);
+	if (!wmt)
+		return -ENOMEM;
+	wmt->consys = mt6797_wmt_provider(&pdev->dev, "consys");
+	if (IS_ERR(wmt->consys)) {
+		ret = PTR_ERR(wmt->consys);
+		goto free;
+	}
+	wmt->btif = mt6797_wmt_provider(&pdev->dev, "btif");
+	if (IS_ERR(wmt->btif)) {
+		ret = PTR_ERR(wmt->btif);
+		goto put_consys;
+	}
+	ret = device_property_read_u8(&pdev->dev, "mediatek,antenna-mode",
+				      &wmt->config.antenna_mode);
+	if (!ret)
+		ret = device_property_read_u8(&pdev->dev, "mediatek,fm-transport",
+					      &wmt->config.fm_transport);
+	if (ret)
+		goto put_btif;
+	wmt->config.co_clock = device_property_read_bool(&pdev->dev, "mediatek,co-clock");
+	ret = init_srcu_struct(&wmt->rx_srcu);
+	if (ret)
+		goto put_btif;
+	wmt->dev = get_device(&pdev->dev);
+	kref_init(&wmt->ref);
+	mutex_init(&wmt->lock);
+	spin_lock_init(&wmt->wake_irq_lock);
+	atomic_set(&wmt->host_wake_pending, 0);
+	INIT_WORK(&wmt->host_wake_work, mt6797_wmt_host_wake_work);
+	INIT_DELAYED_WORK(&wmt->idle_work, mt6797_wmt_idle_work);
+	INIT_WORK(&wmt->recovery_work, mt6797_wmt_recovery_work);
+	wmt->wake_irq = platform_get_irq_optional(pdev, 0);
+	if (wmt->wake_irq == -EPROBE_DEFER) {
+		ret = wmt->wake_irq;
+		goto cleanup_srcu;
+	}
+	if (wmt->wake_irq >= 0) {
+		ret = devm_request_irq(&pdev->dev, wmt->wake_irq, mt6797_wmt_wake_irq,
+				       IRQF_NO_AUTOEN, "mt6797-wmt-wake", wmt);
+		if (ret)
+			goto cleanup_srcu;
+	}
+	mutex_lock(&mt6797_wmt_lookup_lock);
+	platform_set_drvdata(pdev, wmt);
+	mutex_unlock(&mt6797_wmt_lookup_lock);
+	dev_info(&pdev->dev, "shared WMT ready; firmware starts with the first radio client\n");
+	return 0;
+cleanup_srcu:
+	put_device(wmt->dev);
+	cleanup_srcu_struct(&wmt->rx_srcu);
+put_btif:
+	put_device(wmt->btif);
+put_consys:
+	put_device(wmt->consys);
+free:
+	kfree(wmt);
+	return ret;
+}
+
+static void mt6797_wmt_remove(struct platform_device *pdev)
+{
+	struct mt6797_wmt *wmt = platform_get_drvdata(pdev);
+	struct mt6797_wmt_client *client;
+	unsigned int task;
+
+	mutex_lock(&mt6797_wmt_lookup_lock);
+	platform_set_drvdata(pdev, NULL);
+	mutex_unlock(&mt6797_wmt_lookup_lock);
+	mutex_lock(&wmt->lock);
+	wmt->removed = true;
+	wmt->psm_enabled = false;
+	mutex_unlock(&wmt->lock);
+	mt6797_wmt_wake_irq_set(wmt, false);
+	cancel_delayed_work_sync(&wmt->idle_work);
+	cancel_work_sync(&wmt->host_wake_work);
+	cancel_work_sync(&wmt->recovery_work);
+	mutex_lock(&wmt->lock);
+	for (task = 0; task < ARRAY_SIZE(wmt->clients); task++) {
+		client = rcu_dereference_protected(wmt->clients[task],
+						 lockdep_is_held(&wmt->lock));
+		if (client)
+			WRITE_ONCE(client->active, false);
+	}
+	wmt->users = 0;
+	mt6797_wmt_stop(wmt);
+	mutex_unlock(&wmt->lock);
+	kref_put(&wmt->ref, mt6797_wmt_release);
+}
+
+static const struct of_device_id mt6797_wmt_of_match[] = {
+	{ .compatible = "mediatek,mt6797-wmt" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6797_wmt_of_match);
+
+static struct platform_driver mt6797_wmt_driver = {
+	.probe = mt6797_wmt_probe,
+	.remove = mt6797_wmt_remove,
+	.driver = {
+		.name = "mt6797-wmt",
+		.of_match_table = mt6797_wmt_of_match,
+		.dev_groups = mt6797_wmt_groups,
+	},
+};
+module_platform_driver(mt6797_wmt_driver);
+
+MODULE_DESCRIPTION("MT6797 shared connectivity firmware and radio lifecycle");
+MODULE_LICENSE("GPL");
diff --git a/include/linux/mt6797-btif.h b/include/linux/mt6797-btif.h
new file mode 100644
index 000000000..3cd2be30b
--- /dev/null
+++ b/include/linux/mt6797-btif.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MT6797 BTIF byte transport contract (PIO or dedicated DMA/VFIFO).
+ *
+ * BTIF is the ConSys host byte transport.  It is not a tty or a 16550 UART;
+ * callers must put STP/WMT framing above this interface.  The RX callback is
+ * invoked from IRQ or threaded IRQ context and must only copy/schedule work.
+ */
+#ifndef __LINUX_MT6797_BTIF_H
+#define __LINUX_MT6797_BTIF_H
+
+#include <linux/device.h>
+#include <linux/types.h>
+
+struct mt6797_btif_client_ops {
+	void (*rx_bytes)(void *context, const u8 *data, size_t length);
+};
+
+int mt6797_btif_claim(struct device *client,
+			      const struct mt6797_btif_client_ops *ops,
+			      void *context);
+void mt6797_btif_release(struct device *client);
+ssize_t mt6797_btif_write(struct device *client, const u8 *data,
+			   size_t length, unsigned long timeout_jiffies);
+int mt6797_btif_wake(struct device *client);
+/* WMT sleep is acknowledged before entry; retain FIFO/register state. */
+int mt6797_btif_idle(struct device *client, bool idle);
+
+#endif /* __LINUX_MT6797_BTIF_H */
diff --git a/include/linux/mt6797-consys.h b/include/linux/mt6797-consys.h
new file mode 100644
index 000000000..157fe9831
--- /dev/null
+++ b/include/linux/mt6797-consys.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* MT6797 ConSys host-state callbacks used by STP/WMT clients. */
+#ifndef __LINUX_MT6797_CONSYS_H
+#define __LINUX_MT6797_CONSYS_H
+
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/types.h>
+
+#define MT6797_CONSYS_EMI_REGION_SIZE	0x200000
+#define MT6797_CONSYS_WIFI_EMI_SIZE	0x080000
+
+#define MT6797_CONSYS_STP_BTIF_FULL_MODE	BIT(2)
+
+/* WMT function type values from the MT6797 vendor protocol. */
+#define MT6797_CONSYS_FUNC_BT		0
+#define MT6797_CONSYS_FUNC_WIFI		3
+
+struct mt6797_stp_host_ops;
+
+/*
+ * Reserve the ConSys host parser before claiming BTIF.  The reservation is
+ * separate from set_enabled(): it keeps a concurrent sysfs power-off from
+ * tearing down MMIO while a STP transaction is in flight.
+ */
+int mt6797_consys_stp_acquire(struct device *consys_dev,
+				      struct mt6797_stp_host_ops *ops,
+				      void **context);
+int mt6797_consys_stp_release(void *context);
+
+/* Functional clients own power through this reservation; release powers off.
+ * Diagnostic acquire above retains its explicit manual power contract.
+ */
+int mt6797_consys_stp_open(struct device *consys_dev,
+			 struct mt6797_stp_host_ops *ops, void **context);
+
+/* The context is the MT6797 ConSys platform driver's private state. */
+int mt6797_consys_stp_set_mode(void *context, u32 mode);
+int mt6797_consys_stp_set_enabled(void *context, bool enabled);
+
+/* Own the external MT6631 VCN33 rail for a live WMT function. */
+int mt6797_consys_radio_power(void *context, u8 function, bool enabled,
+				     bool *changed);
+
+/* Read the reserved ConSys EMI region while the caller owns the STP context. */
+int mt6797_consys_get_emi(void *context, phys_addr_t *base,
+				  phys_addr_t *size);
+int mt6797_consys_read_cpupcr(void *context, u32 *value);
+
+/* Reserve/release the shared EMI transaction used by firmware download. */
+int mt6797_consys_emi_patch_begin(void *context);
+int mt6797_consys_emi_patch_end(void *context);
+
+/* Bounded, verified WLAN firmware copy with MPU restoration on every exit. */
+int mt6797_consys_wifi_emi_write(void *context, u32 offset,
+			       const void *data, size_t length);
+
+#endif /* __LINUX_MT6797_CONSYS_H */
diff --git a/include/linux/mt6797-stp-session.h b/include/linux/mt6797-stp-session.h
new file mode 100644
index 000000000..6445ba6d1
--- /dev/null
+++ b/include/linux/mt6797-stp-session.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Reliable STP/WMT session on top of the MT6797 BTIF byte transport. */
+#ifndef __LINUX_MT6797_STP_SESSION_H
+#define __LINUX_MT6797_STP_SESSION_H
+
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/types.h>
+
+struct mt6797_stp_session;
+
+/*
+ * Host-side STP controls are deliberately supplied by the ConSys owner.  The
+ * session knows the vendor sequence, but it must not invent register writes or
+ * claim that a platform-specific STP state change succeeded.
+ */
+struct mt6797_stp_host_ops {
+	int (*set_mode)(void *context, u32 mode);
+	int (*set_enabled)(void *context, bool enabled);
+};
+
+#define MT6797_STP_BTIF_FULL_MODE	BIT(2)
+#define MT6797_STP_BTIF_MANDATORY_MODE	BIT(3)
+
+/* Task indices are the values used by the vendor MTKSTP stack. */
+#define MT6797_STP_TASK_BT	0
+#define MT6797_STP_TASK_FM	1
+#define MT6797_STP_TASK_GPS	2
+#define MT6797_STP_TASK_WIFI	3
+#define MT6797_STP_TASK_WMT	4
+
+struct mt6797_stp_session_ops {
+	/* Called from the session workqueue after an in-order STP data frame. */
+	void (*rx_frame)(void *context, u8 task, const u8 *payload,
+			u16 length);
+};
+
+struct mt6797_stp_session *mt6797_stp_session_alloc(
+	struct device *owner, const struct mt6797_stp_session_ops *ops,
+	void *context);
+void mt6797_stp_session_free(struct mt6797_stp_session *session);
+
+/* Claim/release BTIF only. ConSys power and STP mode selection stay above it. */
+int mt6797_stp_session_start(struct mt6797_stp_session *session,
+				     bool delimiter);
+void mt6797_stp_session_stop(struct mt6797_stp_session *session);
+int mt6797_stp_session_wake(struct mt6797_stp_session *session);
+
+#define MT6797_STP_POWER_SLEEP 1
+#define MT6797_STP_POWER_HOST_AWAKE 2
+#define MT6797_STP_POWER_WAKE 3
+/* BSP WMT sleep/host-awake transactions and BTIF-edge wake acknowledgement. */
+int mt6797_stp_session_power(struct mt6797_stp_session *session, u8 action,
+			      unsigned long timeout_jiffies);
+int mt6797_stp_session_idle(struct mt6797_stp_session *session, bool idle);
+
+/* Install platform-owned host mode/enable operations before start(). */
+int mt6797_stp_session_set_host_ops(struct mt6797_stp_session *session,
+					const struct mt6797_stp_host_ops *ops,
+					void *context);
+
+/* Put an active session into the vendor's initial BTIF mandatory mode. */
+int mt6797_stp_session_prepare_btif_mandatory(
+					struct mt6797_stp_session *session);
+
+/*
+ * Execute the vendor MT6797 BTIF full-mode preamble:
+ * query default -> set chip STP -> host mode/enable -> 10 ms -> query full.
+ * This never powers ConSys and never supplies fallback success callbacks.
+ */
+int mt6797_stp_session_configure_btif_full(
+					struct mt6797_stp_session *session,
+					unsigned long timeout_jiffies);
+
+/* Send one reliable STP data frame and wait for its cumulative ACK. */
+int mt6797_stp_session_send(struct mt6797_stp_session *session, u8 task,
+				    const u8 *payload, u16 length,
+				    unsigned long timeout_jiffies);
+
+/* Send one WMT command and return the matching event parameters. */
+int mt6797_stp_session_wmt(struct mt6797_stp_session *session, u8 opcode,
+				   const u8 *params, u16 parameter_length,
+				   u8 *response, u16 *response_length,
+				   size_t response_size,
+				   unsigned long timeout_jiffies);
+
+#endif /* __LINUX_MT6797_STP_SESSION_H */
diff --git a/include/linux/mt6797-stp.h b/include/linux/mt6797-stp.h
new file mode 100644
index 000000000..873636556
--- /dev/null
+++ b/include/linux/mt6797-stp.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Wire codec for the MT6797 ConSys STP full-mode transport. */
+#ifndef __LINUX_MT6797_STP_H
+#define __LINUX_MT6797_STP_H
+
+#include <linux/types.h>
+
+#define MT6797_STP_MAX_PAYLOAD	2048
+#define MT6797_STP_HEADER_SIZE	4
+#define MT6797_STP_CRC_SIZE	2
+
+struct mt6797_stp_frame {
+	u8 sequence;
+	u8 acknowledgement;
+	u8 packet_type;
+	bool nak;
+	bool has_crc;
+	const u8 *payload;
+	u16 payload_length;
+};
+
+struct mt6797_stp_decoder {
+	u8 header[MT6797_STP_HEADER_SIZE];
+	u8 payload[MT6797_STP_MAX_PAYLOAD];
+	u16 payload_length;
+	u16 payload_position;
+	u8 crc[MT6797_STP_CRC_SIZE];
+	u8 crc_position;
+	u8 header_position;
+	u8 state;
+	bool mandatory;
+	u32 bad_frames;
+};
+
+typedef int (*mt6797_stp_frame_cb)(void *context,
+					 const struct mt6797_stp_frame *frame);
+
+u16 mt6797_stp_crc16(const u8 *data, size_t length);
+ssize_t mt6797_stp_encode_frame(u8 *out, size_t out_size, u8 packet_type,
+				 u8 sequence, u8 acknowledgement, bool nak,
+				 const u8 *payload, u16 payload_length,
+				 bool delimiter);
+ssize_t mt6797_stp_encode_mandatory_frame(u8 *out, size_t out_size,
+						  u8 packet_type,
+						  const u8 *payload,
+						  u16 payload_length,
+						  bool delimiter);
+ssize_t mt6797_stp_encode_wmt(u8 *out, size_t out_size, u8 opcode,
+				      const u8 *params, u16 parameter_length);
+void mt6797_stp_decoder_init(struct mt6797_stp_decoder *decoder);
+void mt6797_stp_decoder_set_mandatory(struct mt6797_stp_decoder *decoder,
+					       bool mandatory);
+int mt6797_stp_decoder_feed(struct mt6797_stp_decoder *decoder,
+				    const u8 *data, size_t length,
+				    mt6797_stp_frame_cb callback, void *context);
+
+#endif /* __LINUX_MT6797_STP_H */
diff --git a/include/linux/mt6797-wlan-hif.h b/include/linux/mt6797-wlan-hif.h
new file mode 100644
index 000000000..2cf0b685c
--- /dev/null
+++ b/include/linux/mt6797-wlan-hif.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MT6797 WLAN AHB sdioLike host interface.
+ *
+ * The HIF is not an ARM register file and it is not an MMC SDIO host.  A
+ * caller must first obtain the WLAN function through the ConSys/WMT owner;
+ * only then may it claim this interface and issue the indirect CMD53 PIO
+ * operation below.  Probe and claim deliberately do not touch the HIF
+ * window.
+ */
+#ifndef __LINUX_MT6797_WLAN_HIF_H
+#define __LINUX_MT6797_WLAN_HIF_H
+
+#include <linux/device.h>
+#include <linux/interrupt.h>
+#include <linux/types.h>
+
+#define MT6797_WLAN_HIF_WCIR		0x0000
+
+/* Call only after the WMT WLAN function-on transaction succeeded. */
+int mt6797_wlan_hif_claim(struct device *client);
+int mt6797_wlan_hif_release(struct device *client);
+
+/* 32-bit CMD53 byte-mode access to the WLAN function's register window. */
+int mt6797_wlan_hif_pio_read(struct device *client, u32 address, u32 *value);
+int mt6797_wlan_hif_pio_write(struct device *client, u32 address, u32 value);
+int mt6797_wlan_hif_wcir_read(struct device *client, u32 *value);
+int mt6797_wlan_hif_function(struct device *client, bool enabled);
+int mt6797_wlan_hif_transfer(struct device *client, u32 port, bool write,
+			     void *buffer, size_t length);
+int mt6797_wlan_hif_mask_irq(struct device *client, bool masked);
+int mt6797_wlan_hif_request_threaded_irq(struct device *client,
+			irq_handler_t thread, const char *name, void *data);
+
+/* IRQ ownership is separate from the HIF claim and is explicitly deferred. */
+int mt6797_wlan_hif_request_irq(struct device *client, irq_handler_t handler,
+				unsigned long flags, const char *name, void *data);
+int mt6797_wlan_hif_free_irq(struct device *client, void *data);
+int mt6797_wlan_hif_enable_irq(struct device *client);
+int mt6797_wlan_hif_disable_irq(struct device *client);
+
+#endif /* __LINUX_MT6797_WLAN_HIF_H */
diff --git a/include/linux/mt6797-wmt.h b/include/linux/mt6797-wmt.h
new file mode 100644
index 000000000..e80db0a3a
--- /dev/null
+++ b/include/linux/mt6797-wmt.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_MT6797_WMT_H
+#define __LINUX_MT6797_WMT_H
+
+#include <linux/types.h>
+
+struct device;
+struct mt6797_stp_session;
+struct mt6797_wmt_client;
+
+struct mt6797_wmt_client_ops {
+	/* Queue received bytes; callbacks must not call blocking WMT APIs. */
+	void (*receive)(void *context, const u8 *data, size_t length);
+};
+
+struct mt6797_wmt_client *mt6797_wmt_client_get(struct device *dev, u8 task,
+				const struct mt6797_wmt_client_ops *ops, void *context);
+void mt6797_wmt_client_put(struct mt6797_wmt_client *client);
+int mt6797_wmt_client_open(struct mt6797_wmt_client *client);
+int mt6797_wmt_client_close(struct mt6797_wmt_client *client);
+int mt6797_wmt_client_send(struct mt6797_wmt_client *client,
+			   const void *data, size_t length);
+/* Queue a bounded reset of all registered radios; completion is asynchronous. */
+int mt6797_wmt_client_recover(struct mt6797_wmt_client *client, int reason);
+int mt6797_wmt_wifi_emi_write(struct mt6797_wmt_client *client, u32 offset,
+			    const void *data, size_t length);
+int mt6797_wmt_client_version(struct mt6797_wmt_client *client, u32 *hw, u32 *fw);
+int mt6797_wmt_client_cpupcr(struct mt6797_wmt_client *client, u32 *value);
+
+#define MT6797_WMT_CALIBRATION_MAX 2044
+
+struct mt6797_wmt_calibration {
+	u32 hw_version;
+	u32 fw_version;
+	u16 length;
+	u8 data[MT6797_WMT_CALIBRATION_MAX];
+};
+
+struct mt6797_wmt_config {
+	u8 antenna_mode;
+	u8 fm_transport;
+	bool co_clock;
+};
+
+/* Caller owns the powered ConSys/STP session for the complete transaction. */
+int mt6797_wmt_read_version(struct device *dev,
+			    struct mt6797_stp_session *session,
+			    u32 *hw_version, u32 *fw_version);
+int mt6797_wmt_download_patches(struct device *dev,
+				struct mt6797_stp_session *session,
+				void *host_context, u32 hw_version, u32 fw_version);
+int mt6797_wmt_function_control(struct device *dev,
+				struct mt6797_stp_session *session,
+				u8 function, bool enabled);
+int mt6797_wmt_post_patch_init(struct device *dev,
+			      struct mt6797_stp_session *session,
+			      void *host_context, const struct mt6797_wmt_config *config,
+			      struct mt6797_wmt_calibration *calibration);
+int mt6797_wmt_bootstrap(struct device *dev, struct mt6797_stp_session *session,
+			 void *host_context, const struct mt6797_wmt_config *config,
+			      struct mt6797_wmt_calibration *calibration);
+
+#endif
