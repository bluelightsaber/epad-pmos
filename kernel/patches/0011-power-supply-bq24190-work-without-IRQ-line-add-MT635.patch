From daeb5466bdcdea76b797468e63b780b87d0005b2 Mon Sep 17 00:00:00 2001
From: bluelightsaber <26096600+bluelightsaber@users.noreply.github.com>
Date: Fri, 23 Oct 2026 00:20:03 +0200
Subject: [PATCH 11/20] power: supply: bq24190: work without IRQ line; add
 MT6351 fuel gauge (FGADC) driver

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/Kconfig           |   7 +
 drivers/power/supply/Makefile          |   1 +
 drivers/power/supply/bq24190_charger.c |  44 ++-
 drivers/power/supply/mt6351-battery.c  | 487 +++++++++++++++++++++++++
 4 files changed, 527 insertions(+), 12 deletions(-)
 create mode 100644 drivers/power/supply/mt6351-battery.c

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index f0ede1cec..d007ab1f0 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -778,6 +778,13 @@ config CHARGER_BQ2415X
 	  You'll need this driver to charge batteries on e.g. Nokia
 	  RX-51/N900.
 
+config BATTERY_MT6351
+	tristate "MT6351 AUXADC battery voltage/temperature (E-PAD)"
+	depends on MTK_PMIC_WRAP || COMPILE_TEST
+	help
+	  Battery voltage, temperature and OCV-based capacity estimate read
+	  through the MT6351 PMIC AUXADC.
+
 config CHARGER_BQ24190
 	tristate "TI BQ24190 battery charger driver"
