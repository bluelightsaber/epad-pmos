diff --git a/drivers/power/supply/bq24190_charger.c b/drivers/power/supply/bq24190_charger.c
index 8e28f86ae..a8951c097 100644
--- a/drivers/power/supply/bq24190_charger.c
+++ b/drivers/power/supply/bq24190_charger.c
@@ -220,7 +220,10 @@ enum bq24190_chip {
  * to the user, have the interrupt handler save the reg's value and retrieve
  * it in the appropriate health/status routine.
  */
+#define BQ24190_POLL_MS 5000
+
 struct bq24190_dev_info {
+	struct delayed_work		poll_work;	/* E-PAD: sin línea INT */
 	struct i2c_client		*client;
 	struct device			*dev;
 	struct extcon_dev		*edev;
@@ -1906,6 +1909,16 @@ static int bq24296_check_chip(struct bq24190_dev_info *bdi)
 	return 0;
 }
 
+/* E-PAD: sin línea INT, hacer periódicamente lo mismo que el manejador de la interrupción. */
+static void bq24190_poll_work(struct work_struct *work)
+{
+	struct bq24190_dev_info *bdi = container_of(to_delayed_work(work), struct bq24190_dev_info,
+						    poll_work);
+
+	bq24190_irq_handler_thread(0, bdi);
+	schedule_delayed_work(&bdi->poll_work, msecs_to_jiffies(BQ24190_POLL_MS));
+}
+
 static int bq24190_hw_init(struct bq24190_dev_info *bdi)
 {
 	int ret;
@@ -2095,10 +2108,9 @@ static int bq24190_probe(struct i2c_client *client)
 
 	i2c_set_clientdata(client, bdi);
 
-	if (client->irq <= 0) {
-		dev_err(dev, "Can't get irq info\n");
-		return -EINVAL;
-	}
+	/* E-PAD: la línea INT del bq24296 no está conectada; se sondea el estado (ver bq24190_poll_work). */
+	if (client->irq <= 0)
+		dev_info(dev, "sin IRQ: estado sondeado cada %u ms\n", BQ24190_POLL_MS);
 
 	bdi->edev = devm_extcon_dev_allocate(dev, bq24190_usb_extcon_cable);
 	if (IS_ERR(bdi->edev))
@@ -2165,20 +2177,28 @@ static int bq24190_probe(struct i2c_client *client)
 
 	bdi->initialized = true;
 
-	ret = devm_request_threaded_irq(dev, client->irq, NULL,
-			bq24190_irq_handler_thread,
-			IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
-			"bq24190-charger", bdi);
-	if (ret < 0) {
-		dev_err(dev, "Can't set up irq handler\n");
-		goto out_charger;
+	if (client->irq > 0) {
+		ret = devm_request_threaded_irq(dev, client->irq, NULL,
+				bq24190_irq_handler_thread,
+				IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
+				"bq24190-charger", bdi);
+		if (ret < 0) {
+			dev_err(dev, "Can't set up irq handler\n");
+			goto out_charger;
+		}
+	} else {
+		ret = devm_delayed_work_autocancel(dev, &bdi->poll_work, bq24190_poll_work);
+		if (ret < 0)
+			goto out_charger;
+		schedule_delayed_work(&bdi->poll_work, msecs_to_jiffies(BQ24190_POLL_MS));
 	}
 
 	ret = bq24190_register_vbus_regulator(bdi);
 	if (ret < 0)
 		goto out_charger;
 
-	enable_irq_wake(client->irq);
+	if (client->irq > 0)
+		enable_irq_wake(client->irq);
 
 	pm_runtime_put_autosuspend(dev);
 
diff --git a/drivers/power/supply/mt6351-battery.c b/drivers/power/supply/mt6351-battery.c
new file mode 100644
index 000000000..e449d4acb
--- /dev/null
+++ b/drivers/power/supply/mt6351-battery.c
@@ -0,0 +1,487 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Batería de la E-PAD medida con el AUXADC del PMIC MT6351 (detrás del PMIC wrapper).
+ *
+ * Mínimo frente al fuel gauge de MediaTek: tensión (canal BATSNS) y una capacidad estimada con la curva OCV de fábrica a 25 °C (battery_profile_t2 del DT de Android). Sin
+ * contador de culombios: con el cargador activo la tensión está por encima de la OCV y la capacidad sale
+ * algo alta. La temperatura (NTC en BATON) se lee pero NO se publica: con la tabla y el pull-up de fábrica sale
+ * ~7 °C; el Android de fábrica no la usa (FIXED_TBAT_25: informa siempre 25,0 °C). Registros y conversiones de pmic_auxadc.c y battery_meter_hal.c del kernel 3.18.
+ *
+ * Corriente instantánea con el FGADC (fgauge_read_current() de battery_meter_hal.c): 158,122 µA por LSB,
+ * ×20/r_fg_value (10 mΩ) y ×car_tune_value/100 (129) del DT de fábrica; positiva cargando.
+ *
+ * También detecta el tipo de cargador USB (BC1.2 del MT6351, pmic_chr_type_det.c) al aparecer VBUS y lo publica
+ * como fuente «usb» del bq24190, que ajusta su límite de entrada (CURRENT_MAX) solo.
+ */
+#include <linux/delay.h>
+#include <linux/devm-helpers.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/math64.h>
+#include <linux/regmap.h>
+
+#define MT6351_TOP_CKPDN_CON0_CLR	0x023e
+#define MT6351_AUXADC_SMPS_CK_PDN	BIT(9)
+#define MT6351_AUXADC_CON0_SET		0x0ea4
+#define MT6351_AUXADC_CK_AON		BIT(15)
+#define MT6351_AUXADC_RQST0_SET		0x0e98
+#define MT6351_AUXADC_ADC3		0x0e06	/* BATON, 12 bits */
+#define MT6351_AUXADC_ADC23		0x0e2e	/* BATSNS pedido por el AP, 15 bits */
+#define MT6351_AUXADC_RDY		BIT(15)
+
+#define MT6351_CHR_CON0			0x0f78
+#define MT6351_CHRDET			BIT(5)
+#define MT6351_CHR_CON20		0x0fa0	/* BB_CTRL[0] RST[1] VSRC_EN[3:2] CMP_OUT[7] */
+#define MT6351_CHR_CON21		0x0fa2	/* VREF_VTH[1:0] CMP_EN[3:2] IPD_EN[5:4] IPU_EN[7:6] BIAS_EN[8] */
+#define BC11_VSRC_EN(x)			((x) << 2)
+#define BC11_CMP_OUT			BIT(7)
+#define BC11_VREF_VTH(x)		(x)
+#define BC11_CMP_EN(x)			((x) << 2)
+#define BC11_IPD_EN(x)			((x) << 4)
+#define BC11_IPU_EN(x)			((x) << 6)
+#define BC11_BIAS_EN			BIT(8)
+
+#define U2PHY_ACR6			0x018
+#define U2PHY_BC11_SW_EN		BIT(23)
+#define U2PHY_DTM1			0x06c
+#define U2PHY_VBUS_BITS			(BIT(5) | BIT(4) | BIT(3) | BIT(2))	/* VBUSVALID SESSEND BVALID AVALID */
+#define U2PHY_VBUS_ON			(BIT(5) | BIT(3) | BIT(2))
+#define U2PHY_VBUS_OFF			BIT(4)
+
+#define MT6351_TOP_CKPDN_CON2_CLR	0x024a
+#define MT6351_FGADC_CK_PDN		(BIT(2) | BIT(3))	/* analógico y digital */
+#define MT6351_FGADC_CON0		0x0ca4
+#define MT6351_FGADC_CON11		0x0cba	/* FG_CURRENT_OUT */
+#define MT6351_FG_LATCHDATA_ST		BIT(10)
+#define FG_UA_PER_LSB_X1000		158122
+#define FG_R_FG_MOHM			10
+#define FG_CAR_TUNE			129
+
+#define CH_BATSNS	0
+#define CH_BATON	3
+
+#define FULL_RANGE_MV	1800
+#define NTC_PULLUP_OHM	24000	/* rbat_pull_up_r */
+#define NTC_PULLUP_MV	1800	/* rbat_pull_up_volt */
+
+struct mt6351_bat {
+	struct device *dev;
+	struct regmap *regmap;
+	struct mutex lock;
+	struct power_supply *psy;
+	struct power_supply *usb;
+	void __iomem *u2phy;
+	struct delayed_work work;
+	bool online;
+	int usb_type;
+	int current_max;
+};
+
+/* battery_profile_t2 (25 °C): tensión en mV para una profundidad de descarga de 0..100 %. */
+static const u16 ocv_mv[101] = {
+	4342, 4328, 4316, 4303, 4291, 4280, 4268, 4257, 4246, 4234, 4223, 4212, 4202, 4191, 4180, 4170,
+	4159, 4149, 4138, 4128, 4117, 4107, 4096, 4086, 4077, 4071, 4066, 4043, 4026, 4011, 3999, 3989,
+	3981, 3975, 3972, 3968, 3961, 3953, 3945, 3935, 3923, 3910, 3897, 3887, 3879, 3871, 3865, 3858,
+	3853, 3847, 3842, 3837, 3832, 3828, 3823, 3819, 3815, 3812, 3808, 3804, 3801, 3798, 3795, 3792,
+	3790, 3787, 3785, 3782, 3780, 3777, 3775, 3772, 3769, 3766, 3763, 3761, 3757, 3754, 3747, 3744,
+	3741, 3737, 3733, 3726, 3720, 3715, 3709, 3701, 3694, 3692, 3690, 3689, 3688, 3686, 3683, 3675,
+	3651, 3610, 3558, 3491, 3400,
+};
+
+/* batt_temperature_table: (°C, ohmios) */
+static const int ntc_table[][2] = {
+	{ -20, 68237 }, { -15, 53650 }, { -10, 42506 }, { -5, 33892 }, { 0, 27219 }, { 5, 22021 },
+	{ 10, 17926 }, { 15, 14674 }, { 20, 12081 }, { 25, 10000 }, { 30, 8315 }, { 35, 6948 },
+	{ 40, 5834 }, { 45, 4917 }, { 50, 4161 }, { 55, 3535 }, { 60, 3014 },
+};
+
+static int mt6351_bat_adc(struct mt6351_bat *b, unsigned int ch, unsigned int reg, u32 mask, u32 *val)
+{
+	int ret, i;
+	u32 v;
+
+	mutex_lock(&b->lock);
+	regmap_write(b->regmap, MT6351_TOP_CKPDN_CON0_CLR, MT6351_AUXADC_SMPS_CK_PDN);
+	regmap_write(b->regmap, MT6351_AUXADC_CON0_SET, MT6351_AUXADC_CK_AON);
+	ret = regmap_write(b->regmap, MT6351_AUXADC_RQST0_SET, BIT(ch));
+	if (ret)
+		goto out;
+	udelay(50);
+	for (i = 0; i < 50; i++) {
+		ret = regmap_read(b->regmap, reg, &v);
+		if (ret)
+			goto out;
+		if (v & MT6351_AUXADC_RDY) {
+			*val = v & mask;
+			goto out;
+		}
+		usleep_range(1000, 1500);
+	}
+	ret = -ETIMEDOUT;
+out:
+	mutex_unlock(&b->lock);
+	return ret;
+}
+
+static int mt6351_bat_voltage_mv(struct mt6351_bat *b, int *mv)
+{
+	u32 raw;
+	int ret = mt6351_bat_adc(b, CH_BATSNS, MT6351_AUXADC_ADC23, 0x7fff, &raw);
+
+	if (!ret)
+		*mv = raw * 3 * FULL_RANGE_MV / 32768;
+	return ret;
+}
+
+static int mt6351_fg_wait(struct mt6351_bat *b, bool set)
+{
+	u32 v;
+
+	return regmap_read_poll_timeout(b->regmap, MT6351_FGADC_CON0, v, !!(v & MT6351_FG_LATCHDATA_ST) == set,
+					100, 20000);
+}
+
+/* Corriente en µA (positiva cargando). */
+static int mt6351_bat_current_ua(struct mt6351_bat *b, int *ua)
+{
+	u32 raw = 0;
+	int ret;
+
+	mutex_lock(&b->lock);
+	regmap_update_bits(b->regmap, MT6351_FGADC_CON0, 0xff00, 0x0200);	/* leer */
+	ret = mt6351_fg_wait(b, true);
+	if (!ret)
+		ret = regmap_read(b->regmap, MT6351_FGADC_CON11, &raw);
+	regmap_update_bits(b->regmap, MT6351_FGADC_CON0, 0xff00, 0x0800);	/* borrar estado */
+	mt6351_fg_wait(b, false);
+	regmap_update_bits(b->regmap, MT6351_FGADC_CON0, 0xff00, 0);
+	mutex_unlock(&b->lock);
+	if (ret)
+		return ret;
+	*ua = div_s64((s64)(s16)raw * FG_UA_PER_LSB_X1000 * 20 / FG_R_FG_MOHM * FG_CAR_TUNE, 100 * 1000);
+	return 0;
+}
+
+static void mt6351_fg_init(struct mt6351_bat *b)
+{
+	u32 v = 0;
+
+	/* battery_meter_hal.c: relojes, modo corriente con autocalibración a 32 kHz y activar (sin resetear el CAR) */
+	regmap_write(b->regmap, MT6351_TOP_CKPDN_CON2_CLR, MT6351_FGADC_CK_PDN);
+	regmap_read(b->regmap, MT6351_FGADC_CON0, &v);
+	if ((v & 0xff) != 0x29) {
+		regmap_update_bits(b->regmap, MT6351_FGADC_CON0, 0xff, 0x28);
+		regmap_update_bits(b->regmap, MT6351_FGADC_CON0, 0xff, 0x29);
+	}
+	dev_info(b->dev, "FGADC_CON0 0x%04x\n", v);
+}
+
+static int mt6351_bat_capacity(int mv)
+{
+	int i;
+
+	if (mv >= ocv_mv[0])
+		return 100;
+	for (i = 1; i < ARRAY_SIZE(ocv_mv); i++)
+		if (mv >= ocv_mv[i])
+			/* entre DOD i-1 e i: interpolar */
+			return 100 - i + (mv - ocv_mv[i]) / max(1, (ocv_mv[i - 1] - ocv_mv[i]));
+	return 0;
+}
+
+/* Temperatura en décimas de °C a partir de la tensión del divisor NTC. */
+static int mt6351_bat_temp(struct mt6351_bat *b, int *temp)
+{
+	int i, mv, r;
+	u32 raw;
+	int ret = mt6351_bat_adc(b, CH_BATON, MT6351_AUXADC_ADC3, 0xfff, &raw);
+
+	if (ret)
+		return ret;
+	mv = raw * 2 * FULL_RANGE_MV / 4096;
+	if (mv <= 0 || mv >= NTC_PULLUP_MV)
+		return -ENODATA;
+	r = NTC_PULLUP_OHM * mv / (NTC_PULLUP_MV - mv);
+	if (r >= ntc_table[0][1]) {
+		*temp = ntc_table[0][0] * 10;
+		return 0;
+	}
+	for (i = 1; i < ARRAY_SIZE(ntc_table); i++) {
+		if (r >= ntc_table[i][1]) {
+			int r0 = ntc_table[i - 1][1], r1 = ntc_table[i][1];
+			int t0 = ntc_table[i - 1][0], t1 = ntc_table[i][0];
+
+			*temp = t0 * 10 + (t1 - t0) * 10 * (r0 - r) / (r0 - r1);
+			return 0;
+		}
+	}
+	*temp = ntc_table[ARRAY_SIZE(ntc_table) - 1][0] * 10;
+	return 0;
+}
+
+static int mt6351_bat_get_property(struct power_supply *psy, enum power_supply_property psp,
+				   union power_supply_propval *val)
+{
+	struct mt6351_bat *b = power_supply_get_drvdata(psy);
+	int ret, mv;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = mt6351_bat_voltage_mv(b, &mv);
+		val->intval = mv * 1000;
+		return ret;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = mt6351_bat_voltage_mv(b, &mv);
+		val->intval = mt6351_bat_capacity(mv);
+		return ret;
+	case POWER_SUPPLY_PROP_TEMP:
+		return mt6351_bat_temp(b, &val->intval);
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		return mt6351_bat_current_ua(b, &val->intval);
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = 4352000;
+		return 0;
+	case POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN:
+		val->intval = 3400000;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const enum power_supply_property mt6351_bat_props[] = {
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MIN_DESIGN,
+};
+
+static const struct power_supply_desc mt6351_bat_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = mt6351_bat_props,
+	.num_properties = ARRAY_SIZE(mt6351_bat_props),
+	.get_property = mt6351_bat_get_property,
+};
+
+/* Un paso de BC1.2: programar CHR_CON20/21, esperar y leer el comparador; vuelve a dejar CON21 en reposo. */
+static bool mt6351_bc11_step(struct mt6351_bat *b, u32 con20, u32 con21)
+{
+	u32 v = 0;
+
+	regmap_update_bits(b->regmap, MT6351_CHR_CON20, BC11_VSRC_EN(3), con20);
+	regmap_write(b->regmap, MT6351_CHR_CON21, BC11_BIAS_EN | con21);
+	msleep(80);
+	regmap_read(b->regmap, MT6351_CHR_CON20, &v);
+	regmap_write(b->regmap, MT6351_CHR_CON21, BC11_BIAS_EN);
+	return v & BC11_CMP_OUT;
+}
+
+/*
+ * La PHY no ve VBUS y tphy lo fuerza a «presente», así que el gadget conecta D+ aunque no haya cable. Aquí se
+ * fuerza según CHRDET: sin VBUS el controlador suelta D+, y al enchufar no conecta hasta terminar BC1.2 (con el
+ * host enviando tráfico la detección sale mal: CDP en vez de SDP).
+ */
+static void mt6351_u2phy_vbus(struct mt6351_bat *b, bool on)
+{
+	u32 v;
+
+	if (!b->u2phy)
+		return;
+	v = readl(b->u2phy + U2PHY_DTM1) & ~U2PHY_VBUS_BITS;
+	writel(v | (on ? U2PHY_VBUS_ON : U2PHY_VBUS_OFF), b->u2phy + U2PHY_DTM1);
+}
+
+/* hw_charging_get_charger_type() del kernel 3.18. */
+static void mt6351_bc11_detect(struct mt6351_bat *b)
+{
+	const char *name;
+
+	/* La PHY suelta D+/D- al detector (Charger_Detect_Init). */
+	if (b->u2phy)
+		writel(readl(b->u2phy + U2PHY_ACR6) | U2PHY_BC11_SW_EN, b->u2phy + U2PHY_ACR6);
+	regmap_write(b->regmap, MT6351_CHR_CON21, BC11_BIAS_EN);
+	regmap_write(b->regmap, MT6351_CHR_CON20, BIT(1) | BIT(0));
+	msleep(50);
+
+	if (mt6351_bc11_step(b, 0, BC11_IPU_EN(2) | BC11_IPD_EN(1) | BC11_VREF_VTH(1) | BC11_CMP_EN(2))) {
+		/* DCD sin contacto: no es un puerto BC1.2 */
+		if (mt6351_bc11_step(b, 0, BC11_IPD_EN(1) | BC11_CMP_EN(1))) {
+			name = "Apple 2,1 A";
+			b->usb_type = POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID;
+			b->current_max = 2000000;
+		} else {
+			name = "no estándar";
+			b->usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+			b->current_max = 1000000;
+		}
+	} else if (mt6351_bc11_step(b, BC11_VSRC_EN(2), BC11_IPD_EN(1) | BC11_CMP_EN(1))) {
+		regmap_update_bits(b->regmap, MT6351_CHR_CON20, BC11_VSRC_EN(3), 0);
+		if (mt6351_bc11_step(b, 0, BC11_IPU_EN(2) | BC11_VREF_VTH(1) | BC11_CMP_EN(1))) {
+			name = "DCP";
+			b->usb_type = POWER_SUPPLY_USB_TYPE_DCP;
+			b->current_max = 2000000;
+		} else {
+			name = "CDP";
+			b->usb_type = POWER_SUPPLY_USB_TYPE_CDP;
+			b->current_max = 1500000;
+		}
+	} else {
+		name = "SDP";
+		b->usb_type = POWER_SUPPLY_USB_TYPE_SDP;
+		b->current_max = 500000;
+	}
+
+	regmap_write(b->regmap, MT6351_CHR_CON20, 0);
+	regmap_write(b->regmap, MT6351_CHR_CON21, 0);
+	if (b->u2phy)
+		writel(readl(b->u2phy + U2PHY_ACR6) & ~U2PHY_BC11_SW_EN, b->u2phy + U2PHY_ACR6);
+	dev_info(b->dev, "cargador USB: %s (%d mA)\n", name, b->current_max / 1000);
+}
+
+/* Sin IRQ: sondear CHRDET y repetir la detección al enchufar. */
+static void mt6351_usb_work(struct work_struct *work)
+{
+	struct mt6351_bat *b = container_of(work, struct mt6351_bat, work.work);
+	u32 v = 0;
+	bool online;
+
+	regmap_read(b->regmap, MT6351_CHR_CON0, &v);
+	online = v & MT6351_CHRDET;
+	if (online != b->online) {
+		b->online = online;
+		mt6351_u2phy_vbus(b, false);
+		if (online) {
+			msleep(100);	/* que el host vea la desconexión */
+			mt6351_bc11_detect(b);
+			mt6351_u2phy_vbus(b, true);
+		} else {
+			b->usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+		}
+		power_supply_changed(b->usb);
+	}
+	schedule_delayed_work(&b->work, HZ);
+}
+
+static int mt6351_usb_get_property(struct power_supply *psy, enum power_supply_property psp,
+				   union power_supply_propval *val)
+{
+	struct mt6351_bat *b = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = b->online;
+		return 0;
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		val->intval = b->usb_type;
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_MAX:
+		if (!b->online)
+			return -ENODATA;
+		val->intval = b->current_max;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const enum power_supply_property mt6351_usb_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_USB_TYPE,
+	POWER_SUPPLY_PROP_CURRENT_MAX,
+};
+
+static const struct power_supply_desc mt6351_usb_desc = {
+	.name = "usb",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.usb_types = BIT(POWER_SUPPLY_USB_TYPE_SDP) | BIT(POWER_SUPPLY_USB_TYPE_DCP) |
+		     BIT(POWER_SUPPLY_USB_TYPE_CDP) | BIT(POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID) |
+		     BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN),
+	.properties = mt6351_usb_props,
+	.num_properties = ARRAY_SIZE(mt6351_usb_props),
+	.get_property = mt6351_usb_get_property,
+};
+
+static char *mt6351_usb_supplied_to[] = { "bq24190-charger" };
+
+static int mt6351_bat_probe(struct platform_device *pdev)
+{
+	struct power_supply_config cfg = {};
+	struct device_node *np;
+	struct mt6351_bat *b;
+	int ret, mv, t = 0;
+
+	b = devm_kzalloc(&pdev->dev, sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+	b->dev = &pdev->dev;
+	mutex_init(&b->lock);
+	b->regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!b->regmap)
+		return dev_err_probe(&pdev->dev, -ENODEV, "sin regmap del PMIC wrapper\n");
+
+	if (mt6351_bat_voltage_mv(b, &mv))
+		return dev_err_probe(&pdev->dev, -EIO, "AUXADC BATSNS no responde\n");
+	mt6351_fg_init(b);
+	mt6351_bat_temp(b, &t);
+	dev_info(&pdev->dev, "batería %d mV (~%d %%), %d.%d °C\n", mv, mt6351_bat_capacity(mv), t / 10,
+		 abs(t % 10));
+
+	cfg.drv_data = b;
+	cfg.fwnode = dev_fwnode(&pdev->dev);
+	b->psy = devm_power_supply_register(&pdev->dev, &mt6351_bat_desc, &cfg);
+	if (IS_ERR(b->psy))
+		return PTR_ERR(b->psy);
+
+	/* PHY USB2 (tphy, banco COM): VBUS para el gadget y D+/D- para la detección; opcional. */
+	np = of_parse_phandle(pdev->dev.of_node, "mediatek,u2phy", 0);
+	if (np) {
+		b->u2phy = of_iomap(np, 0);
+		of_node_put(np);
+	}
+	b->usb_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	cfg.fwnode = NULL;
+	cfg.supplied_to = mt6351_usb_supplied_to;
+	cfg.num_supplicants = ARRAY_SIZE(mt6351_usb_supplied_to);
+	b->usb = devm_power_supply_register(&pdev->dev, &mt6351_usb_desc, &cfg);
+	if (IS_ERR(b->usb))
+		return PTR_ERR(b->usb);
+	ret = devm_delayed_work_autocancel(&pdev->dev, &b->work, mt6351_usb_work);
+	if (ret)
+		return ret;
+	/* La primera detección, cuando la PHY ya tenga reloj (mtu3 la enciende al arrancar el gadget). */
+	schedule_delayed_work(&b->work, 5 * HZ);
+	return 0;
+}
+
+static const struct of_device_id mt6351_bat_of_match[] = {
+	{ .compatible = "mediatek,mt6351-battery" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6351_bat_of_match);
+
+static struct platform_driver mt6351_bat_driver = {
+	.driver = {
+		.name = "mt6351-battery",
+		.of_match_table = mt6351_bat_of_match,
+	},
+	.probe = mt6351_bat_probe,
+};
+module_platform_driver(mt6351_bat_driver);
+
+MODULE_DESCRIPTION("MT6351 AUXADC battery voltage and BC1.2 charger detection (E-PAD)");
+MODULE_LICENSE("GPL");
