From 2ab744a1a258f5954efd8e3afcc708d11100a802 Mon Sep 17 00:00:00 2001
From: bluelightsaber <26096600+bluelightsaber@users.noreply.github.com>
Date: Mon, 2 Nov 2026 01:16:51 +0100
Subject: [PATCH 32/51] soc: mediatek: mmsys, mutex: add MT6797 display routing
 (RDMA0 to DSI0)

Routing for the vendor primary_rdma0_disp scenario and the MT6797 mutex
module bits (from the vendor ddp_path.c). The MT6797 mutex has no clock gate.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/soc/mediatek/mt6797-mmsys.h | 25 +++++++++++++++
 drivers/soc/mediatek/mtk-mmsys.c    |  3 ++
 drivers/soc/mediatek/mtk-mutex.c    | 47 +++++++++++++++++++++++++++++
 3 files changed, 75 insertions(+)
 create mode 100644 drivers/soc/mediatek/mt6797-mmsys.h

diff --git a/drivers/soc/mediatek/mt6797-mmsys.h b/drivers/soc/mediatek/mt6797-mmsys.h
new file mode 100644
index 000000000000..7849d1a932eb
--- /dev/null
+++ b/drivers/soc/mediatek/mt6797-mmsys.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef __SOC_MEDIATEK_MT6797_MMSYS_H
+#define __SOC_MEDIATEK_MT6797_MMSYS_H
+
+#define MT6797_DISP_REG_CONFIG_DSI0_SEL_IN		0x07c
+#define MT6797_DISP_REG_CONFIG_DISP_RDMA0_SOUT_SEL_IN	0x090
+
+#define MT6797_RDMA0_SOUT_DSI0				0x2
+#define MT6797_RDMA0_SOUT_MASK				0x7
+
+#define MT6797_DSI0_SEL_IN_RDMA0			0x2
+#define MT6797_DSI0_SEL_IN_MASK				0x7
+
+/* RDMA0 straight to DSI0 (the vendor "primary_rdma0_disp" scenario) */
+static const struct mtk_mmsys_routes mt6797_mmsys_routing_table[] = {
+	MMSYS_ROUTE(RDMA0, DSI0,
+		    MT6797_DISP_REG_CONFIG_DISP_RDMA0_SOUT_SEL_IN, MT6797_RDMA0_SOUT_MASK,
+		    MT6797_RDMA0_SOUT_DSI0),
+	MMSYS_ROUTE(RDMA0, DSI0,
+		    MT6797_DISP_REG_CONFIG_DSI0_SEL_IN, MT6797_DSI0_SEL_IN_MASK,
+		    MT6797_DSI0_SEL_IN_RDMA0),
+};
+
+#endif /* __SOC_MEDIATEK_MT6797_MMSYS_H */
diff --git a/drivers/soc/mediatek/mtk-mmsys.c b/drivers/soc/mediatek/mtk-mmsys.c
index 2f3e0778bb17..1895fd7c3e88 100644
--- a/drivers/soc/mediatek/mtk-mmsys.c
+++ b/drivers/soc/mediatek/mtk-mmsys.c
@@ -14,6 +14,7 @@
 #include <linux/soc/mediatek/mtk-mmsys.h>
 
 #include "mtk-mmsys.h"
+#include "mt6797-mmsys.h"
 #include "mt8167-mmsys.h"
 #include "mt8173-mmsys.h"
 #include "mt8183-mmsys.h"
@@ -51,6 +52,8 @@ static const struct mtk_mmsys_driver_data mt6795_mmsys_driver_data = {
 
 static const struct mtk_mmsys_driver_data mt6797_mmsys_driver_data = {
 	.clk_driver = "clk-mt6797-mm",
+	.routes = mt6797_mmsys_routing_table,
+	.num_routes = ARRAY_SIZE(mt6797_mmsys_routing_table),
 };
 
 static const struct mtk_mmsys_driver_data mt8167_mmsys_driver_data = {
diff --git a/drivers/soc/mediatek/mtk-mutex.c b/drivers/soc/mediatek/mtk-mutex.c
index eb5d381ff5af..abbfb66ec922 100644
--- a/drivers/soc/mediatek/mtk-mutex.c
+++ b/drivers/soc/mediatek/mtk-mutex.c
@@ -121,6 +121,24 @@
 #define MT8186_MUTEX_MOD_MDP_TDSHP0		9
 #define MT8186_MUTEX_MOD_MDP_COLOR0		14
 
+#define MT6797_MUTEX_MOD_DISP_OVL0		10
+#define MT6797_MUTEX_MOD_DISP_OVL1		11
+#define MT6797_MUTEX_MOD_DISP_OVL0_2L		12
+#define MT6797_MUTEX_MOD_DISP_RDMA0		13
+#define MT6797_MUTEX_MOD_DISP_RDMA1		14
+#define MT6797_MUTEX_MOD_DISP_OVL1_2L		15
+#define MT6797_MUTEX_MOD_DISP_WDMA0		16
+#define MT6797_MUTEX_MOD_DISP_WDMA1		17
+#define MT6797_MUTEX_MOD_DISP_COLOR0		18
+#define MT6797_MUTEX_MOD_DISP_CCORR		19
+#define MT6797_MUTEX_MOD_DISP_AAL		20
+#define MT6797_MUTEX_MOD_DISP_GAMMA		21
+#define MT6797_MUTEX_MOD_DISP_OD		22
+#define MT6797_MUTEX_MOD_DISP_DITHER		23
+#define MT6797_MUTEX_MOD_DISP_UFOE		24
+#define MT6797_MUTEX_MOD_DISP_DSC		25
+#define MT6797_MUTEX_MOD_DISP_PWM0		26
+
 #define MT8173_MUTEX_MOD_DISP_OVL0		11
 #define MT8173_MUTEX_MOD_DISP_OVL1		12
 #define MT8173_MUTEX_MOD_DISP_RDMA0		13
@@ -412,6 +430,26 @@ static const u8 mt8167_mutex_mod[DDP_COMPONENT_ID_MAX] = {
 	[DDP_COMPONENT_WDMA0] = MT8167_MUTEX_MOD_DISP_WDMA0,
 };
 
+static const u8 mt6797_mutex_mod[DDP_COMPONENT_ID_MAX] = {
+	[DDP_COMPONENT_AAL0] = MT6797_MUTEX_MOD_DISP_AAL,
+	[DDP_COMPONENT_CCORR] = MT6797_MUTEX_MOD_DISP_CCORR,
+	[DDP_COMPONENT_COLOR0] = MT6797_MUTEX_MOD_DISP_COLOR0,
+	[DDP_COMPONENT_DITHER0] = MT6797_MUTEX_MOD_DISP_DITHER,
+	[DDP_COMPONENT_DSC0] = MT6797_MUTEX_MOD_DISP_DSC,
+	[DDP_COMPONENT_GAMMA] = MT6797_MUTEX_MOD_DISP_GAMMA,
+	[DDP_COMPONENT_OD0] = MT6797_MUTEX_MOD_DISP_OD,
+	[DDP_COMPONENT_OVL0] = MT6797_MUTEX_MOD_DISP_OVL0,
+	[DDP_COMPONENT_OVL1] = MT6797_MUTEX_MOD_DISP_OVL1,
+	[DDP_COMPONENT_OVL_2L0] = MT6797_MUTEX_MOD_DISP_OVL0_2L,
+	[DDP_COMPONENT_OVL_2L1] = MT6797_MUTEX_MOD_DISP_OVL1_2L,
+	[DDP_COMPONENT_PWM0] = MT6797_MUTEX_MOD_DISP_PWM0,
+	[DDP_COMPONENT_RDMA0] = MT6797_MUTEX_MOD_DISP_RDMA0,
+	[DDP_COMPONENT_RDMA1] = MT6797_MUTEX_MOD_DISP_RDMA1,
+	[DDP_COMPONENT_UFOE] = MT6797_MUTEX_MOD_DISP_UFOE,
+	[DDP_COMPONENT_WDMA0] = MT6797_MUTEX_MOD_DISP_WDMA0,
+	[DDP_COMPONENT_WDMA1] = MT6797_MUTEX_MOD_DISP_WDMA1,
+};
+
 static const u8 mt8173_mutex_mod[DDP_COMPONENT_ID_MAX] = {
 	[DDP_COMPONENT_AAL0] = MT8173_MUTEX_MOD_DISP_AAL,
 	[DDP_COMPONENT_COLOR0] = MT8173_MUTEX_MOD_DISP_COLOR0,
@@ -763,6 +801,14 @@ static const struct mtk_mutex_data mt8167_mutex_driver_data = {
 	.no_clk = true,
 };
 
+static const struct mtk_mutex_data mt6797_mutex_driver_data = {
+	.mutex_mod = mt6797_mutex_mod,
+	.mutex_sof = mt8183_mutex_sof,
+	.mutex_mod_reg = MT2701_MUTEX0_MOD0,
+	.mutex_sof_reg = MT2701_MUTEX0_SOF0,
+	.no_clk = true,
+};
+
 static const struct mtk_mutex_data mt8173_mutex_driver_data = {
 	.mutex_mod = mt8173_mutex_mod,
 	.mutex_sof = mt2712_mutex_sof,
@@ -1135,6 +1181,7 @@ static const struct of_device_id mutex_driver_dt_match[] = {
 	{ .compatible = "mediatek,mt2712-disp-mutex", .data = &mt2712_mutex_driver_data },
 	{ .compatible = "mediatek,mt6795-disp-mutex", .data = &mt6795_mutex_driver_data },
 	{ .compatible = "mediatek,mt8167-disp-mutex", .data = &mt8167_mutex_driver_data },
+	{ .compatible = "mediatek,mt6797-disp-mutex", .data = &mt6797_mutex_driver_data },
 	{ .compatible = "mediatek,mt8173-disp-mutex", .data = &mt8173_mutex_driver_data },
 	{ .compatible = "mediatek,mt8183-disp-mutex", .data = &mt8183_mutex_driver_data },
 	{ .compatible = "mediatek,mt8186-disp-mutex", .data = &mt8186_mutex_driver_data },
-- 
2.53.0

