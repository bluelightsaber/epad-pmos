+	struct delayed_work screen_sleep;
+	bool video_hold;	/* despertado de dormir: vídeo siempre en marcha hasta el próximo sueño */
+	unsigned int screen_sleep_tries;
+	u8 *off_img;		/* pantalla de apagado (como sleep_img); la pinta el notificador de apagado */
