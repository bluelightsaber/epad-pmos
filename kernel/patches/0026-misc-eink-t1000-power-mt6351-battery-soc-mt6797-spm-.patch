+static void t1000_refresh_work(struct work_struct *work)
+{
+	struct t1000 *t = container_of(to_delayed_work(work), struct t1000, refresh);
+	int ret;
+
+	if (t->asleep || !t->auto_refresh)
+		return;
+	ret = t1000_set_mode(t, t->mode);
+	if (ret)
+		dev_dbg(&t->client->dev, "refresco automático: %d\n", ret);
+}
+
+void t1000_request_refresh(void)
+{
+	struct t1000 *t = READ_ONCE(t1000_dev);
+
+	/* si ya hay uno en cola no hace nada; si está pintando, queda en cola para después */
+	if (t && t->auto_refresh)
+		queue_delayed_work(system_unbound_wq, &t->refresh, msecs_to_jiffies(refresh_delay_ms));
+}
+EXPORT_SYMBOL_GPL(t1000_request_refresh);
+
+/*
+ * Sueño del T1000 como Android al apagar la pantalla (traza de fábrica): esperar a que esté libre, GPIO 234 a 0 y
+ * orden 0x61 con modo 0x0f. Despertar: GPIO 234 a 1 y esperar HRDY (~0,75 s).
+ */
+#define T1000_MODE_SLEEP	0x0f
+
+static int t1000_sleep(struct t1000 *t)
+{
+	u8 cmd[] = { 0x10, T1000_CMD_SET_MODE, 0x00, 0x00, 0x00, T1000_MODE_SLEEP, 0x00 };
+	int ret;
+
+	mutex_lock(&t->lock);
+	if (t->asleep) {
+		ret = 0;
+		goto out;
+	}
+	ret = t1000_wait_ready(t, 2000);
+	if (ret)
+		goto out;
+	if (t->wakeup)
+		gpiod_set_value_cansleep(t->wakeup, 0);
+	ret = t1000_write(t, cmd, sizeof(cmd));
+	if (!ret) {
+		unsigned int waited;
+
+		/* HRDY baja cuando ya duerme (~90 ms en la traza de Android) */
+		for (waited = 0; waited < 5000 && gpiod_get_value_cansleep(t->hrdy); waited += 10)
+			usleep_range(10000, 11000);
+		if (waited >= 5000)
+			dev_warn(&t->client->dev, "HRDY no baja tras la orden de dormir\n");
+		else
+			dev_dbg(&t->client->dev, "dormido en %u ms\n", waited);
+		t->asleep = true;
+	}
+out:
+	mutex_unlock(&t->lock);
+	return ret;
+}
+
+static int t1000_wake(struct t1000 *t)
+{
+	int ret = 0, i;
+
+	mutex_lock(&t->lock);
+	if (t->asleep) {
+		/* en Android el vídeo MIPI no se para nunca: al despertar el T1000 no se da por listo sin él */
+		bool video = t->video;
+
+		if (t->dsi && !video)
+			t1000_dsi_video(t, true);
+		/* flanco de subida de wakeup; si no se pone listo, repetirlo */
+		for (i = 0; i < 3; i++) {
+			if (t->wakeup) {
+				gpiod_set_value_cansleep(t->wakeup, 0);
+				usleep_range(1000, 2000);
+				gpiod_set_value_cansleep(t->wakeup, 1);
+			}
+			ret = t1000_wait_ready(t, 2000);
+			if (!ret)
+				break;
+		}
+		if (i)
+			dev_info(&t->client->dev, "despertado al intento %d (%d)\n", i + 1, ret);
+		if (t->dsi && !video)
+			t1000_dsi_video(t, false);
+		if (!ret)
+			t->asleep = false;
+	}
+	mutex_unlock(&t->lock);
+	return ret;
+}
