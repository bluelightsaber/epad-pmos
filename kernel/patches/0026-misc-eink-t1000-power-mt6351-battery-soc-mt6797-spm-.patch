+	bool on;
+
+	if (kstrtobool(buf, &on))
+		return -EINVAL;
+	WRITE_ONCE(t->auto_refresh, on);
+	if (!on)
+		cancel_delayed_work_sync(&t->refresh);
+	return n;
+}
+static DEVICE_ATTR_RW(auto_refresh);
