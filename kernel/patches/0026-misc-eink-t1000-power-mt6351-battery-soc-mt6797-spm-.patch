 /* Copia una cadena de la respuesta (bytes por parejas intercambiados) hasta el primer carácter no imprimible. */
 static void t1000_copy_swapped(char *dst, size_t size, const u8 *src, int len)
 {
@@ -382,6 +516,48 @@ static ssize_t video_store(struct device *dev, struct device_attribute *attr, co
 }
 static DEVICE_ATTR_RW(video);
 
+static ssize_t sleep_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct t1000 *t = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", t->asleep);
+}
+
+static ssize_t sleep_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t n)
+{
+	struct t1000 *t = dev_get_drvdata(dev);
+	bool on;
+	int ret;
+
+	if (kstrtobool(buf, &on))
+		return -EINVAL;
+	ret = on ? t1000_sleep(t) : t1000_wake(t);
+	return ret ? ret : n;
+}
+static DEVICE_ATTR_RW(sleep);
+
+static ssize_t auto_refresh_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct t1000 *t = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", t->auto_refresh);
+}
+
+static ssize_t auto_refresh_store(struct device *dev, struct device_attribute *attr, const char *buf,
+				  size_t n)
+{
