 };
 
+/* Solo hay un T1000; simpledrm lo encuentra por aquí. */
+static struct t1000 *t1000_dev;
+
+static unsigned int refresh_delay_ms = 30;
+module_param(refresh_delay_ms, uint, 0644);
+MODULE_PARM_DESC(refresh_delay_ms, "espera para agrupar actualizaciones antes del refresco automático");
+
 #define DSI_START		0x00
 #define DSI_MODE_CTRL		0x14
+#define MMSYS_CG_CON0		0x100
+#define MMSYS_CG_SET0		0x104
+#define MMSYS_CG_CLR0		0x108
+#define MMSYS_CG_CON1		0x110
+#define MMSYS_CG_SET1		0x114
+#define MMSYS_CG_CLR1		0x118
 #define DSI_MODE_SYNC_PULSE	1
 
 #define OVL_SRC_CON		0x2c
@@ -90,6 +118,16 @@ static void t1000_dsi_video(struct t1000 *t, bool on)
 	t->video = on;
 }
 
+static void t1000_dsi_dump(struct t1000 *t, const char *when)
+{
