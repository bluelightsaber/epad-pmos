 }
 
+/*
+ * Suspensión: dormir el T1000 (~130 mA menos). Al reanudar, despertarlo y mandar un refresco con el modo que
+ * tenía: tras el sueño 0x0f no se queda listo sin recibir vídeo MIPI (el refresco lo activa) y, si no, la
+ * siguiente orden de dormir lo deja sin despertar.
+ */
+static bool pm_sleep;	/* el T1000 aún falla al despertar ~1/10: desactivado por omisión */
+module_param(pm_sleep, bool, 0644);
+
+/*
+ * El dominio MM queda encendido al suspender (si se apaga se pierde el pipeline de lk), pero sus relojes en marcha
+ * gastan ~60 mA: cerrarlos todos (los registros se conservan) y al reanudar reabrir los que estaban abiertos.
+ */
+static bool mm_gate = true;
+module_param(mm_gate, bool, 0644);
+
+static void t1000_mm_gate(struct t1000 *t)
+{
+	if (!t->mmsys || !mm_gate)
+		return;
+	t->mm_cg[0] = readl(t->mmsys + MMSYS_CG_CON0);
+	t->mm_cg[1] = readl(t->mmsys + MMSYS_CG_CON1);
+	writel(~0u, t->mmsys + MMSYS_CG_SET0);
+	writel(~0u, t->mmsys + MMSYS_CG_SET1);
+}
+
+static int t1000_suspend(struct device *dev)
+{
+	struct t1000 *t = dev_get_drvdata(dev);
+	int ret;
+
+	cancel_delayed_work_sync(&t->refresh);
+	t->pm_slept = false;
+	if (!pm_sleep || t->asleep) {
+		t1000_mm_gate(t);
+		return 0;
+	}
+	t->pm_mode = t1000_get_mode(t);
+	ret = t1000_sleep(t);
+	if (ret)
+		dev_warn(dev, "no se pudo dormir el T1000 (%d)\n", ret);
+	else
+		t->pm_slept = true;
+	t1000_mm_gate(t);
+	return 0;
+}
+
+static int t1000_resume(struct device *dev)
+{
+	struct t1000 *t = dev_get_drvdata(dev);
+	int ret;
+
+	if (t->dsi)
+		t1000_dsi_dump(t, "al reanudar");
+	if (t->mmsys) {
+		/* reabrir los relojes del display que estaban abiertos */
+		writel(~t->mm_cg[0], t->mmsys + MMSYS_CG_CLR0);
+		writel(~t->mm_cg[1], t->mmsys + MMSYS_CG_CLR1);
+	}
+	if (!t->pm_slept)
+		return 0;
+	ret = t1000_wake(t);
+	if (!ret)
+		ret = t1000_set_mode(t, t1000_mode_allowed(t->pm_mode) && t->pm_mode != 0x10 ? t->pm_mode : 1);
+	if (ret)
+		dev_warn(dev, "el T1000 no despierta bien (%d)\n", ret);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(t1000_pm, t1000_suspend, t1000_resume);
+
