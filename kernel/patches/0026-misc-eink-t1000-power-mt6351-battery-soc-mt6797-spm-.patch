 	return 0;
 }
 
+/*
+ * Carga acumulada en µAh desde que se puso a cero el CAR (positiva cargando): fgauge_read_columb_internal() del
+ * BSP, 17 bits + signo con LSB de 359,86 µAh / 8 (FG_OSR) y el mismo ajuste de R_FG y CAR_TUNE que la corriente.
+ * Sigue contando con la tablet suspendida.
+ */
+static int mt6351_bat_charge_uah(struct mt6351_bat *b, int *uah)
+{
+	u32 hi = 0, lo = 0;
+	s64 car;
+	int ret;
+
+	mutex_lock(&b->lock);
+	regmap_update_bits(b->regmap, MT6351_FGADC_CON0, 0xff00, 0x0200);	/* leer */
+	ret = mt6351_fg_wait(b, true);
+	if (!ret)
+		ret = regmap_read(b->regmap, MT6351_FGADC_CON1, &hi) ?: regmap_read(b->regmap, MT6351_FGADC_CON2, &lo);
+	regmap_update_bits(b->regmap, MT6351_FGADC_CON0, 0xff00, 0x0800);	/* borrar estado */
+	mt6351_fg_wait(b, false);
+	regmap_update_bits(b->regmap, MT6351_FGADC_CON0, 0xff00, 0);
+	mutex_unlock(&b->lock);
+	if (ret)
+		return ret;
+	car = (lo >> 11) | (hi & 0xfff) << 5;
+	if (car == 0x1ffff)
+		car = 0;
+	else if (hi & BIT(15))
+		car -= 0x1ffff;
+	*uah = div_s64(car * 35986 * 20 / FG_R_FG_MOHM * FG_CAR_TUNE, 100 * 8 * 100);
+	return 0;
+}
+
 static void mt6351_fg_init(struct mt6351_bat *b)
 {
 	u32 v = 0;
@@ -249,6 +282,8 @@ static int mt6351_bat_get_property(struct power_supply *psy, enum power_supply_p
 		return mt6351_bat_temp(b, &val->intval);
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
 		return mt6351_bat_current_ua(b, &val->intval);
+	case POWER_SUPPLY_PROP_CHARGE_COUNTER:
+		return mt6351_bat_charge_uah(b, &val->intval);
 	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
 		val->intval = 4352000;
 		return 0;
@@ -266,6 +301,7 @@ static const enum power_supply_property mt6351_bat_props[] = {
