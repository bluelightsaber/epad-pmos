+}
+
 static bool t1000_mode_allowed(unsigned int mode)
 {
 	switch (mode) {
@@ -217,11 +255,107 @@ static int t1000_set_mode(struct t1000 *t, unsigned int mode)
 	} else {
 		ret = t1000_write(t, cmd, sizeof(cmd));
 	}
