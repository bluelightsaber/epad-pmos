# Ajustes de la E-PAD sobre el defconfig de arm64 (Linux 6.12)
CONFIG_ARCH_MEDIATEK=y
CONFIG_PINCTRL_MT6797=y
CONFIG_COMMON_CLK_MT6797=y
CONFIG_I2C_MT65XX=y
CONFIG_I2C_CHARDEV=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_SIMPLEDRM=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# Watchdog de MediaTek: aporta el manejador de reinicio (sin él `reboot` se queda parado con nuestro DT,
# 2026-10-20) y mantiene vivo el watchdog de hardware que deja lk (si el kernel se cuelga, reinicia).
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_CMDLINE="clk_ignore_unused pd_ignore_unused loglevel=8 printk.time=1"
CONFIG_CMDLINE_EXTEND=y
# Lápiz (I2C-HID en i2c-2 0x09) y táctil (cyttsp5): integrados, el initramfs no lleva módulos
CONFIG_I2C_HID_CORE=y
CONFIG_I2C_HID_OF=y
CONFIG_HID_MULTITOUCH=y
CONFIG_TOUCHSCREEN_CYTTSP5=y
# PMIC MT6351 por el PMIC wrapper: LDO (táctil vldo28, etc.)
CONFIG_MTK_PMIC_WRAP=y
CONFIG_REGULATOR_MT6351=y
# USB en modo dispositivo (SSUSB/mtu3 + T-PHY) con gadget configfs: ECM (red) y ACM (serie)
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
# eMMC (MSDC0)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_EFI_PARTITION=y
CONFIG_IIO=y
CONFIG_MSA311=y
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y
CONFIG_EINK_T1000=y
CONFIG_MTK_MT6797_CONSYS=y
CONFIG_MTK_MT6797_BTIF=y
CONFIG_MTK_MT6797_STP=y
CONFIG_MTK_MT6797_STP_SESSION=y
CONFIG_MTK_MT6797_WMT_INIT=y
CONFIG_MTK_MT6797_WMT=y
CONFIG_MTK_MT6797_WLAN_HIF=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_CFG80211=y
CONFIG_MTK_MT6797_WLAN=y
CONFIG_BT=y
CONFIG_BT_MT6797=y
CONFIG_FW_LOADER=y
CONFIG_NVMEM=y
CONFIG_WIRELESS=y
CONFIG_NETDEVICES=y
CONFIG_RFKILL=y
CONFIG_NL80211_TESTMODE=y
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_BQ24190=y
CONFIG_EXTCON=y
CONFIG_BATTERY_MT6351=y
CONFIG_ARM_MT6797_CPUFREQ=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_MTK_MT6797_SPM=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_MT6351=y
CONFIG_MTK_MT6351_IRQ=y
CONFIG_INPUT_MT6351_PWRKEY=y
